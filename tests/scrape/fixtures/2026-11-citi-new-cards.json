      "firstLine": 2249,
      "sourceStartByte": 82298,
      "text": "<h3 class=\"cmp-title__text\">CITI SIMPLICITY</h3>\n</div>\n\n    \n</div>\n\n          \n     \n     \n     \n     \n\n</div>\n<div class=\"responsivegrid text-primary\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"text max-w-none prose text-sm\">\n<div id=\"text-805d655755\" class=\"cmp-text\">\n    <ul><li>No late fee, cash advance fee or over limit fee - Ever</li><li>Enjoy access to select airport lounges across the Middle East</li></ul>\r\n\n</div>\n\n    \n\n</div>\n\n          \n     \n     \n     \n     \n\n</div>\n<div class=\"responsivegrid mx-auto\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"text\">\n<div id=\"text-9eb53addf9\" class=\"cmp-text\">\n    <table cellpadding=\"1\" cellspacing=\"0\" border=\"1\"><tbody><tr><td style=\"\ttext-align: center;\n\tborder: 1.0px solid black;\n\tpadding: 10.0px;\n\twidth: 120.0px;\n\"><small>Annual fee</small><br />\r\n<b>AED 0</b></td><td style=\"\ttext-align: center;\n\tborder: 1.0px solid black;\n\tpadding: 10.0px;\n\twidth: 200.0px;\n\"><small>Minimum Monthly Income</small><br />\r\n<b>AED 5,000</b></td></tr></tbody></table>\r\n\n</div>\n\n    \n\n</div>\n<div class=\"responsivegrid py-5 text-center\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"button cmp-button--primary bg-orange-600 hover:bg-orange-900\"><a id=\"button-2fdf22dd4a\" class=\"cmp-button\" data-cmp-clickable data-ctatype=\"link\" data-ctaname=\"Apply Now\" data-ctaposition=\"undefined\" data-destinationurl=\"https://online.citibank.ae/roca/services/api/product/apply?LV=AE&amp;locale=en&amp;prd=MC510&amp;srcd=100AMF&amp;cicmp=GEN&amp;pf=PCCD&amp;source=GS\" href=\"https://online.citibank.ae/roca/services/api/product/apply?LV=AE&locale=en&prd=MC510&srcd=100AMF&cicmp=GEN&pf=PCCD&source=GS\" target=\"_blank\">",
