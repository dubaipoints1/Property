      "sourceStartByte": 68503,
      "text": "<h3 class=\"cmp-title__text\">CITI REWARDS</h3>\n</div>\n\n    \n</div>\n\n          \n     \n     \n     \n     \n\n</div>\n<div class=\"responsivegrid text-primary\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"text max-w-none prose text-sm\">\n<div id=\"text-d767659b35\" class=\"cmp-text\">\n    <ul><li>Redeem points for cash rebates or travel related spend.</li><li>Access to 1,200 lounges worldwide with MasterCard Travel Pass app.</li><li>No Annual Fee (Spend based)*</li><li>Flat 30% off movie tickets at VOX Cinemas every month.</li></ul>\n\n</div>\n\n    \n\n</div>\n\n          \n     \n     \n     \n     \n\n</div>\n<div class=\"responsivegrid flex flex-col items-center mx-auto space-y-2\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"title font-bold text-center text-primary\"><div id=\"title-75fcfb536d\" class=\"cmp-title\">\n    <h2 class=\"cmp-title__text\">No Annual Fee (Spend based)*</h2>\n</div>\n\n    \n</div>\n<div class=\"text\">\n<div id=\"text-e14709a701\" class=\"cmp-text\">\n    <table cellpadding=\"1\" cellspacing=\"0\" border=\"1\"><tbody><tr><td style=\"\ttext-align: center;\n\tborder: 1.0px solid black;\n\tpadding: 10.0px;\n\twidth: 120.0px;\n\"><small>Annual fee</small><br />\n<b>AED 300*</b></td><td style=\"\ttext-align: center;\n\tborder: 1.0px solid black;\n\tpadding: 10.0px;\n\twidth: 200.0px;\n\"><small>Minimum Monthly Income</small><br />\n<b>AED 8,000</b></td></tr></tbody></table>\n\n</div>\n\n    \n\n</div>\n<div class=\"responsivegrid py-5 text-center\">\n\n    \n    \n     \n     \n          \n          \n          \n          \n          <div class=\"button cmp-button--primary bg-orange-600 hover:bg-orange-900\"><a id=\"button-e2ce66d0fa\" class=\"cmp-button\" data-cmp-clickable data-ctatype=\"link\" data-ctaname=\"Apply Now\" data-ctaposition=\"undefined\" data-destinationurl=\"https://online.citibank.ae/roca/services/api/product/apply?LV=AE&amp;locale=en&amp;prd=MC710&amp;srcd=191AMF&amp;cicmp=GEN&amp;pf=PCCD&amp;source=GS\" href=\"https://online.citibank.ae/roca/services/api/product/apply?LV=AE&locale=en&prd=MC710&srcd=191AMF&cicmp=GEN&pf=PCCD&source=GS\" target=\"_blank\">",
