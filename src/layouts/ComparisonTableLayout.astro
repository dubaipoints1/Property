---
// Comparison-table layout — Phase H2 (Claude Design handoff alignment).
// Used by /cards/cashback/, /cards/islamic/, /cards/miles/, /cards/compare/.
//
// Page head uses the design-handoff narrow pagehead chrome.

import BaseLayout from "./BaseLayout.astro";
import CompareCardArt from "~/components/cards/CompareCardArt.astro";

interface Row {
  cardName: string;
  bankName: string;
  href: string;
  values: (string | number)[];
}

interface Props {
  title: string;
  /** On-page H1; falls back to `title`. Pass this without the
   * "| DubaiPoints" brand suffix — that belongs only in the meta title. */
  heading?: string;
  description?: string;
  columns: string[];
  rows: Row[];
}

const { title, heading, description, columns, rows } = Astro.props;
const displayRows = rows.map((row) => ({
  ...row,
  cardSlug: row.href.match(/^\/cards\/([^/]+)\/$/)?.[1],
}));
---

<BaseLayout title={title} description={description} fullWidth>
  <header class="dp-pagehead is-narrow dp-cmp-head">
    <div class="crumb"><a href="/cards/compare/" class="crumb-link">Compare</a></div>
    <h1>{heading ?? title}</h1>
    {description && <p class="deck">{description}</p>}
  </header>

  <article class="dp-cmp-body">
    <p class="dp-compare-scroll-hint">Scroll across the table to compare every column.</p>
    <div class="dp-compare-wrap" tabindex="0" role="region" aria-label={`${heading ?? title} comparison table`}>
      <table class="dp-compare-table" role="table">
        <caption class="sr-only">{heading ?? title}</caption>
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Card</th>
            {columns.map((c) => <th scope="col" role="columnheader">{c}</th>)}
          </tr>
        </thead>
        <tbody role="rowgroup">
          {displayRows.map((r) => (
            <tr role="row">
              <th scope="row" role="rowheader" class="dp-compare-card">
                <div class="dp-compare-card-identity">
                  {r.cardSlug && <CompareCardArt slug={r.cardSlug} />}
                  <div><a href={r.href}>{r.cardName}</a><span class="dp-compare-bank">{r.bankName}</span></div>
                </div>
              </th>
              {r.values.map((v, i) => (
                <td role="cell">
                  <span class="dp-compare-label" aria-hidden="true">{columns[i]}</span>
                  <span class="dp-compare-value">{v}</span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <section class="dp-prose dp-cmp-prose">
      <slot />
    </section>
  </article>
</BaseLayout>

<style>
  .dp-cmp-head.is-narrow { max-width: 1080px; }
  .dp-cmp-body {
    max-width: 1080px;
    margin: 0 auto;
    padding: 32px 32px 80px;
  }
  .dp-compare-wrap {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
  }
  .dp-compare-wrap:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .dp-compare-scroll-hint { margin: 0 0 10px; color: var(--ink-soft); font: 400 .8125rem/1.5 var(--font-ui); }
  .dp-compare-card-identity { display: flex; align-items: center; gap: 12px; min-inline-size: 0; }
  .dp-compare-card-identity > div { min-inline-size: 0; }
  .dp-compare-card a:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .dp-compare-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
  }
  .dp-compare-table thead {
    background: var(--shade-1);
    text-align: left;
  }
  .dp-compare-table thead th {
    padding: 14px 16px;
    font-family: var(--font-ui);
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.8px; text-transform: uppercase;
    color: var(--ink-soft);
    white-space: nowrap;
  }
  .dp-compare-table :is(td, tbody th) {
    padding: 16px;
    border-top: 1px solid var(--line-soft);
    font-size: 14px;
    color: var(--ink-soft);
    vertical-align: top;
    text-align: left;
    font-variant-numeric: tabular-nums;
  }
  .dp-compare-table tbody tr:hover td { background: var(--shade-1); }
  .dp-compare-label { display: none; }
  .dp-compare-card {
    position: sticky;
    left: 0;
    background: var(--paper);
    border-right: 1px solid var(--line);
    font-weight: 400;
  }
  .dp-compare-table tbody tr:hover .dp-compare-card { background: var(--shade-1); }
  .dp-compare-card a {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.2px;
    color: var(--ink);
    display: block;
    text-decoration: none;
  }
  .dp-compare-card a:hover { color: var(--green); }
  .dp-compare-bank {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: var(--muted);
  }

  .dp-cmp-prose { margin-top: 32px; max-width: 70ch; }
  .dp-cmp-prose > p:first-of-type::first-letter {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    float: none;
    padding: 0;
    color: inherit;
  }

  /* Stack when the 760px data table no longer fits with its gutters.
     Preserve the real table headings in the accessibility tree and
     supply compact visual labels separately. */
  @media (max-width: 824px) {
    .dp-cmp-body { padding-block: 20px 60px; }
    .dp-compare-scroll-hint { display: none; }
    .dp-compare-wrap {
      overflow: visible;
      border: 0;
      background: transparent;
      border-radius: 0;
    }
    .dp-compare-table {
      min-width: 0;
      display: block;
    }
    .dp-compare-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .dp-compare-table tbody { display: block; }
    .dp-compare-table tr {
      display: block;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 12px;
      margin-bottom: 12px;
      padding: 18px 18px 4px;
    }
    .dp-compare-table tbody tr:hover td { background: transparent; }
    .dp-compare-table td {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: baseline;
      gap: 16px;
      border-top: 0;
      border-bottom: 1px solid var(--line-soft);
      padding: 10px 0;
      font-size: 14px;
    }
    .dp-compare-table td:last-child { border-bottom: 0; }
    .dp-compare-label {
      display: block;
      font-family: var(--font-ui);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--muted);
      overflow-wrap: anywhere;
    }
    .dp-compare-value { text-align: end; overflow-wrap: anywhere; }
    /* Card cell renders as a header — full width, no label prefix,
       larger card name + bank below */
    .dp-compare-card {
      display: block !important;
      position: static !important;
      background: transparent !important;
      border-right: 0;
      border-bottom: 1px solid var(--line) !important;
      border-top: 0 !important;
      padding: 0 0 12px !important;
      margin-bottom: 6px;
    }
    .dp-compare-card a {
      font-size: 17px;
    }
  }
  @media (max-width: 640px) {
    .dp-cmp-body { padding-inline: 20px; }
  }
</style>
