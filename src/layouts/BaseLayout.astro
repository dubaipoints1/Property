---
import "~/styles/global.css";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import SchemaJsonLd from "~/components/seo/SchemaJsonLd.astro";

interface Props {
  title: string;
  description?: string;
  fullWidth?: boolean;
  /** Override the default OG image for a specific page (absolute or root path). */
  ogImage?: string;
  /** og:type — "website" (default) or "article" for editorial pages. */
  ogType?: "website" | "article";
  /** Per-page structured data (Product / Article / NewsArticle / Organization /
   * BreadcrumbList) injected before the default WebSite + Organization graph.
   * Layout components compose the right shape and hand it through. */
  schema?: unknown;
}

const {
  title,
  description = "UAE points and miles — credit card analysis, loyalty programs, and deals.",
  fullWidth = false,
  ogImage,
  ogType = "website",
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const siteName = "DubaiPoints";
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
// Default is the PNG raster of og-default.svg — SVG is not a supported
// og:image format on X / Facebook / LinkedIn / WhatsApp, so serving the
// SVG meant every share rendered with no preview at all. Regenerate with:
// node -e "require('sharp')('public/og-default.svg',{density:96}).resize(1200,630).png().toFile('public/og-default.png')"
const ogImageUrl = ogImage
  ? new URL(ogImage, Astro.site).toString()
  : new URL("/og-default.png", Astro.site).toString();

// Default WebSite + Organization graph rendered on every page.
// Per-page schema (Product / Article / etc.) renders before this so
// search engines see the page-specific entity first.
const defaultGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: `${siteUrl}/`,
      name: siteName,
      description:
        "UAE-focused points-and-miles publication. AED-first credit-card reviews, salary-transfer tracker, loyalty-programme guides.",
      inLanguage: "en-AE",
      publisher: { "@id": `${siteUrl}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: siteName,
      url: `${siteUrl}/`,
      logo: `${siteUrl}/logo-mark.svg`,
      // sameAs deliberately absent: no social profiles exist to list (R6, 15 Sep 2026).
    },
  ],
};

// PR-D (29 May 2026): Cloudflare Web Analytics token now gated behind
// PUBLIC_CF_BEACON_TOKEN env var. Build-time env injection only —
// the publisher sets this in Cloudflare Pages → Environment Variables.
// Without it, the beacon is omitted entirely rather than rendering
// a broken script with the literal "REPLACE_WITH_…" placeholder.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN as string | undefined;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
<!-- Theme initialization — MUST run before any styles to prevent flash -->
  <script is:inline>
    (function() {
      const saved = localStorage.getItem('dp-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = saved || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    })();
  </script>
  
  <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/logo-mark.svg" />
    <link rel="mask-icon" href="/logo-mark.svg" color="#1f3a4d" />
    <meta name="theme-color" content="#1f3a4d" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    {!ogImage && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
      </>
    )}
    <meta property="og:locale" content="en_AE" />

    {/* Per-page <head> extras (RSS autodiscovery on the news desks,
        2026-07-27). Named slot: pages pass <link slot="head" …>; without
        this the element renders nowhere at all. */}
    <slot name="head" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Font loading: preconnect first, then a non-render-blocking stylesheet.
         Redesign Phase 2 (A+B): Newsreader display + Geist UI. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=optional"
      media="print"
      onload="this.setAttribute('media','all')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;0,6..72,700;1,6..72,400;1,6..72,500&display=optional"
      />
    </noscript>
    {schema && <SchemaJsonLd schema={schema} />}
    <SchemaJsonLd schema={defaultGraph} />

    {
      import.meta.env.PROD && cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${cfBeaconToken}"}`}
        />
      )
    }
  </head>
  <body class="dp-body">
    <Header />
    <main class={fullWidth ? "dp-main is-full" : "dp-main"}>
      <slot />
    </main>
    <Footer />

    <!-- Motion layer (2026-10-04 redesign, Phase 1): scroll reveal, number
         ticker, cursor spotlight. Styles live at the end of global.css.
         Processed by Astro, which inlines it as one <script type="module">
         at this size: one more executable inline script for the CSP
         inventory (.council/research/2026-09/csp-inline-script-inventory-
         2026-09-17.md). Does nothing under prefers-reduced-motion, and
         nothing is hidden until this has run. -->
    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Carousel prev/next: buttons stay hidden until wired, so no-JS readers
      // get a plain swipeable row with nothing inert on it. Not motion, so it
      // runs under reduced motion too (with instant scrolling).
      document.querySelectorAll("[data-carousel]").forEach((track) => {
        const section = track.closest("section") ?? track.parentElement;
        const prev = section?.querySelector("[data-carousel-prev]") as HTMLButtonElement | null;
        const next = section?.querySelector("[data-carousel-next]") as HTMLButtonElement | null;
        if (!prev || !next) return;
        const el = track as HTMLElement;
        const page = () => Math.max(el.clientWidth * 0.8, 240);
        const sync = () => {
          prev.disabled = el.scrollLeft <= 2;
          next.disabled = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2;
        };
        prev.hidden = next.hidden = false;
        prev.addEventListener("click", () => el.scrollBy({ left: -page(), behavior: reduced ? "auto" : "smooth" }));
        next.addEventListener("click", () => el.scrollBy({ left: page(), behavior: reduced ? "auto" : "smooth" }));
        el.addEventListener("scroll", sync, { passive: true });
        window.addEventListener("resize", sync, { passive: true });
        sync();
      });

      if (!reduced && "IntersectionObserver" in window) {
        document.documentElement.classList.add("dp-motion");

        // Scroll reveal: opt-in. Homepage bands carry data-reveal; directory
        // tiles, tool cards and the featured band's articles are included by
        // class. Never a prose <section> on a reading page (motion audit F1),
        // and never an element inside another reveal (F3).
        const targets = document.querySelectorAll(
          "[data-reveal], .dp-dir-tile, .dp-tool, .dp-featured-band article",
        );
        const io = new IntersectionObserver(
          (entries) => {
            // Stagger by position within the batch that entered together,
            // capped at 3 × 60 ms — not by DOM index (F2).
            let i = 0;
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              (e.target as HTMLElement).style.setProperty("--dp-i", String(Math.min(i++, 3)));
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach((el) => {
          if (el.parentElement?.closest(".dp-reveal, [data-reveal]")) return;
          el.classList.add("dp-reveal");
          io.observe(el);
        });

        // Number ticker: counts integers up to the server-rendered value.
        const tick = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            tick.unobserve(e.target);
            const el = e.target as HTMLElement;
            const end = parseInt((el.textContent || "").replace(/[^0-9]/g, ""), 10);
            if (!Number.isFinite(end) || end <= 0) continue;
            const t0 = performance.now();
            const dur = 600;
            const step = (now: number) => {
              const p = Math.min((now - t0) / dur, 1);
              const v = Math.round(end * (1 - Math.pow(1 - p, 3)));
              // Never paint "0" over the server-rendered figure on frame one.
              if (v > 0) el.textContent = v.toLocaleString("en-US");
              if (p < 1) requestAnimationFrame(step);
            };
            requestAnimationFrame(step);
          }
        });
        // Start after the hero entrance has brought the figure to full
        // opacity, so no part of the count runs unseen (F4).
        setTimeout(() => {
          document.querySelectorAll("[data-count]").forEach((el) => tick.observe(el));
        }, 750);

        // Cursor spotlight on tiles (pointer devices).
        if (window.matchMedia("(hover: hover)").matches) {
          // One layout read per tile entered, not per pointermove.
          let last: HTMLElement | null = null;
          let rect: DOMRect | null = null;
          const reset = () => { last = null; rect = null; };
          window.addEventListener("scroll", reset, { passive: true });
          window.addEventListener("resize", reset, { passive: true });
          document.addEventListener("pointermove", (ev) => {
            const tile = (ev.target as Element | null)?.closest?.(".dp-dir-tile, .dp-tool") as HTMLElement | null;
            if (!tile) return;
            if (tile !== last || !rect) { last = tile; rect = tile.getBoundingClientRect(); }
            tile.style.setProperty("--dp-mx", `${ev.clientX - rect.left}px`);
            tile.style.setProperty("--dp-my", `${ev.clientY - rect.top}px`);
          }, { passive: true });
        }
      }
    </script>

    <!-- Back-to-top — visible after 600px scroll, click smooths to top -->
    <button id="dp-to-top" class="dp-to-top" type="button" aria-label="Back to top">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 14 12 8 18 14"></polyline>
      </svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.getElementById('dp-to-top');
        if (!btn) return;
        var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function update() {
          if (window.scrollY > 600) btn.classList.add('is-visible');
          else btn.classList.remove('is-visible');
        }
        window.addEventListener('scroll', update, { passive: true });
        update();
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
        });
      })();
    </script>
    <script>
      // Site-wide GSAP motion: smooth scroll, word-by-word headings, the
      // homepage picks row, magnetic buttons. See src/scripts/motion-gsap.ts.
      import "../scripts/motion-gsap";
    </script>
  </body>
</html>
