---
// Card review layout — Phase B3 (Claude Design handoff).
// Reference: dubaipoints/project/templates/article.jsx::CardReview.
// Used by /cards/<slug>/.
//
// Shape:
//   Editorial Utility head: name, recurring fees and eligibility first;
//   actions and existing issuer card art, contained rather than decorative.
//   ↓
//   2-col body grid at >=1024px:
//     [body] byline + deck + drop-cap prose (slot)
//     [aside] At-a-glance specs + Earn rates by category +
//             Editor's call (dark variant)
//   ↓
//   sources footer (reuses .dp-article-sources from B2)

import BaseLayout from "./BaseLayout.astro";
import UtilityPageHead from "~/components/UtilityPageHead.astro";
import Disclaimer from "~/components/Disclaimer.astro";
import BankOffers from "~/components/deals/BankOffers.astro";
import NextSteps from "~/components/cards/NextSteps.astro";
import CardJourney from "~/components/cards/CardJourney.astro";
import StockImage from "~/components/StockImage.astro";
import ImageCredit from "~/components/ImageCredit.astro";
import CardImage from "~/components/CardImage.astro";
import { getCardArt } from "~/lib/cardArt";
import { cardArtSrcset } from "~/lib/stockDerivatives";
import HeroImage from "~/components/cards/HeroImage.astro";
import { getStockEntry } from "~/lib/stockManifest";
import { annualFeeLabel, formatEarnRate, welcomeBonusHeadline, formatAED } from "~/lib/cardsDataFormat";
import { getActiveCards, getCardData } from "~/lib/cardsData";
import { cardFxFeeLabel, cardFxNeedsReview, cardFeeNeedsReview } from "~/lib/cardFeeFacts";
import { matchupsForCard, matchupSlug } from "~/data/cardMatchups";
import { getCollection } from "astro:content";
import type { CardData } from "~/lib/cardsData";

interface Props {
  title: string;
  /** On-page H1; falls back to `title`. Pass this without the
   * "| DubaiPoints" brand suffix — that belongs only in the meta title. */
  heading?: string;
  description?: string;
  bankName: string;
  /** bank slug (e.g. "fab", "emirates-nbd") — drives per-issuer tint on card-art mock */
  bankSlug?: string;
  /** card slug — used to look up a per-card photograph in the stock manifest. */
  slug?: string;
  cardName: string;
  network: string;
  annualFee: number;
  fxFee: number | null;
  fxFeeScope?: CardData["fxFeeScope"];
  fxFeeVatTreatment?: CardData["fxFeeVatTreatment"];
  fxFeeUpperBound?: CardData["fxFeeUpperBound"];
  minSalary: number | null;
  earnRates: Record<string, number | undefined>;
  /** L2 earnUnit — drives whether the spec-card earn rows render "5%"
   * (cashback) or "2×" (points). §6 unit-integrity (2026-05-29). */
  earnUnit?: string;
  /** L2 categories array — paired with earnUnit by `earnIsPercentage` to
   * disambiguate cashback vs multiplier rendering. The hub category
   * (`Cards` / `Travel & Miles` / etc.) is a page-display label and
   * should NOT be threaded here; L2 `categories` is the canonical
   * source. */
  categories?: readonly string[];
  /** L2 `_provenance.fxFee` — when "needs-review" the sidebar FX row
   * renders "—" instead of a bare percent so an unverified zero can't
   * be mistaken for a confirmed zero. (1 June 2026 audit follow-up
   * to the 2026-05-29 §10 ADCB FX-fee amendment.) */
  fxFeeProvenance?: string;
  /** L2 `_provenance.eligibility` — when "needs-review" the sidebar
   * Min salary row renders "—" instead of a bare AED figure. Mirrors
   * the fxFeeProvenance pattern; closes the 3 June 2026 audit P0 H3
   * "minSalary leaks as confirmed across chrome surfaces" finding. */
  eligibilityProvenance?: string;
  /** L2 `eligibility.invitationOnly` — when true the sidebar Min salary
   * row renders "Invitation only" instead of "AED 0/mo", matching the
   * AtAGlance tile on the same page (10 June 2026 fresh-eyes audit:
   * FAB World Elite sidebar claimed AED 0/mo while the tile said
   * Invitation only). */
  invitationOnly?: boolean;
  perks?: string[];
  pros?: string[];
  cons?: string[];
  /** The short verdict already published by the review’s EditorVerdict component. */
  editorialVerdict?: string;
  category?: string;
  score?: number;
  verdictLabel?: string;
  lastVerified: Date;
  verificationLimited?: boolean;
  verifiedBy?: string;
  sources: string[];
  deck?: string;
  /** L2 welcomeBonus — rendered in the summary below the key facts.
   * Prefers the structured `headline` field; falls
   * back to `${amount} ${unit}` only when the headline is unset.
   * The page `description` prop is the SEO meta, not the welcome bonus —
   * the strap renders welcomeBonus separately to avoid the cross-wire. */
  welcomeBonus?: CardData["welcomeBonus"];
  /** Optional licensed editorial hero photo, rendered above the body
   * grid. Schema matches `cards` collection
   * `heroImage` field; the filename resolves against
   * `src/assets/cards/library/`. */
  heroImage?: {
    src: string;
    alt: string;
    caption?: string;
    credit?: string;
  };
}

const {
  title,
  heading,
  description,
  bankName,
  bankSlug,
  slug,
  cardName,
  network,
  annualFee,
  fxFee,
  fxFeeScope,
  fxFeeVatTreatment,
  fxFeeUpperBound,
  minSalary,
  earnRates,
  earnUnit,
  categories = [],
  fxFeeProvenance,
  eligibilityProvenance,
  invitationOnly = false,
  perks = [],
  // pros + cons are accepted on the props interface for backward
  // compatibility with existing call sites in src/pages/cards/[slug].astro,
  // but no longer consumed by the layout — see Phase 2a.2.0 (2026-05-20):
  // they are rendered by the MDX-invoked `<ProsCons />` component instead.
  editorialVerdict,
  category = "Cards",
  score,
  verdictLabel,
  lastVerified,
  verificationLimited = false,
  verifiedBy = "DubaiPoints Editorial",
  sources,
  deck,
  welcomeBonus,
  heroImage,
} = Astro.props;

// Welcome-bonus headline for the review summary. The page passes the
// SEO meta description as `description`; that's NOT the welcome bonus
// (it's the "bankName cardName review · annual fee · min salary · top
// earn · AED-first verdict" composed string for SERPs). The strap
// shows the editor-typed L2 welcomeBonus.headline instead — falling
// back to amount + unit when no headline is set, and to null when the
// card has no structured welcome bonus at all (in which case the strap
// is hidden entirely).
const welcomeBonusStrap = welcomeBonusHeadline(welcomeBonus) || null;
const shortVerdict = editorialVerdict?.trim();

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

const initials = verifiedBy
  .split(/\s+/)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .slice(0, 2)
  .join("");

const earnRows = Object.entries(earnRates).filter(
  ([, v]) => typeof v === "number",
) as Array<[string, number]>;

const formatEarnKey = (k: string) =>
  k.replace(/([A-Z])/g, " $1").replace(/^./, (s) => s.toUpperCase());

const fmtScore = (s?: number) => {
  if (s == null) return null;
  return s.toFixed(1).replace(/\.0$/, "");
};

// ── Related reviews (recirculation) ──────────────────────────────────
// Card reviews are the core product and the highest-count page type, but
// a reader finishing one had no on-page path to another — a pages-per-
// session leak the sibling layouts (Article / BankHub / AirlineProgram)
// already close. Mirror the ArticleLayout related-guides footer; it
// reuses the shared `.dp-article-related*` styles in global.css, so no
// new CSS. Relatedness ranks shared hub category first (the strongest
// cross-shop signal — a cashback reader wants other cashback cards),
// then same issuer, then freshness. The current card is always excluded.
const relatedBanks = await getCollection("banks");
const relatedBankName = (bankId: string) =>
  relatedBanks.find((b) => b.id === bankId)?.data.name ?? bankId;
const relatedDescriptor = (c: CardData) =>
  welcomeBonusHeadline(c.welcomeBonus) ||
  (cardFeeNeedsReview(c, "annualFee") ? "Annual fee pending" : c.annualFee.amount === 0
    ? "No annual fee"
    : c.standardFeeConditions
      ? `${annualFeeLabel(c).amount} standard annual fee · ${annualFeeLabel(c).qual}`
      : `${formatAED(c.annualFee.amount)} annual fee`);
const relatedCards = getActiveCards()
  .filter((c) => c.slug !== slug)
  .map((c) => {
    let relScore = 0;
    if (category && c.categories?.[0] === category) relScore += 2;
    if (bankSlug && c.bank === bankSlug) relScore += 1;
    return { c, relScore };
  })
  .sort(
    (a, b) =>
      b.relScore - a.relScore ||
      new Date(b.c.lastVerified).getTime() -
        new Date(a.c.lastVerified).getTime(),
  )
  .slice(0, 3)
  .map(({ c }) => c);
const compareHref = slug ? `/cards/compare/?cards=${[slug, ...relatedCards.slice(0, 2).map((c) => c.slug)].join(",")}` : "/cards/compare/";
const cardData = slug ? getCardData(slug) : undefined;
const publishedIncome = cardData?.eligibility.publishedMinMonthlyIncome;
// These issuer batches are the measured surfaces; do not change eager/lazy
// behaviour on unrelated card profiles or the main card artwork.
const deferRelatedArt = slug === "mashreq-noon" || slug === "mashreq-platinum-plus" || slug === "mashreq-solitaire"
  || slug === "fab-adnoc-rewards" || slug === "fab-gems-world" || slug === "fab-travel"
  || slug === "dib-consumer-cashback-platinum" || slug === "dib-shams-platinum"
  || slug === "dib-prime-platinum" || slug === "dib-shams-signature" || slug === "dib-shams-infinite"
  || slug === "rakbank-red" || slug === "rakbank-titanium"
  || slug === "fab-du-titanium" || slug === "fab-rewards-indulge" || slug === "fab-rewards-active"
  || slug === "mashreq-aura" || slug === "mashreq-aura-world" || slug === "mashreq-aura-world-elite";
const incomeLabel = cardData?.eligibility.publishedIncomeBasis === "salary" ? "Published minimum monthly salary"
  : cardData?.eligibility.publishedIncomeBasis === "salaried-applicants" ? "Minimum monthly salary (salaried applicants)"
  : "Published minimum monthly income";
const availabilityUnconfirmed = cardData?.applicationAvailability === "unconfirmed";
const applicationUnavailable = availabilityUnconfirmed || cardData?.discontinuedForNewApplicants !== undefined;
const fxProvenance = cardData?._provenance ?? (fxFeeProvenance ? { fxFee: fxFeeProvenance } : {});
const fxPending = cardFxNeedsReview({ _provenance: fxProvenance });
const recurringFee = annualFeeLabel(cardData ?? { annualFee: { amount: annualFee } });
const annualFeePending = cardData ? cardFeeNeedsReview(cardData, "annualFee") : false;
const singleFeeOffer = !annualFeePending && !applicationUnavailable
  && !(cardData?.refreshMode === "manual-primary" && recurringFee.qual);
const vatQualifier = !annualFeePending && annualFee > 0 ? (cardData?.vatPolicy === "exclusive" ? "+ 5% VAT" : "incl. VAT") : null;

// Stock photograph lookup. Each card may have an editorial photograph
// registered in data/stock/manifest.json under `card-<slug>` (e.g.
// `card-emirates-nbd-skywards-infinite`). When present, the hero band
// uses the photo if it doesn't have issuer art. There is no synthetic
// product image if neither is available.
const stockSlug = slug ? `card-${slug}` : null;
const stockEntry = stockSlug ? getStockEntry(stockSlug) : undefined;
const hasStockCredit = stockEntry?.source === "pexels" || stockEntry?.source === "unsplash";
// Issuer card art (9 Oct 2026) outranks the stock photograph: the reader
// is looking at a review of this card, so show this card.
const cardArt = slug ? getCardArt(slug) : undefined;
const cardArtSources = slug && cardArt ? cardArtSrcset(slug, cardArt) : undefined;

// JSON-LD: every card review emits a Product entity with a FinancialProduct
// additionalType so search engines parse it as a credit card. The fee and
// eligibility carry into offers / brand. BreadcrumbList complements it.
// PR-D (29 May 2026) per SEO + Tech audit P0.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Product", "FinancialProduct"],
      "@id": `${canonicalUrl}#product`,
      name: cardName,
      brand: { "@type": "Organization", name: bankName },
      category: category ?? "Credit card",
      // Omit description rather than fall back to a placeholder string —
      // Schema.org's Product type doesn't require it, and an absent
      // description is more honest than a generic stand-in (1 June 2026
      // audit LOW).
      ...(description ? { description } : {}),
      url: canonicalUrl,
      ...(slug ? { sku: slug } : {}),
      ...(typeof score === "number"
        ? {
            aggregateRating: {
              "@type": "AggregateRating",
              ratingValue: score,
              bestRating: 10,
              worstRating: 0,
              ratingCount: 1,
              author: { "@type": "Organization", name: "DubaiPoints" },
            },
          }
        : {}),
      ...(singleFeeOffer ? { offers: {
        "@type": "Offer",
        priceCurrency: "AED",
        price: annualFee,
        url: canonicalUrl,
      } } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Cards", item: `${siteUrl}/cards/` },
        // Mirrors the visible trail (Cards → bank → this page); the bank
        // step is omitted when the issuer has no hub.
        ...(bankSlug
          ? [{ "@type": "ListItem", position: 3, name: bankName, item: `${siteUrl}/banks/${bankSlug}/` },
             { "@type": "ListItem", position: 4, name: cardName, item: canonicalUrl }]
          : [{ "@type": "ListItem", position: 3, name: cardName, item: canonicalUrl }]),
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} fullWidth schema={schema}>

  <UtilityPageHead variant="card" class="dp-card-review-head">
    {cardArt ? (
      <figure slot="media" class="dp-card-summary-figure">
        <span class="dp-card-summary-art">
          <img
            src={`/${cardArt.file}`}
            srcset={cardArtSources}
            sizes={cardArtSources ? "(max-width: 719px) 176px, 264px" : undefined}
            width={cardArt.width}
            height={cardArt.height}
            alt={`${cardName} card, as shown by ${bankName}`}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </span>
        <figcaption>Card image: {bankName}</figcaption>
      </figure>
    ) : stockEntry && stockSlug ? (
      <figure slot="media" class="dp-card-summary-figure is-photo">
        <StockImage
          slug={stockSlug}
          class="dp-card-summary-photo"
          sizes="(max-width: 719px) 192px, 304px"
          loading="eager"
        />
        {hasStockCredit && <figcaption><ImageCredit slug={stockSlug} /></figcaption>}
      </figure>
    ) : null}

    <div class="dp-card-summary">
      <nav class="dp-utility-kicker" aria-label="Breadcrumb">
        {/* 10 June 2026 SEO audit: the bank segment links to /banks/<slug>/ so
            every review carries a visible inbound link to its issuer hub. */}
        <ol>
          <li><a href="/cards/">Cards</a></li>
          {category !== "Cards" && <li>{category}</li>}
          <li>{bankSlug ? <a href={`/banks/${bankSlug}/`}>{bankName}</a> : bankName}</li>
        </ol>
      </nav>
      <h1>{heading ?? title}</h1>
      <dl class="dp-card-summary-facts">
        <div>
          <dt>{cardData?.standardFeeConditions ? "Standard annual fee" : "Annual fee"}</dt>
          <dd>{recurringFee.amount}</dd>
          {(recurringFee.qual || vatQualifier) && <dd class="detail">{[recurringFee.qual, vatQualifier].filter(Boolean).join(" · ")}</dd>}
        </div>
        <div>
          <dt>{publishedIncome === undefined ? "Minimum monthly salary" : incomeLabel}</dt>
          <dd class={publishedIncome === undefined && eligibilityProvenance === "needs-review" ? "is-unverified" : ""}>
            {publishedIncome !== undefined ? formatAED(publishedIncome)
              : eligibilityProvenance === "needs-review"
              ? "Pending"
              : invitationOnly
              ? "Invitation only"
              : minSalary === null
              ? <><span aria-hidden="true">—</span><span class="sr-only">not yet verified</span></>
              : minSalary === 0
              ? "No minimum"
              : minSalary === null ? "Pending" : formatAED(minSalary)}
          </dd>
          {publishedIncome !== undefined && <dd class="detail">Other eligibility conditions pending</dd>}
        </div>
        <div>
          <dt>FX markup</dt>
          <dd class={fxPending ? "is-unverified" : ""}>
            {fxPending
              ? <><span aria-hidden="true">—</span><span class="sr-only">not yet verified</span></>
              : fxFeeScope || fxFeeUpperBound || fxFee === null
              ? cardFxFeeLabel({ fxFee, fxFeeScope, fxFeeVatTreatment, fxFeeUpperBound, _provenance: fxProvenance })
              : fxFee === 0
              ? "None"
              : `${fxFee.toFixed(2)}%`}
          </dd>
        </div>
      </dl>
      <p class="dp-card-summary-proof">
        {network && <>{network}<span aria-hidden="true"> · </span></>}
        {verificationLimited ? "Source record" : "Verified"} <time datetime={lastVerified.toISOString()}>{fmt(lastVerified)}</time>{verificationLimited && " — some terms pending"}
      </p>
      {availabilityUnconfirmed && <p class="dp-card-summary-proof">New applications are unconfirmed. This source profile is retained for reference, not an open-application recommendation.</p>}
      {shortVerdict && <p class="dp-card-summary-verdict" data-card-hero-verdict><strong>Our verdict:</strong> {shortVerdict}</p>}
      {(score != null || verdictLabel) && (
        <p class="dp-card-summary-verdict"><strong>{shortVerdict ? "Verdict rating:" : "Our verdict:"}</strong> {score != null && `${fmtScore(score)}/5`} {verdictLabel}</p>
      )}
      {welcomeBonusStrap && <p class="dp-card-summary-bonus"><strong>Welcome bonus:</strong> {welcomeBonusStrap}</p>}
      <div class="dp-utility-actions">
        <a class="dp-ui-action dp-ui-primary" href={compareHref}>Compare cards</a>
        {sources.length > 0 && <a class="dp-ui-action dp-ui-secondary" href="#card-review-sources">See issuer sources</a>}
      </div>
    </div>
  </UtilityPageHead>

  <CardJourney />

  {heroImage && (
    <div class="dp-cr-hero-photo-wrap">
      <HeroImage {...heroImage} />
    </div>
  )}

  <!-- Body grid: prose + sticky sidebar -->
  <div class="dp-cr-body-grid">
    <article class="dp-cr-body">

      <!-- Byline -->
      <div class="dp-byline-strip dp-cr-byline">
        <div class="av" aria-hidden="true">{initials}</div>
        <div>
          <div class="name">{verifiedBy}</div>
          <div class="when">{verificationLimited ? `Source record ${fmt(lastVerified)} — see unresolved terms below` : `Verified ${fmt(lastVerified)} against issuer T&Cs`}</div>
        </div>
      </div>

      {deck && <p class="deck">{deck}</p>}

      {/*
        Editorial Utility places the MDX's short verdict above the bonus.
        If there is no authored kicker, the body verdict remains visible.
        The review's rationale, pros/cons and scorecard remain in the body.

        Jump-nav renders from inside the MDX body (every review authors
        its own JumpToSection with curated labels) — same rule: layout-
        side rendering double-renders it.

        JSX comment, not an HTML comment: HTML comments ship to the
        browser, and this note was leaking an internal .council path
        into the page source of all 55 reviews (2 July 2026 leak audit).
      */}

      {/*
        Phase 2a.2.0 (2026-05-20): the "Our take" callout and the
        pros/cons block were migrated to MDX-invoked components. Do not
        add a duplicate callout or pros/cons list to this layout. Editorial
        Utility promotes only the identical published short verdict into
        the summary when available; MDX still owns the body and jump links.
        See .council/briefs/2026-05-20-phase-2a-2-0-pros-cons-verdict-amendment.md.
      */}
      <div class:list={["dp-prose", { "dp-card-verdict-in-summary": shortVerdict }]}>
        <slot />
      </div>

      {slug && (
        <NextSteps
          slug={slug}
          cardName={cardName}
          bankSlug={bankSlug}
          bankName={bankName}
          earnUnit={earnUnit}
          minSalary={eligibilityProvenance === "needs-review" ? null : minSalary}
          rivals={relatedCards.map((c) => ({ slug: c.slug, name: c.name }))}
        />
      )}

      {bankSlug && <BankOffers bankSlug={bankSlug} bankName={bankName} />}

      <Disclaimer variant="card" />
    </article>

    <!-- Sticky sidebar -->
    <aside class="dp-cr-aside">
      {earnRows.length > 0 && (
        <div class="dp-spec-card">
          <h2>Earn rates by category</h2>
          <dl class="dp-spec-rows">
            {earnRows.map(([k, v]) => (
              <div class="dp-spec-row">
                <dt class="k">{formatEarnKey(k)}</dt>
                <dd class={`v ${v >= 3 ? "flag" : ""}`}>{formatEarnRate(v, earnUnit, categories)}</dd>
              </div>
            ))}
          </dl>
        </div>
      )}

      {perks.length > 0 && (() => {
        // Filter junk perks bleeding from the scrape — Arabic-toggle UI
        // strings (`[العربية...`), Markdown image references
        // (`![icon...](http...)`), and other source-HTML artefacts that
        // the scrape normaliser hasn't been taught to strip yet.
        // Permanent fix lives in scripts/scrape/_normaliser.ts (BRE editor
        // + scrape pipeline pass); this is a display-time defence so
        // readers never see the garbage.
        const cleanPerks = perks.filter((p) => {
          const s = (p ?? "").trim();
          if (!s) return false;
          if (s.length < 4) return false;
          if (s.startsWith("[") || s.startsWith("![")) return false;
          if (s.startsWith("(") && s.includes("](")) return false;
          if (/^\\+$/.test(s)) return false;
          if (/^https?:\/\//i.test(s)) return false;
          if (/العربية/.test(s)) return false;
          if (/^icon\./i.test(s)) return false;
          if (/\.alt\]/.test(s)) return false;
          return true;
        });
        return cleanPerks.length > 0 ? (
          <div class="dp-spec-card">
            <h2>Perks</h2>
            <ul class="dp-spec-list">
              {cleanPerks.slice(0, 6).map((p) => (
                <li><span class="mark" aria-hidden="true">+</span>{p}</li>
              ))}
            </ul>
          </div>
        ) : null;
      })()}

      {/* Phase 2a.2.3 (2026-05-20): the layout's `.dp-spec-card.is-call`
         block was removed — it duplicated the EditorVerdict at the top.
         The new <EditorScorecard /> at the end of the MDX body carries
         the tier badge + dimension scores + apply/skip qualifiers. */}
    </aside>
  </div>

  {/* Head-to-head pages that involve this card. Without this the matchup
      pages would have exactly one inbound link each, from the compare hub —
      the orphan shape the 2026-09-06 audit flagged as F-013. */}
  {slug && matchupsForCard(slug).length > 0 && (
    <section class="dp-cr-matchups" aria-label="Head-to-head comparisons">
      <h2>Compared head to head</h2>
      <ul>
        {matchupsForCard(slug).map((m) => {
          const other = m.left === slug ? m.right : m.left;
          return (
            <li>
              <a href={`/cards/compare/${matchupSlug(m)}/`}>
                versus {getCardData(other)?.name ?? other}
              </a>
              <span>{m.deck}</span>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <!-- Related reviews (recirculation) — reuses shared .dp-article-related* -->
  {relatedCards.length > 0 && (
    <section class="dp-article-related" aria-label="Related card reviews">
      <div class="dp-article-related-head">
        <span class="eyebrow">Related</span>
        <h2>More card reviews</h2>
      </div>
      <div class="dp-article-related-grid">
        {relatedCards.map((c) => (
          <a href={`/cards/${c.slug}/`} class="dp-article-related-card">
            {deferRelatedArt ? (
              <span class="dp-related-art-slot">
                <template data-related-card-art>
                  <CardImage cardSlug={c.slug} cardName={c.name} bankName={relatedBankName(c.bank)} coverSize="med"
                    sizes="(max-width: 900px) calc(100vw - 40px), 380px" />
                </template>
                <noscript><CardImage cardSlug={c.slug} cardName={c.name} bankName={relatedBankName(c.bank)} coverSize="med"
                  sizes="(max-width: 900px) calc(100vw - 40px), 380px" /></noscript>
              </span>
            ) : (
              <CardImage cardSlug={c.slug} cardName={c.name} bankName={relatedBankName(c.bank)} coverSize="med"
                sizes="(max-width: 900px) calc(100vw - 40px), 380px" />
            )}
            <div class="body">
              <span class="cat">{relatedBankName(c.bank)} · {c.categories?.[0] ?? "Cards"}</span>
              <h3>{c.name}</h3>
              <p>{relatedDescriptor(c)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
  {deferRelatedArt && <script is:inline>
    (() => {
      const slots = [...document.querySelectorAll('[data-related-card-art]')];
      const reveal = (template) => template.replaceWith(template.content);
      if (!('IntersectionObserver' in window)) {
        slots.forEach(reveal);
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(({ target, isIntersecting }) => {
          if (!isIntersecting) return;
          observer.unobserve(target);
          const template = target.querySelector('[data-related-card-art]');
          if (template) reveal(template);
        });
      }, { rootMargin: '96px' });
      slots.forEach((template) => observer.observe(template.parentElement));
    })();
  </script>}

  <!-- Sources footer -->
  {sources.length > 0 && (
    <footer class="dp-article-sources dp-card-review-sources" id="card-review-sources">
      <p>
        <strong>{verificationLimited ? "Source record date:" : "Last verified:"}</strong> {fmt(lastVerified)}{verificationLimited && " — some terms remain pending; this is not whole-card verification."}
      </p>
      <p>
        <strong>Sources:</strong>{" "}
        {sources.map((s, i) => (
          <>
            {i > 0 && " · "}
            <a href={s} target="_blank" rel="noopener noreferrer">{new URL(s).hostname}</a>
          </>
        ))}
      </p>
    </footer>
  )}

</BaseLayout>

