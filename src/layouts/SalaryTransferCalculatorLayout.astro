---
// Salary-transfer calculator layout — Phase F1 (Claude Design handoff).
// Mirrors the Phase C tools chrome (pagehead-narrow + stats strip +
// methodology footer). The interactive tool itself is the Preact
// island injected via `slot="calculator"`.

import BaseLayout from "./BaseLayout.astro";
import Disclaimer from "~/components/Disclaimer.astro";
import { publishedAEDPerUnit } from "~/lib/valuations";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const skywardsBaseline = publishedAEDPerUnit("Emirates Skywards");
---

<BaseLayout title={title} description={description} fullWidth>
  <header class="dp-pagehead is-narrow dp-salary-calc-head">
    <div class="crumb">Tools / <a href="/salary-transfer/" class="crumb-link">Salary transfer</a></div>
    <h1>Salary-transfer calculator</h1>
    <p class="deck">
      Compare estimated rewards by monthly salary and the products you are
      willing to take. Check issuer conditions before relying on an estimate.
    </p>
    <div class="dp-tools-stats">
      <div><strong>Inputs</strong> <span class="lbl">salary · products · tenure</span></div>
      <div><strong>Currency</strong> <span class="lbl">AED-equivalent</span></div>
      <div><strong>Voucher discount</strong> <span class="lbl">20%</span></div>
    </div>
  </header>

  <section class="dp-calc-shell">
    <slot name="calculator" />
  </section>

  <section class="dp-tools-methodology">
    <div class="col">
      <div class="lbl">How the score works</div>
      <p><strong>Cash bonus</strong> — face value. <strong>Voucher</strong> — face value × 0.80 (resale and utility loss). <strong>Monthly cashback</strong> — per-month value × tenure months. Unidentified points currencies are not priced.{skywardsBaseline != null && <> For reference, the <a href="/valuations/">published Skywards baseline</a> is AED {skywardsBaseline.toFixed(2)} per mile, not a rate for other points.</>}</p>
    </div>
    <div class="col">
      <div class="lbl">What matches your inputs</div>
      <p>Salary, product choices and filters are checked. A matching estimate is not a bank approval; check the offer's full conditions.</p>
    </div>
    <div class="col">
      <div class="lbl">What needs confirmation</div>
      <p>Where a product, qualifying transaction or spending condition cannot be checked, the offer is not ranked. Optional rewards with unverified conditions are excluded from the estimate.</p>
    </div>
  </section>

  <section class="dp-tools-actions">
    <a href="/salary-transfer/">Current tracker →</a>
    <a href="/cards/compare/">Compare cards →</a>
    <a href="/valuations/">AED valuations →</a>
    <a href="/editorial-policy/">Methodology</a>
  </section>

  <div class="dp-calc-disclaimer">
    <Disclaimer variant="general" />
  </div>

  <slot />
</BaseLayout>

<style>
  .dp-calc-shell {
    max-width: var(--container-listing);
    margin: 0 auto;
    padding: 32px;
  }
  .dp-calc-disclaimer {
    max-width: var(--container-listing);
    margin: 0 auto;
    padding: 0 32px 64px;
  }
  @media (max-width: 640px) {
    .dp-salary-calc-head.dp-pagehead { padding: 22px 20px 14px; }
    .dp-salary-calc-head h1 { font-size: clamp(1.9rem, 8vw, 2.5rem); }
    .dp-salary-calc-head .dp-tools-stats { gap: 4px 12px; margin-block-start: 10px; }
    .dp-calc-shell { padding: 16px 20px 24px; }
    .dp-calc-disclaimer { padding-inline: 20px; }
  }
</style>
