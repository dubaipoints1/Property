---
// Airline programme layout — Phase H2 + F.16 (post-audit restructure).
// Used by /airlines/[slug]/ and /hotels/[slug]/ (the `section` prop).
//
// Restructure (F.16):
//   - MDX body prose renders FIRST — the editorial content (Tier
//     structure / Who Bonvoy suits / How to earn / What to watch) is
//     what the reader came for.
//   - Reference data (Sweet spots, Transfer partners, Expiry policy)
//     renders below as a structured "Programme reference" block.
//   - Related cards auto-populates from cards.json filtered by
//     loyaltyProgram match. Empty "tiers" / "earning" / "related-cards"
//     slots dropped — they were never filled by the [slug] consumer.

import BaseLayout from "./BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import { stagePhoto, stageStyle } from "~/lib/stage";
import { hasStockEntry } from "~/lib/stockManifest";
import { getEntry } from "astro:content";
import { programmeHref } from "~/lib/programmes";

interface RelatedCard {
  slug: string;
  name: string;
  bankName: string;
  annualFeeAed: number;
}

interface Props {
  title: string;
  description?: string;
  /** programme slug (e.g. "etihad-guest") — resolves the programme-<slug> hero. */
  slug?: string;
  programName: string;
  currencyName: string;
  region: string;
  expiryPolicy: string;
  expirySection?: string;
  sweetSpots: { title: string; description: string }[];
  transferPartners: string[];
  relatedCards?: RelatedCard[];
  /** Which programme directory this hub sits under (11 Oct 2026 hotels split). */
  section?: "airlines" | "hotels";
}

const {
  title,
  description,
  slug,
  programName,
  currencyName,
  region,
  expiryPolicy,
  expirySection,
  sweetSpots,
  transferPartners,
  relatedCards = [],
  section = "airlines",
} = Astro.props;

const sectionPath = `/${section}/`;
const sectionName = section === "hotels" ? "Hotels" : "Airlines";
const unlistedPartnerNames: Record<string, string> = {
  "british-airways-executive-club": "The British Airways Club",
  "aer-lingus-aerclub": "Aer Lingus AerClub",
  "iberia-plus": "Iberia Club",
  "finnair-plus": "Finnair Plus",
};
const partnerLabels = await Promise.all(transferPartners.map(async (p) => {
  const id = p === "emirates-skywards" ? "skywards" : p;
  const entry = await getEntry("programs", id);
  return {
    label: entry?.data.name ?? unlistedPartnerNames[p] ?? p.replaceAll("-", " "),
    href: entry ? programmeHref(id) : null,
  };
}));

const heroSlug = slug ? `programme-${slug}` : null;
const hasHero = heroSlug ? hasStockEntry(heroSlug) : false;
// A licensed photo moves up into the cinematic stage; an AI illustration
// stays in the body, where StockImage gives it its visible label.
const stageOwnsHero = stagePhoto(heroSlug) != null;

// JSON-LD: programmes emit a Product entity (the loyalty programme itself)
// + BreadcrumbList. Region and currency name carry through. PR-D
// (29 May 2026).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${canonicalUrl}#programme`,
      name: programName,
      category: "Loyalty programme",
      description: description ?? `${programName} — DubaiPoints loyalty programme guide.`,
      url: canonicalUrl,
      brand: { "@type": "Organization", name: programName },
      additionalProperty: [
        { "@type": "PropertyValue", name: "Currency", value: currencyName },
        { "@type": "PropertyValue", name: "Region", value: region },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: sectionName, item: `${siteUrl}${sectionPath}` },
        { "@type": "ListItem", position: 3, name: programName, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} fullWidth schema={schema}>
  <header style={stageOwnsHero ? stageStyle(heroSlug) : undefined} class:list={["dp-pagehead is-narrow dp-prog-head", { "dp-stage": stageOwnsHero }]}>
    <div class="crumb">{region} · <a href={sectionPath} class="crumb-link">{section === "hotels" ? "Hotel programme" : "Loyalty programme"}</a></div>
    <h1>{programName}</h1>
    <p class="deck">Loyalty currency: <strong>{currencyName}</strong></p>

    <div class="dp-metric-strip">
      <div class="metric">
        <span class="v">{sweetSpots.length}<span class="sub">documented</span></span>
        <span class="l">Sweet spots</span>
      </div>
      <div class="metric">
        <span class="v">{transferPartners.length}<span class="sub">programmes</span></span>
        <span class="l">Transfer partners</span>
      </div>
      <div class="metric">
        <span class="v">{relatedCards.length}<span class="sub">UAE cards</span></span>
        <span class="l">Earn into this</span>
      </div>
      <div class="metric">
        <span class="v">{region}</span>
        <span class="l">Region</span>
      </div>
    </div>
  </header>

  <div class="dp-prog-grid">
    <article class="dp-prog-body">
      {hasHero && heroSlug && !stageOwnsHero && (
        <StockImage
          slug={heroSlug}
          coverTitle={programName}
          coverCategory="Programme"
          coverSize="hero"
          class="dp-hub-hero"
          loading="eager"
        />
      )}

      <!-- Editorial prose first — this is what the reader came for. -->
      <div class="dp-prose dp-prog-prose">
        <slot />
      </div>

      <!-- Redemption sweet spots: unbounded length, stays in main column. -->
      {sweetSpots.length > 0 && (
        <section class="dp-prog-reference" id="programme-redemptions">
          <h2>Programme reference</h2>
          <div class="dp-prog-ref-block">
            <h3>Redemption sweet spots</h3>
            <ul class="dp-sweet-list">
              {sweetSpots.map((s) => (
                <li>
                  <p class="title">{s.title}</p>
                  <p class="desc">{s.description}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <details class="dp-prog-expiry" id="programme-expiry">
        <summary>Expiry policy</summary>
        <p>{expiryPolicy}</p>
      </details>

      {/* Related cards: auto-populated from the card database by loyaltyProgram.
         JSX comment — HTML comments ship to the browser (2 July leak audit). */}
      {relatedCards.length > 0 && (
        <section class="dp-prog-related" id="programme-cards">
          <h2>UAE cards that earn into {currencyName}</h2>
          <ul class="dp-prog-related-list">
            {relatedCards.map((c) => (
              <li>
                <a href={`/cards/${c.slug}/`}>
                  <span class="bank">{c.bankName}</span>
                  <span class="name">{c.name}</span>
                  <span class="fee">{c.annualFeeAed === 0 ? "Free" : `AED ${c.annualFeeAed.toLocaleString()}/yr`}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="dp-prog-aside" aria-label="Programme quick reference">
      <section class="dp-prog-railcard">
        <h2>Quick reference</h2>
        <ul class="dp-prog-rail-links">
          {sweetSpots.length > 0 && <li><a href="#programme-redemptions">Redemption examples</a></li>}
          {relatedCards.length > 0 && <li><a href="#programme-cards">UAE earning cards</a></li>}
          <li><a href={`#${expirySection ?? "programme-expiry"}`}>Expiry rules</a></li>
        </ul>
      </section>
      {transferPartners.length > 0 && (
        <section class="dp-prog-railcard">
          <h2>Transfer partners</h2>
          <ul class="dp-tag-list">
            {partnerLabels.map(({ label, href }) => (
              <li>{href ? <a href={href}>{label}</a> : <span>{label}</span>}</li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>

<style>
  /* The plain header, full-bleed stage text and body all use the same
     inset. The wide stage keeps its full-bleed photograph. */
  .dp-prog-head,
  .dp-prog-grid {
    --programme-frame: 760px;
    --programme-gutter: clamp(16px, 3vw, 32px);
    --programme-rail: 0px;
    --programme-rail-gap: 0px;
  }
  .dp-prog-head:not(.dp-stage) {
    max-width: var(--programme-frame);
    padding-inline: var(--programme-gutter) calc(var(--programme-gutter) + var(--programme-rail) + var(--programme-rail-gap));
  }
  :global(:root body) .dp-prog-head.dp-stage.is-narrow {
    --programme-stage-inset: max(var(--programme-gutter), calc((100% - var(--programme-frame)) / 2 + var(--programme-gutter)));
    padding-inline: var(--programme-stage-inset) calc(var(--programme-stage-inset) + var(--programme-rail) + var(--programme-rail-gap));
    padding-block: clamp(36px, 5vw, 62px) clamp(24px, 3vw, 38px);
    min-height: 0;
  }
  .dp-prog-head .deck { font-size: clamp(1rem, 1.7vw, 1.25rem); }
  .dp-prog-head .dp-metric-strip { margin-block-start: clamp(16px, 2vw, 24px); }
  .dp-prog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    max-width: var(--programme-frame);
    margin: 0 auto;
    padding: 28px var(--programme-gutter) 72px;
  }
  @media (min-width: 1024px) {
    .dp-prog-head,
    .dp-prog-grid {
      --programme-frame: var(--container-listing);
      --programme-rail: 250px;
      --programme-rail-gap: clamp(36px, 5vw, 64px);
    }
    .dp-prog-grid {
      grid-template-columns: minmax(0, 1fr) var(--programme-rail);
      gap: var(--programme-rail-gap);
    }
  }
  @media (max-width: 719.98px) {
    /* A programme has four facts, unlike the generic three-fact stage. */
    :global(:root body) .dp-prog-head.dp-stage .dp-metric-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 12px;
    }
    :global(:root body) .dp-prog-head.dp-stage .dp-metric-strip .metric:nth-child(odd) { padding-left: 0; }
    :global(:root body) .dp-prog-head.dp-stage .dp-metric-strip .metric:nth-child(even) { border-right: 0; }
  }
  @media (max-width: 640px) {
    .dp-prog-grid { padding-block: 28px 56px; gap: 28px; }
  }
  .dp-prog-body { width: 100%; min-width: 0; }

  .dp-prog-aside { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 1024px) {
    .dp-prog-aside { position: sticky; top: calc(var(--dp-sticky-header-height, 81px) + 16px); align-self: flex-start; }
  }
  .dp-prog-railcard {
    background: var(--shade-1);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
  }
  .dp-prog-railcard h2 {
    font-family: var(--font-ui);
    font-size: .875rem; font-weight: 700;
    color: var(--green);
    margin: 0 0 6px;
  }
  .dp-prog-rail-links { list-style: none; margin: 0; padding: 0; }
  .dp-prog-rail-links li + li { border-top: 1px solid var(--line); }
  .dp-prog-rail-links a, .dp-tag-list :is(a, span) {
    display: flex; align-items: center; min-block-size: 44px;
    color: var(--ink); font-size: .9375rem; line-height: 1.35;
  }
  .dp-prog-aside a, .dp-prog-expiry summary { text-underline-offset: .18em; }
  .dp-prog-aside a { text-decoration: underline; }
  .dp-prog-aside a:focus-visible, .dp-prog-expiry summary:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

  .dp-prog-prose { margin-bottom: 48px; }
  .dp-prog-body :is(section, details)[id] { scroll-margin-top: calc(var(--dp-sticky-header-height, 81px) + 16px); }
  .dp-prog-prose :global(:is(h2, h3)[id]) { scroll-margin-top: calc(var(--dp-sticky-header-height, 81px) + 16px); }

  /* Programme reference: light grey band with structured data */
  .dp-prog-reference {
    background: var(--shade-1);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 28px 28px 32px;
    margin-bottom: 40px;
  }
  @media (max-width: 640px) {
    .dp-prog-reference { padding: 20px 18px 24px; }
  }
  .dp-prog-reference h2 {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin: 0 0 18px;
    padding: 0;
    border: 0;
  }
  .dp-prog-ref-block { margin-bottom: 24px; }
  .dp-prog-ref-block:last-child { margin-bottom: 0; }
  .dp-prog-ref-block h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.3px;
    color: var(--ink);
    margin: 0 0 12px;
  }

  .dp-sweet-list {
    list-style: none; padding: 0; margin: 0;
    display: grid; gap: 10px;
  }
  @media (min-width: 650px) { .dp-sweet-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .dp-sweet-list li {
    background: var(--paper);
    border: 1px solid var(--line);
    border-left: 3px solid var(--green);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .dp-sweet-list .title {
    font-family: var(--font-display); font-weight: 500;
    font-size: 1.0625rem; letter-spacing: -0.2px;
    color: var(--ink); margin: 0 0 4px;
  }
  .dp-sweet-list .desc {
    font-size: .9375rem; line-height: 1.55;
    color: var(--ink-soft); margin: 0;
  }

  .dp-tag-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
  }
  .dp-tag-list li + li { border-top: 1px solid var(--line); }
  .dp-prog-expiry {
    background: var(--shade-1);
    border: 1px solid var(--line);
    border-radius: 12px;
    margin: 0 0 32px;
    padding-inline: 16px;
  }
  .dp-prog-expiry summary {
    min-block-size: 44px; padding-block: 10px; cursor: pointer;
    font-weight: 600; color: var(--green);
  }
  .dp-prog-expiry p { max-width: 64ch; margin: 0 0 16px; font-size: 1rem; line-height: 1.6; }

  /* Related cards — actual card tiles, not empty slot */
  .dp-prog-related h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: -0.4px;
    color: var(--ink);
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }
  .dp-prog-related-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 8px;
  }
  .dp-prog-related-list a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 10px;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
  }
  .dp-prog-related-list a:hover {
    border-color: var(--green);
    background: var(--shade-1);
    transform: translateY(-1px);
  }
  .dp-prog-related-list .bank {
    font-family: var(--font-ui);
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--green);
    white-space: nowrap;
  }
  .dp-prog-related-list .name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 15px;
    letter-spacing: -0.2px;
    color: var(--ink);
    line-height: 1.3;
  }
  .dp-prog-related-list .fee {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .dp-prog-related-list a {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .dp-prog-related-list .fee {
      margin-top: 4px;
    }
  }
</style>
