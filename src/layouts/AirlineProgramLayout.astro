---
// Airline/hotel programme flow: a single contents rail and editorial text.
// Used by /airlines/[slug]/ and /hotels/[slug]/ (the `section` prop).
//
// Reference components render beside the section that explains them in MDX,
// rather than being appended after the editorial conclusion. Fact sources and
// the original anchor IDs remain stable.

import BaseLayout from "./BaseLayout.astro";
import UtilityPageHead from "~/components/UtilityPageHead.astro";
import ImageCredit from "~/components/ImageCredit.astro";
import StockImage from "~/components/StockImage.astro";
import ProgrammeContents from "~/components/ProgrammeContents.astro";
import ProgrammeHub from "~/components/ProgrammeHub.astro";
import { getStockEntry } from "~/lib/stockManifest";
import { programmeImage } from "~/lib/programmes";
import { transferDestinations, transferOrigins } from "~/lib/transferFinder";

interface RelatedCard {
  slug: string;
  name: string;
  bankName: string;
  annualFeeAed: number;
}

interface Props {
  title: string;
  description?: string;
  /** Programme slug (e.g. "etihad-guest") — resolves the manifest-backed hero. */
  slug?: string;
  programName: string;
  currencyName: string;
  region: string;
  expiryPolicy: string;
  expirySection?: string;
  sweetSpots: { title: string; description: string }[];
  transferPartners: string[];
  relatedCards?: RelatedCard[];
  headings: { depth: number; slug: string; text: string }[];
  /** Which programme directory this hub sits under (11 Oct 2026 hotels split). */
  section?: "airlines" | "hotels";
}

const {
  title,
  description,
  slug,
  programName,
  currencyName,
  region,
  expirySection,
  sweetSpots,
  transferPartners,
  relatedCards = [],
  headings,
  section = "airlines",
} = Astro.props;

const sectionPath = `/${section}/`;
const sectionName = section === "hotels" ? "Hotels" : "Airlines";
const hero = slug ? programmeImage(slug) : undefined;
const heroEntry = hero ? getStockEntry(hero.slug) : undefined;
const hasPhotoCredit = heroEntry?.source === "pexels" || heroEntry?.source === "unsplash";
const transferTo = slug && Object.hasOwn(transferDestinations, slug);
const transferFrom = slug && Object.hasOwn(transferOrigins, slug);
const transferHref = transferTo ? `/transfer-finder/?to=${slug}` : transferFrom ? `/transfer-finder/?from=${slug}` : null;
const hasEmbeddedCalculator = slug === "skywards" || slug === "etihad-guest";
const primaryAction = hasEmbeddedCalculator
  ? { href: "#programme-calculator", label: "Price your redemption" }
  : sweetSpots.length > 0
    ? { href: "#programme-redemptions", label: "See redemption examples" }
    : { href: "/valuations/", label: "Compare points values" };
const secondaryAction = transferHref
  ? { href: transferHref, label: "Find transfer routes" }
  : relatedCards.length > 0
    ? { href: "#programme-cards", label: "See UAE earning cards" }
    : { href: `#${expirySection ?? "programme-expiry"}`, label: "Check expiry rules" };

const menuLabels: Record<string, string> = {
  "mile-expiry-mechanics": "Expiry mechanics",
  "mile-expiry-mechanics--the-skywards-differentiator": "Expiry mechanics",
  "how-to-earn-skywards-miles": "How to earn",
  "how-to-earn-etihad-guest-miles": "How to earn",
  "how-to-earn-from-the-uae": "How to earn",
  "what-a-skywards-mile-is-worth": "What a mile is worth",
  "what-an-etihad-guest-mile-is-worth": "What a mile is worth",
  "best-sweet-spot-redemptions": "Sweet spots",
};
const contents = headings.filter(heading => heading.depth === 2).map(heading => ({ id: heading.slug, label: menuLabels[heading.slug] ?? heading.text }));
if (slug) contents.unshift({ id: "programme-hub", label: "News, guides & offers" });
const insertAfter = (test: RegExp, item: { id: string; label: string }) => {
  const index = contents.findIndex(section => test.test(section.id));
  if (index >= 0) contents.splice(index + 1, 0, item);
};
if (relatedCards.length > 0) insertAfter(/how-to-earn/, { id: "programme-cards", label: "UAE earning cards" });
if (sweetSpots.length > 0) insertAfter(
  headings.some(heading => heading.slug === "best-sweet-spot-redemptions") ? /best-sweet-spot/ : slug === "qatar-privilege-club" ? /programme-cards|how-to-earn/ : /what.*worth/,
  { id: "programme-redemptions", label: "Redemption examples" },
);
insertAfter(/expiry|what-to-watch|watch-out/, { id: "programme-expiry", label: "Expiry policy" });

// JSON-LD: programmes emit a Product entity (the loyalty programme itself)
// + BreadcrumbList. Region and currency name carry through. PR-D
// (29 May 2026).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Product",
      "@id": `${canonicalUrl}#programme`,
      name: programName,
      category: "Loyalty programme",
      description: description ?? `${programName} — DubaiPoints loyalty programme guide.`,
      url: canonicalUrl,
      brand: { "@type": "Organization", name: programName },
      additionalProperty: [
        { "@type": "PropertyValue", name: "Currency", value: currencyName },
        { "@type": "PropertyValue", name: "Region", value: region },
      ],
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: sectionName, item: `${siteUrl}${sectionPath}` },
        { "@type": "ListItem", position: 3, name: programName, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} fullWidth schema={schema}>
  <UtilityPageHead variant="programme" class="dp-prog-head">
    <p class="dp-utility-kicker">{region} · <a href={sectionPath}>{section === "hotels" ? "Hotel programmes" : "Airline programmes"}</a></p>
    <h1>{programName}</h1>
    <p class="dp-utility-deck">How to earn and spend <strong>{currencyName}</strong> from the UAE, with transfer routes, redemption examples and expiry rules.</p>
    <div class="dp-utility-actions">
      <a class="dp-ui-action dp-ui-primary" href={primaryAction.href}>{primaryAction.label}</a>
      <a class="dp-ui-action dp-ui-secondary" href={secondaryAction.href}>{secondaryAction.label}</a>
    </div>

    {hero && heroEntry && (
      <figure slot="media" class="dp-prog-figure">
        <StockImage
          slug={hero.slug}
          class="dp-prog-image"
          sizes="(max-width: 719px) calc(100vw - 32px), 336px"
          delivery="feature"
          loading="eager"
        />
        {(hero.caption || hasPhotoCredit) && (
          <figcaption class="dp-prog-photo-credit">
            {hero.caption && <span>{hero.caption}{hasPhotoCredit ? " ·" : ""}</span>}{" "}
            {hasPhotoCredit && <ImageCredit slug={hero.slug} />}
          </figcaption>
        )}
      </figure>
    )}

    <dl slot="facts" class="dp-metric-strip dp-prog-facts">
      <div class="metric">
        <dt class="l">Sweet spots</dt>
        <dd class="v">{sweetSpots.length}<span class="sub">documented</span></dd>
      </div>
      <div class="metric">
        <dt class="l">Transfer partners</dt>
        <dd class="v">{transferPartners.length}<span class="sub">programmes</span></dd>
      </div>
      <div class="metric">
        <dt class="l">UAE earning cards</dt>
        <dd class="v">{relatedCards.length}</dd>
      </div>
      <div class="metric">
        <dt class="l">Region</dt>
        <dd class="v">{region}</dd>
      </div>
    </dl>
  </UtilityPageHead>

  {slug && <ProgrammeHub programme={slug} name={programName} section={section} transferHref={transferHref} hasCalculator={hasEmbeddedCalculator} hasCards={relatedCards.length > 0} />}

  <div class="dp-prog-grid" id="programme-guide">
    <aside class="dp-prog-aside" aria-label="Programme quick reference">
      <ProgrammeContents sections={contents} />
    </aside>
    <article class="dp-prog-body">
      <div class="dp-prose dp-prog-prose">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .dp-prog-grid {
    --programme-frame: 760px;
    --programme-gutter: clamp(16px, 3vw, 32px);
    scroll-margin-block-start: calc(var(--dp-sticky-header-height, 81px) + 16px);
  }
  .dp-prog-figure { margin: 0; max-inline-size: 100%; }
  .dp-prog-figure :global(.dp-prog-image) {
    display: block;
    inline-size: 100%;
    block-size: clamp(104px, 30vw, 186px);
    object-fit: cover;
    border-radius: var(--dp-ui-radius, 12px);
  }
  .dp-prog-figure :global(.dp-ai-figure) { border-radius: var(--dp-ui-radius, 12px); overflow: hidden; }
  .dp-prog-photo-credit {
    margin-block-start: 6px;
    color: var(--ink-soft);
    font-size: 12px;
    line-height: 1.4;
  }
  .dp-prog-photo-credit :global(.dp-image-credit) { display: inline; margin: 0; }
  .dp-prog-facts.dp-metric-strip {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding-block: 8px 0;
    border-block-end: 0;
  }
  .dp-prog-facts.dp-metric-strip .metric { min-inline-size: 0; padding: 5px 12px; }
  .dp-prog-facts.dp-metric-strip .metric:first-child { padding-inline-start: 0; }
  .dp-prog-facts.dp-metric-strip .l { margin: 0 0 4px; letter-spacing: .05em; color: var(--ink-soft); }
  .dp-prog-facts.dp-metric-strip .v { margin: 0; font-size: clamp(1.125rem, 2vw, 1.45rem); }
  .dp-prog-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    max-width: var(--programme-frame);
    margin: 0 auto;
    padding: 28px var(--programme-gutter) 72px;
  }
  @media (min-width: 1024px) {
    .dp-prog-grid {
      --programme-frame: var(--container-listing);
      --programme-rail: 250px;
      --programme-rail-gap: clamp(36px, 5vw, 64px);
    }
    .dp-prog-grid {
      grid-template-columns: minmax(0, 1fr) var(--programme-rail);
      gap: var(--programme-rail-gap);
    }
    .dp-prog-body { grid-column: 1; grid-row: 1; }
    .dp-prog-aside { grid-column: 2; grid-row: 1; }
  }
  @media (max-width: 719.98px) {
    .dp-prog-facts.dp-metric-strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .dp-prog-facts.dp-metric-strip .metric { border-block-end: 0; }
    .dp-prog-facts.dp-metric-strip .metric:nth-child(odd) { padding-inline-start: 0; }
    .dp-prog-facts.dp-metric-strip .metric:nth-child(even) { border-inline-end: 0; }
  }
  @media (max-width: 640px) {
    .dp-prog-grid { padding-block: 28px 56px; gap: 28px; }
  }
  .dp-prog-body { width: 100%; min-width: 0; }

  .dp-prog-aside { display: flex; flex-direction: column; gap: 12px; }
  @media (min-width: 1024px) {
    .dp-prog-aside { position: sticky; top: calc(var(--dp-sticky-header-height, 81px) + 16px); align-self: flex-start; }
  }
  .dp-prog-prose { margin-bottom: 0; }
  .dp-prog-body :is(section, details)[id] { scroll-margin-top: calc(var(--dp-sticky-header-height, 81px) + 16px); }
  .dp-prog-prose :global(:is(h2, h3)[id]) { scroll-margin-top: calc(var(--dp-sticky-header-height, 81px) + 16px); }
</style>
