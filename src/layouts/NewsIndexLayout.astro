---
// NewsIndexLayout — shared shell for /news/ and the per-desk indexes
// (/news/banking/, /news/airlines/, /news/hotels/).
//
// Editorial Utility: a chronological briefing plus one recent photo
// feature when the desk owns a suitable manifest-tracked photograph.

import type { CollectionEntry } from "astro:content";
import { collectionPageGraph, breadcrumbGraph, siteUrlFrom } from "~/lib/schema";
import BaseLayout from "~/layouts/BaseLayout.astro";
import NewsListingVisual from "~/components/NewsListingVisual.astro";
import NewsStoryRow from "~/components/NewsStoryRow.astro";
import { stagePhoto } from "~/lib/stage";
import { getCollection } from "astro:content";

interface Props {
  /** <title> for the page. */
  title: string;
  /** Meta description. */
  description: string;
  /** Breadcrumb line, e.g. "DubaiPoints / News / Airlines". */
  crumb: string;
  /** Page H1. */
  heading: string;
  /** Deck paragraph under the H1. */
  deck: string;
  /** Pre-filtered, pre-sorted (newest first) news entries to render. */
  posts: CollectionEntry<"news">[];
  /** Which desk tab is active. */
  activeDesk: "all" | "banking" | "airline" | "hotel";
}

const { title, description, crumb, heading, deck, posts, activeDesk } =
  Astro.props;

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });

// Never pull an old story forward just because it has a photograph. If
// the newest story already has one, the feature is also the newest item.
const featured = posts.slice(0, 6).find((post) =>
  !post.data.textLed && (post.data.beat === "airline" || post.data.beat === "hotel") && stagePhoto(`news-${post.id}`),
);
const featureIsLatest = featured?.id === posts[0]?.id;
const remaining = posts.filter((post) => post.id !== featured?.id);
// Keep a useful current edition visible. Native closed details keeps the
// rest of the archive and its links accessible without initially fetching
// dozens of lazy images on a compact mobile feed.
const editionSize = 8;
const latest = remaining.slice(0, featured ? 2 : editionSize);
// Give two desks a place in the briefing when stories share the newest
// date. This never moves an older item ahead of a newer one.
const first = latest[0];
if (activeDesk === "all" && featured && first && latest[1]?.data.beat === first.data.beat) {
  const sameDayFromAnotherDesk = remaining.find((post) =>
    post.data.beat !== first.data.beat && post.data.publishedAt.getTime() === first.data.publishedAt.getTime(),
  );
  if (sameDayFromAnotherDesk) latest[1] = sameDayFromAnotherDesk;
}
const afterLatest = remaining.filter((post) => !latest.some((item) => item.id === post.id));
const more = featured ? afterLatest.slice(0, editionSize - 3) : [];
const archive = afterLatest.slice(more.length);

// Desk tabs — every href is a real filtered route (no fictional facets).
const tabs: Array<{ label: string; href: string; key: Props["activeDesk"] }> = [
  { label: "All news", href: "/news/", key: "all" },
  { label: "Banking", href: "/news/banking/", key: "banking" },
  { label: "Airlines", href: "/news/airlines/", key: "airline" },
  { label: "Hotels", href: "/news/hotels/", key: "hotel" },
];

const formatCategory = (c: string) =>
  c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

const searchInputId = `news-search-input-${activeDesk}`;

// Per-desk RSS: each desk index advertises its own feed, so a reader who
// only wants one beat can subscribe to exactly that (2026-07-27 council
// follow-up). The "all" index keeps the site-wide feed.
const FEED_BY_DESK: Record<Props["activeDesk"], string> = {
  all: "/rss.xml",
  banking: "/news/banking/rss.xml",
  airline: "/news/airlines/rss.xml",
  hotel: "/news/hotels/rss.xml",
};
const feedHref = FEED_BY_DESK[activeDesk];
const feedLabel = activeDesk === "all" ? "DubaiPoints" : `DubaiPoints — ${heading}`;
const siteUrl = siteUrlFrom(Astro.site);
const newsPath = Astro.url.pathname.endsWith("/") ? Astro.url.pathname : `${Astro.url.pathname}/`;
const newsName = title.replace(/\s*\|\s*DubaiPoints\s*$/, "");
const newsCrumbs = newsPath === "/news/" ? [{ name: "News", path: "/news/" }] : [{ name: "News", path: "/news/" }, { name: newsName, path: newsPath }];
const schema = collectionPageGraph({ siteUrl, path: newsPath, name: newsName, description, crumbs: newsCrumbs });
---

<BaseLayout title={title} description={description} fullWidth schema={schema}>
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={feedLabel}
    href={feedHref}
  />
  <header class="intel-pagehead" id="news-edition-top">
    <div class="intel-pagehead-inner">
      <div class="crumb">{crumb}</div>
      <h1>{heading}</h1>
      <p>{deck}</p>

      <div class="intel-tools">
        <nav class="intel-tabs" aria-label="News desks">
          {tabs.map((t) => <a href={t.href} class="dp-ui-filter" aria-current={t.key === activeDesk ? "page" : undefined}>{t.label}</a>)}
        </nav>
        <div class="intel-tools-end">
          <a class="intel-feed dp-ui-action dp-ui-secondary" href={feedHref} aria-label="RSS feed for this desk">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
              <circle cx="6.2" cy="17.8" r="2.2"/>
              <path d="M4 10.2v3.1c3.7 0 6.7 3 6.7 6.7h3.1c0-5.4-4.4-9.8-9.8-9.8z"/>
              <path d="M4 4v3.1c7.1 0 12.9 5.8 12.9 12.9H20C20 11.2 12.8 4 4 4z"/>
            </svg>
            <span class="intel-feed-text">RSS</span>
          </a>
          <form class="intel-search" action="/search/" method="get" role="search" aria-label="Site search from the news desk">
            <label class="intel-search-label" for={searchInputId}>Search DubaiPoints</label>
            <input
              id={searchInputId}
              class="dp-ui-field"
              type="search"
              name="q"
              placeholder="Search DubaiPoints"
              autocomplete="off"
            />
            <button class="dp-ui-action dp-ui-secondary intel-search-submit" type="submit" aria-label="Search">
              <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="9" cy="9" r="6"/>
                <line x1="13.5" y1="13.5" x2="17.5" y2="17.5" stroke-linecap="round"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <div class="intel-grid">
    <div class:list={["intel-main", { "has-feature": Boolean(featured), "feature-is-latest": featureIsLatest }]}>
      {posts.length === 0 ? (
        <section class="news-empty">
          <slot name="empty" />
        </section>
      ) : (
        <>
          {featureIsLatest && featured && (
            <a href={`/news/${featured.id}/`} class="intel-featured" data-news-feature>
              <NewsListingVisual id={featured.id} featured />
              <div class="intel-featured-body">
                <span class="intel-featured-top">
                  <span class="intel-featured-eyebrow">Latest reporting · {formatCategory(featured.data.category)}</span>
                  <time class="intel-date" datetime={featured.data.publishedAt.toISOString()}>{fmt(featured.data.publishedAt)}</time>
                </span>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
              </div>
            </a>
          )}

          {latest.length > 0 && (
            <section class="dp-news-latest" aria-labelledby="news-latest-heading" data-news-latest>
              <h2 class="dp-news-section-heading" id="news-latest-heading">{featureIsLatest ? "More recent reporting" : "Latest reporting"}</h2>
              <ol>{latest.map((post) => <NewsStoryRow post={post} />)}</ol>
            </section>
          )}

          {!featureIsLatest && featured && (
            <a href={`/news/${featured.id}/`} class="intel-featured" data-news-feature>
              <NewsListingVisual id={featured.id} featured />
              <div class="intel-featured-body">
                <span class="intel-featured-top">
                  <span class="intel-featured-eyebrow">Photo feature · {formatCategory(featured.data.category)}</span>
                  <time class="intel-date" datetime={featured.data.publishedAt.toISOString()}>{fmt(featured.data.publishedAt)}</time>
                </span>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
              </div>
            </a>
          )}

          {more.length > 0 && (
            <section class="dp-news-more" aria-labelledby="news-more-heading">
              <h2 class="dp-news-section-heading" id="news-more-heading">More recent stories</h2>
              <ol>{more.map((post) => <NewsStoryRow post={post} />)}</ol>
            </section>
          )}
          {archive.length > 0 && (
            <details class="dp-news-archive" data-news-archive>
              <summary class="dp-ui-action dp-ui-secondary"><span class="dp-news-archive-closed">Browse older news</span><span class="dp-news-archive-open">Older news is open</span> <span>({archive.length} {archive.length === 1 ? "story" : "stories"})</span></summary>
              <div class="dp-news-archive-range"><p>Recorded publication dates: <time datetime={archive[archive.length - 1].data.publishedAt.toISOString()}>{fmt(archive[archive.length - 1].data.publishedAt)}</time> to <time datetime={archive[0].data.publishedAt.toISOString()}>{fmt(archive[0].data.publishedAt)}</time>. Newest first.</p><a class="dp-ui-action dp-ui-quiet" href="#news-edition-top">Back to current edition ↑</a></div>
              <ol>{archive.map((post) => <NewsStoryRow post={post} />)}</ol>
              <a class="dp-ui-action dp-ui-secondary" href="#news-edition-top">Back to current edition ↑</a>
            </details>
          )}
        </>
      )}
    </div>

    {posts.length === 0 && guides.length > 0 && (
    <aside class="intel-aside">
        <nav class="intel-trending" aria-label="From the guides desk">
          <div class="dp-rail-heading">From the guides desk</div>
          <ol>
            {guides.slice(0, 5).map((item) => (
              <li>
                <a href={`/guides/${item.id}/`}>{item.data.title}</a>
              </li>
            ))}
          </ol>
        </nav>
    </aside>
    )}
  </div>
</BaseLayout>

<style>
  .intel-pagehead {
    padding: clamp(24px, 4vw, 44px) clamp(16px, 3vw, 32px) clamp(16px, 3vw, 28px);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .intel-pagehead-inner { max-width: var(--container-listing); margin-inline: auto; }
  .intel-pagehead .crumb {
    margin-block-end: 10px;
    color: var(--green);
    font: 700 .6875rem/1.4 var(--font-ui);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .intel-pagehead h1 {
    margin: 0 0 8px;
    color: var(--ink);
    font: 550 clamp(2rem, 5vw, 3.5rem)/1.06 var(--font-display);
    letter-spacing: -.035em;
  }
  .intel-pagehead p {
    max-width: 65ch;
    margin: 0 0 clamp(14px, 2.5vw, 24px);
    color: var(--ink-soft);
    font-size: .9375rem;
    line-height: 1.5;
  }
  .intel-tools,
  .intel-tabs,
  .intel-tools-end { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; }
  .intel-tools { justify-content: space-between; gap: 10px 18px; }
  .intel-search { display: flex; gap: 6px; min-width: 0; }
  .intel-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .intel-search input { width: min(26vw, 260px); }
  .intel-search-submit { min-inline-size: var(--dp-ui-control); }

  .intel-grid {
    max-width: var(--container-listing);
    margin: clamp(18px, 3vw, 36px) auto var(--dp-ui-section);
    padding-inline: clamp(16px, 3vw, 32px);
  }
  .intel-main { min-width: 0; display: grid; gap: var(--dp-ui-gap); }
  .dp-news-latest,
  .dp-news-more { min-width: 0; }
  .dp-news-latest ol, .dp-news-more ol { list-style: none; margin: 0; padding: 0; }
  .dp-news-section-heading {
    margin: 0;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--line);
    color: var(--green);
    font: 700 .875rem/1.35 var(--font-ui);
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .intel-featured {
    display: block;
    align-self: start;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    color: inherit;
    background: var(--paper);
    text-decoration: none;
  }
  .intel-featured:hover { border-color: var(--green); }
  .intel-featured:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .intel-featured :global(.intel-featured-image) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
    border-bottom: 1px solid var(--line);
  }
  .intel-featured-body { display: grid; gap: 7px; padding: clamp(14px, 2.4vw, 24px); }
  .intel-featured-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--ink-soft);
    font: 650 .75rem/1.35 var(--font-ui);
  }
  .intel-featured-eyebrow { color: var(--green); }
  .intel-featured h2 {
    margin: 0;
    color: var(--ink);
    font: 550 clamp(1.375rem, 3vw, 2.125rem)/1.12 var(--font-display);
    letter-spacing: -.025em;
    text-wrap: pretty;
  }
  .intel-featured:hover h2 { color: var(--green); text-decoration: underline; text-underline-offset: .15em; }
  .intel-featured p { margin: 0; color: var(--ink-soft); font-size: .9375rem; line-height: 1.5; }
  .dp-news-archive ol { list-style: none; margin: 10px 0 0; padding: 0; }
  .dp-news-archive > summary { display: list-item; width: fit-content; list-style-position: inside; padding-inline: 12px; align-content: center; }
  .dp-news-archive > summary span { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .dp-news-archive > summary .dp-news-archive-open { display: none; }
  .dp-news-archive[open] > summary .dp-news-archive-open { display: inline; }
  .dp-news-archive[open] > summary .dp-news-archive-closed { display: none; }
  .dp-news-archive-range { display: flex; align-items: start; justify-content: space-between; flex-wrap: wrap; gap: 8px 18px; padding-block: 16px 6px; border-block-start: 1px solid var(--line-soft); margin-block-start: 14px; }
  .dp-news-archive-range p { margin: 0; max-inline-size: 48ch; color: var(--ink-soft); font-size: .8125rem; line-height: 1.5; }
  @media (min-width: 820px) {
    .intel-main.has-feature { grid-template-columns: minmax(0, 1fr) minmax(0, 1.28fr); align-items: start; }
    .intel-main.feature-is-latest { grid-template-columns: minmax(0, 1.28fr) minmax(0, 1fr); }
    .dp-news-more, .dp-news-archive { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .intel-tabs { gap: 6px; }
    .intel-tabs .dp-ui-filter { font-size: .8125rem; padding-inline: .7em; }
    .intel-tools-end { width: 100%; flex-wrap: nowrap; }
    .intel-search { flex: 1; }
    .intel-search input { flex: 1; width: 0; }
    .intel-featured p {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
    }
  }

  /* Empty desks supply their own copy through the named slot. */
  .news-empty,
  .intel-aside {
    padding: clamp(16px, 3vw, 30px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
  }
  .news-empty { display: grid; gap: 12px; }
  .news-empty :global(.news-empty-eyebrow) { color: var(--green); font: 700 .75rem/1.35 var(--font-ui); }
  .news-empty :global(h2) { margin: 0; font: 550 clamp(1.5rem, 3vw, 2.25rem)/1.15 var(--font-display); }
  .news-empty :global(p) { max-width: 62ch; margin: 0; color: var(--ink-soft); }
  .news-empty :global(.news-empty-ctas) { display: flex; flex-wrap: wrap; gap: 8px; }
  .news-empty :global(.news-empty-cta) {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--dp-ui-control);
    padding-inline: 12px;
    border: 1px solid var(--green);
    border-radius: var(--dp-ui-radius);
    background: var(--green);
    color: var(--paper);
    font-weight: 650;
    text-decoration: none;
  }
  .news-empty :global(.news-empty-cta.is-ghost) { background: var(--paper); color: var(--green); }
  .news-empty :global(.news-empty-cta:hover) { text-decoration: underline; }
  .intel-aside { margin-top: var(--dp-ui-gap); }
  .intel-trending ol { list-style: none; padding: 0; margin: 10px 0 0; }
  .intel-trending a {
    display: flex;
    align-items: center;
    min-block-size: var(--dp-ui-control);
    color: var(--green);
  }
</style>
