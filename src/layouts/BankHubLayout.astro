---
// Bank hub layout — Phase H2 (Claude Design handoff alignment).
// Used by /banks/[slug]/.
//
// Aligns to the design-handoff narrow pagehead chrome.
// Body sections use the same dp-prog-body conventions for consistency
// across hub pages (banks + airlines).

import BaseLayout from "./BaseLayout.astro";
import UtilityPageHead from "~/components/UtilityPageHead.astro";
import { bankMark } from "~/lib/logos";

interface Props {
  title: string;
  description?: string;
  bankName: string;
  /** bank slug (e.g. "fab") — resolves the bank-<slug> hero photograph. */
  slug?: string;
  logo?: string;
  /** Number of cards we cover from this issuer; renders as the headline metric. */
  cardCount?: number;
  /** Live salary-transfer top bonus in AED (or undefined when none). */
  topBonusAed?: number;
  /** Date this hub was last verified by the editorial team. */
  lastVerified?: Date;
  customerService?: {
    phone?: string;
    email?: string;
    website?: string;
  };
}

const {
  title,
  description,
  bankName,
  slug,
  cardCount,
  topBonusAed,
  lastVerified,
  customerService,
} = Astro.props;

const fmtVerified = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

// The bank's own mark leads the page (2026-10-20 ruling: logos, not
// generic skyline photographs). White-only marks sit on the brand navy.
const mark = slug ? bankMark(slug) : null;

// JSON-LD: bank hubs emit Organization (sub-type FinancialService) +
// BreadcrumbList. Customer-service contact and the issuer website are
// surfaced when present. PR-D (29 May 2026).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "FinancialService"],
      "@id": `${canonicalUrl}#bank`,
      name: bankName,
      description: description ?? `${bankName} — DubaiPoints UAE bank guide.`,
      url: customerService?.website || canonicalUrl,
      areaServed: "AE",
      ...(customerService?.phone || customerService?.email
        ? {
            contactPoint: {
              "@type": "ContactPoint",
              contactType: "customer service",
              ...(customerService?.phone ? { telephone: customerService.phone } : {}),
              ...(customerService?.email ? { email: customerService.email } : {}),
              areaServed: "AE",
            },
          }
        : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: "Banks", item: `${siteUrl}/banks/` },
        { "@type": "ListItem", position: 3, name: bankName, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} fullWidth schema={schema}>
  <UtilityPageHead variant="bank">
    <p class="dp-utility-kicker"><a href="/banks/">UAE banks</a></p>
    <h1>{bankName}</h1>
    <p class="dp-utility-deck">Compare {bankName} cards and rewards, and check whether there is a tracked salary-transfer offer.</p>
    <div class="dp-utility-actions">
      {cardCount ? (
        <a class="dp-ui-action dp-ui-primary" href="#bank-cards">Compare {bankName} cards</a>
      ) : (
        <a class="dp-ui-action dp-ui-primary" href="/cards/">Browse UAE cards</a>
      )}
      {topBonusAed != null ? (
        <a class="dp-ui-action dp-ui-secondary" href="#bank-salary-transfer">See salary-transfer offer</a>
      ) : (
        <a class="dp-ui-action dp-ui-secondary" href="/salary-transfer/">Open salary tracker</a>
      )}
    </div>
    {mark && (
      <span slot="media" class:list={["dp-hub-mark", { "is-plated": mark.plated }]}>
        <img src={mark.src} alt="" loading="eager" decoding="async" />
      </span>
    )}

    {(cardCount != null || topBonusAed != null || lastVerified) && (
      <dl slot="facts" class="dp-metric-strip dp-bank-facts">
        {cardCount != null && (
          <div class="metric">
            <dt class="l">Cards covered</dt>
            <dd class="v">{cardCount}</dd>
          </div>
        )}
        {topBonusAed != null && (
          <div class="metric is-live">
            <dt class="l">Top salary-transfer bonus</dt>
            <dd class="v">AED {topBonusAed.toLocaleString()}</dd>
          </div>
        )}
        {lastVerified && (
          <div class="metric">
            <dt class="l">Last card verification</dt>
            <dd class="v"><time datetime={lastVerified.toISOString()}>{fmtVerified(lastVerified)}</time></dd>
          </div>
        )}
      </dl>
    )}
  </UtilityPageHead>

  <article class="dp-bank-body">
    <section class="dp-bank-callout" id="bank-salary-transfer">
      <h2 class="label">Current salary transfer offer</h2>
      <slot name="salary-transfer" />
    </section>

    <section>
      <h2>Reward currencies</h2>
      <slot name="currencies" />
    </section>

    <section id="bank-cards">
      <h2>Cards from {bankName}</h2>
      <slot name="cards" />
    </section>

    <section>
      <h2>Related reading</h2>
      <slot name="articles" />
    </section>

    {customerService && (
      <section class="dp-bank-cs">
        <p class="label">Customer service</p>
        {customerService.phone && <p>Phone: {customerService.phone}</p>}
        {customerService.email && (
          <p>Email: <a href={`mailto:${customerService.email}`}>{customerService.email}</a></p>
        )}
        {customerService.website && (
          <p>Web: <a href={customerService.website} target="_blank" rel="noopener">{customerService.website}</a></p>
        )}
      </section>
    )}

    <div class="dp-prose dp-bank-prose">
      <slot />
    </div>
  </article>
</BaseLayout>

<style>
  .dp-hub-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    max-inline-size: 100%;
    padding: 10px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius, 12px);
  }
  .dp-hub-mark.is-plated { background: var(--navy-pin); border-color: var(--navy-pin); }
  .dp-hub-mark img { block-size: 40px; inline-size: auto; max-inline-size: 100%; object-fit: contain; }
  .dp-bank-facts.dp-metric-strip { margin: 0; padding-block: 8px 0; border-block-end: 0; }
  .dp-bank-facts.dp-metric-strip .l { margin: 0 0 4px; letter-spacing: .05em; color: var(--ink-soft); }
  .dp-bank-facts.dp-metric-strip .v { margin: 0; font-size: clamp(1.125rem, 2vw, 1.45rem); }
  /* Single-column reading width. A Stage 2 sticky rail was trialled here
     but reverted: bank hubs carry too little content to fill two columns,
     so the rail left a large empty void on laptop. Reinstate the rail once
     hubs have real reward-currency data, articles, and a live offer. */
  .dp-bank-body {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(24px, 3vw, 40px) clamp(16px, 3vw, 32px) 80px;
  }
  @media (max-width: 640px) {
    .dp-bank-body { padding-block-end: 56px; }
    .dp-bank-body section { margin-bottom: 28px; }
  }
  .dp-bank-body section { margin-bottom: 36px; }
  .dp-bank-body section[id] { scroll-margin-block-start: calc(var(--dp-sticky-header-height, 81px) + 16px); }
  .dp-bank-body h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: -0.4px;
    color: var(--ink);
    margin: 0 0 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  .dp-bank-callout {
    border: 1px solid var(--gold);
    border-left: 3px solid var(--gold);
    border-radius: 8px;
    background: var(--gold-soft, #faf3e3);
    padding: 18px 20px;
  }
  .dp-bank-callout .label {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold-ink, var(--gold));
    margin: 0 0 10px;
    border: 0;
    padding: 0;
  }
  .dp-bank-callout :global(strong) { color: var(--ink); }

  .dp-bank-cs {
    background: var(--shade-1);
    border-radius: 8px;
    padding: 16px 20px;
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .dp-bank-cs .label {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--green);
    margin: 0 0 8px;
  }
  .dp-bank-cs p { margin: 0 0 6px; }
  .dp-bank-cs p:last-child { margin-bottom: 0; }
  .dp-bank-cs a {
    color: var(--ink); font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: var(--line);
  }
  .dp-bank-cs a:hover { color: var(--green); }

  .dp-bank-prose { margin-top: 24px; }
  /* Bank-hub prose is reference, not editorial — disable drop-cap. */
  .dp-bank-prose > p:first-of-type::first-letter {
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    line-height: inherit;
    float: none;
    padding: 0;
    color: inherit;
  }
</style>
