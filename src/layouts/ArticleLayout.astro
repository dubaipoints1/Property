---
// Editorial Utility reading layout for guides, news and deals. The answer,
// article navigation and evidence lead; photographs and card references
// support the story without gating access to it.

import BaseLayout from "./BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import { getStockEntry } from "~/lib/stockManifest";
import CardImage from "~/components/CardImage.astro";
import ReaderNextSteps from "~/components/ReaderNextSteps.astro";
import ReadingContents from "~/components/ReadingContents.astro";
import { getCollection } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import { programmeHref } from "~/lib/programmes";
import { resolveReaderJourney, type ReaderContext } from "~/lib/readerJourneys";

interface Props {
  title: string;
  /** On-page H1; falls back to `title`. Pass this without the
   * "| DubaiPoints" brand suffix — that belongs only in the meta title. */
  heading?: string;
  description?: string;
  crumb?: string;
  /**
   * Green-pill kicker rendered above the h1 (mockup page 04 "SWEET SPOTS"
   * pattern). Already wired into news/[slug] via `category`. Optional —
   * articles with no natural category leave it undefined and the row
   * doesn't render.
   */
  eyebrow?: string;
  /**
   * Estimated read time in minutes. Optional — when supplied, renders as
   * a meta pill next to the eyebrow in the article head row.
   * Editorial judgement per piece; no auto-compute (avoid the "this
   * article is 12 min read" vs a 4-paragraph reality mismatch).
   */
  readMinutes?: number;
  deck?: string;
  author?: string;
  authorRole?: string;
  publishedAt?: Date;
  updatedAt?: Date;
  toc?: { id: string; label: string }[];
  sources?: string[];
  showHero?: boolean;
  systemTypography?: boolean;
  /** Cards the piece discusses (10 Oct 2026, direction B): rendered as a
   *  "Cards in this guide" strip after the article, issuer card art first.
   *  Order is the author's; the strip makes no ranking claim. */
  cards?: Array<{ slug: string; name: string; bank: string; fee: string }>;
  /** Manifest-tracked story image. Missing images don't generate a cover. */
  heroSlug?: string;
  /** Editorial opt-in for a selected travel feature; otherwise images follow evidence. */
  photoLead?: boolean;
  /** Explicit collection references; never inferred from story prose. */
  readerContext?: ReaderContext;
}

const {
  title,
  heading,
  description,
  crumb,
  eyebrow,
  readMinutes,
  deck,
  cards = [],
  author = "DubaiPoints Editorial",
  authorRole,
  publishedAt,
  updatedAt,
  toc = [],
  sources = [],
  showHero = false,
  systemTypography = false,
  heroSlug,
  photoLead = false,
  readerContext,
} = Astro.props;

const fmt = (d?: Date) =>
  d
    ? d.toLocaleDateString("en-GB", {
        day: "numeric",
        month: "short",
        year: "numeric",
      })
    : null;

const supportingImage = showHero && heroSlug ? getStockEntry(heroSlug) : undefined;
const earlyPhoto = photoLead && supportingImage?.source !== "ai-generated" && supportingImage;

const showUpdated =
  updatedAt && publishedAt && updatedAt.getTime() !== publishedAt.getTime();

const initials = author
  .split(/\s+/)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .slice(0, 2)
  .join("");

const currentPath = Astro.url.pathname;
const allGuides = await getCollection("guides");
const journey = readerContext ? resolveReaderJourney(readerContext, {
  cards: getActiveCards().map((c) => ({ id: c.slug, name: c.name, bank: c.bank })),
  banks: (await getCollection("banks")).map((b) => ({ id: b.id, name: b.data.name })),
  programmes: (await getCollection("programs")).map((p) => ({ id: p.id, name: p.data.name, href: programmeHref(p.id) })),
  guides: allGuides.map((g) => ({
    id: g.id, title: g.data.title, updatedAt: g.data.updatedAt,
    cards: g.data.relatedCards.map((ref) => ref.id),
    programmes: g.data.relatedPrograms.map((ref) => ref.id),
  })),
}) : { actions: [], relatedGuides: [] };
// No relation is better than a false relation. Only show a small, explicitly
// chronological fallback when no contextual route or explainer is available.
const hasContextualNext = journey.actions.length > 0 || journey.relatedGuides.length > 0;
const latestGuides = hasContextualNext ? [] : allGuides
  .filter((g) => currentPath !== `/guides/${g.id}/`)
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
  .slice(0, 2);

const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

// JSON-LD: news pages emit NewsArticle; guides + deals emit Article.
// Author + publisher + dates carry through; BreadcrumbList complements
// it via the crumb prop. PR-D (29 May 2026).
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://dubaipoints.ae";
const articleType = currentPath.startsWith("/news/") ? "NewsArticle" : "Article";
const sectionType = currentPath.startsWith("/news/")
  ? "News"
  : currentPath.startsWith("/deals/")
  ? "Deals"
  : "Guides";
const sectionPath = currentPath.startsWith("/news/")
  ? "/news/"
  : currentPath.startsWith("/deals/")
  ? "/deals/"
  : "/guides/";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": articleType,
      "@id": `${canonicalUrl}#article`,
      headline: title,
      ...(description ? { description } : {}),
      url: canonicalUrl,
      mainEntityOfPage: canonicalUrl,
      ...(publishedAt ? { datePublished: publishedAt.toISOString() } : {}),
      ...(updatedAt ? { dateModified: updatedAt.toISOString() } : {}),
      inLanguage: "en-AE",
      author: { "@type": "Organization", name: author },
      publisher: {
        "@type": "Organization",
        name: "DubaiPoints",
        logo: { "@type": "ImageObject", url: `${siteUrl}/logo-mark.svg` },
      },
      ...(eyebrow ? { articleSection: eyebrow } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
        { "@type": "ListItem", position: 2, name: sectionType, item: `${siteUrl}${sectionPath}` },
        { "@type": "ListItem", position: 3, name: title, item: canonicalUrl },
      ],
    },
  ],
};
---

<BaseLayout title={title} description={description} fullWidth schema={schema} systemTypography={systemTypography}>
  <article class="dp-reading-shell">
    <header class="dp-pagehead dp-reading-head">
      <div class="dp-reading-column">
        {crumb && (
          <div class="crumb">
            {/* 10 June 2026 SEO punch-list #3: visible crumb segments anchored
                so each guide/news/deals article carries inbound links to the
                section index (was BreadcrumbList-schema-only). sectionType +
                sectionPath are already computed above for the schema graph;
                re-using them here keeps the visible crumb structurally aligned
                with the schema. The passed `crumb` string's first two segments
                ("DubaiPoints / Guides") are now rendered as anchors; any third
                segment (e.g. category on news / deals) stays plain text. */}
            <a href="/" class="crumb-link">DubaiPoints</a>
            {" / "}
            <a href={sectionPath} class="crumb-link">{sectionType}</a>
            {(() => {
              const segments = crumb.split("/").map((s) => s.trim());
              return segments.length >= 3 ? <>{" / "}{segments.slice(2).join(" / ")}</> : null;
            })()}
          </div>
        )}
        {(eyebrow || readMinutes) && (
          <div class="dp-article-eyebrow-row">
            {eyebrow && <span class="dp-article-eyebrow">{eyebrow}</span>}
            {eyebrow && readMinutes && <span class="dp-article-eyebrow-sep" aria-hidden="true">·</span>}
            {readMinutes && <span class="dp-article-eyebrow-read">{readMinutes} min read</span>}
          </div>
        )}
        <h1>{heading ?? title}</h1>
        {(deck || description) && <p class="deck">{deck ?? description}</p>}
      </div>
    </header>

    <div class="dp-byline-strip dp-reading-column">
      <div class="av" aria-hidden="true">{initials}</div>
      <div>
        <div class="name">
          {author}
          {authorRole && <span style="color: var(--muted); font-weight: 400;"> · {authorRole}</span>}
        </div>
        {(publishedAt || updatedAt) && (
          <div class="when">
            {publishedAt && <>Filed <time datetime={publishedAt.toISOString()}>{fmt(publishedAt)}</time></>}
            {updatedAt && (!publishedAt || showUpdated) && <>
              {publishedAt && " · "}Updated <time datetime={updatedAt.toISOString()}>{fmt(updatedAt)}</time>
            </>}
          </div>
        )}
      </div>
    </div>

    <div class="dp-article-body dp-reading-column">
      <slot name="before-hero" />
      {toc.length >= 2 && (
        <ReadingContents sections={toc} />
      )}

      {showHero && Astro.slots.has("hero") && <slot name="hero" />}
      {earlyPhoto && (
        <div class="dp-reading-media dp-reading-photo-lead" data-reading-media data-reading-photo-lead>
          <StockImage slug={earlyPhoto.slug} class="article-hero-image" loading="eager"
            sizes="(max-width: 720px) calc(100vw - 32px), 680px" />
        </div>
      )}
      <div class="dp-prose">
        <slot />
      </div>
    </div>

    {sources.length > 0 && (
      <footer class="dp-article-sources dp-reading-column">
        <p>
          <strong>Sources:</strong>{" "}
          {sources.map((s, i) => (
            <>
              {i > 0 && " · "}
              <a href={s} target="_blank" rel="noopener noreferrer">{new URL(s).hostname}</a>
            </>
          ))}
        </p>
      </footer>
    )}

    {supportingImage && !earlyPhoto && !Astro.slots.has("hero") && (
      <div class="dp-reading-media dp-reading-column" data-reading-media>
        <StockImage slug={supportingImage.slug} class="article-hero-image"
          sizes="(max-width: 720px) calc(100vw - 32px), 680px" />
      </div>
    )}

    {cards.length > 0 && (
      <section class="dp-guide-cards dp-reading-column" aria-labelledby="dp-guide-cards-h">
        <h2 class="dp-guide-cards-kicker" id="dp-guide-cards-h">Cards in this guide</h2>
        <ul>
          {cards.map((c) => (
            <li>
              <a href={`/cards/${c.slug}/`}>
                <CardImage cardSlug={c.slug} cardName={c.name} bankName={c.bank} coverSize="thumb" sizes="(max-width: 640px) 45vw, 300px" />
                <span class="n">{c.name}</span>
                <span class="f">{c.fee}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {Astro.slots.has("related") && (
      <aside class="dp-reading-column" aria-label="Related reading"><slot name="related" /></aside>
    )}

    {hasContextualNext && (
      <div class="dp-reading-column" id="dp-latest-guides-heading">
        <ReaderNextSteps actions={journey.actions} guides={journey.relatedGuides} />
      </div>
    )}

    {latestGuides.length > 0 && (
      <aside class="dp-reading-latest dp-reading-column" aria-labelledby="dp-latest-guides-heading" data-reader-latest>
        <h2 id="dp-latest-guides-heading">Latest guides</h2>
        <p>Recent updates from the guides desk.</p>
        <ul>{latestGuides.map((g) => <li><a href={`/guides/${g.id}/`}>{g.data.title}</a><span>Updated {fmtShort(g.data.updatedAt)}</span></li>)}</ul>
      </aside>
    )}
  </article>
</BaseLayout>

<style>
  .dp-reading-shell {
    --dp-reading-gutter: clamp(16px, 3vw, 32px);
    --dp-reading-width: 680px;
    --dp-reading-anchor-offset: calc(var(--dp-sticky-header-height, 92px) + 16px);
  }
  .dp-reading-shell .dp-reading-column {
    width: min(var(--dp-reading-width), calc(100% - var(--dp-reading-gutter) - var(--dp-reading-gutter)));
    min-width: 0;
    max-width: none;
    margin-inline: auto;
  }
  .dp-reading-shell .dp-reading-head {
    padding: clamp(22px, 3.5vw, 44px) 0 clamp(16px, 2.5vw, 28px);
    background: var(--paper);
  }
  .dp-reading-head h1 {
    font-size: clamp(32px, 4.5vw, 48px);
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .dp-reading-shell .dp-reading-head .deck {
    display: block;
    overflow: visible;
    font-size: clamp(1rem, 1.6vw, 1.1875rem);
    line-height: 1.45;
    margin-block-start: 12px;
  }
  .dp-reading-shell .dp-byline-strip {
    padding: 12px 0;
    margin-bottom: 16px;
  }
  .dp-reading-shell .dp-guide-cards {
    padding: 18px 0 12px;
    margin-block: 24px;
    border-top: 1px solid var(--line);
  }
  .dp-reading-shell .dp-article-body {
    overflow-wrap: anywhere;
  }
  .dp-reading-shell .dp-reading-toc {
    margin-bottom: 20px;
    padding: 0 clamp(14px, 2vw, 22px);
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius, 12px);
    background: var(--shade-1);
  }
  .dp-reading-toc summary {
    cursor: pointer;
    min-block-size: var(--dp-ui-control, 44px);
    padding-block: 12px;
    color: var(--green);
    font-weight: 600;
  }
  .dp-reading-toc li { padding: 0; }
  .dp-reading-toc a {
    display: block;
    min-block-size: var(--dp-ui-control, 44px);
    padding-block: 11px;
    text-decoration: underline;
    text-underline-offset: .18em;
  }
  .dp-reading-shell .dp-article-body :global(:is(h2, h3, h4)[id]) {
    scroll-margin-top: var(--dp-reading-anchor-offset);
  }
  .dp-reading-shell .dp-article-sources {
    margin-block: 32px;
    padding: 16px clamp(16px, 3vw, 24px);
    overflow-wrap: anywhere;
  }
  .dp-reading-media {
    margin-block: clamp(20px, 4vw, 36px);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
  }
  .dp-reading-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-block-size: 440px;
    object-fit: cover;
  }
  .dp-reading-photo-lead { margin-block: 0 var(--dp-ui-gap, 20px); }
  .dp-reading-photo-lead :global(.article-hero-image) {
    aspect-ratio: 2.4 / 1;
    margin: 0;
    border: 0;
    border-radius: 0;
  }
  .dp-reading-latest { margin-block: 32px; padding-block: 20px; border-block-start: 1px solid var(--line); }
  .dp-reading-latest h2 { margin: 0 0 8px; font: 600 1.5rem/1.2 var(--font-display); }
  .dp-reading-latest p { margin: 0 0 12px; font: 400 .875rem/1.5 var(--font-ui); color: var(--ink-soft); }
  .dp-reading-latest ul { list-style: none; padding: 0; margin: 0; }
  .dp-reading-latest li { padding-block: 10px; }
  .dp-reading-latest li + li { border-block-start: 1px solid var(--line-soft); }
  .dp-reading-latest a { display: block; min-block-size: 44px; align-content: center; color: var(--link); font: 550 1rem/1.45 var(--font-ui); text-decoration: underline; text-underline-offset: .18em; }
  .dp-reading-latest span { display: block; font: 400 .75rem/1.4 var(--font-ui); color: var(--ink-soft); }
  .dp-reading-latest a:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
</style>
