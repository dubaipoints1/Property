---
import TrustPageLayout from "~/layouts/TrustPageLayout.astro";
import {
  cardsCorrected,
  correctionsByDate,
  corrections,
  lastCorrectionDate,
} from "~/data/corrections";

// Entries used to be hardcoded in this file's markup, which meant the page
// could not say how many corrections it held or when the last one was — the
// two facts that make a corrections log evidence rather than a promise.
const log = correctionsByDate();
const last = lastCorrectionDate();
const fmtLong = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---

<TrustPageLayout
  title="Corrections log | DubaiPoints"
  description="The DubaiPoints corrections log. Every material correction to a published figure or recommendation is noted here, dated, with the original and corrected values side by side."
  eyebrow="Corrections"
  heading="What we got wrong, and when we fixed it."
  deck="Material corrections to a published figure, fee, eligibility detail or recommendation are logged here permanently. The page corrected, the original value, and the corrected value — every time."
  lastUpdated={last ?? new Date("2026-06-11")}
  facts={[
    { label: "Corrections published", value: String(corrections.length) },
    { label: "Most recent", value: last ? fmtShort(last) : "None yet" },
    { label: "Card pages corrected", value: String(cardsCorrected()) },
    { label: "Fixed within", value: "3 working days" },
  ]}
>
  <section>
    <h2>The standard</h2>
    <p>If we publish a figure that turns out to be wrong, we fix the page, refresh its <strong>Last verified</strong> stamp, and add an entry to this log. The log is permanent — corrections do not vanish from the record once the page is fixed.</p>
    <p>Material corrections include: any monetary figure (annual fee, FX fee, welcome bonus value, salary band), any eligibility detail (minimum salary, salary-transfer requirement, residency rule), and any recommendation reversal (e.g. moving a card off our "best of" list because new information surfaced).</p>
    <p>Typo fixes, layout changes, and routine updates to refresh-stamped figures (where the bank changed the value, not us) are not logged here — those happen continuously and the <a href="/editorial-policy/">editorial policy</a> covers the verification cadence.</p>
  </section>

  <section>
    <h2>Recent corrections</h2>

    {log.map((entry) => (
      <article class="dp-correction">
        <h3>
          <time datetime={entry.date.toISOString().slice(0, 10)}>
            {fmtLong(entry.date)}
          </time>{" "}
          — {entry.title}
          {" "}
          <span class="count">
            ({entry.cardsAffected.length}{" "}
            {entry.cardsAffected.length === 1 ? "card" : "cards"})
          </span>
        </h3>
        <p><strong>Original:</strong> <Fragment set:html={entry.original} /></p>
        <p><strong>Corrected:</strong> <Fragment set:html={entry.corrected} /></p>
      </article>
    ))}

    <p>
      If you've spotted an error, please
      <a href="mailto:info@dubaipoints.ae?subject=Correction"> email us</a>
      with the page URL and the corrected value.
    </p>
  </section>

  <section>
    <h2>How to report an error</h2>
    <p>Email <a href="mailto:info@dubaipoints.ae?subject=Correction">info@dubaipoints.ae</a> with the URL of the page, the figure or claim that's wrong, and — where you can — a link to the source that proves it. We aim to acknowledge within one business day and fix within three.</p>
  </section>

  <section class="related">
    <h3>Related</h3>
    <ul>
      <li><a href="/editorial-policy/">Editorial policy</a></li>
      <li><a href="/how-we-make-money/">How we make money</a></li>
      <li><a href="/about/">About DubaiPoints</a></li>
    </ul>
  </section>
</TrustPageLayout>

<style>
  .dp-correction {
    padding-top: 4px;
  }
  .dp-correction + .dp-correction {
    border-top: 1px solid var(--line-soft);
    margin-top: 28px;
    padding-top: 24px;
  }
  .dp-correction h3 time {
    font-variant-numeric: tabular-nums;
  }
  .dp-correction h3 .count {
    font-family: "DM Sans", system-ui, sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: var(--muted);
    white-space: nowrap;
  }
</style>
