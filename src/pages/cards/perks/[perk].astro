---
import { cardSalaryLabel } from "~/lib/cardEligibility";
import { cardFeeNeedsReview, compareKnownAnnualFees } from "~/lib/cardFeeProvenance";
// Perk facet pages — /cards/perks/<perk>/.
//
// `_features` is a typed discriminated union of fourteen perk types, and
// getCardsWithFeature() has existed to filter on it since the union shipped.
// It had zero call sites: the data was queryable and no page queried it, so
// a reader could not ask "which cards get me into a lounge" anywhere on the
// site (2026-09-06 audit; surfaced again by the 10 September kredit.ae
// teardown, which runs about 306 facet pages on this idea).
//
// THREE TYPES, NOT FOURTEEN. Our card set is thinner than a lead
// generator's, and eleven of the fourteen types cover between one and five
// cards. A page listing one card is the thin-content shape the 2026-07-27
// honest-nav rule forbids, so PERK_PAGES carries only the types that clear a
// real threshold. The rest stay as chips on the cards index, where they
// already are. Raising the set means checking the counts again, which
// tests/cards/perk-pages.test.ts does on every run.
import ComparisonTableLayout from "~/layouts/ComparisonTableLayout.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import {
  getCardsWithFeature,
  welcomeBonusHeadline,
  annualFeeLabel,
} from "~/lib/cardsData";
import {
  verifiedMonthStamp,
  loungeDisplay,
  loungeFeatureOf,
} from "~/lib/cardsDataFormat";
import { PERK_PAGE_RECORDS, hasPerkComparisonCoverage, type PerkPage } from "~/data/perkPages";

export async function getStaticPaths() {
  return PERK_PAGE_RECORDS.map((perk) => ({
    params: { perk: perk.slug },
    props: { perk },
  }));
}

interface Props {
  perk: PerkPage;
}

const { perk } = Astro.props;
const cards = getCardsWithFeature(perk.feature).sort(
  (a, b) => compareKnownAnnualFees(cardFeeNeedsReview(a, "annualFee") ? null : a.annualFee.amount,
    cardFeeNeedsReview(b, "annualFee") ? null : b.annualFee.amount),
);
const verifiedStamp = verifiedMonthStamp(cards);
const comparisonEligible = hasPerkComparisonCoverage(cards.length);

const rows = await Promise.all(
  cards.map(async (c) => {
    const bank = await getEntry("banks", c.bank);
    const fee = annualFeeLabel(c);
    // Lounge is the one type with a typed detail worth a column of its own;
    // the other two say the same thing for every card that has them.
    const detail =
      perk.feature === "lounge_access"
        ? loungeDisplay(loungeFeatureOf(c))
        : "Included";
    return {
      cardName: c.name,
      bankName: bank?.data.name ?? c.bank,
      href: `/cards/${c.slug}/`,
      values: [
        detail,
        fee.qual ? `${fee.amount} (${fee.qual})` : fee.amount,
        cardSalaryLabel(c, { perMonth: true }),
        welcomeBonusHeadline(c.welcomeBonus) || "—",
      ],
    };
  }),
);
---

{comparisonEligible ? <ComparisonTableLayout
  title={`${perk.heading}${verifiedStamp ? ` (${verifiedStamp})` : ""} | DubaiPoints`}
  heading={`${perk.heading}${verifiedStamp ? ` (${verifiedStamp})` : ""}`}
  description={perk.description}
  columns={[perk.detailColumn, "Annual fee", "Min salary", "Welcome bonus"]}
  rows={rows}
/> : <BaseLayout
  title={`${perk.heading} — source status | DubaiPoints`}
  description="A retained benefit-source reference. Verified benefit coverage is currently insufficient for a comparison; unknown terms are not evidence of no benefit."
  fullWidth
  excludeFromSearch
>
  <meta slot="head" name="robots" content="noindex,follow" />
  <article class="dp-article" data-pagefind-ignore>
    <header class="dp-article-head">
      <div class="crumb"><a href="/cards/">Cards</a> / Benefit source status</div>
      <h1>{perk.heading}: source status</h1>
      <p>Verified benefit coverage is currently insufficient for a comparison. This URL is retained as a source-status reference, not a ranking or a complete benefit catalogue.</p>
    </header>
    <section class="dp-prose">
      <p>{cards.length} currently available card profiles have a confirmed {perk.detailColumn.toLowerCase()} record in our data. Other benefit conditions are still under review. Incomplete coverage does not mean those cards have no benefit.</p>
      <h2>Known source profiles</h2>
      <ul>{cards.map(card => <li><a href={`/cards/${card.slug}/`}>{card.name}</a></li>)}</ul>
      <p>Read the individual source notes and issuer conditions. For broader discovery, use the <a href="/cards/finder/">card Finder</a> or <a href="/cards/">card directory</a>.</p>
    </section>
  </article>
</BaseLayout>}
