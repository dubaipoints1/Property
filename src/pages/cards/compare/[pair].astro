---
// Head-to-head card pages — /cards/compare/<a>-vs-<b>/.
//
// /cards/compare/ is a picker: useful once a reader is already there, and
// invisible to anyone searching for two named cards. These are the pages a
// person actually looks for, and the only comparison surface on the site
// with a stable URL per pair.
//
// The pair list and every verdict live in src/data/cardMatchups.ts, which
// explains why the set is curated rather than generated. The spec table is
// CardComparison.astro — the same component three card reviews already
// mount — so the numbers here are the numbers there.
import BaseLayout from "~/layouts/BaseLayout.astro";
import CardComparison from "~/components/cards/CardComparison.astro";
import CardValueLines from "~/components/cards/CardValueLines.astro";
import CardValueScenario from "~/components/cards/CardValueScenario.astro";
import VerifiedStamp from "~/components/cards/VerifiedStamp.astro";
import { getCardData } from "~/lib/cardsData";
import { cardMatchups, matchupSlug, type CardMatchup } from "~/data/cardMatchups";

export async function getStaticPaths() {
  return cardMatchups.map((matchup) => ({
    params: { pair: matchupSlug(matchup) },
    props: { matchup },
  }));
}

interface Props {
  matchup: CardMatchup;
}

const { matchup } = Astro.props;
const left = getCardData(matchup.left);
const right = getCardData(matchup.right);

// getStaticPaths built these from the same data, so a miss means the pair
// list references a card cards.json no longer carries. Fail the build rather
// than render a half-empty comparison.
if (!left || !right) {
  throw new Error(
    `Matchup ${matchupSlug(matchup)} references an unknown card: ${
      !left ? matchup.left : matchup.right
    }`,
  );
}

const newestVerified = new Date(
  Math.max(
    new Date(left.lastVerified).getTime(),
    new Date(right.lastVerified).getTime(),
  ),
);
---

<BaseLayout
  title={`${left.name} vs ${right.name} | DubaiPoints`}
  description={`${matchup.deck} Side-by-side fees, salary requirements and earn rates, with our verdict.`}
  fullWidth
>
  <article class="dp-article dp-matchup-reader">
    <div class="dp-article-head">
      <div class="crumb dp-article-eyebrow">
        <a href="/cards/">Cards</a> / <a href="/cards/compare/">Compare</a>
      </div>
      <h1 class="dp-article-title">{left.name} vs {right.name}</h1>
      <p class="lede dp-article-lede">{matchup.deck}</p>
      <VerifiedStamp lastVerified={newestVerified} />
    </div>

    <section class="dp-matchup-verdict" aria-labelledby="verdict-head">
      <h2 id="verdict-head">Our verdict</h2>
      {matchup.verdict.map((para) => <p>{para}</p>)}
    </section>

    <section aria-labelledby="specs-head">
      <h2 id="specs-head">Side by side</h2>
      <CardComparison cards={[matchup.left, matchup.right]} showArt />
    </section>

    <div class="dp-matchup-value">
      <CardValueScenario id="matchup-card-value" compact />
      <div class="dp-matchup-value-grid">
        {[{ card: left, slug: matchup.left }, { card: right, slug: matchup.right }].map(({ card, slug }) => (
          <div>
            <h3>{card.name}</h3>
            <CardValueLines card={card} slug={slug} />
          </div>
        ))}
      </div>
    </div>

    <section aria-labelledby="reviews-head">
      <h2 id="reviews-head">The full reviews</h2>
      <ul class="dp-matchup-links">
        <li><a href={`/cards/${matchup.left}/`}>{left.name} review</a></li>
        <li><a href={`/cards/${matchup.right}/`}>{right.name} review</a></li>
        <li>
          <a href="/cards/compare/">Compare any cards side by side</a>
        </li>
        <li>
          <a href="/calculator/">Work out what each pays on your own spend</a>
        </li>
      </ul>
    </section>

    <section aria-labelledby="other-head">
      <h2 id="other-head">Other matchups</h2>
      <ul class="dp-matchup-links">
        {cardMatchups
          .filter((m) => matchupSlug(m) !== matchupSlug(matchup))
          .slice(0, 5)
          .map((m) => (
            <li>
              <a href={`/cards/compare/${matchupSlug(m)}/`}>
                {getCardData(m.left)?.name} vs {getCardData(m.right)?.name}
              </a>
            </li>
          ))}
      </ul>
    </section>
  </article>
</BaseLayout>

<style>
  .dp-matchup-value { max-width: 720px; margin-block: 28px; }
  .dp-matchup-value-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 245px), 1fr));
    gap: 16px;
    margin-block-start: 14px;
  }
  .dp-matchup-value-grid h3 { margin-block: 0 6px; font: 600 16px/1.3 var(--font-ui); }
  .dp-matchup-verdict {
    margin: 8px 0 28px;
    max-inline-size: 72ch;
    padding: clamp(16px, 3vw, 22px);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--green);
    border-radius: var(--dp-ui-radius, 8px);
    background: var(--paper);
  }
  .dp-matchup-verdict h2 { margin-block-start: 0; }
  .dp-matchup-verdict p {
    font-size: clamp(1rem, 2.4vw, 1.1875rem);
    line-height: 1.58;
    margin: 0 0 12px;
  }
  .dp-matchup-verdict p:last-child { margin-block-end: 0; }
  .dp-matchup-links {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: grid;
    gap: 10px;
  }
  .dp-matchup-links a {
    color: var(--link);
    font-family: var(--font-ui);
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 2px;
    display: inline-flex;
    align-items: center;
    min-height: var(--dp-ui-control, 44px);
  }
</style>
