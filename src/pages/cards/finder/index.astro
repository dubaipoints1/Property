---
// Card finder — filter-driven chooser for every UAE card we cover.
//
// Stage 4–7 (Tech) workstream of the card-data-audit-and-ui-programme.
// The form is a GET form posting back to itself; the URL is the
// shareable state. Because this site builds with `output: "static"`,
// the actual ranking + filtering executes in a small inline script
// on page load. All cards render at build time with data-*
// attributes; the script reorders + hides DOM nodes.
//
// Filter on published minimum salary, network, fee and availability.
// Rank reward/benefit matches first, then published spend-category rate
// (or general rate if no category rate is listed), then lower annual fee.
// This is a shortlist heuristic, not a common AED valuation or approval.
//
// Top 6 cards displayed as SpecCard variant="full".

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import { finderEvidence } from "~/lib/finderEvidence";
import SpecCard from "~/components/cards/SpecCard.astro";
import CardValueLines from "~/components/cards/CardValueLines.astro";
import CardValueScenario from "~/components/cards/CardValueScenario.astro";

const allCards = getActiveCards();

// Resolve bank-collection display names up-front so the SpecCards
// don't need to await inside the .map (which works in Astro but is
// noisier).
const cardsWithBanks = await Promise.all(
  allCards.map(async (card) => {
    const bank = await getEntry("banks", card.bank);
    return { card, bankName: bank?.data.name ?? card.bank, evidence: finderEvidence(card) };
  }),
);

// Read URL params for initial form state (works in dev / SSR; static
// build emits defaults — the inline script re-reads at runtime).
const params = Astro.url.searchParams;
const salaryInit = params.get("salary") ?? "";
const spendInit = params.get("spend") ?? "general";
const preferInit = params.get("prefer") ?? "none";
const networkInit = params.get("network") ?? "any";
const feeInit = params.get("fee") ?? "any";
// Keep explicit true/false values on existing shared links; a bare URL
// starts with cards that do not require an invitation.
const includeInviteOnlyInit = params.get("include_invite_only") === "true";
const includeLegacyInit = params.get("include_legacy") ?? "false";

// Serialise card data for the client-side ranker.
const cardIndex = cardsWithBanks.map(({ card, evidence }) => ({
  slug: card.slug,
  bank: card.bank,
  network: card.network,
  annualFee: card.annualFee.amount,
  minSalary: card.eligibility.minSalary,
  salaryTransferRequired: card.eligibility.salaryTransferRequired,
  invitationOnly: card.eligibility.invitationOnly === true,
  discontinued: card.discontinuedForNewApplicants !== undefined,
  loyaltyProgram: card.loyaltyProgram ?? "",
  earnRates: card.earnRates,
  hasLounge: card._features.some((f) => f.type === "lounge_access"),
  hasStatus: card._features.some((f) => f.type === "status_match"),
  evidence,
}));

const SPEND_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "dining", label: "Dining" },
  { value: "groceries", label: "Groceries" },
  { value: "travel", label: "Travel" },
  { value: "fuel", label: "Fuel" },
  { value: "online", label: "Online shopping" },
  { value: "general", label: "General / mixed" },
];
const PREFER_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "cashback", label: "AED cashback" },
  { value: "miles", label: "Airline miles" },
  { value: "points", label: "Other points and credits" },
  { value: "lounges", label: "Airport lounges" },
  { value: "status", label: "Hotel / airline status" },
  { value: "none", label: "No preference" },
];
const NETWORK_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "any", label: "Any" },
  { value: "Visa", label: "Visa" },
  { value: "Mastercard", label: "Mastercard" },
  { value: "Amex", label: "Amex" },
];
const FEE_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "any", label: "Any" },
  { value: "free", label: "Free only" },
  { value: "under-500", label: "Under AED 500" },
  { value: "under-1000", label: "Under AED 1,000" },
];

// The grid used to paint all 58 tiles and then have the inline script hide
// all but six about 160 ms later, collapsing the page by tens of rows:
// CLS 0.248 at 1280px (2026-09-06 audit, F-027). It measures 0 at 390px,
// where the single-column grid puts the hidden rows below the fold, which
// is why a mobile-only check misses it.
//
// So the six the script will choose on a bare /cards/finder/ are marked
// here and the rest start hidden. With no query string the default filter
// keeps publicly available cards open to new applicants and the default score
// reduces to the "everything else" earn rate — spend "general" reads that
// rate and prefer "none" adds no bonus — with annual fee as the
// tie-break, exactly as score() and apply() do in the inline script
// below. Change one, change the other; the assertion in
// tests/cards/finder-default-six.test.ts fails if they drift.
const defaultCandidates = cardsWithBanks.filter(
  ({ card }) => card.discontinuedForNewApplicants === undefined && card.eligibility.invitationOnly !== true,
);
const defaultTopSlugs = defaultCandidates
  .map(({ card }) => ({
    slug: card.slug,
    score: card.earnRates.everythingElse ?? 0,
    annualFee: card.annualFee.amount,
  }))
  .sort((a, b) => (b.score !== a.score ? b.score - a.score : a.annualFee - b.annualFee))
  .slice(0, 6)
  .map((c) => c.slug);

// Put the default shortlist into rank in the HTML itself. CSS-only order
// makes focus and screen-reader order disagree with the displayed ranking.
const defaultRank = new Map(defaultTopSlugs.map((slug, i) => [slug, i]));
const initialOrder = [...cardsWithBanks].sort(
  (a, b) => (defaultRank.get(a.card.slug) ?? Infinity) - (defaultRank.get(b.card.slug) ?? Infinity),
);
const defaultCompareSlugs = defaultTopSlugs.slice(0, 3);

// "Last refreshed" stamp computed from the newest L2 lastVerified so the
// stats strip can never go stale (10 June 2026 staleness sweep — the
// previous hardcoded "20 May 2026" had been overtaken by three L2
// refreshes).
const lastRefreshed = new Date(
  Math.max(...allCards.map((c) => new Date(c.lastVerified).getTime())),
).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout
  title="Find your UAE credit card | DubaiPoints"
  description={`Tell us your AED salary, primary spend category, and what you're optimising for. We'll rank the ${allCards.length} UAE cards in our database against your profile.`}
  fullWidth
>
  <div class="dp-pagehead dp-finder-head">
    <div class="crumb">DubaiPoints / Cards / Finder</div>
    <h1>Find your card</h1>
    <p>Shortlist UAE cards by salary, rewards and the way you spend.</p>
    {/* Stage 5.5 UX Fix #6: visual anchor above the fold. Matches the
        stats-strip pattern used on the compare page so the two tool
        pages read as one publication. */}
    <div class="dp-tools-stats">
      <span>
        <span class="lbl">Cards covered</span>
        <strong>{allCards.length}</strong>
      </span>
      <span>
        <span class="lbl">Last refreshed</span>
        <strong>{lastRefreshed}</strong>
      </span>
      <span>
        <span class="lbl">Methodology</span>
        <strong><a href="/editorial-policy/">Read &rarr;</a></strong>
      </span>
    </div>
  </div>

  <section class="dp-finder">
    {/* Compact layouts can collapse the filters; a sidebar always shows
        them, including when the window is resized from a collapsed view. */}
    <details class="dp-finder-formwrap" id="finder-filters">
      <summary class="dp-finder-formwrap-summary">
        <span class="dp-finder-formwrap-title">Filter cards</span>
        <span class="dp-finder-formwrap-hint">Salary, spend, preference</span>
      </summary>
      <script is:inline data-finder-initial-disclosure>
        // Set the desktop disclosure before the browser parses its content.
        // Mobile default remains closed even if the rest of the document is slow.
        if (!window.matchMedia("(max-width: 820px)").matches) {
          document.currentScript.parentElement.open = true;
        }
      </script>
      <form method="get" action="/cards/finder/" class="dp-finder-form" id="finder-form">
        <fieldset class="dp-finder-fs is-salary">
          <legend>Your monthly salary (AED)</legend>
          <input
            class="dp-ui-field"
            type="number"
            name="salary"
            aria-label="Your monthly salary (AED)"
            inputmode="numeric"
            placeholder="e.g. 15,000"
            min="0"
            step="1"
            value={salaryInit}
          />
          <p class="hint">
            Leave blank to skip the salary filter. Published minimums
            are not a guarantee of approval.
          </p>
        </fieldset>

        <fieldset class="dp-finder-fs">
          <legend>Reward preference</legend>
          <select class="dp-ui-field" name="prefer" aria-label="Reward preference">
            {PREFER_OPTIONS.map((opt) => <option value={opt.value} selected={preferInit === opt.value}>{opt.label}</option>)}
          </select>
        </fieldset>

        <div class="dp-finder-actions">
          <button type="submit" class="dp-ui-action dp-ui-primary">Rank cards</button>
          <a href="/cards/finder/" class="dp-ui-action dp-ui-quiet">Reset filters</a>
        </div>

        <details class="dp-finder-more" id="finder-more">
          <summary>More filters · spending, network and fees</summary>
        <fieldset class="dp-finder-fs">
          <legend>Primary spend category</legend>
          <div class="dp-finder-radios">
            {SPEND_OPTIONS.map((opt) => (
              <label>
                <input
                  type="radio"
                  name="spend"
                  value={opt.value}
                  checked={spendInit === opt.value}
                />
                <span>{opt.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Stage 5.5 UX Fix #8: combine "Card network" + "Annual fee" into
            a single .dp-finder-fs-row. Reduces the form from 5 sections
            to 4. Both are narrow inline-radio fieldsets serving the
            secondary-filter role. */}
        <div class="dp-finder-fs-row">
          <fieldset class="dp-finder-fs">
            <legend>Card network</legend>
            <div class="dp-finder-radios is-inline">
              {NETWORK_OPTIONS.map((opt) => (
                <label>
                  <input
                    type="radio"
                    name="network"
                    value={opt.value}
                    checked={networkInit === opt.value}
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dp-finder-fs">
            <legend>Annual fee</legend>
            <div class="dp-finder-radios is-inline">
              {FEE_OPTIONS.map((opt) => (
                <label>
                  <input
                    type="radio"
                    name="fee"
                    value={opt.value}
                    checked={feeInit === opt.value}
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        {/* Optional availability filters share one row. */}
        <div class="dp-finder-fs-row">
          <fieldset class="dp-finder-fs">
            <legend>Invitation-only cards</legend>
            <select class="dp-ui-field" name="include_invite_only" aria-label="Invitation-only cards">
              <option value="false" selected={!includeInviteOnlyInit}>Exclude</option>
              <option value="true" selected={includeInviteOnlyInit}>Include</option>
            </select>
          </fieldset>

          <fieldset class="dp-finder-fs">
            <legend>Legacy cards</legend>
            <label class="dp-finder-checkbox">
              <input
                type="checkbox"
                name="include_legacy"
                value="true"
                checked={includeLegacyInit === "true"}
              />
              <span>Include legacy cards</span>
            </label>
          </fieldset>
        </div>

          <div class="dp-finder-actions"><button type="submit" class="dp-ui-action dp-ui-primary">Apply all filters</button></div>
        </details>
      </form>
    </details>

    <div class="dp-finder-results" id="finder-results">
      <div class="dp-finder-results-head">
        <h2>Matching cards</h2>
        <p class="count" id="finder-count">
          Showing {defaultTopSlugs.length} of {defaultCandidates.length} cards that meet your filters
        </p>
        <p class="count" id="finder-mode">
          Ordered by published earn rate for general spending, then lower annual fee.
          Rates use different units. The order is not based on the AED examples and is not an approval decision.
        </p>
      </div>

      <div class="dp-finder-empty" id="finder-empty" hidden>
        <p>
          No cards match these filters. Check your salary entry or try
          setting the network or annual fee to "Any".
        </p>
        <p>
          <a href="/cards/finder/" class="reset">Reset filters →</a>
        </p>
      </div>

      <div class="dp-finder-next" id="finder-next">
        <a
          id="finder-compare"
          class="dp-ui-action dp-ui-secondary"
          href={`/cards/compare/?cards=${defaultCompareSlugs.join(",")}`}
          hidden={defaultCompareSlugs.length < 2}
        >Compare top {defaultCompareSlugs.length} →</a>
        <button type="button" id="finder-share" class="dp-ui-action dp-ui-quiet" hidden>Copy results link</button>
        <span id="finder-share-status" role="status" aria-live="polite"></span>
      </div>

      <div class="dp-finder-value-context">
        <CardValueScenario id="finder-card-value" compact />
      </div>

      <div class="dp-finder-grid" id="finder-grid">
        {initialOrder.map(({ card, evidence }) => (
          <div
            class="dp-finder-tile"
            data-slug={card.slug}
            hidden={!defaultRank.has(card.slug)}
          >
            <SpecCard card={card} variant="full">
              <Fragment slot="match-explanation">
              <div class="dp-finder-match">
                <p class="dp-finder-match-preference" data-finder-match hidden></p>
                <details>
                  <summary>Why this card matched<span class="dp-finder-match-sr">: {card.name}</span></summary>
                  <dl>
                    <div>
                      <dt>Ranking</dt>
                      <dd data-finder-ranking>General spending: {evidence.earnLabels.everythingElse ?? "rate needs confirmation"}.</dd>
                    </div>
                    <div>
                      <dt>Filters</dt>
                      <dd data-finder-filters>No salary, network or fee filter applied.</dd>
                    </div>
                    <div>
                      <dt>Check before applying</dt>
                      <dd>
                        <ul data-finder-checks>
                          {[...evidence.feeNotes, ...evidence.capNotes, evidence.categoryCaps.everythingElse, card.eligibility.salaryTransferRequired ? "Salary transfer required." : ""].filter(Boolean).map((check) => <li>{check}</li>)}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                  {evidence.sourceUrl && <a href={evidence.sourceUrl}>Check issuer terms <span aria-hidden="true">↗</span></a>}
                </details>
              </div>
              <CardValueLines card={card} slug={card.slug} />
              </Fragment>
            </SpecCard>
          </div>
        ))}
      </div>
    </div>

    <footer class="dp-finder-foot">
      <p>
        DubaiPoints earns no commission on these recommendations.
        Affiliate disclosure is governed by our
        <a href="/editorial-policy/">editorial policy</a>.
      </p>
    </footer>
  </section>
</BaseLayout>

<script is:inline type="application/json" id="finder-card-index" set:html={JSON.stringify(cardIndex).replace(/</g, "\\u003c")}></script>
<script
  is:inline
  type="application/json"
  id="finder-options"
  set:html={JSON.stringify({
    spend: SPEND_OPTIONS.map((o) => o.value),
    spendLabels: Object.fromEntries(SPEND_OPTIONS.map((o) => [o.value, o.label])),
    prefer: PREFER_OPTIONS.map((o) => o.value),
    preferLabels: Object.fromEntries(PREFER_OPTIONS.map((o) => [o.value, o.label])),
    network: NETWORK_OPTIONS.map((o) => o.value),
    fee: FEE_OPTIONS.map((o) => o.value),
    feeLabels: Object.fromEntries(FEE_OPTIONS.map((o) => [o.value, o.label])),
  })}
></script>

<script is:inline>
  // ── Client-side ranker — runs on page load and re-reads on form submit.
  // Mirrors the server-side score formula documented at the top of the file.
  (function () {
    var idxEl = document.getElementById("finder-card-index");
    if (!idxEl) return;
    var CARDS = JSON.parse(idxEl.textContent || "[]");

    var grid = document.getElementById("finder-grid");
    var count = document.getElementById("finder-count");
    var mode = document.getElementById("finder-mode");
    var empty = document.getElementById("finder-empty");
    if (!grid || !count || !mode || !empty) return;

    // A query-string value that is not one of the offered options used to
    // reach the filter unchanged: /cards/finder/?network=visa (lowercase)
    // matched no card, so the reader saw an empty result set while the
    // control still read "Any" and nothing on the page explained why.
    // An unrecognised value now falls back to the default, which is what
    // the control shows.
    var optEl = document.getElementById("finder-options");
    var OPTIONS = JSON.parse((optEl && optEl.textContent) || "{}");
    function oneOf(name, value, fallback) {
      var allowed = OPTIONS[name];
      return allowed && allowed.indexOf(value) >= 0 ? value : fallback;
    }

    function readParams() {
      var p = new URLSearchParams(window.location.search);
      return {
        salary: parseInt(p.get("salary") || "", 10),
        spend: oneOf("spend", p.get("spend") || "general", "general"),
        prefer: oneOf("prefer", p.get("prefer") || "none", "none"),
        network: oneOf("network", p.get("network") || "any", "any"),
        fee: oneOf("fee", p.get("fee") || "any", "any"),
        includeInviteOnly: p.get("include_invite_only") === "true",
        includeLegacy: (p.get("include_legacy") || "false") === "true",
      };
    }

    // MIRROR: verbatim JS copy of loyaltyTag() in
    // src/lib/cardsDataFormat.ts (this inline script runs without
    // imports). Change both together; the TS one is unit-tested.
    function loyaltyTag(loyalty) {
      var l = (loyalty || "").toLowerCase();
      if (
        l.indexOf("cashback") >= 0 ||
        l.indexOf("aed") >= 0 ||
        l === ""
      )
        return "cashback";
      if (
        l.indexOf("skywards") >= 0 ||
        l.indexOf("etihad") >= 0 ||
        l.indexOf("avios") >= 0 ||
        l.indexOf("alfursan") >= 0 ||
        l.indexOf("miles") >= 0
      )
        return "miles";
      return "points";
    }

    function feeMatches(annualFee, bucket) {
      if (bucket === "any") return true;
      if (bucket === "free") return annualFee === 0;
      if (bucket === "under-500") return annualFee < 500;
      if (bucket === "under-1000") return annualFee < 1000;
      return true;
    }

    function spendBasis(rates, key) {
      if (key !== "general" && typeof rates[key] === "number") {
        return { key: key, value: rates[key] };
      }
      return { key: "everythingElse", value: rates.everythingElse || 0 };
    }

    function matchesPreference(card, prefer) {
      if (prefer === "none") return false;
      if (prefer === "lounges") return card.hasLounge;
      if (prefer === "status") return card.hasStatus;
      return loyaltyTag(card.loyaltyProgram) === prefer;
    }

    function apply() {
      var p = readParams();
      var hasSalary = !isNaN(p.salary) && p.salary > 0;

      var ranked = CARDS.filter(function (c) {
        if (hasSalary && c.minSalary > p.salary) return false;
        if (p.network !== "any" && c.network !== p.network) return false;
        if (!feeMatches(c.annualFee, p.fee)) return false;
        // Invitation-only products enter the shortlist only on opt-in.
        if (!p.includeInviteOnly && c.invitationOnly) return false;
        // Phase 2a.0: discontinued cards filtered out by default; reader
        // opts in via the "Include legacy cards" checkbox.
        if (!p.includeLegacy && c.discontinued) return false;
        return true;
      })
        .map(function (c) {
          var basis = spendBasis(c.earnRates, p.spend);
          return {
            slug: c.slug,
            preferred: matchesPreference(c, p.prefer),
            invitationOnly: c.invitationOnly,
            card: c,
            basis: basis,
            score: basis.value,
            annualFee: c.annualFee,
          };
        })
        .sort(function (a, b) {
          if (b.preferred !== a.preferred) return Number(b.preferred) - Number(a.preferred);
          if (b.score !== a.score) return b.score - a.score;
          return a.annualFee - b.annualFee;
        });

      var top = ranked.slice(0, 6);
      var topSlugs = top.map(function (r) {
        return r.slug;
      });
      var bySlug = new Map();
      grid.querySelectorAll(".dp-finder-tile[data-slug]").forEach(function (tile) {
        bySlug.set(tile.getAttribute("data-slug"), tile);
        tile.hidden = true;
      });
      var preferenceLabel = OPTIONS.preferLabels[p.prefer];
      var spendLabel = p.spend === "general" ? "general spending" : OPTIONS.spendLabels[p.spend].toLowerCase();
      var visibleTiles = top.map(function (r) {
        var tile = bySlug.get(r.slug);
        var note = tile.querySelector("[data-finder-match]");
        var labels = [];
        if (r.invitationOnly) labels.push("Invitation only");
        if (p.prefer !== "none") {
          labels.push(r.preferred ? "Matches your preference: " + preferenceLabel : "Different reward or benefit");
        }
        note.textContent = labels.join(" · ");
        note.hidden = labels.length === 0;

        var card = r.card;
        var evidence = card.evidence;
        var rate = evidence.earnLabels[r.basis.key] || "rate needs confirmation";
        var ranking = p.spend === "general" ? "General spending: " + rate + "."
          : r.basis.key === "everythingElse"
            ? "No separate rate listed for " + spendLabel + "; general-spending rate used: " + rate + "."
            : OPTIONS.spendLabels[p.spend] + ": " + rate + ".";
        tile.querySelector("[data-finder-ranking]").textContent = ranking;

        var applied = [];
        if (hasSalary) {
          if (card.invitationOnly || evidence.salaryPending) {
            applied.push("Confirm salary and eligibility with the bank.");
          } else if (evidence.salaryLabel) {
            applied.push("Meets the listed salary minimum of " + evidence.salaryLabel + " a month.");
          } else {
            applied.push("No positive salary minimum is listed.");
          }
        }
        if (p.network !== "any") applied.push("Network: " + p.network + ".");
        if (p.fee !== "any") {
          applied.push("Fee filter: " + OPTIONS.feeLabels[p.fee] + (evidence.feeExcludesVat ? " (before VAT)." : "."));
        }
        tile.querySelector("[data-finder-filters]").textContent = applied.length ? applied.join(" ") : "No salary, network or fee filter applied.";

        var checks = evidence.feeNotes.concat(evidence.capNotes);
        var categoryCap = evidence.categoryCaps[p.spend === "general" ? "everythingElse" : p.spend];
        if (categoryCap) checks.push(categoryCap);
        if (card.salaryTransferRequired) checks.push("Salary transfer required.");
        if (card.invitationOnly) checks.push("The bank must invite you.");
        if (card.discontinued) checks.push("Closed to new applicants.");
        if (r.preferred && p.prefer === "lounges") checks.push("Check visit limits and qualifying spend in the issuer terms.");
        if (r.preferred && p.prefer === "status") checks.push("Check the status period and renewal conditions.");
        tile.querySelector("[data-finder-checks]").replaceChildren(...checks.map(function (check) {
          var item = document.createElement("li");
          item.textContent = check;
          return item;
        }));
        tile.hidden = false;
        return tile;
      });
      // Move the actual elements in ranked order, not merely the grid cells.
      grid.prepend.apply(grid, visibleTiles);

      count.textContent = ranked.length === 0
        ? "No cards meet your filters"
        : "Showing " + visibleTiles.length + " of " + ranked.length + (ranked.length === 1 ? " card that meets" : " cards that meet") + " your filters";
      var compareLink = document.getElementById("finder-compare");
      if (compareLink) {
        var top3 = topSlugs.slice(0, 3);
        compareLink.href = "/cards/compare/?cards=" + top3.join(",");
        compareLink.textContent = "Compare top " + top3.length + " →";
        compareLink.hidden = top3.length < 2;
      }
      mode.textContent = (p.prefer !== "none" ? preferenceLabel + " matches first. " : "")
        + "Ordered by published earn rate for " + spendLabel
        + (p.spend === "general" ? "" : " (general rate where no separate rate is listed)")
        + ", then lower annual fee. Rates use different units. The order is not based on the AED examples and is not an approval decision.";
      mode.hidden = visibleTiles.length === 0;

      if (visibleTiles.length === 0) {
        empty.hidden = false;
        grid.hidden = true;
      } else {
        empty.hidden = true;
        grid.hidden = false;
      }
    }

    // The static build emits the form's default state, so on a shared or
    // bookmarked URL the results were filtered by the query string while
    // every control still showed its default — the reader could not see
    // what was being applied, or change one filter without silently
    // resetting the rest (2026-09-06 audit, F-039).
    function syncControls(p) {
      var form = document.getElementById("finder-form");
      if (!form) return;
      var salary = form.querySelector('input[name="salary"]');
      if (salary) salary.value = isNaN(p.salary) || p.salary <= 0 ? "" : String(p.salary);
      var prefer = form.querySelector('select[name="prefer"]');
      if (prefer) prefer.value = p.prefer;
      var more = document.getElementById("finder-more");
      if (more && (p.spend !== "general" || p.network !== "any" || p.fee !== "any" || p.includeInviteOnly || p.includeLegacy)) more.open = true;
      [["spend", p.spend], ["network", p.network], ["fee", p.fee]]
        .forEach(function (pair) {
          var el = form.querySelector(
            'input[name="' + pair[0] + '"][value="' + pair[1] + '"]',
          );
          if (el) el.checked = true;
        });
      var invite = form.querySelector('select[name="include_invite_only"]');
      if (invite) invite.value = String(p.includeInviteOnly);
      var legacy = form.querySelector('input[name="include_legacy"]');
      if (legacy) legacy.checked = p.includeLegacy;
    }

    var initial = readParams();
    var filters = document.getElementById("finder-filters");
    if (filters instanceof HTMLDetailsElement) {
      var compactFilters = window.matchMedia("(max-width: 820px)");
      var activeFilters = initial.salary > 0 || initial.prefer !== "none" || initial.spend !== "general"
        || initial.network !== "any" || initial.fee !== "any" || initial.includeInviteOnly || initial.includeLegacy;
      // Default results are immediately visible on phones. Shared filters
      // stay exposed. Without JS, the native disclosure can still open.
      filters.open = !compactFilters.matches || activeFilters;
      compactFilters.addEventListener("change", function () {
        if (!compactFilters.matches) filters.open = true;
      });
    }
    syncControls(initial);
    apply();

    // The form submits by GET, so the address bar already holds the
    // reader's filters; this copies it so a result can be saved or sent.
    var share = document.getElementById("finder-share");
    var shareStatus = document.getElementById("finder-share-status");
    if (share && navigator.clipboard) {
      share.hidden = false;
      share.addEventListener("click", function () {
        navigator.clipboard.writeText(window.location.href).then(
          function () { if (shareStatus) shareStatus.textContent = "Link copied"; },
          function () { if (shareStatus) shareStatus.textContent = "Copy the address bar to save these results"; }
        );
        window.setTimeout(function () { if (shareStatus) shareStatus.textContent = ""; }, 2500);
      });
    }
  })();
</script>

