---
// Card finder — filter-driven chooser for every UAE card we cover.
//
// Stage 4–7 (Tech) workstream of the card-data-audit-and-ui-programme.
// The form is a GET form posting back to itself; the URL is the
// shareable state. Because this site builds with `output: "static"`,
// the actual ranking + filtering executes in a small inline script
// on page load. All cards render at build time with data-*
// attributes; the script reorders + hides DOM nodes.
//
// Filter on published minimum salary, network, fee and availability.
// Rank reward/benefit matches first, then published spend-category rate
// (or general rate if no category rate is listed), then lower annual fee.
// This is a shortlist heuristic, not a common AED valuation or approval.
//
// Top 6 cards displayed as SpecCard variant="full".

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import { finderEvidence } from "~/lib/finderEvidence";
import FinderCard from "~/components/cards/FinderCard.astro";
import CardJourney from "~/components/cards/CardJourney.astro";
import CardValueLines from "~/components/cards/CardValueLines.astro";
import CardValueScenario from "~/components/cards/CardValueScenario.astro";
import CardSelectionTray from "~/components/cards/CardSelectionTray.astro";
import FinderFilterTokens from "~/components/cards/FinderFilterTokens.astro";
import { cardFinderState } from "~/lib/readerJourneyState";
import { eligibleForSalaryFilter } from "~/lib/cardSelection";
import { cardHasKnownFeature } from "~/lib/cardsDataFormat";
import { compareKnownAnnualFees } from "~/lib/cardFeeProvenance";

const allCards = getActiveCards();

// Resolve bank-collection display names up-front so the SpecCards
// don't need to await inside the .map (which works in Astro but is
// noisier).
const cardsWithBanks = await Promise.all(
  allCards.map(async (card) => {
    const bank = await getEntry("banks", card.bank);
    return { card, bankName: bank?.data.name ?? card.bank, evidence: finderEvidence(card) };
  }),
);

// Read URL params for initial form state (works in dev / SSR; static
// build emits defaults — the inline script re-reads at runtime).
const params = Astro.url.searchParams;
const appliedInit = cardFinderState(params);
const salaryInit = appliedInit.salary ?? "";
const spendInit = appliedInit.spend;
const preferInit = appliedInit.prefer;
const networkInit = appliedInit.network;
const feeInit = appliedInit.fee;
// Keep explicit true/false values on existing shared links; a bare URL
// starts with cards that do not require an invitation.
const includeInviteOnlyInit = appliedInit.includeInviteOnly;
const includeLegacyInit = appliedInit.includeLegacy;

// Serialise card data for the client-side ranker.
const cardIndex = cardsWithBanks.map(({ card, evidence }) => ({
  slug: card.slug,
  name: card.name,
  bank: card.bank,
  network: card.network,
  annualFee: evidence.annualFeePending ? null : card.annualFee.amount,
  minSalary: eligibleForSalaryFilter(card._provenance, card.eligibility.minSalary) ? card.eligibility.minSalary : null,
  eligibleForSalaryFilter: eligibleForSalaryFilter(card._provenance, card.eligibility.minSalary),
  salaryTransferRequired: card._provenance?.eligibility === "needs-review" || card._provenance?.["eligibility.salaryTransferRequired"] === "needs-review" ? null : card.eligibility.salaryTransferRequired,
  invitationOnly: card._provenance?.eligibility !== "needs-review" && card._provenance?.["eligibility.invitationOnly"] !== "needs-review" && card.eligibility.invitationOnly === true,
  discontinued: card.discontinuedForNewApplicants !== undefined,
  loyaltyProgram: card.loyaltyProgram ?? "",
  earnRates: evidence.rankRates,
  hasLounge: cardHasKnownFeature(card, "lounge_access"),
  hasStatus: cardHasKnownFeature(card, "status_match"),
  evidence,
}));

const SPEND_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "dining", label: "Dining" },
  { value: "groceries", label: "Groceries" },
  { value: "travel", label: "Travel" },
  { value: "fuel", label: "Fuel" },
  { value: "online", label: "Online shopping" },
  { value: "general", label: "General / mixed" },
];
const PREFER_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "cashback", label: "AED cashback" },
  { value: "miles", label: "Airline miles" },
  { value: "points", label: "Other points and credits" },
  { value: "lounges", label: "Airport lounges" },
  { value: "status", label: "Hotel / airline status" },
  { value: "none", label: "No preference" },
];
const NETWORK_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "any", label: "Any" },
  { value: "Visa", label: "Visa" },
  { value: "Mastercard", label: "Mastercard" },
  { value: "Amex", label: "Amex" },
];
const FEE_OPTIONS: Array<{ value: string; label: string }> = [
  { value: "any", label: "Any" },
  { value: "free", label: "Free only" },
  { value: "under-500", label: "Under AED 500" },
  { value: "under-1000", label: "Under AED 1,000" },
];

// The grid used to paint all 58 tiles and then have the inline script hide
// all but six about 160 ms later, collapsing the page by tens of rows:
// CLS 0.248 at 1280px (2026-09-06 audit, F-027). It measures 0 at 390px,
// where the single-column grid puts the hidden rows below the fold, which
// is why a mobile-only check misses it.
//
// So the six the script will choose on a bare /cards/finder/ are marked
// here and the rest start hidden. With no query string the default filter
// keeps publicly available cards open to new applicants and the default score
// reduces to the "everything else" earn rate — spend "general" reads that
// rate and prefer "none" adds no bonus — with annual fee as the
// tie-break, exactly as score() and apply() do in the inline script
// below. Change one, change the other; the assertion in
// tests/cards/finder-default-six.test.ts fails if they drift.
const defaultCandidates = cardsWithBanks.filter(
  ({ card }) => card.discontinuedForNewApplicants === undefined && card.eligibility.invitationOnly !== true,
);
const defaultTopSlugs = defaultCandidates
  .map(({ card, evidence }) => ({
    slug: card.slug,
    score: evidence.fallbackPending ? null : card.earnRates.everythingElse ?? null,
    annualFee: evidence.annualFeePending ? null : card.annualFee.amount,
  }))
  .sort((a, b) => a.score === null || b.score === null
    ? a.score === b.score ? compareKnownAnnualFees(a.annualFee, b.annualFee) : a.score === null ? 1 : -1
    : b.score !== a.score ? b.score - a.score : compareKnownAnnualFees(a.annualFee, b.annualFee))
  .slice(0, 6)
  .map((c) => c.slug);

// Put the default shortlist into rank in the HTML itself. CSS-only order
// makes focus and screen-reader order disagree with the displayed ranking.
const defaultRank = new Map(defaultTopSlugs.map((slug, i) => [slug, i]));
const initialOrder = [...cardsWithBanks].sort(
  (a, b) => (defaultRank.get(a.card.slug) ?? Infinity) - (defaultRank.get(b.card.slug) ?? Infinity),
);
const defaultCompareSlugs = defaultTopSlugs.slice(0, 3);

// "Last refreshed" stamp computed from the newest L2 lastVerified so the
// stats strip can never go stale (10 June 2026 staleness sweep — the
// previous hardcoded "20 May 2026" had been overtaken by three L2
// refreshes).
const lastRefreshed = new Date(
  Math.max(...allCards.map((c) => new Date(c.lastVerified).getTime())),
).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---

<BaseLayout
  title="Find your UAE credit card | DubaiPoints"
  description={`Tell us your AED salary, primary spend category, and what you're optimising for. We'll rank the ${allCards.length} UAE cards in our database against your profile.`}
  fullWidth
>
  <div class="dp-pagehead dp-finder-head">
    <div class="crumb">DubaiPoints / Cards / Finder</div>
    <h1>Find your card</h1>
    <p>Shortlist UAE cards by salary, rewards and the way you spend.</p>
    {/* Stage 5.5 UX Fix #6: visual anchor above the fold. Matches the
        stats-strip pattern used on the compare page so the two tool
        pages read as one publication. */}
    <details class="dp-finder-coverage">
      <summary>{allCards.length} cards · coverage and methodology</summary>
    <div class="dp-tools-stats">
      <span>
        <span class="lbl">Cards covered</span>
        <strong>{allCards.length}</strong>
      </span>
      <span>
        <span class="lbl">Last refreshed</span>
        <strong>{lastRefreshed}</strong>
      </span>
      <span>
        <span class="lbl">Methodology</span>
        <strong><a href="/editorial-policy/">Read &rarr;</a></strong>
      </span>
    </div>
    </details>
  </div>

  <CardJourney />

  <section class="dp-finder">
    {/* Compact layouts can collapse the filters; a sidebar always shows
        them, including when the window is resized from a collapsed view. */}
    <details class="dp-finder-formwrap" id="finder-filters">
      <summary class="dp-finder-formwrap-summary">
        <span class="dp-finder-formwrap-title">Filter cards</span>
        <span class="dp-finder-formwrap-hint" data-finder-applied-count>Salary, spend, preference</span>
      </summary>
      <script is:inline data-finder-initial-disclosure>
        // Set the desktop disclosure before the browser parses its content.
        // Mobile default remains closed even if the rest of the document is slow.
        if (!window.matchMedia("(max-width: 820px)").matches) {
          document.currentScript.parentElement.open = true;
        }
      </script>
      <div class="dp-finder-guide" data-finder-guide hidden>
        <button type="button" class="dp-ui-action dp-ui-secondary" data-guide-start>Help me choose</button>
        <div data-guide-controls hidden>
          <p data-guide-label></p>
          <button type="button" class="dp-ui-action dp-ui-quiet" data-guide-back>Back</button>
          <button type="button" class="dp-ui-action dp-ui-quiet" data-guide-skip hidden>Skip salary</button>
          <button type="button" class="dp-ui-action dp-ui-secondary" data-guide-next>Next</button>
          <button type="button" class="dp-ui-action dp-ui-quiet" data-guide-all>Show all filters</button>
        </div>
      </div>
      <form method="get" action="/cards/finder/" class="dp-finder-form" id="finder-form">
        <fieldset class="dp-finder-fs is-salary" data-guide-step="eligibility">
          <legend>Your monthly salary (AED)</legend>
          <input
            class="dp-ui-field"
            type="number"
            name="salary"
            aria-label="Your monthly salary (AED)"
            aria-describedby="finder-salary-hint"
            inputmode="numeric"
            placeholder="e.g. 15,000"
            min="0"
            step="1"
            value={salaryInit}
          />
          <p class="hint" id="finder-salary-hint">
            Leave blank to skip the salary filter. Published minimums
            are not a guarantee of approval.
          </p>
        </fieldset>

        <fieldset class="dp-finder-fs" data-guide-step="goal">
          <legend>Reward preference</legend>
          <select class="dp-ui-field" name="prefer" aria-label="Reward preference">
            {PREFER_OPTIONS.map((opt) => <option value={opt.value} selected={preferInit === opt.value}>{opt.label}</option>)}
          </select>
        </fieldset>

        <div class="dp-finder-actions">
          <button type="submit" class="dp-ui-action dp-ui-primary">Rank cards</button>
          <a href="/cards/finder/" class="dp-ui-action dp-ui-quiet" data-clear-card-filters data-card-journey-reset>Clear filters</a>
        </div>

        <details class="dp-finder-more" id="finder-more">
          <summary>More filters · spending, network and fees</summary>
        <fieldset class="dp-finder-fs">
          <legend>Primary spend category</legend>
          <div class="dp-finder-radios">
            {SPEND_OPTIONS.map((opt) => (
              <label>
                <input
                  type="radio"
                  name="spend"
                  value={opt.value}
                  checked={spendInit === opt.value}
                />
                <span>{opt.label}</span>
              </label>
            ))}
          </div>
        </fieldset>

        {/* Stage 5.5 UX Fix #8: combine "Card network" + "Annual fee" into
            a single .dp-finder-fs-row. Reduces the form from 5 sections
            to 4. Both are narrow inline-radio fieldsets serving the
            secondary-filter role. */}
        <div class="dp-finder-fs-row">
          <fieldset class="dp-finder-fs" data-guide-step="refine">
            <legend>Card network</legend>
            <div class="dp-finder-radios is-inline">
              {NETWORK_OPTIONS.map((opt) => (
                <label>
                  <input
                    type="radio"
                    name="network"
                    value={opt.value}
                    checked={networkInit === opt.value}
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <fieldset class="dp-finder-fs">
            <legend>Annual fee</legend>
            <div class="dp-finder-radios is-inline">
              {FEE_OPTIONS.map((opt) => (
                <label>
                  <input
                    type="radio"
                    name="fee"
                    value={opt.value}
                    checked={feeInit === opt.value}
                  />
                  <span>{opt.label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>

        {/* Optional availability filters share one row. */}
        <div class="dp-finder-fs-row">
          <fieldset class="dp-finder-fs">
            <legend>Invitation-only cards</legend>
            <select class="dp-ui-field" name="include_invite_only" aria-label="Invitation-only cards">
              <option value="false" selected={!includeInviteOnlyInit}>Exclude</option>
              <option value="true" selected={includeInviteOnlyInit}>Include</option>
            </select>
          </fieldset>

          <fieldset class="dp-finder-fs">
            <legend>Archived products</legend>
            <p class="hint">Archived cards are reference-only, not included in these recommendations.</p>
            {includeLegacyInit && <input type="hidden" name="include_legacy" value="true" data-card-journey-field />}
          </fieldset>
        </div>

          <div class="dp-finder-actions"><button type="submit" class="dp-ui-action dp-ui-primary">Apply all filters</button></div>
        </details>
      </form>
      <div class="dp-finder-value-context">
        <CardValueScenario id="finder-card-value" compact />
      </div>
    </details>

    <div class="dp-finder-results" id="finder-results">
      <div class="dp-finder-results-head">
        <h2>Matching cards</h2>
        <noscript><p class="count">JavaScript is off. These are the default cards, not personalised results from the URL. You can open the filters and browse the full <a href="/cards/">card directory</a> or individual reviews.</p></noscript>
        <p class="count" id="finder-count">
          Showing {defaultTopSlugs.length} of {defaultCandidates.length} cards that meet your filters
        </p>
        <p class="count">Rate order, not approval or an AED-return ranking.</p>
        <details class="dp-finder-ranking-details">
          <summary>How these cards are ordered</summary>
        <p class="count" id="finder-mode">
          Ordered by published earn rate for general spending, then lower annual fee.
          Rates use different units. The order is not based on the AED examples and is not an approval decision.
        </p>
        </details>
      </div>

      <FinderFilterTokens />
      <CardSelectionTray />

      <div class="dp-finder-empty" id="finder-empty" hidden>
        <p>
          No cards match these filters. Check your salary entry or try
          setting the network or annual fee to "Any".
        </p>
        <p>
          <a href="/cards/finder/" class="dp-ui-action dp-ui-secondary reset" data-clear-card-filters data-card-journey-reset>Reset filters →</a>
        </p>
      </div>

      <div class="dp-finder-next" id="finder-next">
        <a
          id="finder-compare"
          data-card-journey-reset
          class="dp-ui-action dp-ui-secondary"
          href={`/cards/compare/?cards=${defaultCompareSlugs.join(",")}`}
          hidden={defaultCompareSlugs.length < 2}
        >Compare top {defaultCompareSlugs.length} →</a>
        <button type="button" id="finder-share" class="dp-ui-action dp-ui-quiet" hidden>Copy results link</button>
        <span id="finder-share-status" role="status" aria-live="polite"></span>
        <p class="dp-finder-share-notice">Shared links include salary and spending choices. Share only if you want to.</p>
      </div>

      <div class="dp-finder-grid" id="finder-grid">
        {initialOrder.map(({ card, bankName, evidence }) => (
          <div
            class="dp-finder-tile"
            data-slug={card.slug}
            hidden={!defaultRank.has(card.slug)}
          >
            <FinderCard card={card} bankName={bankName}>
              <div slot="match-summary" class="dp-finder-match-summary">
                <p class="dp-finder-match-preference" data-finder-match hidden></p>
                <p data-finder-ranking>General spending: {evidence.earnLabels.everythingElse ?? "rate needs confirmation"}.</p>
              </div>
              <Fragment slot="match-explanation">
              <div class="dp-finder-match">
                <details>
                  <summary>Why this card matched<span class="dp-finder-match-sr">: {card.name}</span></summary>
                  <dl>
                    <div>
                      <dt>Filters</dt>
                      <dd data-finder-filters>No salary, network or fee filter applied.</dd>
                    </div>
                    <div>
                      <dt>Check before applying</dt>
                      <dd>
                        <ul data-finder-checks>
                          {[...evidence.feeNotes, ...evidence.capNotes, evidence.categoryCaps.everythingElse, card._provenance?.eligibility !== "needs-review" && card._provenance?.["eligibility.salaryTransferRequired"] !== "needs-review" && card.eligibility.salaryTransferRequired ? "Salary transfer required." : ""].filter(Boolean).map((check) => <li>{check}</li>)}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                  {evidence.sourceUrl && <a href={evidence.sourceUrl}>Check issuer terms <span aria-hidden="true">↗</span></a>}
                </details>
              </div>
              <CardValueLines card={card} slug={card.slug} />
              </Fragment>
            </FinderCard>
          </div>
        ))}
      </div>
    </div>

    <footer class="dp-finder-foot">
      <p>
        DubaiPoints earns no commission on these recommendations.
        Affiliate disclosure is governed by our
        <a href="/editorial-policy/">editorial policy</a>.
      </p>
    </footer>
  </section>
</BaseLayout>

<script is:inline type="application/json" id="finder-card-index" set:html={JSON.stringify(cardIndex).replace(/</g, "\\u003c")}></script>
<script
  is:inline
  type="application/json"
  id="finder-options"
  set:html={JSON.stringify({
    spend: SPEND_OPTIONS.map((o) => o.value),
    spendLabels: Object.fromEntries(SPEND_OPTIONS.map((o) => [o.value, o.label])),
    prefer: PREFER_OPTIONS.map((o) => o.value),
    preferLabels: Object.fromEntries(PREFER_OPTIONS.map((o) => [o.value, o.label])),
    network: NETWORK_OPTIONS.map((o) => o.value),
    fee: FEE_OPTIONS.map((o) => o.value),
    feeLabels: Object.fromEntries(FEE_OPTIONS.map((o) => [o.value, o.label])),
  })}
></script>

<script>
  import { initialiseCardFinder } from "~/scripts/cardFinder.mjs";
  import { initialiseCardSelection } from "~/scripts/cardSelection";
  import { initialiseFinderGuide } from "~/scripts/finderGuide";
  initialiseCardSelection();
  initialiseCardFinder();
  initialiseFinderGuide();
</script>

<style>
  .dp-finder-coverage { margin-block-start: 10px; }
  .dp-finder-coverage > summary, .dp-finder-ranking-details > summary {
    min-height: 44px; align-content: center; cursor: pointer; color: var(--green); font: 600 .8125rem/1.4 var(--font-ui);
  }
  .dp-finder-coverage > summary:focus-visible, .dp-finder-ranking-details > summary:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .dp-finder-coverage[open] { padding-block-end: 8px; }
  .dp-finder-coverage .dp-tools-stats { margin-block-start: 8px; }
  .dp-finder-ranking-details { margin-block-start: 4px; }
  .dp-finder-value-context { padding: 0 16px 16px; }
  .dp-finder-more > summary {
    cursor: pointer;
    min-height: 44px;
    color: var(--green);
    font-weight: 600;
    padding-block: 10px;
  }
  .dp-finder-match-summary { font: 500 .8125rem/1.45 var(--font-ui); color: var(--ink-soft); }
  .dp-finder-match-summary p { margin: 0; }
  .dp-finder-match-summary p + p { margin-block-start: 4px; }
  .dp-finder-more > :not(summary) { margin-block-start: 16px; }
  .dp-finder-fs select {
    width: 100%;
  }
  @media (max-width: 640px) {
    .dp-finder-head { padding-block: 24px 18px; }
    .dp-finder-head .dp-tools-stats { margin-block-start: 12px; }
  }
  .dp-finder-next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 8px;
    margin: 0 0 12px;
    font-family: var(--font-ui);
    font-size: 15px;
  }
  .dp-finder-next [hidden] { display: none; }
  #finder-share-status:empty { position: absolute; }
  #finder-share-status { font-size: 13px; color: var(--green); font-weight: 600; }
  .dp-finder-share-notice { flex-basis: 100%; margin: 2px 0 0; color: var(--ink-soft); font: 400 .8125rem/1.45 var(--font-ui); }

  .dp-finder {
    max-width: var(--container-listing);
    margin: 32px auto 56px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: minmax(280px, 320px) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }

  /* ── Form wrapper (mobile <details> collapse) ─────────────────── */
  .dp-finder-formwrap { min-width: 0; }
  .dp-finder-formwrap[open] > .dp-finder-formwrap-summary {
    display: none;
  }
  .dp-finder-formwrap-summary {
    min-block-size: var(--dp-ui-control, 44px);
    cursor: pointer;
    align-content: center;
  }

  /* ── Form ─────────────────────────────────────────────────────── */
  .dp-finder-form {
    position: sticky;
    top: 24px;
    display: grid;
    gap: 24px;
    padding: 24px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-family: var(--font-ui);
  }
  /* Stage 5.5 UX Fix #8: combined network + fee fieldsets share a row. */
  .dp-finder-fs-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .dp-finder-fs {
    border: 0;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
    min-inline-size: 0;
  }
  .dp-finder-fs legend {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.8px;
    text-transform: uppercase;
    color: var(--muted);
    padding: 0;
    margin-bottom: 4px;
  }
  .dp-finder-fs input[type="number"] {
    font-size: 16px;
    width: 100%;
  }
  .dp-finder-fs .hint {
    font-size: 12px;
    color: var(--ink-soft);
    line-height: 1.4;
    margin: 0;
  }
  .dp-finder-radios {
    display: grid;
    gap: 4px;
  }
  .dp-finder-radios.is-inline {
    grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    gap: 4px 8px;
  }
  .dp-finder-radios label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
    padding: 8px;
    min-block-size: 44px;
    border: 1px solid transparent;
    border-radius: var(--dp-ui-radius-small, 6px);
  }
  .dp-finder-radios input {
    accent-color: var(--green);
    flex: none;
    inline-size: 16px;
    block-size: 16px;
    margin: 0;
  }
  .dp-finder-radios label:has(input:checked) { border-color: var(--line); background: var(--shade-1); font-weight: 600; }
  .dp-finder-radios label:has(input:focus-visible), .dp-finder-checkbox:has(input:focus-visible) { outline: 2px solid var(--green); outline-offset: 2px; }
  .dp-finder-radios label:hover { border-color: var(--line); }
  /* Phase 2a.0: include/exclude checkboxes for invitation-only +
     discontinued. Renders inline with the other inline-radios. */
  .dp-finder-checkbox {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--ink);
