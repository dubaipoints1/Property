---
import { cardHasUnresolvedTerms } from "~/lib/cardEligibility";
// Cards index — Phase F (May 2026 mockup-fidelity rebuild).
// Reference: Replit Canvas mockup, page 02 (Credit Cards).
//
// Composition mirrors the mockup top-to-bottom:
//   1. Page header (title + subtitle)
//   2. Top Picks — 2 featured cards side-by-side (image + welcome-bonus
//      highlighted in green + annual fee + Read review CTA)
//   3. Compare All Cards header + filter pills + Sort
//   4. Card rows — list view: image | bank+name | welcome bonus | annual
//      fee | earn rate | perks | Read review
//   5. Editorial callout (dark band): "Not sure which card is right?"
//      + 2 secondary CTAs into existing /guides/
//
// Charter notes
// ─────────────
//   - No "Apply Now" CTAs anywhere. STATUS.md 2026-05-08-bis ruling.
//     Mockup shows "Apply Now"; we ship "Read review" (Top Picks) and
//     "Compare →" (list rows).
//   - Filter taxonomy preserved: All / Cashback / Miles / Islamic /
//     Compare. Mockup adds "Hotel Points" — we don't have a Hotel Points
//     content collection or matching filter route, so we don't fabricate
//     one. The Charter §"slug rename" gate covers fictional category
//     additions too.
//   - Welcome bonus highlighted via `--green` token (Charter §"two-accent
//     system"); annual fee uses `--ink`. No new colour utilities.

import { PERK_PAGES } from "~/data/perkPages";
import { collectionPageGraph, breadcrumbGraph, siteUrlFrom } from "~/lib/schema";
import { verifiedMonthStamp } from "~/lib/cardsDataFormat";
import { cardsTracked, banksCovered } from "~/lib/trustFacts";
import BaseLayout from "~/layouts/BaseLayout.astro";
import CardImage from "~/components/CardImage.astro";
import CardsIndexDeferredArt from "~/components/CardsIndexDeferredArt.astro";
import { getCardArt } from "~/lib/cardArt";
import { getEntry } from "astro:content";
import {
  getActiveCards,
  welcomeBonusHeadline,
  FEATURE_CHIP_LABELS,
  annualFeeLabel,
} from "~/lib/cardsData";
import { compareByWelcomeValue, formatEarnRate, earnRateFieldPending, cardFeatureNeedsReview } from "~/lib/cardsDataFormat";

const cards = await Promise.all(
  getActiveCards()
    .sort(compareByWelcomeValue)
    .map(async (card) => {
      const bank = await getEntry("banks", card.bank);
      return { card, bankName: bank?.data.name ?? card.bank };
    }),
);

const verifiedStamp = verifiedMonthStamp(cards.map((c) => c.card));
const topPicks = cards.slice(0, 2);
const compareList = cards.slice(2);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

// The perk rows come from PERK_PAGES rather than being written out here, so
// adding a perk page cannot leave it unlinked — which is how eight
// salary-transfer bank pages ended up with no inbound link at all
// (2026-09-06 audit, F-013).
const filters = [
  { label: "All cards", active: true, href: "/cards/" },
  { label: "Miles", active: false, href: "/cards/miles/" },
  { label: "Cashback", active: false, href: "/cards/cashback/" },
  { label: "Islamic", active: false, href: "/cards/islamic/" },
  ...PERK_PAGES.map((perk) => ({
    label: perk.detailColumn,
    active: false,
    href: `/cards/perks/${perk.slug}/`,
  })),
  { label: "By salary", active: false, href: "/cards/salary/" },
  { label: "Fees", active: false, href: "/cards/fees/" },
  { label: "Compare", active: false, href: "/cards/compare/" },
];

// Headline earn-rate string per card — pulls the top non-default tier.
function topEarnRate(card: typeof cards[number]["card"]): string | null {
  const rates = card.earnRates;
  if (!rates) return null;
  const entries = Object.entries(rates).filter(([k]) => k !== "_caps");
  if (entries.length === 0) return null;
  // Highest numeric value across categories; descriptive label paired.
  let best: { label: string; value: number } | null = null;
  for (const [label, raw] of entries) {
    if (earnRateFieldPending(card._provenance, label)) continue;
    const value = typeof raw === "number" ? raw : (raw as { rate?: number } | null)?.rate;
    if (typeof value === "number" && (!best || value > best.value)) {
      best = { label, value };
    }
  }
  if (!best) return null;
  // De-camelCase the L2 key for the sentence — "everythingElse" was
  // leaking verbatim into the reader-facing "Top earn rate" column on
  // ~20 rows (July 2026 structure audit): "1.5% on everythingElse".
  const label = best.label.replace(/([A-Z])/g, " $1").toLowerCase();
  return `${formatEarnRate(best.value, card.earnUnit, card.categories)} on ${label}`;
}

// Perk chips — up to 2 short scan-affordances. Prefers typed `_features`
// canonical labels (Cinema BOGO, Lounge access, Concierge etc.) over
// free-text `perks[]`. Free-text fallback clips at the last whole word
// inside 18 chars so the chip never reads "Complimentary unlimited D…".
function perkChips(card: typeof cards[number]["card"]): string[] {
  if (cardFeatureNeedsReview(card)) return ["Benefits pending"];
  const seen = new Set<string>();
  const out: string[] = [];
  for (const f of (card._features ?? []) as Array<{ type: string }>) {
    if (out.length >= 2) break;
    const label = FEATURE_CHIP_LABELS[f.type];
    if (label && !seen.has(label)) {
      seen.add(label);
      out.push(label);
    }
  }
  if (out.length >= 2) return out;
  // Free-text fallback for cards without enough typed _features.
  for (const p of card.perks ?? []) {
    if (out.length >= 2) break;
    let label = p;
    if (label.length > 18) {
      const cut = label.slice(0, 18);
      const lastSpace = cut.lastIndexOf(" ");
      label = (lastSpace > 8 ? cut.slice(0, lastSpace) : cut) + "…";
    }
    if (!seen.has(label)) {
      seen.add(label);
      out.push(label);
    }
  }
  return out;
}

// Year-1 vs year-2 annual-fee qualifier lives in cardsDataFormat.ts
// (see `annualFeeLabel`) so every listing surface (Top picks, row list,
// SpecCard, comparison tables) routes through the same primitive.
const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({ siteUrl, path: "/cards/", name: "UAE credit cards", description: "UAE credit cards covered by DubaiPoints, checked against primary issuer sources.", crumbs: [{ name: "Cards", path: "/cards/" }] });
---

<BaseLayout
  title={`The best UAE credit cards${verifiedStamp ? ` (${verifiedStamp})` : ""} | DubaiPoints`}
  description="UAE credit cards covered by DubaiPoints, sorted by welcome-bonus value. Annual fees and earn rates checked against primary issuer sources."
  fullWidth
  schema={schema}
>
  <!-- ── 1. Page header ─────────────────────────────────────────────── -->
  <header class="cards-pagehead">
    <div class="cards-pagehead-inner">
      <div class="crumb">DubaiPoints / Cards</div>
      <h1>The best UAE credit cards.</h1>
      <p>
        Browse our primary-source card profiles, compare the recorded fees and
        reward units, then open each review for its conditions and source notes.
        Partial profiles show which terms still need confirmation; coverage is
        not an approval guarantee or a claim that every field is verified.
      </p>
      <p class="cards-pagehead-snapshot">
        <strong>{cardsTracked()}</strong> cards
        <span class="sep">·</span>
        <strong>{banksCovered()}</strong> banks
        {verifiedStamp && (
          <>
            <span class="sep">·</span>
            latest source-record month <strong>{verifiedStamp}</strong>
          </>
        )}
        <span class="sep">·</span>
        <a href="/cards/fees/">fee index</a>
      </p>
      <nav class="cards-pagehead-actions" aria-label="Credit card tools">
        <a href="/cards/finder/" class="dp-ui-action dp-ui-primary">Find cards by salary</a>
        <a href="/cards/compare/" class="dp-ui-action dp-ui-secondary">Compare cards side by side</a>
      </nav>
    </div>
  </header>

  <!-- ── 2. Top Picks ─────────────────────────────────────────────────── -->
  {topPicks.length > 0 && (
    <section class="cards-top-picks" aria-labelledby="cards-top-picks-title" data-top-picks>
      <div class="cards-section-head">
        <span class="cards-section-eyebrow">Top picks this month</span>
        <h2 id="cards-top-picks-title">The two cards we'd open first.</h2>
      </div>
      {topPicks.length > 1 && (
        <div class="cards-top-controls" data-top-picks-controls>
          <span class="cards-top-position" data-top-picks-position role="status" aria-atomic="true">Swipe to see both cards</span>
          <div class="cards-top-arrows" role="group" aria-label="Top picks controls">
            <button type="button" data-top-picks-prev aria-controls="cards-top-picks-rail" aria-label="Previous card">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m14 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button type="button" data-top-picks-next aria-controls="cards-top-picks-rail" aria-label="Next card">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="m10 6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      )}
      <div class="cards-top-grid" id="cards-top-picks-rail" data-top-picks-rail data-multiple={topPicks.length > 1 ? "" : undefined}>
        {topPicks.map((f, index) => {
          const fee = annualFeeLabel(f.card);
          const artProps = {
            cardSlug: f.card.slug,
            cardName: f.card.name,
            bankName: f.bankName,
            coverSize: "med" as const,
            class: "cards-top-card-image",
            sizes: "(max-width: 720px) 70vw, (max-width: 1080px) 38vw, 420px",
          };
          return (
          <article class="cards-top-card">
            {getCardArt(f.card.slug) ? (
              index === 0 ? <CardImage {...artProps} /> : (
                <div class="cards-top-image-slot" data-cards-art="pick"><CardsIndexDeferredArt {...artProps} /></div>
              )
            ) : <p class="cards-top-art-unavailable">Issuer card image not available.</p>}
            <div class="cards-top-card-body">
              <span class="cards-top-card-bank">{f.bankName}</span>
              <h3>{f.card.name}</h3>
              <dl class="cards-top-card-stats">
                <div>
                  <dt>Welcome bonus</dt>
                  <dd class="is-bonus">{welcomeBonusHeadline(f.card.welcomeBonus) || "—"}</dd>
                </div>
                <div>
                  <dt>Annual fee</dt>
                  <dd>
                    {fee.amount}
                    {fee.qual && <small class="cards-top-card-fee-qual"> ({fee.qual})</small>}
                  </dd>
                </div>
              </dl>
              <a href={`/cards/${f.card.slug}/`} class="cards-top-card-cta">Read review →</a>
            </div>
          </article>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── 3. Compare All Cards header ─────────────────────────────────── -->
  <section class="cards-compare-section">
    <div class="cards-compare-head">
      <h2>Compare all cards.</h2>
      <div class="cards-compare-tools">
        <nav class="cards-compare-pills" aria-label="Browse card categories">
          {filters.map((f) => (
            f.active
              ? <a href={f.href} class="dp-ui-filter" aria-current="page">{f.label}</a>
              : <a href={f.href} class="dp-ui-filter">{f.label}</a>
          ))}
        </nav>
        <span class="cards-compare-sort">Sorted by <strong>welcome bonus</strong></span>
      </div>
    </div>

    <!-- ── 4. Card rows ────────────────────────────────────────────── -->
    <ul class="cards-row-list">
      {compareList.map((f) => {
        const earn = topEarnRate(f.card);
        const chips = perkChips(f.card);
        const fee = annualFeeLabel(f.card);
        const bonus = welcomeBonusHeadline(f.card.welcomeBonus);
        return (
          <li class="cards-row">
            <a href={`/cards/${f.card.slug}/`} class="cards-row-link">
              <div class="cards-row-art" data-cards-art="row">
                <CardsIndexDeferredArt
                  cardSlug={f.card.slug}
                  cardName={f.card.name}
                  bankName={f.bankName}
                  coverSize="thumb"
                  class="cards-row-art-image"
                  sizes="(max-width: 640px) 84px, 140px"
                />
              </div>
              <div class="cards-row-id">
                <span class="cards-row-bank">{f.bankName}</span>
                {/* Strip a leading bank-name prefix from the display name —
                    the eyebrow above already says it, so "EMIRATES NBD /
                    Emirates NBD Skywards Infinite" stuttered on ~30 rows
                    (10 June 2026 fresh-eyes audit). Display-only; L2 name
                    untouched. */}
                <span class="cards-row-name">
                  {f.card.name.startsWith(`${f.bankName} `)
                    ? f.card.name.slice(f.bankName.length + 1)
                    : f.card.name}
                </span>
                {chips.length > 0 && (
                  <div class="cards-row-chips">
                    {chips.map((c) => <span class="cards-row-chip">{c}</span>)}
                  </div>
                )}
              </div>
              <div class="cards-row-bonus">
                <span class="cards-row-label">Welcome bonus</span>
                <span class="cards-row-value is-bonus">{bonus || "—"}</span>
              </div>
              <div class="cards-row-fee">
                <span class="cards-row-label">Annual fee</span>
                <span class="cards-row-value">
                  {fee.amount}
                  {fee.qual && <small class="cards-row-fee-qual"> ({fee.qual})</small>}
                </span>
              </div>
              <div class="cards-row-earn">
                <span class="cards-row-label">Top earn rate</span>
                <span class="cards-row-value">{earn ?? "—"}</span>
              </div>
              <div class="cards-row-cta">
                <span class="cards-row-cta-pill">Read review →</span>
                <span class="cards-row-verified">{cardHasUnresolvedTerms(f.card) ? `Source record ${fmt(f.card.lastVerified)} — terms pending` : `Verified ${fmt(f.card.lastVerified)}`}</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- ── 5. Editorial callout (dark) ─────────────────────────────────── -->
  <section class="cards-callout">
    <div class="cards-callout-grid">
      <div class="cards-callout-text">
        <h2>Not sure which card is right for you?</h2>
        <p>The right card depends on your AED salary band, the bank you transfer to, and what you actually spend on each month. These two guides cut the noise.</p>
      </div>
      <div class="cards-callout-ctas">
        <a href="/guides/expat-starter-first-credit-card/" class="cards-callout-cta">
          <span class="cards-callout-cta-eyebrow">Start here</span>
          <span class="cards-callout-cta-title">Your first UAE credit card</span>
          <span class="cards-callout-cta-arrow">→</span>
        </a>
        <a href="/guides/uae-credit-card-eligibility-2026/" class="cards-callout-cta">
          <span class="cards-callout-cta-eyebrow">Eligibility</span>
          <span class="cards-callout-cta-title">Salary bands & AECB score</span>
          <span class="cards-callout-cta-arrow">→</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Keep the existing artwork and no-script fallback, but do not let
  // native lazy-loading fetch a screenful of catalogue rows early.
  const artSlots = document.querySelectorAll<HTMLElement>("[data-cards-art]");
  const revealArt = (slot: Element | null) => {
    const template = slot?.querySelector<HTMLTemplateElement>("template[data-cards-art-template]");
    if (template) template.replaceWith(template.content.cloneNode(true));
  };
  if ("IntersectionObserver" in window) {
    const onVisible: IntersectionObserverCallback = (entries, observer) => {
      for (const entry of entries) {
        if (!entry.isIntersecting || entry.intersectionRatio < observer.thresholds[0]) continue;
        revealArt(entry.target);
        observer.unobserve(entry.target);
      }
    };
    const rows = new IntersectionObserver(onVisible, { rootMargin: "64px 0px" });
    // The thin preview of the next mobile card should not download its
    // art. On desktop, both full card panels load as they enter view.
    const picks = new IntersectionObserver(onVisible, { rootMargin: "64px 0px", threshold: 0.4 });
    artSlots.forEach(slot => (slot.dataset.cardsArt === "pick" ? picks : rows).observe(slot));
  } else {
    artSlots.forEach(revealArt);
  }

  const section = document.querySelector<HTMLElement>("[data-top-picks]");
  const rail = section?.querySelector<HTMLElement>("[data-top-picks-rail][data-multiple]");
  const controls = section?.querySelector<HTMLElement>("[data-top-picks-controls]");
  const previous = controls?.querySelector<HTMLButtonElement>("[data-top-picks-prev]");
  const next = controls?.querySelector<HTMLButtonElement>("[data-top-picks-next]");
  const position = controls?.querySelector<HTMLElement>("[data-top-picks-position]");
  if (section && rail && controls && previous && next && position) {
    const slides = Array.from(rail.children).filter((node): node is HTMLElement => node instanceof HTMLElement);
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    let active = 0;
    const scrollable = () => rail.scrollWidth - rail.clientWidth > 2;
    const update = () => {
      const enabled = scrollable();
      controls.toggleAttribute("data-controls-ready", enabled);
      rail.toggleAttribute("data-rail-ready", enabled);
      if (!enabled) return;
      // With a small neighbour visible, the nearer card centre is the
      // selected card at either end. No timers or automatic movement.
      const edge = rail.getBoundingClientRect();
      const centre = edge.left + edge.width / 2;
      active = slides.reduce((best, slide, index) => {
        const distance = (item: HTMLElement) => {
          const rect = item.getBoundingClientRect();
          return Math.abs(rect.left + rect.width / 2 - centre);
        };
        return distance(slide) < distance(slides[best]) ? index : best;
      }, 0);
      const label = "Card " + (active + 1) + " of " + slides.length;
      if (position.textContent !== label) position.textContent = label;
      previous.setAttribute("aria-disabled", String(active === 0));
      next.setAttribute("aria-disabled", String(active === slides.length - 1));
      slides.forEach((slide, index) => slide.toggleAttribute("data-current", index === active));
    };
    const go = (index: number) => {
      if (!scrollable() || index < 0 || index >= slides.length) return;
      revealArt(slides[index].querySelector("[data-cards-art]"));
      const edge = rail.getBoundingClientRect();
      const target = slides[index].getBoundingClientRect();
      const delta = index === slides.length - 1 ? target.right - edge.right : target.left - edge.left;
      rail.scrollTo({ left: rail.scrollLeft + delta, behavior: reduced.matches ? "instant" : "smooth" });
    };
    previous.addEventListener("click", () => go(active - 1));
    next.addEventListener("click", () => go(active + 1));
    controls.addEventListener("keydown", (event) => {
      if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || !scrollable()) return;
      const key = event.key;
      if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(key)) return;
      event.preventDefault();
      go(key === "Home" ? 0 : key === "End" ? slides.length - 1 : active + (key === "ArrowLeft" ? -1 : 1));
    });
    rail.addEventListener("scroll", update, { passive: true });
    rail.addEventListener("focusin", (event) => {
      if (event.target instanceof Element) revealArt(event.target.closest("article")?.querySelector("[data-cards-art]") ?? null);
    });
    window.addEventListener("resize", update, { passive: true });
    window.addEventListener("pageshow", update);
    update();
  }
</script>

<style>
  /* ── Page header ─────────────────────────────────────────────────── */
  .cards-pagehead-actions { display: flex; flex-wrap: wrap; gap: var(--dp-ui-gap, 8px); margin-block-start: 16px; }
  .cards-pagehead {
    background: var(--paper);
    padding: 48px 32px 32px;
  }
  .cards-pagehead-inner {
    max-width: 880px; margin: 0 auto;
    text-align: center;
  }
  .cards-pagehead .crumb {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 18px;
  }
  .cards-pagehead h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(32px, 5vw, 56px);
    letter-spacing: -1.4px;
    line-height: 1.06;
    color: var(--ink);
    margin: 0 auto 16px;
    text-wrap: balance;
    max-width: 22ch;
  }
  .cards-pagehead p {
    max-width: 60ch; margin: 0 auto;
    font-size: 15px; line-height: 1.6;
    color: var(--ink-soft);
  }

  /* ── Top Picks ──────────────────────────────────────────────────── */
  .cards-top-picks {
    max-width: var(--container-listing); margin: 32px auto;
    padding: 0 32px;
  }
  .cards-section-head {
    text-align: center;
    margin-bottom: 28px;
  }
  .cards-section-eyebrow {
    display: inline-block;
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 12px;
  }
  .cards-section-head h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.5vw, 36px);
    letter-spacing: -0.9px;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .cards-top-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .cards-top-grid:not([data-multiple]) { grid-template-columns: minmax(0, 1fr); }
  .cards-top-controls { display: none; }
  .cards-top-position {
    color: var(--ink-soft);
    font: 600 13px / 1.4 var(--font-ui);
    font-variant-numeric: tabular-nums;
  }
  .cards-top-arrows { display: flex; gap: 8px; }
  .cards-top-arrows button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    background: var(--paper);
    cursor: pointer;
  }
  .cards-top-arrows button:not([aria-disabled="true"]):hover {
    border-color: var(--green);
    color: var(--green);
  }
  .cards-top-arrows button[aria-disabled="true"] { color: var(--muted); cursor: default; }
  .cards-top-arrows button:focus-visible,
  .cards-top-card-cta:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .cards-top-card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
  }
  .cards-top-card :global(.cards-top-card-image) {
    width: 100%; aspect-ratio: 16 / 9;
    object-fit: cover; display: block;
    border-bottom: 1px solid var(--line);
  }
  .cards-top-image-slot {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--shade-1);
  }
  .cards-top-image-slot:has(> template) { border-bottom: 1px solid var(--line); }
  .cards-top-art-unavailable {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    margin: 0;
    padding: 16px;
    border-bottom: 1px solid var(--line);
    background: var(--shade-1);
    color: var(--ink-soft);
  }
  .cards-top-card-body {
    padding: 22px 24px 24px;
    display: grid; gap: 14px;
  }
  .cards-top-card-bank {
    font-family: var(--font-ui);
    font-size: 10px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--green);
  }
