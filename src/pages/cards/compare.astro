---
// Card compare — Phase F picker (2026-05-20).
// Accepts ?cards=slug1,slug2,slug3,slug4 (max 4). With no param, the
// page falls back to the static top-3-by-welcome-bonus default that
// shipped in Phase C (and preserves that as the no-params view).
//
// The picker submits a GET form. The static page's script displays the
// requested cards in URL order, so the comparison is shareable.
//
// All side-by-side surfaces use the new src/components/cards/* set
// (FeeBlock, EarnRateTable, EligibilityChips, WelcomeBonusCallout,
// VerifiedStamp) so the comparison renders the same data tokens the
// hubs and finder render.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { getEntry } from "astro:content";
import { getActiveCards, welcomeBonusDisplay } from "~/lib/cardsData";
import {
  formatEarnRate,
  topEarnEntry,
  CATEGORY_LABELS_FOR_TOP,
  compareByWelcomeValue,
} from "~/lib/cardsDataFormat";
import { cardMatchups, matchupSlug } from "~/data/cardMatchups";
import CompareCardArt from "~/components/cards/CompareCardArt.astro";
import CardValueLines from "~/components/cards/CardValueLines.astro";
import CardValueScenario from "~/components/cards/CardValueScenario.astro";
import CardJourney from "~/components/cards/CardJourney.astro";
import FeeBlock from "~/components/cards/FeeBlock.astro";
import EarnRateTable from "~/components/cards/EarnRateTable.astro";
import EligibilityChips from "~/components/cards/EligibilityChips.astro";
import WelcomeBonusCallout from "~/components/cards/WelcomeBonusCallout.astro";
import VerifiedStamp from "~/components/cards/VerifiedStamp.astro";

const MAX_CARDS = 4;

const allCards = getActiveCards();

// ── Selection ───────────────────────────────────────────────────────
// This page used to read `Astro.url.searchParams.get("cards")` here and
// render only the requested cards. astro.config.mjs is `output: "static"`,
// so search params are always empty at build: the emitted HTML was the
// default three on every visit, the picker's checkboxes never came back
// ticked, and the deck's promise that "the URL is shareable" was not true.
// Nothing on the page recovered it, unlike /cards/finder/, which at least
// had a script (2026-09-06 audit; the finder's half is F-039).
//
// Fixed the same way the finder was: every card's column is emitted, the
// default three are visible, and the inline script at the foot of this file
// unhides whatever the query string asks for. A reader with JS off still
// gets a working default rather than a blank page.
const defaultSlugs = allCards
  .filter((c) => c.welcomeBonus)
  .sort(compareByWelcomeValue)
  .slice(0, 3)
  .map((c) => c.slug);
const defaultSet = new Set(defaultSlugs);
const defaultRank = new Map(defaultSlugs.map((slug, i) => [slug, i]));

const cardsRaw = await Promise.all(
  allCards.map(async (card) => {
    const bank = await getEntry("banks", card.bank);
    return { card, bankName: bank?.data.name ?? card.bank };
  }),
);
const initialColumns = [...cardsRaw].sort(
  (a, b) => (defaultRank.get(a.card.slug) ?? Infinity) - (defaultRank.get(b.card.slug) ?? Infinity),
);

// ── Picker data — all cards grouped by bank for the <details> form ──
const allByBank: Map<string, Array<typeof cardsRaw[number]>> = new Map();
for (const card of allCards) {
  const bank = await getEntry("banks", card.bank);
  const bankName = bank?.data.name ?? card.bank;
  if (!allByBank.has(bankName)) allByBank.set(bankName, []);
  allByBank.get(bankName)!.push({ card, bankName });
}
const bankGroups = [...allByBank.entries()].sort(([a], [b]) =>
  a.localeCompare(b),
);

const selectedSet = defaultSet;

// Pick a representative earn-rate metric per card. Routes through the
// canonical `topEarnEntry` + `CATEGORY_LABELS_FOR_TOP` so this surface
// renders the same label AtAGlance, EarnRateTable.is-top and SpecCard
// use — closes the same regression class PR #204 fixed in SpecCard
// (local-CATEGORY_LABELS leak of raw L2 keys like "partnerBrands" /
// "online" / "utilities" / "everythingElse" to the reader).
const earnLine = (card: (typeof cardsRaw)[number]["card"]) => {
  const top = topEarnEntry(card.earnRates as Record<string, unknown>);
  const r = card.earnRates;
  const everythingElse = typeof r.everythingElse === "number" ? r.everythingElse : 0;
  const fmtRest = formatEarnRate(everythingElse, card.earnUnit, card.categories);
  if (!top || top.key === "everythingElse") {
    return `${fmtRest} all spend`;
  }
  const topLabel = CATEGORY_LABELS_FOR_TOP[top.key] ?? top.key;
  const topFmt = formatEarnRate(top.value, card.earnUnit, card.categories);
  const restFmt = formatEarnRate(everythingElse, card.earnUnit, card.categories);
  return `${topFmt} ${topLabel.toLowerCase()}, ${restFmt} rest`;
};
---

<BaseLayout
  title="Compare UAE credit cards side-by-side | DubaiPoints"
  description="Pick up to four UAE credit cards and compare them side by side across eligibility, earn rates, welcome bonuses, and verified-on date."
  fullWidth
>
  <div class="dp-pagehead dp-compare-picker-head">
    <div class="crumb">DubaiPoints / Cards / Compare</div>
    <h1>Compare cards</h1>
    <p>
      Compare fees, rewards and eligibility for up to four cards. Share your selection using the page link.
    </p>

    <div class="dp-tools-stats">
      <span>
        <span class="lbl">Cards covered:</span>
        <strong>{allCards.length}</strong>
      </span>
      <span>
        <span class="lbl">Showing:</span>
        <strong>
          <span id="dp-compare-count">{defaultSlugs.length}</span>{" "}
          <span id="dp-compare-mode">top welcome-bonus cards</span>
        </strong>
      </span>
      <span>
        <span class="lbl">Methodology:</span>
        <strong>
          <a href="/editorial-policy/" style="color: var(--link);">Read →</a>
        </strong>
      </span>
    </div>
  </div>

  <CardJourney />

  <!-- ── Picker ───────────────────────────────────────────────────── -->
  <section class="dp-compare-picker">
    <details>
      <summary>
        <span class="dp-compare-picker-title">Pick cards to compare</span>
        <span class="dp-compare-picker-hint">
          Up to {MAX_CARDS} cards
        </span>
      </summary>
      <form method="get" action="/cards/compare/" class="dp-compare-picker-form">
        <p id="dp-compare-selection" class="dp-compare-selection" role="status" aria-live="polite">{selectedSet.size} of {MAX_CARDS} selected. Choose cards, then update the comparison.</p>
        <fieldset aria-describedby="dp-compare-selection">
          <legend class="sr-only">Select up to {MAX_CARDS} cards</legend>
          {bankGroups.map(([bankName, items]) => (
            <div class="dp-compare-picker-group">
              <div class="dp-compare-picker-label">{bankName}</div>
              <ul>
                {items.map(({ card }) => (
                  <li>
                    <label>
                      <input
                        type="checkbox"
                        name="cards"
                        value={card.slug}
                        checked={selectedSet.has(card.slug)}
                      />
                      <span>{card.name}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </fieldset>
        <div class="dp-compare-picker-actions">
          <button type="submit" class="dp-ui-action dp-ui-primary">Update comparison</button>
          <a href="/cards/compare/" class="dp-ui-action dp-ui-quiet">Reset to defaults</a>
          <span class="caveat">
            Select up to {MAX_CARDS} cards.
          </span>
        </div>
      </form>
    </details>
  </section>

  <div
    id="dp-compare-empty"
    hidden
    style="padding: 64px 32px; text-align: center; color: var(--ink-soft);"
  >
    <p style="font-size: 16px;">
      None of the requested cards are in our database.
    </p>
    <p style="font-size: 14px; margin-top: 8px;">
      <a href="/cards/compare/" style="color: var(--link);">
        Reset to defaults →
      </a>
    </p>
  </div>

  <div class="dp-compare-value-context">
    <CardValueScenario id="compare-card-value" compact />
  </div>

  <p class="dp-compare-overflow-hint">Scroll across to see more cards.</p>

  {(
    <section
      class="dp-compare-grid"
      id="dp-compare-grid"
      aria-label="Card comparison"
      tabindex="0"
      data-visible-count={defaultSlugs.length}
    >
      {initialColumns.map(({ card, bankName }) => {
        const wbDisplay = card.welcomeBonus
          ? welcomeBonusDisplay(card.welcomeBonus)
          : "";
        const showWelcome =
          card.welcomeBonus !== undefined &&
          card.welcomeBonus !== null &&
          wbDisplay.length > 0;
        return (
          <article
            class="dp-compare-col"
            data-bank={card.bank}
            data-slug={card.slug}
            hidden={!defaultSet.has(card.slug)}
          >
            <header class="dp-compare-col-head">
              <div class="dp-compare-identity">
                <span class="bank">{bankName}</span>
                <h2>
                  <a href={`/cards/${card.slug}/`}>{card.name}</a>
                </h2>
                <span class="network">{card.network}</span>
              </div>
              <CompareCardArt slug={card.slug} deferred size="identity" />
            </header>

            <div class="dp-compare-col-section dp-compare-fee">
              <div class="dp-compare-row-label">Fees</div>
              <FeeBlock card={card.slug} />
            </div>

            <div class="dp-compare-col-section dp-compare-eligibility">
              <div class="dp-compare-row-label">Eligibility</div>
              <EligibilityChips eligibility={card.eligibility} />
            </div>

            <div class="dp-compare-col-section dp-compare-top">
              <div class="dp-compare-row-label">Top category</div>
              <p class="line">{earnLine(card)}</p>
            </div>

            <details class="dp-compare-reward-rates">
              <summary>Earn rates<span class="sr-only"> for {card.name}</span></summary>
              <EarnRateTable earnRates={card.earnRates} earnUnit={card.earnUnit} />
            </details>

            <CardValueLines card={card} slug={card.slug} />

            {showWelcome && card.welcomeBonus && (
              <div class="dp-compare-col-section dp-compare-welcome">
                <div class="dp-compare-row-label">Welcome offer</div>
                <WelcomeBonusCallout
                  welcomeBonus={card.welcomeBonus}
                  welcomeBonusDisplay={wbDisplay}
                />
              </div>
            )}

            <div class="dp-compare-col-section dp-compare-programme">
              <div class="dp-compare-row-label">Loyalty programme</div>
              <p class="line">{card.loyaltyProgram ?? "—"}</p>
            </div>

            <footer class="dp-compare-col-foot">
              <VerifiedStamp lastVerified={card.lastVerified} />
              <a href={`/cards/${card.slug}/`} class="dp-ui-action dp-ui-quiet">
                Read review →
              </a>
            </footer>
          </article>
        );
      })}
    </section>
  )}

  <section class="dp-compare-matchups" id="dp-compare-matchups" aria-labelledby="dp-matchups-head">
    <h2 id="dp-matchups-head">Head to head, with a verdict</h2>
    <p>Written comparisons for cards you might shortlist together, with a verdict on who each suits.</p>
    <ul>
      {cardMatchups.map((m) => (
        <li>
          <a href={`/cards/compare/${matchupSlug(m)}/`}>
            {allCards.find((c) => c.slug === m.left)?.name} vs{" "}
            {allCards.find((c) => c.slug === m.right)?.name}
          </a>
          <span class="deck">{m.deck}</span>
        </li>
      ))}
    </ul>
  </section>

  <div class="dp-tools-actions" style="margin-top: 32px;">
    <span style="font-size: 13px; color: var(--ink-soft);">
      Up to <strong>{MAX_CARDS}</strong> cards per comparison. Data is
      audited quarterly; each card's last-verified date sits in its footer.
    </span>
    <span><a href="/cards/">All cards →</a></span>
  </div>
</BaseLayout>

<script is:inline define:vars={{ MAX_CARDS, defaultSlugs }}>
  // Recovers the ?cards= selection this page could never render. See the
  // note beside the frontmatter's selection block: the server read search
  // params in a static build, so they were always empty and the picker's
  // "Update comparison" button returned the same three cards every time.
  (function () {
    var grid = document.getElementById("dp-compare-grid");
    var empty = document.getElementById("dp-compare-empty");
    var countEl = document.getElementById("dp-compare-count");
    var modeEl = document.getElementById("dp-compare-mode");
    if (!grid || !empty || !countEl || !modeEl) return;

    var cols = Array.prototype.slice.call(grid.querySelectorAll("[data-slug]"));
    var known = Object.create(null);
    cols.forEach(function (el) {
      known[el.getAttribute("data-slug")] = el;
    });

    function requested() {
      var raw = new URLSearchParams(window.location.search).getAll("cards");
      // Accept both repeated ?cards=a&cards=b (what the form submits) and a
      // single comma-joined value (what a hand-written link tends to use).
      var slugs = [];
      raw.forEach(function (v) {
        String(v)
          .split(",")
          .forEach(function (part) {
            var slug = part.trim();
            // An unknown slug is dropped rather than emptying the page.
            if (slug && known[slug] && slugs.indexOf(slug) < 0) slugs.push(slug);
          });
      });
      return slugs.slice(0, MAX_CARDS);
    }

    function apply() {
      var chosen = requested();
      var isDefault = chosen.length === 0;
      var show = isDefault ? defaultSlugs : chosen;

      cols.forEach(function (el) {
        el.hidden = show.indexOf(el.getAttribute("data-slug")) < 0;
      });
      // Keep the URL, visible comparison and keyboard order in sync.
      grid.prepend.apply(grid, show.map(function (slug) { return known[slug]; }));
      // An img inside a template is inert: the browser cannot fetch every
      // card, or the default cards on a visit with an explicit selection.
      show.forEach(function (slug) {
        var template = known[slug].querySelector("[data-compare-art-template]");
        if (!template) return;
        var img = template.content.querySelector("img").cloneNode(true);
        img.addEventListener("error", function () { img.remove(); }, { once: true });
        template.replaceWith(img);
      });

      countEl.textContent = String(show.length);
      modeEl.textContent = isDefault ? "top welcome-bonus cards" : "selected";
      grid.dataset.visibleCount = String(show.length);

      var none = show.length === 0;
      empty.hidden = !none;
      grid.hidden = none;

      // The checkboxes are server-rendered against the defaults, so they need
      // the same correction.
      var boxes = document.querySelectorAll('.dp-compare-picker-form input[name="cards"]');
      Array.prototype.forEach.call(boxes, function (box) {
        box.checked = show.indexOf(box.value) >= 0;
      });
    }

    apply();

    // Native checkboxes remain independent. At the comparison limit,
    // prevent a fifth choice being silently discarded on submission.
    var picker = document.querySelector(".dp-compare-picker-form");
    var selection = document.getElementById("dp-compare-selection");
    if (picker && selection) {
      var boxes = Array.prototype.slice.call(picker.querySelectorAll('input[name="cards"]'));
      function updatePickerState() {
        var selected = boxes.filter(function (box) { return box.checked; }).length;
        boxes.forEach(function (box) {
          box.disabled = !box.checked && selected >= MAX_CARDS;
        });
        selection.textContent = selected + " of " + MAX_CARDS + " selected. "
          + (selected >= MAX_CARDS ? "Deselect a card to choose another."
            : selected === 0 ? "Choose a card, or update to restore the defaults."
              : "Choose cards, then update the comparison.");
      }
      boxes.forEach(function (box) { box.addEventListener("change", updatePickerState); });
      updatePickerState();
    }
  })();
</script>

<style>
  .dp-compare-matchups {
    max-width: var(--container-listing);
    margin: 0 auto 40px;
    padding: 0 32px;
  }
  #dp-compare-grid + .dp-compare-matchups { margin-block-start: 40px; }
  .dp-compare-matchups h2 {
    font-family: var(--font-display);
    font-size: 24px;
    margin: 0 0 6px;
  }
  .dp-compare-matchups > p {
    font-family: var(--font-ui);
    font-size: 15px;
    color: var(--ink-soft);
    margin: 0 0 18px;
    max-width: 62ch;
  }
  .dp-compare-matchups ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
  }
  .dp-compare-matchups li {
    border-top: 1px solid var(--line);
    padding-top: 12px;
  }
  .dp-compare-matchups a {
    display: inline-flex;
    align-items: center;
    min-height: var(--dp-ui-control, 44px);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    color: var(--green);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .dp-compare-matchups a:hover { text-decoration: underline; }
  .dp-compare-matchups .deck {
    display: block;
    font-family: var(--font-ui);
    font-size: 13px;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-top: 2px;
  }
  @media (max-width: 720px) {
    .dp-compare-matchups { padding: 0 20px; }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Picker ───────────────────────────────────────────────────── */
  .dp-compare-picker-head {
    max-inline-size: var(--container-listing);
    margin-inline: auto;
    padding-block: clamp(22px, 4vw, 48px) 18px;
    background: none;
    border-block-end-color: var(--line);
  }
  .dp-compare-picker-head h1 { margin-block-end: 8px; }
  .dp-compare-picker-head .dp-tools-stats { margin-block-start: 12px; gap: 4px 16px; }
  .dp-compare-picker-head .dp-tools-stats a { text-decoration: underline; text-underline-offset: .16em; }
  .dp-compare-picker {
    max-width: var(--container-listing);
    margin: 12px auto 0;
    padding: 0 32px;
  }
  .dp-compare-picker details {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
  }
  .dp-compare-picker summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-block-size: var(--dp-ui-control, 44px);
    padding: 8px 16px;
    cursor: pointer;
    list-style: none;
  }
  .dp-compare-picker summary::-webkit-details-marker {
    display: none;
  }
  .dp-compare-picker summary:hover { background: var(--shade-1); }
  .dp-compare-picker summary::after {
    content: "▾" / "";
    color: var(--ink-soft);
    font-size: 12px;
  }
  .dp-compare-picker details[open] > summary::after {
    transform: rotate(180deg);
  }
  .dp-compare-picker summary:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; border-radius: 8px; }
  .dp-compare-picker-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    color: var(--ink);
  }
  .dp-compare-picker-hint {
    font-size: 12px;
    color: var(--ink-soft);
    margin-left: auto;
  }
  .dp-compare-picker-form {
    padding: 16px 24px 24px;
    border-top: 1px solid var(--line);
  }
  .dp-compare-picker-form fieldset {
    border: 0;
    padding: 4px;
    margin: 0;
    display: grid;
    min-inline-size: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
    gap: 24px;
    max-block-size: min(50vh, 28rem);
    overflow: auto;
    scroll-padding-block: 4px;
  }
  .dp-compare-picker-group .dp-compare-picker-label {
    font-family: var(--font-ui);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--green);
    margin: 0 0 8px;
  }
  .dp-compare-picker-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 4px;
  }
  .dp-compare-picker-group label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink);
    cursor: pointer;
    padding: 8px;
    border: 1px solid transparent;
    border-radius: var(--dp-ui-radius-small, 6px);
    min-block-size: var(--dp-ui-control, 44px);
  }
  .dp-compare-picker-group input {
    accent-color: var(--green);
    flex-shrink: 0;
    inline-size: 16px;
    block-size: 16px;
    margin: 0;
  }
  .dp-compare-selection { margin: 0 0 12px; color: var(--ink-soft); font: 500 .8125rem/1.5 var(--font-ui); }
  .dp-compare-picker-group label:has(input:checked) { background: var(--shade-1); border-color: var(--line); }
  .dp-compare-picker-group label:has(input:focus-visible) { outline: 2px solid var(--green); outline-offset: 2px; }
  .dp-compare-picker-group label:has(input:disabled) { color: var(--ink-soft); cursor: not-allowed; }
  .dp-compare-picker-group label span { min-width: 0; overflow-wrap: anywhere; }
  .dp-compare-picker-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--line-soft);
  }
  .dp-compare-picker-actions .caveat {
    font-size: 12px;
    color: var(--muted);
    margin-left: auto;
  }

  /* ── Comparison grid ──────────────────────────────────────────── */
  .dp-compare-value-context {
    max-width: var(--container-listing);
    margin: 10px auto 0;
    padding: 0 32px;
  }
  .dp-compare-overflow-hint { display: none; }
  .dp-compare-grid {
    --compare-visible: 3;
    /* Keep absolutely positioned screen-reader labels inside the local
       scroll region, including labels in off-screen card columns. */
    position: relative;
    max-width: var(--container-listing);
    margin: 12px auto 0;
    padding: 0 32px;
    display: grid;
    gap: 16px 10px;
    grid-template-columns: repeat(var(--compare-visible), minmax(0, 1fr));
    align-items: start;
  }
  .dp-compare-grid[data-visible-count="1"] { --compare-visible: 1; }
  .dp-compare-grid[data-visible-count="2"] { --compare-visible: 2; }
  .dp-compare-grid[data-visible-count="4"] { --compare-visible: 4; }
  .dp-compare-grid:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .dp-compare-col {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    align-content: start;
    font-family: var(--font-ui);
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .dp-compare-col > :is(.dp-compare-col-head, .dp-compare-col-section, .dp-compare-reward-rates, .dp-compare-col-foot) {
    min-inline-size: 0;
    margin: 0;
    padding: 12px clamp(10px, 1.25vw, 18px);
    border-block-start: 1px solid var(--line-soft);
  }
  .dp-compare-col > .dp-compare-col-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    border: 0;
    padding-block-start: 16px;
    background: var(--shade-1);
    border-start-start-radius: 7px;
    border-start-end-radius: 7px;
  }
  .dp-compare-col-head :global(.dp-compare-card-art) { order: -1; }
  .dp-compare-identity {
    display: grid;
    min-width: 0;
