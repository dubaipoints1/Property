---
/**
 * /cards/fees/ — annual and foreign-currency fees across the card set.
 *
 * Added 10 September 2026 from the kredit.ae teardown, which publishes a
 * fee index over its catalogue. Ours is computed from L2 at build time in
 * src/lib/feeIndex.ts; this page types no figure of its own. Two things
 * theirs does not have: an exact-fee FX distribution (unknown and unlike
 * scopes stay out) and a per-card table a reader can check a figure
 * against. Definitions are stated in the methodology block below and
 * enforced by tests/cards/fee-index.test.ts.
 */
import BaseLayout from "~/layouts/BaseLayout.astro";
import { getActiveCards } from "~/lib/cardsData";
import { verifiedMonthStamp } from "~/lib/cardsDataFormat";
import { buildFeeIndex, firstYearAnnualFeeLabel } from "~/lib/feeIndex";
import { cardFxFeeLabel } from "~/lib/cardFeeFacts";
import { getEntry } from "astro:content";

const cards = getActiveCards();
const idx = buildFeeIndex(cards);
const stamp = verifiedMonthStamp(cards);

const bankNames = new Map<string, string>();
for (const b of idx.byBank) {
  const e = await getEntry("banks", b.bank);
  bankNames.set(b.bank, e?.data.name ?? b.bank);
}
const bankName = (slug: string) => bankNames.get(slug) ?? slug;

const aed = (n: number) => `AED ${Math.round(n).toLocaleString("en-GB")}`;
const pct = (n: number) => `${Math.round(n * 100)}%`;
const fx = (n: number | null) => n === null ? "Pending" : (n === 0 ? "0%" : `${n}%`);
---

<BaseLayout
  title={`UAE credit-card fee index${stamp ? ` (${stamp})` : ""} | DubaiPoints`}
  description="Listed annual and foreign-currency fees across UAE cards we cover: zero annual fees, known year-one waivers, pending terms, medians by bank and salary tier, and a per-card table."
  fullWidth
>
  <div class="dp-pagehead">
    <div class="crumb"><a href="/cards/" class="crumb-link">Cards</a> / Fees</div>
    <h1>UAE credit-card fees, across the set</h1>
    <p>
      Listed annual and foreign-currency fees for the {idx.total} cards we cover.
      Figures are computed from this site's source records and change when
      accepted record updates are rebuilt. Pending terms are not assumed confirmed.
    </p>
    <div class="dp-tools-stats">
      <span><span class="lbl">Cards:</span> <strong>{idx.total}</strong></span>
      <span><span class="lbl">Banks:</span> <strong>{idx.byBank.length}</strong></span>
      {stamp && <span><span class="lbl">Latest source record:</span> <strong>{stamp}</strong></span>}
    </div>
  </div>

  <div class="dp-fees-body">
    <dl class="dp-stats is-four">
      <div class="dp-stat"><dt>No annual fee listed</dt><dd>{idx.freeForLife} of {idx.annualFeeSampleSize} known fee records <small>{idx.freeShare === null ? "Pending" : `(${pct(idx.freeShare)})`} · {idx.annualFeePending} pending</small></dd></div>
      <div class="dp-stat"><dt>Year-one annual fee waived</dt><dd>{idx.firstYearFree}<small>{idx.firstYearPending} pending</small></dd></div>
      <div class="dp-stat"><dt>Median annual fee</dt><dd>{idx.medianFee === null ? "Pending" : aed(idx.medianFee)}</dd></div>
      <div class="dp-stat"><dt>Median fee, paid cards</dt><dd>{idx.medianPaidFee == null ? "—" : aed(idx.medianPaidFee)}</dd></div>
      <div class="dp-stat"><dt>Highest fee</dt><dd>{idx.highest ? <>{aed(idx.highest.annualFee)} <small><a href={`/cards/${idx.highest.slug}/`}>{idx.highest.name}</a></small></> : "—"}</dd></div>
      <div class="dp-stat"><dt>Cheapest paid card</dt><dd>{idx.lowestPaid ? <>{aed(idx.lowestPaid.annualFee)} <small><a href={`/cards/${idx.lowestPaid.slug}/`}>{idx.lowestPaid.name}</a></small></> : "—"}</dd></div>
      <div class="dp-stat"><dt>No listed issuer FX fee</dt><dd>{idx.fxZero} of {idx.fxSampleSize} exact-fee records</dd></div>
      <div class="dp-stat"><dt>Median exact issuer FX fee</dt><dd>{fx(idx.medianFx)} <small>(largest listed {fx(idx.maxFx)})</small></dd></div>
    </dl>

    <section class="dp-fees-section">
      <h2>By bank</h2>
      <div class="dp-fees-table-wrap">
        <table class="dp-data-table">
          <thead>
            <tr><th>Bank</th><th class="num">Cards</th><th class="num">No annual fee listed</th><th class="num">Median annual fee</th><th class="num">Median FX fee</th></tr>
          </thead>
          <tbody>
            {idx.byBank.map((b) => (
              <tr>
                <td><a href={`/banks/${b.bank}/`}>{bankName(b.bank)}</a></td>
                <td class="num">{b.cards}</td>
                <td class="num">{b.freeForLife}</td>
                <td class="num">{b.medianFee === null ? "Pending" : aed(b.medianFee)}</td>
                <td class="num">{fx(b.medianFx)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dp-fees-section">
      <h2>By minimum salary</h2>
      <div class="dp-fees-table-wrap">
        <table class="dp-data-table">
          <thead>
            <tr><th>Minimum salary tier</th><th class="num">Cards</th><th class="num">No annual fee listed</th><th class="num">Median annual fee</th></tr>
          </thead>
          <tbody>
            {idx.bySalaryTier.map((t) => (
              <tr>
                <td>{t.label}</td>
                <td class="num">{t.cards}</td>
                <td class="num">{t.freeForLife}</td>
                <td class="num">{t.medianFee == null ? "—" : aed(t.medianFee)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="dp-fees-note">
        Cards whose minimum salary we have not verified, or which are by invitation, are left out of the tiers. Per-salary listings are at <a href="/cards/salary/">cards by salary</a>.
      </p>
    </section>

    <section class="dp-fees-section">
      <h2>Every card, cheapest first</h2>
      <div class="dp-fees-table-wrap">
        <table class="dp-data-table">
          <thead>
            <tr><th>Card</th><th>Bank</th><th class="num">Annual fee</th><th>First-year annual fee</th><th class="num">FX fee</th><th class="num">Min salary</th></tr>
          </thead>
          <tbody>
            {idx.rows.map((r) => (
              <tr>
                <td><a href={`/cards/${r.slug}/`}>{r.name}</a></td>
                <td>{bankName(r.bank)}</td>
                <td class="num">{r.renewalOnlyFeeLabel ?? (r.annualFee === null ? "Pending" : r.annualFee === 0 ? "Free" : aed(r.annualFee))}</td>
                <td>{firstYearAnnualFeeLabel(r)}</td>
                <td class="num">{cardFxFeeLabel(r)}</td>
                <td class="num">{r.minSalary == null ? "—" : r.minSalary === 0 ? "None" : aed(r.minSalary)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="dp-tools-methodology">
      <div class="col">
        <div class="lbl">No annual fee listed</div>
        <p>A known zero standard annual-fee record, not a claim that every card cost is zero. Pending annual fees are excluded from annual-fee counts and medians, not treated as zero. A positive annual fee with a known year-one waiver is counted separately under <strong>year-one annual fee waived</strong>. Joining charges and other costs are not included in either annual-fee label.</p>
      </div>
      <div class="col">
        <div class="lbl">Annual fee</div>
        <p>The standard published amount before any spend-based waiver. The first-year column and waiver count cover the annual fee only, not joining charges, interest or total first-year cost. Pending terms do not count as waived. A known renewal-only fee is shown in the table but left out of the annual-fee comparisons when the initial terms are pending. A zero annual fee does not confirm that joining or other charges are zero. See each card's source notes and conditions.</p>
      </div>
      <div class="col">
        <div class="lbl">FX fee</div>
        <p>The card's listed foreign-currency fee, not a total conversion cost. Scheme charges and the exchange rate may add cost. Issuer-only entries retain that qualifier in the table and are excluded from comparable numeric summaries, alongside unknown and upper-bound fees. None is treated as zero; check the linked card's source and conditions.</p>
      </div>
    </section>

    <div class="dp-tools-actions">
      <span>Medians rather than means throughout: a few premium cards pull an average up.</span>
      <span><a href="/calculator/">Spend-return calculator →</a></span>
    </div>
  </div>
</BaseLayout>

<style>
  .dp-fees-body { max-width: 1120px; margin: 0 auto; padding: 0 32px 40px; }
  .dp-fees-body .dp-stats { margin-top: 8px; }
  .dp-fees-body .dp-stat dd small { display: block; font-family: var(--font-ui); font-weight: 500; font-size: 12px; color: var(--muted); letter-spacing: 0; margin-top: 2px; }
  .dp-fees-body .dp-stat dd small a { color: var(--link); }
  .dp-fees-section { margin: 32px 0; }
  .dp-fees-section h2 { font-family: var(--font-display); font-weight: 500; font-size: 22px; color: var(--ink); margin: 0 0 12px; }
  .dp-fees-table-wrap { overflow-x: auto; }
  .dp-fees-body .dp-data-table .num { text-align: right; font-feature-settings: 'tnum'; }
  .dp-fees-note { font-size: 13px; color: var(--ink-soft); margin: 10px 0 0; }
  .dp-fees-body .dp-tools-methodology { padding-left: 0; padding-right: 0; }
  .dp-fees-body .dp-tools-actions { padding-left: 0; padding-right: 0; }
  @media (max-width: 640px) { .dp-fees-body { padding: 0 16px 32px; } }
</style>
