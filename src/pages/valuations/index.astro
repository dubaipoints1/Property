---
// Valuations — Phase C tools template (Claude Design handoff).
// Reference: dubaipoints/project/templates/tools.jsx::Valuations.
// DP values mirror the published programme-page baselines; rows with
// no published baseline are "Pending" and remain unpriced.
//
// Chairman ruling R10, 10 September 2026 (audit F-018): the Floor,
// Ceiling, Distribution and 90-day-delta columns are cut. Every one of
// them was a dash on every row while the page carried a published
// promise that the ranges would land in Q3 2026 — a promise with eleven
// days left and no sampling done. The fields stay in
// src/lib/valuations.ts so the columns can return in one commit when
// real figures exist; nothing renders them until then.
//
// The audit counted three empty columns. It was four: delta90 is "—" on
// all ten rows as well.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { programmeValuations, baselinesConfirmed } from "~/lib/valuations";
import PointsToAEDConverter from "~/components/islands/PointsToAEDConverter";

// The converter prices a balance at the same rows the table renders, so the
// two cannot disagree. Pending rows are passed through disabled rather than
// omitted: the reader should see that the programme exists and has no
// published figure, not wonder why it is missing.
const converterProgrammes = programmeValuations.map((p) => ({
  slug: p.slug ?? p.name.toLowerCase().replace(/\s+/g, "-"),
  name: `${p.name} ${p.currencyName}`,
  currencyName: p.currencyName,
  dpValue: p.dpValue ?? null,
}));

// Rows and baselines live in src/lib/valuations.ts — the single
// source of truth the header mega-menu also renders from (Fact-Checker
// redline, 11 June 2026; nav fork closed 29 August 2026).
const programmes = programmeValuations;
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

---

<BaseLayout
  title="UAE points & miles valuations | DubaiPoints"
  description="The conservative points and miles baselines DubaiPoints uses in UAE card comparisons, in fils per mile or point."
  fullWidth
>
  <div class="dp-pagehead">
    <div class="crumb">DubaiPoints / Valuations</div>
    <h1>Points &amp; miles valuations</h1>
    <p><strong>DP value</strong> is the conservative editorial baseline we use in card comparisons, in fils per mile or point. It is not a cash-out rate or a forecast for a specific booking. Programmes without a published baseline are marked Pending.</p>

    <div class="dp-tools-stats">
      <span><span class="lbl">Programmes tracked:</span> <strong>{programmes.length}</strong></span>
      <span><span class="lbl">Baselines confirmed:</span> <strong>{fmt(baselinesConfirmed)}</strong></span>
      <span><span class="lbl">Methodology:</span> <strong><a href="/valuations/methodology/" style="color: var(--link);">Read →</a></strong></span>
    </div>
  </div>

  <div class="dp-toolbar" aria-label="Table scope" style="justify-content: space-between;">
    <span style="font-family: var(--font-ui); font-size: 13px; color: var(--ink-soft);">
      Showing <strong style="color: var(--ink); font-weight: 600;">{programmes.length}</strong> UAE-relevant programmes
    </span>
    <span style="font-family: var(--font-ui); font-size: 13px; color: var(--ink-soft);">
      Sorted by <strong style="color: var(--ink); font-weight: 600;">DP value</strong>
    </span>
  </div>

  <PointsToAEDConverter client:visible programmes={converterProgrammes} />

  <div class="dp-tools-table-wrap">
    <table class="dp-tools-table">
      <thead>
        <tr>
          <th style="width: 46%;">Programme</th>
          <th class="sort-active">DP value (fils) ▼</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {programmes.map((p) => (
          <tr>
            <td>
              <div class="bank-cell">
                <div class="bank-mark">{p.mark}</div>
                <div>
                  <div class="bank-name">{p.name}</div>
                  <div class="bank-tier">{p.currencyName}</div>
                </div>
              </div>
            </td>
            <td class="num"><strong style="font-size: 15px;">{p.dpValue ?? "—"}</strong></td>
            <td>
              <span class={p.status === "Active" ? "status-active" : "status-paused"} style={p.status === "Pending" ? "color: var(--muted);" : ""}>● {p.status}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <section class="dp-tools-methodology">
    <div class="col">
      <div class="lbl">DP value</div>
      <p>A conservative editorial baseline for comparing card earn rates. A specific redemption can be worth more or less.</p>
    </div>
    <div class="col">
      <div class="lbl">Status</div>
      <p><strong>Active</strong> means a baseline is published on the programme's own page and in use in card reviews. <strong>Pending</strong> means no baseline is published yet, so the row carries no figure.</p>
    </div>
    <div class="col">
      <div class="lbl">Value a booking</div>
      <p>No sampled floor or ceiling is published. Use the <a href="/news/cash-or-miles-uae-flight-break-even/">Cash or Miles worked examples</a> to compare an actual fare with an award’s miles and fees.</p>
    </div>
  </section>

  <div class="dp-tools-actions">
    <span><a href="/valuations/methodology/">Methodology</a> · UAE-relevant programmes, editor-curated</span>
    <span><a href="/airlines/">Programme guides →</a></span>
  </div>
</BaseLayout>
