        }
        companion.hidden = !desktop.matches;
        // Clone only the existing image/caption, never an ID or a story row.
        // Its provenance and visible credit remain attached to the image.
        stage.replaceChildren(...[...panel.children].map(child => child.cloneNode(true)));
        title.textContent = link.textContent;
        title.href = read.href = link.href;
        description.textContent = story.querySelector("[data-atlas-description]")?.textContent ?? "";
        status.textContent = `Preview ${index + 1} of ${stories.length}: ${link.textContent}`;
        if (animate) {
          for (const animation of activeMotion) animation.cancel();
          animatePreview(desktop.matches ? stage : panel, [{ opacity: .45, transform: "translateY(8px)" }, { opacity: 1, transform: "none" }], { duration: 280, easing: "ease-out" });
        }
      };
      buttons.forEach((button, index) => button.addEventListener("click", () => show(index, true)));
      desktop.addEventListener("change", () => show(selected));
      show(0);
    }
  }

  // Optional entrance feedback; the rendered state is always visible.
  // No body locking, timers, video or scroll-position manipulation.
  if (!reducedMotion.matches && "IntersectionObserver" in window) {
    entranceObserver = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entranceObserver?.unobserve(entry.target);
        if (entry.boundingClientRect.top < 80) continue;
        animatePreview(entry.target, [{ transform: "translateY(14px)", opacity: .75 }, { transform: "none", opacity: 1 }], { duration: 440, easing: "cubic-bezier(.22, 1, .36, 1)" });
      }
    }, { threshold: .12 });
    document.querySelectorAll(".dp-site-directions [data-direction-reveal]").forEach(element => entranceObserver?.observe(element));
  }
</script>

