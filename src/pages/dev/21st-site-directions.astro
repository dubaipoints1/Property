---
import BaseLayout from "~/layouts/BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import ImageCredit from "~/components/ImageCredit.astro";
import CompareCardArt from "~/components/cards/CompareCardArt.astro";
import { getCollection } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import { getCardArt } from "~/lib/cardArt";
import { getStockEntry } from "~/lib/stockManifest";
import { cardArtSrcset } from "~/lib/stockDerivatives";
import { getLiveOffers } from "~/lib/offerAdapter";
import { getLiveDeals } from "~/lib/deals";

// Local owner review only. /dev/ is excluded from the sitemap and pruned
// before Pagefind/production delivery. No homepage or working tool changes.
// Composition references only: 21st Hero 07/08 (felipemenezes098), the
// existing Runway exploration, and house editorial/decision primitives.
// No third-party source code, demo assets, generation or dependencies.
const news = (await getCollection("news")).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const guides = (await getCollection("guides")).sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());
const banks = await getCollection("banks");
const bankNames = new Map(banks.map(bank => [bank.id, bank.data.name]));
const lead = news.find(post => post.id === "cash-or-miles-emirates-three-quotes") ?? news[0];
const leadImage = lead && getStockEntry(`news-${lead.id}`);
const latest = news.filter(post => post.id !== lead?.id).slice(0, 4);
const atlasStories = lead ? [lead, ...latest] : latest;
const guide = guides.find(item => item.id === "expat-starter") ?? guides[0];
const guideShelf = guides.filter(item => item.id !== guide?.id).slice(0, 3);
const salaryOffers = (await getLiveOffers()).slice(0, 2);
const deals = (await getLiveDeals()).slice(0, 2);
const activeCards = getActiveCards();
const reviewCards = ["emirates-nbd-skywards-infinite", "adcb-365-cashback"].flatMap(slug => {
  const card = activeCards.find(item => item.slug === slug);
  const art = getCardArt(slug);
  return card && art ? [{ card, art, bank: bankNames.get(card.bank) ?? card.bank }] : [];
});
const compareHref = reviewCards.length > 1 ? `/cards/compare/?cards=${reviewCards.map(item => item.card.slug).join(",")}` : "/cards/compare/";
const date = (value: Date | string) => (value instanceof Date ? value : new Date(value)).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const photoFor = (id: string, collection = "news") => {
  const entry = getStockEntry(`${collection}-${id}`);
  return entry && entry.source !== "ai-generated" ? entry : undefined;
};
const deck = "UAE-resident guides to the card combinations, salary-transfer bonuses and miles redemptions that stretch a Dubai paycheque further — AED-first, dated and sourced.";
const directions = [
  { id: "editorial-atlas", name: "Editorial Atlas", letter: "A", idea: "A landscape-led publication. Discover the story, then the useful next step.", fit: "Best when editorial discovery and travel imagery should lead.", reference: "Composition reference: 21st Hero 07 / Hero 08, felipemenezes098. Rebuilt with native house CSS; not imported source." },
  { id: "runway-journal", name: "Runway Journal", letter: "B", idea: "A panoramic opening, followed by three chapters you explore at your own pace.", fit: "Best when a connected travel story should organise the homepage.", reference: "Composition reference: the Runway editorial direction and native chapter navigation. Still photography only; no video download." },
  { id: "decision-desk", name: "Decision Desk", letter: "C", idea: "Start with cards, salary or miles. The reporting supports the decision.", fit: "Best when readers arrive with a specific task and want a clear route.", reference: "Composition reference: native task progression, contained issuer art and the existing Finder / Tracker / Compare journeys." },
];
const tasks = [
  { id: "cards", label: "Choose a card", title: "What fits the way I spend?", description: "Compare the published fees, eligibility and benefits before choosing a card.", href: "/cards/finder/", action: "Open Card Finder", secondary: compareHref, secondaryLabel: "Compare cards" },
  { id: "salary", label: "Move my salary", title: "What should I check before switching?", description: "Read the qualifying conditions, required products, payout timing and clawback terms before applying.", href: "/salary-transfer/", action: "Open Salary Tracker", secondary: "/salary-transfer/calculator/", secondaryLabel: "Check a reward estimate" },
  { id: "miles", label: "Use my miles", title: "Cash or miles for the next trip?", description: "Compare the cash fare with the miles and total cash due on the award. Check the itinerary and conditions match.", href: "/calculator/cash-or-miles/", action: "Compare cash with miles", secondary: "/airlines/skywards/", secondaryLabel: "Read the Skywards guide" },
];
const chapters = [
  { id: "earn", label: "Earn", title: "The next trip starts before the airport.", slug: "guide-expat-starter", description: guide?.data.description ?? "Explore the UAE guides.", href: guide ? `/guides/${guide.id}/` : "/guides/", action: "Start with the UAE guide" },
  { id: "understand", label: "Understand", title: "Know the programme behind the promise.", slug: "programme-skywards", description: "How to earn and spend Skywards Miles from the UAE, with transfer routes, redemption examples and expiry rules.", href: "/airlines/skywards/", action: "Explore Emirates Skywards" },
  { id: "decide", label: "Decide", title: "Put two flight quotes side by side.", slug: "programme-etihad-guest", description: "See how much cash the award saves, what you get per mile, and when the award reaches your target value.", href: "/calculator/cash-or-miles/", action: "Compare cash with miles" },
];
---

<BaseLayout title="Private whole-site design directions | DubaiPoints" description="Three unselected local design compositions for owner review. Not the live website." fullWidth>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <div class="dp-site-directions" data-pagefind-ignore>
    <header class="directions-intro" id="site-direction-review-top">
      <p class="eyebrow">Private owner review · unselected · not live</p>
      <h1>One publication.<br />Three complete directions.</h1>
      <p>Compare the homepage, then the article and tool language beneath it. The content, brand and fonts stay the same; the composition and path through them change. These are prototypes, not approved replacements.</p>
      <nav class="direction-index" aria-label="Choose a complete design direction">
        {directions.map(direction => <a href={`#${direction.id}`}><span>{direction.letter}</span><strong>{direction.name}</strong><span aria-hidden="true">↘</span></a>)}
      </nav>
      <p class="review-note">Use the site's theme control for light and dark. All chapters, tasks and links work without JavaScript. Optional motion never locks scrolling or loads video.</p>
    </header>

    {directions.map(direction => (
      <section class:list={["direction", `is-${direction.id}`]} id={direction.id} aria-labelledby={`${direction.id}-title`}>
        <header class="direction-label"><div><p class="eyebrow">Direction {direction.letter} · complete homepage composition</p><h2 id={`${direction.id}-title`}>{direction.name}</h2></div><p>{direction.idea}</p></header>
        <div class="concept-home">
          <div class="concept-masthead">
            <a href="/" class="concept-wordmark"><span aria-hidden="true">↗</span>DubaiPoints</a>
            <nav aria-label={`${direction.name} preview navigation`}><a href={`#${direction.id}-tools`}>Tools</a><a href={`#${direction.id}-reporting`}>Reporting</a><a href={`#${direction.id}-guides`}>Guides</a><a href="/deals/">Deals</a></nav>
          </div>

          {direction.id === "editorial-atlas" ? (
            <header class="atlas-opening">
              <figure class="atlas-landscape"><StockImage slug="guide-expat-starter" class="concept-photo" delivery="feature" sizes="(max-width: 720px) calc(100vw - 32px), 1180px" /><figcaption><span>Dubai skyline · an aerial photograph</span><ImageCredit slug="guide-expat-starter" /></figcaption></figure>
              <div class="atlas-title" data-direction-reveal><p class="eyebrow">Independent UAE points &amp; miles publication</p><h3>Fly further.<br /><em>Pay less.</em></h3><div><p>{deck}</p><a class="text-action" href={`#${direction.id}-tools`}>Start with a tool <span aria-hidden="true">↗</span></a></div></div>
            </header>
          ) : direction.id === "runway-journal" ? (
            <header class="journal-opening">
              <figure><StockImage slug="hero-dubai-night" class="concept-photo" delivery="feature" sizes="(max-width: 720px) calc(100vw - 32px), 1180px" /><figcaption><span>Dubai, photographed · not a rendered travel scene</span><ImageCredit slug="hero-dubai-night" /></figcaption></figure>
              <div class="journal-opening-copy" data-direction-reveal><p class="eyebrow">Independent UAE points &amp; miles publication</p><h3>Fly further. <em>Pay less.</em></h3><p>{deck}</p><nav class="chapter-index" aria-label="Runway Journal chapters">{chapters.map((chapter, index) => <a href={`#journal-${chapter.id}`}><span>0{index + 1}</span>{chapter.label}<span aria-hidden="true">↓</span></a>)}</nav></div>
            </header>
          ) : (
            <header class="decision-opening">
              <div data-direction-reveal><p class="eyebrow">Independent UAE points &amp; miles publication</p><h3>Fly further.<br /><em>Pay less.</em></h3><p>{deck}</p><a class="text-action" href={`#${direction.id}-tools`}>Choose your next step <span aria-hidden="true">↘</span></a></div>
              <div class="decision-card-wall" aria-label="Real issuer card artwork, not a recommendation">
                {reviewCards.map(({ card, art, bank }) => <figure><a href={`/cards/${card.slug}/`} aria-label={card.name}><img src={`/${art.file}`} srcset={cardArtSrcset(card.slug, art)} sizes="(max-width: 600px) calc(50vw - 48px), 230px" alt={card.name} width={art.width} height={art.height} loading="lazy" decoding="async" /></a><figcaption>Card image: {bank}<a href={art.page ?? art.url}>Issuer source ↗</a></figcaption></figure>)}
                <p>Two reviews to explore—not a ranking.</p>
              </div>
            </header>
          )}

          {direction.id === "runway-journal" && (
            <div class="journal-chapters">
              {chapters.map((chapter, index) => <article class="journal-chapter" id={`journal-${chapter.id}`} data-direction-reveal><figure><StockImage slug={chapter.slug} class="concept-photo" delivery="feature" sizes="(max-width: 760px) calc(100vw - 64px), 520px" /><figcaption><ImageCredit slug={chapter.slug} /></figcaption></figure><div><p class="eyebrow">Chapter 0{index + 1} · {chapter.label}</p><h4>{chapter.title}</h4><p>{chapter.description}</p><a class="text-action" href={chapter.href}>{chapter.action} <span aria-hidden="true">↗</span></a></div></article>)}
            </div>
          )}

          {direction.id === "editorial-atlas" && (
            <section class="home-reporting atlas-briefing" id="editorial-atlas-reporting" aria-labelledby="editorial-atlas-reporting-title" data-atlas-briefing>
              <div class="section-heading"><div><p class="eyebrow">Dated, sourced reporting</p><h3 id="editorial-atlas-reporting-title">Fresh from the desk.</h3></div><a class="text-action" href="/news/">All news ↗</a></div>
              <p class="atlas-preview-help" data-atlas-help hidden>Read any headline directly. The numbered preview buttons let you explore a story without leaving the briefing.</p>
              <div class="atlas-briefing-grid">
                <div class="atlas-stories">
                  {atlasStories.map((post, index) => (
                    <article class="atlas-story" data-atlas-story>
                      <div class="atlas-story-head"><span class="atlas-story-number" aria-hidden="true">0{index + 1}</span><div><p class="story-meta">News · <time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time></p><h4><a href={`/news/${post.id}/`} data-atlas-story-link>{post.data.title}</a></h4></div></div>
                      <p class="atlas-story-description" data-atlas-description>{post.data.description}</p>
                      <button class="atlas-preview-control" type="button" hidden data-atlas-select={index} aria-pressed="false" aria-controls={`atlas-inline-${post.id}`}><span aria-hidden="true">0{index + 1}</span> Preview story <span class="sr-only">{post.data.title}</span><span aria-hidden="true">↗</span></button>
                      <div class="atlas-inline-panel" id={`atlas-inline-${post.id}`} data-atlas-inline>
                        {photoFor(post.id) ? <figure class:list={["atlas-inline-figure", { "is-issuer": photoFor(post.id)?.source === "editorial" }]}>{photoFor(post.id)?.source === "editorial" ? <img class="concept-photo" src={`/${photoFor(post.id)?.file}`} alt={photoFor(post.id)?.alt} width={photoFor(post.id)?.width} height={photoFor(post.id)?.height} loading="lazy" decoding="async" data-stock-source="editorial" /> : <StockImage slug={`news-${post.id}`} class="concept-photo" delivery="feature" sizes="(max-width: 799px) calc(100vw - 64px), 540px" />}<figcaption>{photoFor(post.id)?.source === "editorial" ? <span>Card image: <a href={photoFor(post.id)?.photographer_url ?? photoFor(post.id)?.source_url}>{photoFor(post.id)?.photographer}</a></span> : <ImageCredit slug={`news-${post.id}`} />}</figcaption></figure> : <p class="atlas-text-led">The full report carries the source detail.</p>}
                      </div>
                    </article>
                  ))}
                </div>
                <aside class="atlas-companion" id="atlas-briefing-companion" aria-label="Selected story preview" hidden>
                  <p class="eyebrow">In focus</p><div data-atlas-stage></div><h4><a href="/news/" data-atlas-companion-link>Open the news desk</a></h4><p data-atlas-companion-description></p><a class="text-action" href="/news/" data-atlas-companion-read>Read the full story ↗</a>
                </aside>
              </div>
              <p class="atlas-preview-status" role="status" aria-live="polite" aria-atomic="true" data-atlas-status></p>
            </section>
          )}

          <section class="home-tools" id={`${direction.id}-tools`} aria-labelledby={`${direction.id}-tools-title`}>
            <div class="section-heading"><div><p class="eyebrow">Start with a useful question</p><h3 id={`${direction.id}-tools-title`}>What brings you here?</h3></div><a class="text-action" href="/cards/finder/">All card choices ↗</a></div>
            {direction.id === "decision-desk" ? (
              <div class="decision-task-layout"><div class="decision-task-list">{tasks.map((task, index) => <details name="decision-desk-tasks" open={index === 0}><summary><span class="task-number">0{index + 1}</span><span>{task.label}<small>{task.title}</small></span><span class="task-toggle" aria-hidden="true">+</span></summary><div class="task-body"><p>{task.description}</p><div class="action-row"><a class="primary-action" href={task.href}>{task.action} ↗</a><a class="text-action" href={task.secondary}>{task.secondaryLabel} →</a></div></div></details>)}</div><aside class="decision-context"><p class="eyebrow">Keep the decision yours</p><h4>Published terms.<br />A clearer next step.</h4><p>A published minimum is not a guarantee of approval. Read the issuer's current terms before applying.</p><a class="text-action" href="/editorial-policy/">How we check the details ↗</a></aside></div>
            ) : (
              <div class="tool-grid">{tasks.map((task, index) => <article><span class="task-number">0{index + 1}</span><h4>{task.label}</h4><p>{task.description}</p><a class="text-action" href={task.href}>{task.action}<span aria-hidden="true">↗</span></a></article>)}</div>
            )}
          </section>

          {direction.id !== "editorial-atlas" && <section class="home-reporting" id={`${direction.id}-reporting`} aria-labelledby={`${direction.id}-reporting-title`}>
            <div class="section-heading"><div><p class="eyebrow">Dated, sourced reporting</p><h3 id={`${direction.id}-reporting-title`}>Fresh from the desk.</h3></div><a class="text-action" href="/news/">All news ↗</a></div>
            <div class="reporting-grid">
              {lead && <article class="lead-story" data-direction-reveal>{leadImage && <figure><a href={`/news/${lead.id}/`} aria-label={lead.data.title}><StockImage slug={leadImage.slug} class="concept-photo" delivery="feature" sizes="(max-width: 760px) calc(100vw - 64px), 660px" /></a><figcaption><ImageCredit slug={leadImage.slug} /></figcaption></figure>}<div class="story-body"><p class="story-meta">News <span>·</span> <time datetime={lead.data.publishedAt.toISOString()}>{date(lead.data.publishedAt)}</time></p><h4><a href={`/news/${lead.id}/`}>{lead.data.title}</a></h4><p>{lead.data.description}</p><a class="text-action" href={`/news/${lead.id}/`}>Read the story ↗</a></div></article>}
              <div class="latest-stories"><p class="eyebrow">Latest reporting</p><ol>{latest.map(post => <li><span class="story-meta"><time datetime={post.data.publishedAt.toISOString()}>{date(post.data.publishedAt)}</time></span><h4><a href={`/news/${post.id}/`}>{post.data.title}</a></h4></li>)}</ol></div>
            </div>
          </section>}

          <section class="home-live" aria-labelledby={`${direction.id}-live-title`}>
            <div class="section-heading"><div><p class="eyebrow">The practical desk</p><h3 id={`${direction.id}-live-title`}>Offers, with the conditions.</h3></div><a class="text-action" href="/deals/">Browse current deals ↗</a></div>
            <div class="live-grid"><section><h4>Salary-transfer tracker</h4>{salaryOffers.length ? <ul>{salaryOffers.map(offer => <li><a href={`/salary-transfer/${offer.bankSlug}/`}>{offer.name}<span aria-hidden="true">↗</span></a><p>{offer.bankName} · Last checked <time datetime={offer.lastVerified}>{date(offer.lastVerified)}</time></p></li>)}</ul> : <p>Open the tracker to see current coverage and recorded offer history.</p>}<a class="text-action" href="/salary-transfer/">Check all tracked offers →</a></section><section><h4>Recorded deal deadlines</h4>{deals.length ? <ul>{deals.map(deal => <li><a href={`/deals/${deal.id}/`}>{deal.data.title}<span aria-hidden="true">↗</span></a><p>Recorded expiry <time datetime={deal.data.expiresOn.toISOString()}>{date(deal.data.expiresOn)}</time></p></li>)}</ul> : <p>No live deals are listed in this build.</p>}<a class="text-action" href="/deals/">Read the offer terms →</a></section></div>
          </section>

          <section class="home-guides" id={`${direction.id}-guides`} aria-labelledby={`${direction.id}-guides-title`}>
            <div class="section-heading"><div><p class="eyebrow">Keep the useful detail</p><h3 id={`${direction.id}-guides-title`}>A guide to what comes next.</h3></div><a class="text-action" href="/guides/">The guide shelf ↗</a></div>
            <div class="guide-grid">{guideShelf.map(item => <article>{photoFor(item.id, "guide") && <figure><StockImage slug={`guide-${item.id}`} class="concept-photo" delivery="feature" sizes="(max-width: 760px) calc(100vw - 64px), 360px" /><figcaption><ImageCredit slug={`guide-${item.id}`} /></figcaption></figure>}<p class="story-meta">Updated <time datetime={item.data.updatedAt.toISOString()}>{date(item.data.updatedAt)}</time></p><h4><a href={`/guides/${item.id}/`}>{item.data.title}</a></h4><p>{item.data.description}</p></article>)}</div>
          </section>

          <footer class="concept-footer"><a href="/" class="concept-wordmark"><span aria-hidden="true">↗</span>DubaiPoints</a><p>Independent UAE points &amp; miles publication.<br />AED-first, dated and sourced.</p><nav aria-label={`${direction.name} trust links`}><a href="/editorial-policy/">Editorial standards</a><a href="/how-we-make-money/">How we make money</a><a href="/corrections/">Corrections</a></nav></footer>
        </div>

        <section class="interior-continuity" aria-labelledby={`${direction.id}-interiors-title`}>
          <header class="section-heading"><div><p class="eyebrow">The same direction, beyond the homepage</p><h3 id={`${direction.id}-interiors-title`}>One visual language.<br />Different jobs.</h3></div><p>Mini-previews of article and tool hierarchy. The links open the real pages; these panels do not recalculate or replace them.</p></header>
          <div class="interior-grid">
            <article class="article-preview"><p class="eyebrow">Article language · real story</p>{lead && <><p class="story-meta">DubaiPoints Editorial · <time datetime={lead.data.publishedAt.toISOString()}>{date(lead.data.publishedAt)}</time></p><h4>{lead.data.title}</h4><p class="preview-deck">{lead.data.description}</p><nav class="preview-contents" aria-label={`${direction.name} article preview contents`}><a href={`#${direction.id}-article-detail`}>Compare like for like ↓</a><a href={`/news/${lead.id}/`}>Open the complete story ↗</a></nav><div id={`${direction.id}-article-detail`}><h5>Compare like for like</h5><p>Use the same flight, dates, cabin and passengers. Compare baggage and change or cancellation rules before treating the two fares as equivalent.</p><p>Include taxes, fees and surcharges. Use booking-screen totals rather than an indicative mileage calculator or a “from” fare.</p><aside class="preview-next"><span>Continue this task</span><a href="/calculator/cash-or-miles/">Compare your own cash and miles quotes ↗</a></aside></div></>}</article>
            <section class="tool-preview" aria-labelledby={`${direction.id}-tool-title`}><p class="eyebrow">Tool language · real card identities</p><h4 id={`${direction.id}-tool-title`}>Compare the details.<br />Keep the conditions.</h4><p>Published minimums are not a guarantee of approval. These two reviews are examples to explore, not a ranked shortlist.</p><div class="mini-card-grid">{reviewCards.map(({ card, bank }) => <article><CompareCardArt slug={card.slug} size="identity" /><span class="story-meta">{bank} · {card.network}</span><h5><a href={`/cards/${card.slug}/`}>{card.name}</a></h5><a class="text-action" href={`/cards/${card.slug}/`}>Read review →</a></article>)}</div><div class="action-row"><a class="primary-action" href={compareHref}>Compare these cards ↗</a><a class="text-action" href="/cards/finder/">Start with your own needs →</a></div></section>
          </div>
        </section>
        <footer class="direction-notes"><p><strong>{direction.fit}</strong><br />{direction.reference}</p><a href="#site-direction-review-top" class="text-action">Compare the directions ↑</a></footer>
      </section>
    ))}
    <aside class="review-close"><p class="eyebrow">Review before rollout</p><h2>Choose the composition,<br />then test the whole journey.</h2><p>Atlas leads with discovery. Journal leads with a story. Decision Desk leads with a task. None is selected or live. Financial data, analytics and the existing homepage are unchanged.</p><nav class="direction-index" aria-label="Return to a design direction">{directions.map(direction => <a href={`#${direction.id}`}><span>{direction.letter}</span><strong>{direction.name}</strong><span aria-hidden="true">↑</span></a>)}</nav></aside>
  </div>
</BaseLayout>

<script>
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const activeMotion = new Set<Animation>();
  let entranceObserver: IntersectionObserver | undefined;
  const animatePreview = (element: Element, frames: Keyframe[], options: KeyframeAnimationOptions) => {
    if (reducedMotion.matches) return;
    const animation = element.animate(frames, options);
    activeMotion.add(animation);
    const release = () => activeMotion.delete(animation);
    animation.addEventListener("finish", release, { once: true });
    animation.addEventListener("cancel", release, { once: true });
  };
  reducedMotion.addEventListener("change", () => {
    if (!reducedMotion.matches) return;
    entranceObserver?.disconnect();
    for (const animation of activeMotion) animation.cancel();
    activeMotion.clear();
  });
  const atlas = document.querySelector<HTMLElement>("[data-atlas-briefing]");
  if (atlas) {
    const stories = [...atlas.querySelectorAll<HTMLElement>("[data-atlas-story]")];
    const buttons = [...atlas.querySelectorAll<HTMLButtonElement>("[data-atlas-select]")];
    const companion = atlas.querySelector<HTMLElement>("#atlas-briefing-companion");
    const stage = companion?.querySelector<HTMLElement>("[data-atlas-stage]");
    const title = companion?.querySelector<HTMLAnchorElement>("[data-atlas-companion-link]");
    const description = companion?.querySelector<HTMLElement>("[data-atlas-companion-description]");
    const read = companion?.querySelector<HTMLAnchorElement>("[data-atlas-companion-read]");
    const status = atlas.querySelector<HTMLElement>("[data-atlas-status]");
    const help = atlas.querySelector<HTMLElement>("[data-atlas-help]");
    const desktop = window.matchMedia("(min-width: 800px)");
    let selected = 0;
    if (stories.length && buttons.length === stories.length && companion && stage && title && description && read && status) {
      if (help) help.hidden = false;
      const show = (index: number, animate = false) => {
        selected = index;
        const story = stories[index];
        const link = story.querySelector<HTMLAnchorElement>("[data-atlas-story-link]")!;
        const panel = story.querySelector<HTMLElement>("[data-atlas-inline]")!;
        // Preserve intentional keyboard focus when a preview moves between
        // the inline phone layout and desktop companion at a resize.
        const activePreview = desktop.matches ? stories.find(item => item.querySelector("[data-atlas-inline]")?.contains(document.activeElement)) : companion.contains(document.activeElement);
        if (activePreview) buttons[index].focus({ preventScroll: true });
        for (let item = 0; item < stories.length; item++) {
          const inline = stories[item].querySelector<HTMLElement>("[data-atlas-inline]")!;
          buttons[item].hidden = false;
          buttons[item].setAttribute("aria-pressed", String(item === index));
          buttons[item].setAttribute("aria-controls", desktop.matches ? companion.id : inline.id);
          stories[item].classList.toggle("is-selected", item === index);
