---
import BaseLayout from "~/layouts/BaseLayout.astro";

// Local review only. The entire /dev/ tree is removed before Pagefind and
// production delivery by scripts/build/prune-internal-pages.mjs.
const pages = [
  ["/airlines/", "Airlines hub"],
  ["/hotels/", "Hotels hub"],
  ["/guides/", "Guides hub"],
  ["/airlines/skywards/", "Skywards programme guide"],
  ["/cards/finder/", "Card Finder"],
  ["/cards/compare/", "Card Compare"],
  ["/cards/liv-cashback-plus/", "Card review"],
  ["/salary-transfer/", "Salary Tracker"],
  ["/salary-transfer/emirates-islamic/", "Salary offer detail"],
  ["/deals/", "Deals"],
  ["/news/", "News"],
  ["/news/cash-or-miles-emirates-three-quotes/", "News article"],
  ["/banks/adcb/", "Bank hub"],
  ["/calculator/cash-or-miles/", "Calculator"],
  ["/about/", "Trust/reference page"],
];
---
<BaseLayout title="21st-inspired UI review — not live | DubaiPoints" fullWidth>
  <meta slot="head" name="robots" content="noindex,nofollow" />
  <section class="dp-review" data-pagefind-ignore>
    <header class="dp-review-head">
      <p class="eyebrow">Owner review · local candidate</p>
      <h1>DubaiPoints design preview</h1>
      <p>These are the actual working pages in light and dark mode. This new pass is not live. The homepage hero, financial data and analytics configuration are unchanged.</p>
      <label for="dp-review-page">Page to compare</label>
      <select id="dp-review-page" class="dp-ui-field">
        {pages.map(([href, label]) => <option value={href}>{label}</option>)}
      </select>
      <a class="dp-ui-action dp-ui-secondary" href="/airlines/" target="_blank" rel="noopener" data-review-full>Open selected page full-size <span aria-hidden="true">↗</span></a>
      <p class="dp-review-note">Each panel scrolls independently. Narrow this window to compare phone layouts. Full-size pages use your normal theme preference.</p>
      <p role="status" aria-live="polite" data-review-status>Preview: Airlines hub</p>
    </header>
    <div class="dp-review-grid">
      <section class="dp-review-panel" aria-labelledby="dp-preview-light">
        <h2 id="dp-preview-light">Light</h2>
        <iframe title="Light-mode page preview" src="/airlines/" data-review-frame="light"></iframe>
      </section>
      <section class="dp-review-panel" aria-labelledby="dp-preview-dark">
        <h2 id="dp-preview-dark">Dark</h2>
        <iframe title="Dark-mode page preview" src="/airlines/" data-review-frame="dark"></iframe>
      </section>
    </div>
    <noscript><p>The pages remain usable without JavaScript. Side-by-side theme overrides require JavaScript; use each page's normal theme control when viewing it full-size.</p></noscript>
  </section>
</BaseLayout>

<script>
  const picker = document.getElementById("dp-review-page") as HTMLSelectElement | null;
  const frames = Array.from(document.querySelectorAll<HTMLIFrameElement>("[data-review-frame]"));
  const full = document.querySelector<HTMLAnchorElement>("[data-review-full]");
  const status = document.querySelector<HTMLElement>("[data-review-status]");
  const permitted = new Set(Array.from(picker?.options ?? [], option => option.value));
  for (const frame of frames) {
    const applyTheme = () => {
      try {
        frame.contentDocument?.documentElement.setAttribute("data-theme", frame.dataset.reviewFrame ?? "light");
      } catch {
        // A link followed outside this local origin is not a preview target.
      }
    };
    frame.addEventListener("load", applyTheme);
    if (frame.contentDocument?.readyState === "complete") applyTheme();
  }
  picker?.addEventListener("change", () => {
    const route = picker.value;
    if (!permitted.has(route)) return;
    for (const frame of frames) frame.src = route;
    if (full) full.href = route;
    if (status) status.textContent = `Preview: ${picker.selectedOptions[0]?.textContent ?? "selected page"}`;
  });
</script>

<style>
  .dp-review { max-width: 1800px; margin: auto; padding: clamp(20px, 3vw, 48px); }
  .dp-review-head { max-width: 960px; margin-block-end: 28px; }
  .eyebrow { margin: 0 0 10px; color: var(--green); font: 650 .75rem/1.5 var(--font-ui); text-transform: uppercase; letter-spacing: .12em; }
  h1 { margin: 0 0 14px; font: 550 clamp(30px, 4vw, 52px)/1.1 var(--font-display); letter-spacing: -.025em; }
  .dp-review-head > p { margin: 0 0 18px; color: var(--ink-soft); max-width: 75ch; }
  label { display: block; margin-block-end: 8px; font: 600 .875rem/1.5 var(--font-ui); }
  select { margin: 0 12px 12px 0; width: min(100%, 360px); }
  .dp-review-note, [data-review-status] { font-size: .875rem; }
  .dp-review-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .dp-review-panel { min-width: 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--paper); }
  .dp-review-panel h2 { margin: 0; padding: 12px 16px; font: 600 1rem/1.5 var(--font-ui); border-block-end: 1px solid var(--line); }
  iframe { display: block; width: 100%; height: min(82svh, 1000px); min-height: 560px; border: 0; }
  @media (max-width: 740px) { .dp-review-grid { grid-template-columns: 1fr; } iframe { height: 720px; min-height: 0; } }
</style>
