---
import { getCollection, render } from "astro:content";
import ArticleLayout from "~/layouts/ArticleLayout.astro";
import { resolveDealIssuer } from "~/lib/dealIssuer";

export async function getStaticPaths() {
  const deals = await getCollection("deals");
  return deals.map((d) => ({
    params: { slug: d.id },
    props: { deal: d },
  }));
}

const { deal } = Astro.props;
const { Content, headings } = await render(deal);
const issuer = await resolveDealIssuer(deal);

const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

const formatCategory = (c: string) =>
  c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

const expiresStr = deal.data.expiresOn.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const verifiedStr = deal.data.lastVerified.toLocaleDateString("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const isCurrentAtBuild = !deal.data.archived && deal.data.expiresOn.getTime() >= Date.now();
const deck = isCurrentAtBuild
  ? `Last checked ${verifiedStr}; recorded to expire ${expiresStr}. Verify provider terms before acting.`
  : `Recorded expiry ${expiresStr}. Kept for archival reference.`;
---

<ArticleLayout
  title={`${deal.data.title} | DubaiPoints`}
  heading={deal.data.title}
  description={`${deal.data.title} — ${issuer.name} ${formatCategory(deal.data.category).toLowerCase()} deal, recorded to expire ${expiresStr}. AED-first verdict from DubaiPoints.`}
  crumb={`DubaiPoints / Deals / ${formatCategory(deal.data.category)}`}
  eyebrow={`DEAL · ${formatCategory(deal.data.category).toUpperCase()}`}
  deck={deck}
  publishedAt={deal.data.publishedAt}
  toc={toc}
  showHero
  heroSlug={`deal-${deal.id}`}
  heroCategory="Deal"
  heroLabel={`Deal · ${issuer.name}`}
>
  <Content />
</ArticleLayout>
