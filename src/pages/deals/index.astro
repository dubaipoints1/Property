---
// Deals index — Phase F.11 (May 2026 mockup-fidelity rebuild).
// Same composition as /guides/ (F.3), /news/ (F.4), /airlines/ (F.5):
// page header with tabs + search, 2-col grid (main feed +
// sidebar), featured deal + card grid + Trending Now + Insider Intel.
//
// Differences vs the other surfaces:
//   - Deals are time-limited. Each card carries a status pill (Live /
//     Expires-in-N-days) and a countdown line.
//   - Live deals only. Expired entries stay in the collection marked
//     `archived: true` (their /deals/<slug>/ pages render an expired
//     state); scripts/ci/check-deal-expiry.mjs enforces the sweep.
//   - Tabs use the DEAL_CATEGORY enum from content.config.ts.
//   - Empty-state band when zero live deals — points readers at the
//     news desk + RSS feed.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageGraph, siteUrlFrom } from "~/lib/schema";
import DealVisual from "~/components/deals/DealVisual.astro";
import EditorialRail from "~/components/EditorialRail.astro";
import { getCollection } from "astro:content";
import { resolveDealIssuer } from "~/lib/dealIssuer";
import { getStockEntry } from "~/lib/stockManifest";

import { getLiveDeals, daysLeft, ENDING_SOON_DAYS, SECTOR_LABELS, usesRecordedExpiryLabel } from "~/lib/deals";

const todayMs = Date.now();

const liveDeals = await getLiveDeals(todayMs);

const dealsWithBank = await Promise.all(
  liveDeals.map(async (d) => {
    const issuer = await resolveDealIssuer(d);
    return {
      entry: d,
      bankName: issuer.name,
      issuerId: d.data.bank?.id ?? d.data.program?.id ?? "",
      days: daysLeft(d, todayMs),
      hasArt: Boolean(d.data.logo || getStockEntry(`deal-${d.id}`)),
    };
  }),
);

// Offer only categories and issuers with at least one live entry.
// Without JS every deal shows and the interactive filters stay hidden.
const sectorChips = (Object.keys(SECTOR_LABELS) as (keyof typeof SECTOR_LABELS)[])
  .map((s) => ({ id: s, label: SECTOR_LABELS[s], n: liveDeals.filter((d) => d.data.sector === s).length }))
  .filter((s) => s.n > 0);
const issuerOptions = [...new Map(dealsWithBank.map((d) => [d.issuerId, d.bankName])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1]));
const codeCount = liveDeals.filter((d) => d.data.promoCode).length;
const endingSoon = dealsWithBank.filter((d, index) => index > 0 && d.days <= ENDING_SOON_DAYS);
const dealAttrs = (d: (typeof dealsWithBank)[number]) => ({
  "data-sector": d.entry.data.sector ?? "",
  "data-issuer": d.issuerId,
  "data-code": d.entry.data.promoCode ? "1" : "0",
});
const countdownText = (days: number) =>
  days === 0 ? "Ends today" : days === 1 ? "Ends tomorrow" : `Ends in ${days} days`;

const guides = (await getCollection("guides"))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());

const featured = dealsWithBank[0];
// The urgency rail replaces, rather than duplicates, those grid entries.
// Both groups keep the source's recorded-expiry order.
const endingSoonIds = new Set(endingSoon.map((d) => d.entry.id));
const others = dealsWithBank.slice(1).filter((d) => !endingSoonIds.has(d.entry.id));

// These explain using issuer offers; recency alone is not topic relevance.
const dealGuideIds = ["uae-credit-card-eligibility-2026", "dubai-shopping-festival-2026"];
const dealGuides = dealGuideIds.flatMap((id) => guides.filter((guide) => guide.id === id));

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

const formatCategory = (c: string) =>
  c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

// DSF season panel (11 October 2026, Chairman direction "all", per
// .council/briefs/2026-09-15-dsf-deals-cadence.md). Shown until the
// 2026–27 festival is over; it states only what is confirmed and points to
// the guide, and bank DSF campaigns land in the grid as ordinary deals.
const showDsf = todayMs < Date.UTC(2027, 1, 1);
const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({ siteUrl, path: "/deals/", name: "UAE bank & card deals", description: "Current UAE deals, each dated, sourced and checked against its recorded expiry.", crumbs: [{ name: "Deals", path: "/deals/" }] });
---

<BaseLayout
  title="Current UAE bank & card deals | DubaiPoints"
  description="Current UAE deals: welcome bonuses, salary-transfer top-ups, spend promos and fee waivers. Every offer is dated, sourced and checked against its recorded expiry."
  fullWidth
  schema={schema}
>
  <header class="intel-pagehead runway-deals-head">
    <div class="intel-pagehead-inner">
      <div class="crumb">DubaiPoints / Deals</div>
      <h1>Current deals.</h1>
      <p>UAE bank and card offers, with recorded expiry dates and links to the terms.</p>
    </div>
  </header>

  <div class="intel-grid runway-deals-grid">
    <div class="intel-main">
      {dealsWithBank.length === 0 ? (
        <section class="news-empty">
          <span class="news-empty-eyebrow">No live deals right now</span>
          <h2>The deal desk is between offers.</h2>
          <p>
            We only list deals that are <em>live</em> on the day you visit — expired
            offers don't sit in the archive pretending to be available. Watch the
            <a href="/salary-transfer/">salary-transfer tracker</a> for the bank offers
            currently verified, or follow the <a href="/news/">news desk</a> and its
            <a href="/rss.xml">RSS feed</a> to see the moment something lands.
          </p>
          <div class="news-empty-ctas">
            <a href="/news/" class="dp-ui-action dp-ui-primary">Read the news</a>
            <a href="/rss.xml" class="dp-ui-action dp-ui-secondary">RSS feed</a>
          </div>
        </section>
      ) : (
        <>
          <div class="deals-filters" data-deal-filters hidden>
            <label class="deals-sector">
              <span>Deal category</span>
              <select class="dp-ui-field" data-filter-sector>
                <option value="">All categories</option>
                {sectorChips.map((s) => <option value={s.id}>{s.label} ({s.n})</option>)}
              </select>
            </label>
            <details class="deals-advanced">
              <summary class="dp-ui-field">More filters <span data-extra-filters hidden></span></summary>
              <div class="deals-advanced-controls">
                <label class="deals-issuer">
                  <span>Bank or programme</span>
                  <select class="dp-ui-field" data-filter-issuer>
                    <option value="">All issuers</option>
                    {issuerOptions.map(([id, name]) => <option value={id}>{name}</option>)}
                  </select>
                </label>
                {codeCount > 0 && (
                  <label class="deals-code-filter dp-ui-filter"><input type="checkbox" data-filter-code /> Has a promo code</label>
                )}
              </div>
            </details>
            <p class="deals-count" role="status" data-deal-count>{dealsWithBank.length} live deals</p>
          </div>

          <p class="deals-sort-note">Listed by recorded expiry date. The first offer is not an editorial recommendation.</p>

          {featured && (
            <a href={`/deals/${featured.entry.id}/`} class:list={["intel-featured", { "has-art": featured.hasArt }]} aria-labelledby={`deal-${featured.entry.id}`} data-deal {...dealAttrs(featured)}>
              <div class="intel-featured-body" data-deal-offer-facts>
                <span class="intel-featured-eyebrow">Ending first · {featured.entry.data.sector ? SECTOR_LABELS[featured.entry.data.sector] : formatCategory(featured.entry.data.category)} · {featured.bankName}</span>
                <h2 id={`deal-${featured.entry.id}`}>{featured.entry.data.title}</h2>
                {featured.entry.data.eligibilityNote && <p>{featured.entry.data.eligibilityNote}</p>}
                <span class="deals-card-foot">
                  <time class:list={["deals-countdown", { "is-soon": 7 >= featured.days }]} datetime={featured.entry.data.expiresOn.toISOString().slice(0, 10)}>Recorded expiry {fmt(featured.entry.data.expiresOn)}</time>
                  {featured.entry.data.promoCode && <span class="deals-code">Code {featured.entry.data.promoCode}</span>}
                </span>
                <p class="intel-featured-meta">Last checked {fmt(featured.entry.data.lastVerified)} · See offer terms <span aria-hidden="true">→</span></p>
              </div>
              {featured.hasArt && (
                <span class="dp-deal-listing-art" data-deal-listing-art>
                  <DealVisual dealId={featured.entry.id} title={featured.entry.data.title} logo={featured.entry.data.logo}
                    merchant={featured.entry.data.merchant} bankSlug={featured.entry.data.bank?.id} bankName={featured.bankName}
                    coverSize="med" class="intel-featured-image" sizes="(max-width: 700px) calc(100vw - 34px), (max-width: 1040px) 40vw, 410px" loading="eager" />
                </span>
              )}
            </a>
          )}

          {endingSoon.length > 0 && (
            <div data-deal-soon>
              <EditorialRail id="deals-soon-h" heading="Also ending soon" description="Recorded end dates, with the same eligibility notes and codes as the full offer." class="dp-deals-offer-rail">
                {endingSoon.map((d) => (
                  <li class="dp-deal-rail-item" data-deal data-deal-soon-item {...dealAttrs(d)}>
                    <a href={`/deals/${d.entry.id}/`} class="dp-deal-rail-card" aria-labelledby={`deal-${d.entry.id}`}>
                      {d.hasArt && <span class="dp-deal-rail-art" data-deal-listing-art><DealVisual dealId={d.entry.id} title={d.entry.data.title} logo={d.entry.data.logo} merchant={d.entry.data.merchant} bankSlug={d.entry.data.bank?.id} bankName={d.bankName} coverSize="sm" class="intel-card-image" sizes="(max-width: 640px) min(82vw, 320px), 300px" /></span>}
                      <div class="intel-card-body" data-deal-offer-facts>
                        <span class="intel-card-cat">{d.entry.data.sector ? SECTOR_LABELS[d.entry.data.sector] : formatCategory(d.entry.data.category)} · {d.bankName}</span>
                        <h3 id={`deal-${d.entry.id}`}>{d.entry.data.title}</h3>
                        {d.entry.data.eligibilityNote && <p>{d.entry.data.eligibilityNote}</p>}
                        <span class="deals-card-foot">
                          {usesRecordedExpiryLabel(d.entry.id) ? (
                            <time class:list={["intel-card-meta deals-countdown", { "is-soon": 7 >= d.days }]} datetime={d.entry.data.expiresOn.toISOString().slice(0, 10)}>Recorded expiry {fmt(d.entry.data.expiresOn)}</time>
                          ) : (
                            <span class:list={["intel-card-meta deals-countdown", { "is-soon": 7 >= d.days }]}>{countdownText(d.days)}</span>
                          )}
                          {d.entry.data.promoCode && <span class="deals-code">Code {d.entry.data.promoCode}</span>}
                        </span>
                        <p class="intel-card-meta">Last checked <time datetime={d.entry.data.lastVerified.toISOString().slice(0, 10)}>{fmt(d.entry.data.lastVerified)}</time>.</p>
                      </div>
                    </a>
                  </li>
                ))}
              </EditorialRail>
            </div>
          )}

          {others.length > 0 && (
            <ul class="intel-card-grid">
              {others.map((d) => {
                return (
                  <li class="intel-card-item" data-deal {...dealAttrs(d)}>
                    <a href={`/deals/${d.entry.id}/`} class:list={["intel-card", { "has-art": d.hasArt }]} aria-labelledby={`deal-${d.entry.id}`}>
                      <div class="intel-card-body" data-deal-offer-facts>
                        <span class="intel-card-cat">
                          {d.entry.data.sector ? SECTOR_LABELS[d.entry.data.sector] : formatCategory(d.entry.data.category)} · {d.bankName}
                        </span>
                        <h2 id={`deal-${d.entry.id}`}>{d.entry.data.title}</h2>
                        {d.entry.data.eligibilityNote && <p>{d.entry.data.eligibilityNote}</p>}
                        <span class="deals-card-foot">
                          {usesRecordedExpiryLabel(d.entry.id) ? (
                            <time class:list={["intel-card-meta deals-countdown", { "is-soon": 7 >= d.days }]} datetime={d.entry.data.expiresOn.toISOString().slice(0, 10)}>Recorded expiry {fmt(d.entry.data.expiresOn)}</time>
                          ) : (
                            <span class:list={["intel-card-meta deals-countdown", { "is-soon": 7 >= d.days }]}>
                              {ENDING_SOON_DAYS >= d.days ? countdownText(d.days) : `Recorded expiry ${fmt(d.entry.data.expiresOn)}`}
                            </span>
                          )}
                          {d.entry.data.promoCode && <span class="deals-code">Code {d.entry.data.promoCode}</span>}
                        </span>
                        <p class="intel-card-meta">Last checked <time datetime={d.entry.data.lastVerified.toISOString().slice(0, 10)}>{fmt(d.entry.data.lastVerified)}</time>.</p>
                      </div>
                      {d.hasArt && (
                        <span class="dp-deal-listing-art" data-deal-listing-art>
                          <DealVisual dealId={d.entry.id} title={d.entry.data.title} logo={d.entry.data.logo} merchant={d.entry.data.merchant}
                            bankSlug={d.entry.data.bank?.id} bankName={d.bankName} coverSize="sm" class="intel-card-image"
                            sizes="clamp(63px, 7.5vw, 105px)" />
                        </span>
                      )}
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <p class="deals-none" data-deal-none hidden>No live deals match these filters. <button type="button" class="dp-ui-action dp-ui-quiet" data-filter-reset>Clear filters</button></p>
        </>
      )}
    </div>

    <aside class="intel-aside">
      <section class="deals-related" aria-label="More ways to find offers">
        <form class="intel-search" action="/search/" method="get" role="search" aria-label="Sitewide search">
          <label for="deals-search-input">Search the site</label>
          <div class="intel-search-row">
            <input id="deals-search-input" class="dp-ui-field" type="search" name="q" autocomplete="off" />
            <button type="submit" class="dp-ui-action dp-ui-secondary">Search</button>
          </div>
        </form>
        <a href="/salary-transfer/">Browse the salary-transfer tracker →</a>
      </section>
      {dealGuides.length > 0 && (
        <nav class="intel-trending" aria-label="Using bank offers">
          <div class="dp-rail-heading">Using bank offers</div>
          <ol>
            {dealGuides.map((item) => (
                <li>
                  <a href={`/guides/${item.id}/`}>{item.data.title}</a>
                </li>
            ))}
          </ol>
        </nav>
      )}

      {showDsf && (
        <section class="deals-dsf" aria-labelledby="deals-dsf-heading">
          <span class="eyebrow">Dubai Shopping Festival</span>
          <h2 id="deals-dsf-heading" class="dp-rail-heading">DSF 2026–27 bank offers land here.</h2>
          <p>
            The 32nd edition runs 4 December 2026 to 17 January 2027, per the
            organiser, Dubai Festivals and Retail Establishment. Banks publish their DSF card campaigns
            in the weeks before it opens, and each one is listed here with its terms
            and end date once it is on the bank's own page.
          </p>
          <a href="/guides/dubai-shopping-festival-2026/">The DSF card-stacking guide →</a>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  // Deals filter: category, "has a code" and issuer, combined
  // with AND. Progressive enhancement only — the controls start hidden and
  // every deal is in the HTML, so no JS means the full list.
  const root = document.querySelector<HTMLElement>("[data-deal-filters]");
  if (root) {
    root.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>("[data-deal]")];
    const soon = document.querySelector<HTMLElement>("[data-deal-soon]");
    const soonItems = [...(soon?.querySelectorAll<HTMLElement>("[data-deal-soon-item]") ?? [])];
    const sectorSel = root.querySelector<HTMLSelectElement>("[data-filter-sector]");
    const codeInput = root.querySelector<HTMLInputElement>("[data-filter-code]");
    const issuerSel = root.querySelector<HTMLSelectElement>("[data-filter-issuer]");
    const count = root.querySelector<HTMLElement>("[data-deal-count]");
    const none = document.querySelector<HTMLElement>("[data-deal-none]");
    const active = root.querySelector<HTMLElement>("[data-extra-filters]");

    const apply = (resetRail = false) => {
      const issuer = issuerSel?.value ?? "";
      const sector = sectorSel?.value ?? "";
      const codeOnly = codeInput?.checked ?? false;
      const matches = (el: HTMLElement) =>
        (!sector || el.dataset.sector === sector) &&
        (!codeOnly || el.dataset.code === "1") &&
        (!issuer || el.dataset.issuer === issuer);
      let shown = 0;
      for (const el of items) {
        el.hidden = !matches(el);
        if (!el.hidden) shown++;
      }
      for (const el of soonItems) el.hidden = !matches(el);
      if (soon) soon.hidden = soonItems.every((el) => el.hidden);
      // A new filter is a new shortlist. Start at its first matching
      // offer, while preserving normal back/forward scroll restoration.
      if (resetRail) {
        const track = soon?.querySelector<HTMLElement>("[data-editorial-track]");
        if (track) track.scrollLeft = 0;
      }
      if (active) {
        const n = Number(Boolean(issuer)) + Number(codeOnly);
        active.hidden = n === 0;
        active.textContent = n > 0 ? `(${n} active)` : "";
      }
      const filtered = sector !== "" || codeOnly || issuer !== "";
      if (count) count.textContent = filtered ? `${shown} of ${items.length} live deals` : `${items.length} live deals`;
      if (none) none.hidden = shown > 0;
    };

    sectorSel?.addEventListener("change", () => apply(true));
    codeInput?.addEventListener("change", () => apply(true));
    issuerSel?.addEventListener("change", () => apply(true));
    document.querySelector("[data-filter-reset]")?.addEventListener("click", () => {
      if (sectorSel) sectorSel.value = "";
      if (codeInput) codeInput.checked = false;
      if (issuerSel) issuerSel.value = "";
      apply(true);
      sectorSel?.focus();
    });
    apply();
    window.addEventListener("pageshow", () => apply());
  }
</script>

<style>
  .dp-deal-rail-item { display: flex; }
  .dp-deal-rail-card { display: flex; flex-direction: column; gap: 16px; inline-size: 100%; padding-block-end: 18px; border-block-end: 1px solid var(--line); color: inherit; text-decoration: none; }
  .dp-deal-rail-card:hover h3 { color: var(--green); text-decoration: underline; text-underline-offset: .16em; }
  .dp-deal-rail-card:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .dp-deal-rail-card h3 { margin: 0; color: var(--ink); font: 550 clamp(1.25rem, 2.2vw, 1.6rem)/1.15 var(--font-display); letter-spacing: -.02em; }
  .dp-deal-rail-card p { margin: 0; color: var(--ink-soft); font-size: .875rem; line-height: 1.5; }
  .dp-deal-rail-card .intel-card-body { display: grid; gap: 10px; }
  .dp-deal-rail-art { display: grid; place-items: center; min-inline-size: 0; overflow: hidden; border: 1px solid var(--line-soft); border-radius: var(--dp-ui-radius); }
  .dp-deal-rail-art :global(.intel-card-image) { display: block; inline-size: 100%; block-size: auto; aspect-ratio: 1.8; object-fit: contain; }
  /* Inherits the .intel-* idiom from /guides/, /news/, /airlines/.
     Inlined here scoped to /deals/ for evolution independence; a
     shared layout component covers the four once they stabilise. */
  .intel-pagehead {
    background: var(--paper);
    padding: clamp(22px, 4vw, 44px) clamp(16px, 3vw, 32px) clamp(16px, 3vw, 28px);
    border-bottom: 1px solid var(--line);
  }
  .intel-pagehead-inner { max-width: var(--container-listing); margin: 0 auto; }
  .intel-pagehead .crumb {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 16px;
  }
  .intel-pagehead h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 5.6vw, 58px);
    letter-spacing: -1.6px;
    line-height: 1.04;
    color: var(--green);
    margin: 0 0 8px;
  }
  .intel-pagehead p {
    max-width: 62ch;
    font-size: 15px; line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  .deals-related {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .deals-related > a { color: var(--green); font-size: 14px; }
  .intel-search { display: grid; gap: 6px; color: var(--ink); font-family: var(--font-ui); font-size: 13px; font-weight: 600; }
  .intel-search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
  .intel-grid {
    max-width: var(--container-listing);
    margin: clamp(14px, 3vw, 32px) auto var(--dp-ui-section);
    padding-inline: clamp(16px, 3vw, 32px);
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: var(--dp-ui-gap);
    align-items: start;
  }
  .intel-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }

  .intel-featured, .intel-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(10px, 2vw, 20px);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: clamp(12px, 2vw, 20px);
    text-decoration: none;
    color: inherit;
  }
  .intel-featured.has-art { grid-template-columns: minmax(0, 1fr) minmax(0, clamp(110px, 18vw, 230px)); }
  .intel-card.has-art { grid-template-columns: minmax(0, 1fr) minmax(0, clamp(80px, 11vw, 132px)); }
  .intel-featured:hover, .intel-card:hover { border-color: var(--green); }
  .intel-featured:focus-visible, .intel-card:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .dp-deal-listing-art {
    display: block;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius);
    overflow: hidden;
  }
  .dp-deal-listing-art :global(:is(.intel-featured-image, .intel-card-image)) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.5;
    object-fit: cover;
    border: 0;
  }
  .intel-featured-body { min-width: 0; display: grid; gap: 8px; }
  .intel-featured-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
  }
  .intel-featured-body h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.4vw, 34px);
    letter-spacing: -0.9px;
    line-height: 1.12;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .intel-featured:hover h2 { color: var(--green); }
  .intel-featured-body p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 64ch;
  }
  .intel-featured-meta {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.3px;
    margin-top: 4px;
  }

  .intel-card-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .intel-card-item { display: block; }
  .intel-card { height: 100%; }
