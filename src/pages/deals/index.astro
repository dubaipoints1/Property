---
// Deals index — Phase F.11 (May 2026 mockup-fidelity rebuild).
// Same composition as /guides/ (F.3), /news/ (F.4), /airlines/ (F.5):
// page header with tabs + search, 2-col grid (main feed + sticky
// sidebar), featured deal + card grid + Trending Now + Insider Intel.
//
// Differences vs the other surfaces:
//   - Deals are time-limited. Each card carries a status pill (Live /
//     Expires-in-N-days) and a countdown line.
//   - Live deals only. Expired entries stay in the collection marked
//     `archived: true` (their /deals/<slug>/ pages render an expired
//     state); scripts/ci/check-deal-expiry.mjs enforces the sweep.
//   - Tabs use the DEAL_CATEGORY enum from content.config.ts.
//   - Empty-state band when zero live deals — points readers at the
//     news desk + RSS feed.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageGraph, siteUrlFrom } from "~/lib/schema";
import DealVisual from "~/components/deals/DealVisual.astro";
import { LISTING_SIZES } from "~/lib/stockDerivatives";
import { getCollection } from "astro:content";
import { resolveDealIssuer } from "~/lib/dealIssuer";

import { getLiveDeals, daysLeft, ENDING_SOON_DAYS, SECTOR_LABELS } from "~/lib/deals";

const todayMs = Date.now();

const liveDeals = await getLiveDeals(todayMs);

const dealsWithBank = await Promise.all(
  liveDeals.map(async (d) => {
    const issuer = await resolveDealIssuer(d);
    return {
      entry: d,
      bankName: issuer.name,
      issuerId: d.data.bank?.id ?? d.data.program?.id ?? "",
      days: daysLeft(d, todayMs),
    };
  }),
);

// Offer only categories and issuers with at least one live entry.
// Without JS every deal shows and the interactive filters stay hidden.
const sectorChips = (Object.keys(SECTOR_LABELS) as (keyof typeof SECTOR_LABELS)[])
  .map((s) => ({ id: s, label: SECTOR_LABELS[s], n: liveDeals.filter((d) => d.data.sector === s).length }))
  .filter((s) => s.n > 0);
const issuerOptions = [...new Map(dealsWithBank.map((d) => [d.issuerId, d.bankName])).entries()]
  .sort((a, b) => a[1].localeCompare(b[1]));
const codeCount = liveDeals.filter((d) => d.data.promoCode).length;
const endingSoon = dealsWithBank.filter((d) => d.days <= ENDING_SOON_DAYS);
const dealAttrs = (d: (typeof dealsWithBank)[number]) => ({
  "data-sector": d.entry.data.sector ?? "",
  "data-issuer": d.issuerId,
  "data-code": d.entry.data.promoCode ? "1" : "0",
});
const countdownText = (days: number) =>
  days === 0 ? "Ends today" : days === 1 ? "Ends tomorrow" : `Ends in ${days} days`;

const guides = (await getCollection("guides"))
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime());

const featured = dealsWithBank[0];
const others = dealsWithBank.slice(1);

const trending = dealsWithBank.length >= 6 ? others.slice(0, 5) : guides.slice(0, 5);
const trendingLinkBase = dealsWithBank.length >= 6 ? "/deals" : "/guides";

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

const formatCategory = (c: string) =>
  c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");

// DSF season panel (11 October 2026, Chairman direction "all", per
// .council/briefs/2026-09-15-dsf-deals-cadence.md). Shown until the
// 2026–27 festival is over; it states only what is confirmed and points to
// the guide, and bank DSF campaigns land in the grid as ordinary deals.
const showDsf = todayMs < Date.UTC(2027, 1, 1);
const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({ siteUrl, path: "/deals/", name: "UAE bank & card deals", description: "Current UAE deals, each dated, sourced and checked against its recorded expiry.", crumbs: [{ name: "Deals", path: "/deals/" }] });
---

<BaseLayout
  title="Current UAE bank & card deals | DubaiPoints"
  description="Current UAE deals: welcome bonuses, salary-transfer top-ups, spend promos and fee waivers. Every offer is dated, sourced and checked against its recorded expiry."
  fullWidth
  schema={schema}
>
  <header class="intel-pagehead">
    <div class="intel-pagehead-inner">
      <div class="crumb">DubaiPoints / Deals</div>
      <h1>Current deals.</h1>
      <p>UAE bank and card offers, with recorded expiry dates and links to the terms.</p>
    </div>
  </header>

  <div class="intel-grid">
    <div class="intel-main">
      {dealsWithBank.length === 0 ? (
        <section class="news-empty">
          <span class="news-empty-eyebrow">No live deals right now</span>
          <h2>The deal desk is between offers.</h2>
          <p>
            We only list deals that are <em>live</em> on the day you visit — expired
            offers don't sit in the archive pretending to be available. Watch the
            <a href="/salary-transfer/">salary-transfer tracker</a> for the bank offers
            currently verified, or follow the <a href="/news/">news desk</a> and its
            <a href="/rss.xml">RSS feed</a> to see the moment something lands.
          </p>
          <div class="news-empty-ctas">
            <a href="/news/" class="news-empty-cta">Read the news →</a>
            <a href="/rss.xml" class="news-empty-cta is-ghost">RSS feed →</a>
          </div>
        </section>
      ) : (
        <>
          <div class="deals-filters" data-deal-filters hidden>
            <label class="deals-sector">
              <span>Deal category</span>
              <select data-filter-sector>
                <option value="">All categories</option>
                {sectorChips.map((s) => <option value={s.id}>{s.label} ({s.n})</option>)}
              </select>
            </label>
            <details class="deals-advanced">
              <summary>More filters <span data-extra-filters hidden></span></summary>
              <div class="deals-advanced-controls">
                <label class="deals-issuer">
                  <span>Bank or programme</span>
                  <select data-filter-issuer>
                    <option value="">All issuers</option>
                    {issuerOptions.map(([id, name]) => <option value={id}>{name}</option>)}
                  </select>
                </label>
                {codeCount > 0 && (
                  <label class="deals-code-filter"><input type="checkbox" data-filter-code /> Has a promo code</label>
                )}
              </div>
            </details>
            <p class="deals-count" role="status" data-deal-count>{dealsWithBank.length} live deals</p>
          </div>

          {featured && (
            <a href={`/deals/${featured.entry.id}/`} class="intel-featured" data-deal {...dealAttrs(featured)}>
              <DealVisual
                dealId={featured.entry.id}
                title={featured.entry.data.title}
                logo={featured.entry.data.logo}
                merchant={featured.entry.data.merchant}
                bankSlug={featured.entry.data.bank?.id}
                bankName={featured.bankName}
                coverSize="hero"
                class="intel-featured-image"
                sizes={LISTING_SIZES.featured}
                loading="eager"
              />
              <div class="intel-featured-body">
                <span class="intel-featured-eyebrow">{featured.entry.data.sector ? SECTOR_LABELS[featured.entry.data.sector] : formatCategory(featured.entry.data.category)} · {featured.bankName}</span>
                <h2>{featured.entry.data.title}</h2>
                <p>Last checked {fmt(featured.entry.data.lastVerified)} · recorded to expire {fmt(featured.entry.data.expiresOn)}.</p>
                {featured.entry.data.promoCode && <span class="deals-code">Code {featured.entry.data.promoCode}</span>}
                <span class="intel-featured-meta">
                  Read the full deal →
                </span>
              </div>
            </a>
          )}

          {others.length > 0 && (
            <ul class="intel-card-grid">
              {others.map((d) => {
                return (
                  <li class="intel-card-item" data-deal {...dealAttrs(d)}>
                    <a href={`/deals/${d.entry.id}/`} class="intel-card">
                      <DealVisual
                        dealId={d.entry.id}
                        title={d.entry.data.title}
                        logo={d.entry.data.logo}
                        merchant={d.entry.data.merchant}
                        bankSlug={d.entry.data.bank?.id}
                        bankName={d.bankName}
                        coverSize="med"
                        class="intel-card-image"
                        sizes={LISTING_SIZES.tile}
                      />
                      <div class="intel-card-body">
                        <span class="intel-card-cat">
                          {d.entry.data.sector ? SECTOR_LABELS[d.entry.data.sector] : formatCategory(d.entry.data.category)} · {d.bankName}
                        </span>
                        <h2>{d.entry.data.title}</h2>
                        <p>Last checked {fmt(d.entry.data.lastVerified)}.</p>
                        <span class="deals-card-foot">
                          <span class:list={["intel-card-meta deals-countdown", { "is-soon": 7 >= d.days }]}>
                            {ENDING_SOON_DAYS >= d.days ? countdownText(d.days) : `Recorded expiry ${fmt(d.entry.data.expiresOn)}`}
                          </span>
                          {d.entry.data.promoCode && <span class="deals-code">Code {d.entry.data.promoCode}</span>}
                        </span>
                      </div>
                    </a>
                  </li>
                );
              })}
            </ul>
          )}
          <p class="deals-none" data-deal-none hidden>No live deals match these filters. <button type="button" data-filter-reset>Clear filters</button></p>
        </>
      )}
    </div>

    <aside class="intel-aside">
      {endingSoon.length > 0 && (
        <section class="deals-soon" aria-labelledby="deals-soon-h" data-deal-soon>
          <h2 id="deals-soon-h" class="deals-soon-h">Ending soon</h2>
          <ul>
            {endingSoon.map((d) => (
              <li {...dealAttrs(d)} data-deal-soon-item>
                <a href={`/deals/${d.entry.id}/`}>
                  <span class="deals-soon-who">{d.entry.data.merchant ? `${d.entry.data.merchant} · ${d.bankName}` : d.entry.data.title}</span>
                  <span class="deals-soon-when">{countdownText(d.days)}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <section class="deals-related" aria-label="More ways to find offers">
        <form class="intel-search" action="/search/" method="get" role="search" aria-label="Sitewide search">
          <label for="deals-search-input">Search the site</label>
          <div class="intel-search-row">
            <input id="deals-search-input" type="search" name="q" autocomplete="off" />
            <button type="submit">Search</button>
          </div>
        </form>
        <a href="/salary-transfer/">Browse the salary-transfer tracker →</a>
      </section>
      {trending.length > 0 && (
        <nav class="intel-trending" aria-label="More content">
          <div class="dp-rail-heading">{dealsWithBank.length >= 6 ? "More live deals · all categories" : "From the guides desk"}</div>
          <ol>
            {trending.map((item, i) => {
              const title = "entry" in item ? item.entry.data.title : item.data.title;
              const id = "entry" in item ? item.entry.id : item.id;
              return (
                <li>
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  <a href={`${trendingLinkBase}/${id}/`}>{title}</a>
                </li>
              );
            })}
          </ol>
        </nav>
      )}

      {showDsf && (
        <section class="deals-dsf" aria-labelledby="deals-dsf-heading">
          <span class="eyebrow">Dubai Shopping Festival</span>
          <h2 id="deals-dsf-heading" class="dp-rail-heading">DSF 2026–27 bank offers land here.</h2>
          <p>
            The 32nd edition runs 4 December 2026 to 17 January 2027, per the
            organiser, Dubai Festivals and Retail Establishment. Banks publish their DSF card campaigns
            in the weeks before it opens, and each one is listed here with its terms
            and end date once it is on the bank's own page.
          </p>
          <a href="/guides/dubai-shopping-festival-2026/">The DSF card-stacking guide →</a>
        </section>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  // Deals filter: category, "has a code" and issuer, combined
  // with AND. Progressive enhancement only — the controls start hidden and
  // every deal is in the HTML, so no JS means the full list.
  const root = document.querySelector<HTMLElement>("[data-deal-filters]");
  if (root) {
    root.hidden = false;
    const items = [...document.querySelectorAll<HTMLElement>("[data-deal]")];
    const soon = document.querySelector<HTMLElement>("[data-deal-soon]");
    const soonItems = [...(soon?.querySelectorAll<HTMLElement>("[data-deal-soon-item]") ?? [])];
    const sectorSel = root.querySelector<HTMLSelectElement>("[data-filter-sector]");
    const codeInput = root.querySelector<HTMLInputElement>("[data-filter-code]");
    const issuerSel = root.querySelector<HTMLSelectElement>("[data-filter-issuer]");
    const count = root.querySelector<HTMLElement>("[data-deal-count]");
    const none = document.querySelector<HTMLElement>("[data-deal-none]");
    const active = root.querySelector<HTMLElement>("[data-extra-filters]");

    const apply = () => {
      const issuer = issuerSel?.value ?? "";
      const sector = sectorSel?.value ?? "";
      const codeOnly = codeInput?.checked ?? false;
      const matches = (el: HTMLElement) =>
        (!sector || el.dataset.sector === sector) &&
        (!codeOnly || el.dataset.code === "1") &&
        (!issuer || el.dataset.issuer === issuer);
      let shown = 0;
      for (const el of items) {
        el.hidden = !matches(el);
        if (!el.hidden) shown++;
      }
      for (const el of soonItems) el.hidden = !matches(el);
      if (soon) soon.hidden = soonItems.every((el) => el.hidden);
      if (active) {
        const n = Number(Boolean(issuer)) + Number(codeOnly);
        active.hidden = n === 0;
        active.textContent = n > 0 ? `(${n} active)` : "";
      }
      const filtered = sector !== "" || codeOnly || issuer !== "";
      if (count) count.textContent = filtered ? `${shown} of ${items.length} live deals` : `${items.length} live deals`;
      if (none) none.hidden = shown > 0;
    };

    sectorSel?.addEventListener("change", apply);
    codeInput?.addEventListener("change", apply);
    issuerSel?.addEventListener("change", apply);
    document.querySelector("[data-filter-reset]")?.addEventListener("click", () => {
      if (sectorSel) sectorSel.value = "";
      if (codeInput) codeInput.checked = false;
      if (issuerSel) issuerSel.value = "";
      apply();
      sectorSel?.focus();
    });
    apply();
    window.addEventListener("pageshow", apply);
  }
</script>

<style>
  /* Inherits the .intel-* idiom from /guides/, /news/, /airlines/.
     Inlined here scoped to /deals/ for evolution independence; a
     shared layout component covers the four once they stabilise. */
  .intel-pagehead {
    background: var(--paper);
    padding: 48px 32px 32px;
    border-bottom: 1px solid var(--line);
  }
  .intel-pagehead-inner { max-width: var(--container-listing); margin: 0 auto; }
  .intel-pagehead .crumb {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 16px;
  }
  .intel-pagehead h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 5.6vw, 58px);
    letter-spacing: -1.6px;
    line-height: 1.04;
    color: var(--green);
    margin: 0 0 14px;
  }
  .intel-pagehead p {
    max-width: 62ch;
    font-size: 15px; line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }
  .deals-related {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 14px;
  }
  .deals-related > a { color: var(--green); font-size: 14px; }
  .intel-search { display: grid; gap: 6px; color: var(--ink); font-family: var(--font-ui); font-size: 13px; font-weight: 600; }
  .intel-search-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; }
  .intel-search input[type="search"], .intel-search button {
    min-width: 0;
    min-height: 44px;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
  .intel-search input[type="search"] { font-size: 16px; }
  .intel-search button { cursor: pointer; }
  .intel-search :is(input, button):focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

  .intel-grid {
    max-width: var(--container-listing);
    margin: 32px auto 56px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .intel-main { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; }

  .intel-featured {
    display: grid; grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .intel-featured:hover {
    transform: translateY(-2px);
    border-color: var(--ink-soft);
    box-shadow: 0 20px 40px -20px rgba(15, 31, 46, 0.22);
  }
  .intel-featured :global(.intel-featured-image) {
    width: 100%; aspect-ratio: 16 / 9;
    object-fit: cover; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-featured :global(svg.dp-cover) {
    width: 100%; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-featured-body { padding: 24px 28px 28px; display: grid; gap: 10px; }
  .intel-featured-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
  }
  .intel-featured-body h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.4vw, 34px);
    letter-spacing: -0.9px;
    line-height: 1.12;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .intel-featured:hover h2 { color: var(--green); }
  .intel-featured-body p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 64ch;
  }
  .intel-featured-meta {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.3px;
    margin-top: 4px;
  }

  .intel-card-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .intel-card-item { display: block; }
  .intel-card {
    display: grid; grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none; color: inherit;
    height: 100%;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .intel-card:hover {
    transform: translateY(-2px);
    border-color: var(--ink-soft);
    box-shadow: 0 14px 28px -16px rgba(15, 31, 46, 0.18);
  }
  .intel-card :global(.intel-card-image) {
    width: 100%; aspect-ratio: 3 / 2;
    object-fit: cover; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-card :global(svg.dp-cover) {
    width: 100%; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-card-body { padding: 18px 20px 20px; display: grid; gap: 8px; }
  .intel-card-cat {
    font-family: var(--font-ui);
    font-size: 10px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--green);
  }
  .intel-card h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.3px;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .intel-card:hover h2 { color: var(--green); }
  .intel-card-body p {
    font-size: 13px; line-height: 1.5;
    color: var(--ink-soft); margin: 0;
  }
  .intel-card-meta {
    font-family: var(--font-ui);
    font-size: 11px; color: var(--muted);
    letter-spacing: 0.2px; margin-top: 2px;
  }
  /* Deals-specific countdown pill — turns gold when ≤ 7 days */
  .deals-countdown {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--shade-1);
    /* --muted on --shade-1 was 4.25:1 in light (axe, 10 Oct 2026).
       --ink-soft is 5.5:1 there and 5.7:1 on the dark --shade-1. */
    color: var(--ink-soft);
    font-weight: 700;
    align-self: start;
  }
  .deals-countdown.is-soon {
    border-color: var(--gold);
    background: var(--gold-soft);
    /* --gold-ink is theme-aware; the old literal #6c4a18 fell to ~2:1 on
       the dark --gold-soft. */
    color: var(--gold-ink);
  }

  /* Empty state — same shape as /news/. */
  .news-empty {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 40px 36px 36px;
    display: grid; gap: 14px;
  }
  .news-empty-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
  }
  .news-empty h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(26px, 3.4vw, 36px);
    letter-spacing: -0.9px;
    line-height: 1.12;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .news-empty p {
    font-size: 15px; line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 60ch;
  }
  .news-empty p a {
    color: var(--green);
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }
  .news-empty-ctas {
    display: flex; flex-wrap: wrap; gap: 10px;
    margin-top: 8px;
  }
  .news-empty-cta {
    display: inline-flex; align-items: center;
    height: 40px; padding: 0 18px;
    background: var(--ink);
    color: var(--paper);
    border-radius: 999px;
    font-family: var(--font-ui);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.3px;
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .news-empty-cta:hover { background: var(--green); }
  .news-empty-cta.is-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid var(--line);
  }
  .news-empty-cta.is-ghost:hover {
    border-color: var(--ink-soft); background: var(--shade-1);
  }

  /* Sidebar */
  .intel-aside { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 1024px) {
    .intel-aside { position: sticky; top: 32px; align-self: flex-start; }
  }
  .intel-trending {
