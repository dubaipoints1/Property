---
// News index — all desks, newest first.
// Composition lives in NewsIndexLayout (lifted from this file per the
// 2026-07-27 council session `travel-news-desks-strategy`); this page
// just supplies the full feed and the whole-newsroom empty state.

import NewsIndexLayout from "~/layouts/NewsIndexLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news")).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
---

<NewsIndexLayout
  title="UAE points, miles & banking news | DubaiPoints"
  description="UAE points-and-miles news: salary-transfer changes, card launches, programme shifts and regulatory updates, with original denominations and source links."
  crumb="DubaiPoints / News"
  heading="The news desk."
  deck="Salary-transfer changes, card launches, programme shifts and regulatory updates that affect UAE residents — with original denominations retained and the available source basis linked."
  posts={posts}
  activeDesk="all"
>
  <Fragment slot="empty">
    <span class="news-empty-eyebrow">Newsroom · being assembled</span>
    <h2>The wire is quiet — for now.</h2>
    <p>
      When the next salary-transfer change, card launch or programme
      shift lands, it'll appear here first. Until then, the
      <a href="/guides/">guides desk</a> covers the structural pieces
      that matter year-round, and the <a href="/salary-transfer/">live
      tracker</a> shows the active offers we have verified.
    </p>
    <div class="news-empty-ctas">
      <a href="/newsletter/" class="news-empty-cta">Join the launch list →</a>
      <a href="/rss.xml" class="news-empty-cta is-ghost">RSS feed →</a>
    </div>
  </Fragment>
</NewsIndexLayout>
