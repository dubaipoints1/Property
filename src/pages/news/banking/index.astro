---
// Banking desk — beat-filtered news index (2026-07-27 council session
// `travel-news-desks-strategy`). Card launches, salary-transfer cycles,
// rate and fee changes across UAE issuers.

import NewsIndexLayout from "~/layouts/NewsIndexLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("news", (p) => p.data.beat === "banking"))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---

<NewsIndexLayout
  title="UAE banking & card news | DubaiPoints"
  description="UAE banking news for points collectors: card launches, salary-transfer cycles, cashback rate cuts and fee changes across the issuers we track, with original denominations and source links."
  crumb="DubaiPoints / News / Banking"
  heading="The banking desk."
  deck="Card launches, salary-transfer cycles, rate cuts and fee changes across the UAE issuers we track, with the source basis linked and published denominations retained."
  posts={posts}
  activeDesk="banking"
>
  <Fragment slot="empty">
    <span class="news-empty-eyebrow">Banking desk · no stories yet</span>
    <h2>No banking stories filed yet.</h2>
    <p>
      When an issuer moves — a rate cut, a new card, a salary-transfer
      cycle opening or closing — the story files here. Until then the
      <a href="/salary-transfer/">live tracker</a> shows the active
      offers we have verified and the <a href="/cards/">card reviews</a> carry the current
      verified figures.
    </p>
    <div class="news-empty-ctas">
      <a href="/newsletter/" class="news-empty-cta">Join the launch list →</a>
      <a href="/rss.xml" class="news-empty-cta is-ghost">RSS feed →</a>
    </div>
  </Fragment>
</NewsIndexLayout>
