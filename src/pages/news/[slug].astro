---
import { getCollection, render } from "astro:content";
import ArticleLayout from "~/layouts/ArticleLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("news");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const toc = headings
  .filter((h) => h.depth === 2)
  .map((h) => ({ id: h.slug, label: h.text }));

const formatCategory = (c: string) =>
  c.split("-").map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
---

<ArticleLayout
  title={`${post.data.title} | DubaiPoints`}
  heading={post.data.title}
  description={post.data.description}
  crumb={`DubaiPoints / News / ${formatCategory(post.data.category)}`}
  eyebrow={formatCategory(post.data.category).toUpperCase()}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  toc={toc}
  sources={post.data.sources}
  readerContext={{ section: "news", id: post.id, category: post.data.category, cards: post.data.relatedCards.map((ref) => ref.id), programmes: post.data.relatedPrograms.map((ref) => ref.id), banks: post.data.relatedBanks.map((ref) => ref.id) }}
  showHero={!post.data.textLed}
  systemTypography={post.data.textLed}
  heroSlug={`news-${post.id}`}
  photoLead={post.id === "flydubai-dubai-skopje-three-weekly-from-1-april-2027"}
>
  <Content />
</ArticleLayout>
