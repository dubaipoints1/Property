---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SearchSurface from "~/components/search/SearchSurface.astro";
---

<BaseLayout
  title="Search | DubaiPoints"
  description="Search every UAE credit card review, salary-transfer offer, points-and-miles guide, and lifestyle deal on DubaiPoints."
  fullWidth
>
  <header class="dp-pagehead is-narrow dp-utility-head">
    <p class="dp-search-eyebrow">The DubaiPoints library</p>
    <h1>What are you looking for?</h1>
    <p class="deck">Find the card, programme, news or guide you need. All in one place.</p>
  </header>
  <SearchSurface />
</BaseLayout>

<style>
  .dp-utility-head { max-width: 900px; padding-bottom: 16px; }
  .dp-search-eyebrow { margin: 0 0 16px; color: var(--green); font: 700 11px/1.5 var(--font-ui); letter-spacing: 1.5px; text-transform: uppercase; }
</style>
