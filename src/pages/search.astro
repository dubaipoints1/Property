---
import BaseLayout from "~/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search | DubaiPoints"
  description="Search every UAE credit card review, salary-transfer offer, points-and-miles guide, and lifestyle deal on DubaiPoints."
  fullWidth
>
  <header class="dp-pagehead is-narrow dp-utility-head">
    <h1>Search DubaiPoints</h1>
    <p class="deck">Find a card, an offer, a loyalty programme or a guide.</p>
  </header>

  <div class="dp-search-body">
    <p class="dp-search-tip" id="search-tip">Use quotation marks to search for an exact phrase, such as <code>"salary transfer"</code>.</p>
    <noscript>
      <p class="dp-search-fallback">
        Search requires JavaScript. The full site map is on the
        <a href="/sitemap-index.xml">sitemap</a>, or browse by section:
        <a href="/cards/">Cards</a> · <a href="/guides/">Guides</a> ·
        <a href="/news/">News</a> · <a href="/deals/">Deals</a> ·
        <a href="/airlines/">Airlines</a> · <a href="/hotels/">Hotels</a> ·
        <a href="/banks/">Banks</a>.
      </p>
    </noscript>
    <div id="search" class="dp-search-results" data-pagefind-ignore></div>

  </div>
</BaseLayout>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  window.addEventListener("DOMContentLoaded", () => {
    if (typeof window.PagefindUI === "undefined") return;
    const ui = new window.PagefindUI({
      element: "#search",
      showImages: false,
      resetStyles: false,
      autofocus: window.matchMedia("(min-width: 1024px) and (pointer: fine)").matches,
      showSubResults: true,
    });
    // Directory search forms submit here with ?q= (2026-09-06 audit, F-015).
    const q = new URLSearchParams(window.location.search).get("q");
    if (q && typeof ui.triggerSearch === "function") ui.triggerSearch(q);
    // Pagefind labels its input by title only (axe label-title-only).
    const input = document.querySelector(".pagefind-ui__search-input");
    if (input) {
      input.setAttribute("aria-label", "Search DubaiPoints");
      input.setAttribute("aria-describedby", "search-tip");
    }
  });
</script>

<style>
  /* Reserve room for the results Pagefind injects, so the tip and footer
     below do not jump when they arrive (layout shift 0.47 on a phone,
     8 Oct 2026 audit). */
  .dp-search-results { min-height: 70vh; }
  .dp-utility-head { max-width: 760px; padding-bottom: 16px; }
  .dp-search-body {
    max-width: 760px;
    margin: 0 auto;
    padding: 16px 32px 32px;
  }
  @media (max-width: 640px) {
    .dp-search-body { padding: 16px 20px 32px; }
  }
  #search { margin-bottom: 24px; }
  /* The remaining shift was inside the list, not below it (10 Oct 2026
     CLS probe at 390px, throttled, ?q=): Pagefind draws each result as a
     ~114px loading skeleton, then swaps in the real row (often ~60px) as
     each fragment arrives, so every row under a loaded one jumps. Keep the
     list unpainted until no row is still loading; it then appears once,
     settled. The result count above it stays visible meanwhile. Shifts of
     unpainted nodes are not layout shifts. Browsers without :has() keep
     the old behaviour. */
  :global(.pagefind-ui__results:has(.pagefind-ui__loading)) { visibility: hidden; }
  /* Override Pagefind UI defaults to match design idiom */
  /* Pagefind keeps its Clear button in the tab order while it is
     invisible (opacity 0) — a focus stop with no visible ring
     (2026-09-06 audit, F-025). */
  :global(.pagefind-ui__search-clear.pagefind-ui__suppressed) { display: none; }
  :global(.pagefind-ui) {
    --pagefind-ui-primary: var(--green);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--paper);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--shade-1);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--dp-ui-radius);
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-ui);
  }
  :global(.pagefind-ui__search-input) {
    font-family: var(--font-ui);
    font-size: 16px !important;
  }
  :global(.pagefind-ui__search-input:focus-visible),
  :global(.pagefind-ui__search-clear:focus-visible) {
    outline: 2px solid var(--green);
    outline-offset: 2px;
  }
  .dp-search-fallback {
    padding: 16px;
    background: var(--shade-1);
    border-radius: var(--dp-ui-radius);
  }
  .dp-search-fallback, .dp-search-tip {
    font-size: 0.875rem;
    color: var(--ink-soft);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .dp-search-tip code {
    background: var(--paper);
    padding: 1px 6px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--ink);
    border: 1px solid var(--line);
  }
  .dp-search-fallback a {
    color: var(--green);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
