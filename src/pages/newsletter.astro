---
import TrustPageLayout from "~/layouts/TrustPageLayout.astro";
import NewsletterSignup from "~/components/NewsletterSignup.astro";

const buttondownUsername = (import.meta.env.PUBLIC_BUTTONDOWN_USERNAME as string | undefined)?.trim();
const automatedSignupReady = Boolean(
  buttondownUsername && /^[a-zA-Z0-9_-]+$/.test(buttondownUsername),
);
---

<TrustPageLayout
  title="Join the Friday brief | DubaiPoints"
  description="Join the DubaiPoints Friday brief for UAE salary-transfer changes, card offers, miles redemptions and lifestyle deals."
  eyebrow="Friday brief"
  heading={automatedSignupReady
    ? "The Friday brief, in your inbox."
    : "The Friday brief is preparing for launch."}
  deck={automatedSignupReady
    ? "One Friday email with UAE salary-transfer changes, card offers, worthwhile miles redemptions and lifestyle deals."
    : "The brief is preparing for launch. Join the launch list while automated sign-up is being configured."}
  lastUpdated={new Date("2026-08-05")}
>
  <section>
    <h2>{automatedSignupReady ? "Join the brief" : "Join the launch list"}</h2>
    <NewsletterSignup source="newsletter-page" />
    <p>
      Automated delivery uses <a href="https://buttondown.email/" target="_blank" rel="noopener">Buttondown</a>.
      The embedded form remains disabled until the public account name and
      confirmation, privacy and tracking settings have been verified.
    </p>
  </section>

  <section>
    <h2>What you'll get</h2>
    <ul>
      <li>A Friday-morning send with the week's UAE points and banking news once the brief launches.</li>
      <li>Salary-transfer updates grouped by the five salary bands used by the live tracker.</li>
      <li>Time-bound deal alerts only when the deal is worth your time (we use the lifestyle-culture editor's judgement, not affiliate volume).</li>
    </ul>
  </section>

  <section>
    <h2>What you won't get</h2>
    <ul>
      <li>Pop-up newsletter modals while you're trying to read.</li>
      <li>Affiliate links disguised as editorial picks.</li>
      <li>Sold email addresses or subscriber lists shared with advertisers. Cloudflare Web Analytics measures site use without cookies. If the form is enabled, Buttondown processes subscription and delivery data under the disclosure above.</li>
    </ul>
  </section>

  <section>
    <h2>RSS already works</h2>
    <p>
      If you prefer RSS over email, the site-wide feed is at
      <a href="/rss.xml"><code>/rss.xml</code></a>. Per-band salary-transfer
      feeds are not yet available; they will be linked here only after they
      ship. See the <a href="/editorial-policy/">editorial policy</a> for
      what we publish and how often.
    </p>
  </section>

  <section class="related">
    <h3>Related</h3>
    <ul>
      <li><a href="/editorial-policy/">Editorial policy</a></li>
      <li><a href="/how-we-make-money/">How we make money</a></li>
      <li><a href="/about/">About DubaiPoints</a></li>
    </ul>
  </section>
</TrustPageLayout>
