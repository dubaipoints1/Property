---
// Runway Editorial: a credited programme photograph leads the index,
// followed by a programme grid that becomes a reader-operated rail on
// phones. The directory, not the photograph, owns programme discovery.

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageGraph, siteUrlFrom } from "~/lib/schema";
import StockImage from "~/components/StockImage.astro";
import ImageCredit from "~/components/ImageCredit.astro";
import EditorialHubHero from "~/components/EditorialHubHero.astro";
import EditorialRail from "~/components/EditorialRail.astro";
import { LISTING_SIZES } from "~/lib/stockDerivatives";
import { getStockEntry } from "~/lib/stockManifest";
import { getCollection } from "astro:content";
import { isHotelProgramme } from "~/lib/programmes";

// Hotel programmes moved to /hotels/ on 11 October 2026 (closing R5); this
// directory lists airline programmes only and points across with one tile.
const programmes = (await getCollection("programs", (p) => !isHotelProgramme(p.id))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const hotelCount = (await getCollection("programs", (p) => isHotelProgramme(p.id))).length;

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);

// Featured programme — Skywards if present (UAE-flag carrier),
// otherwise the first A–Z.
const featured = programmes.find((p) => p.id === "skywards") ?? programmes[0];
const others = programmes.filter((p) => p.id !== featured?.id);
const featuredPhoto = featured ? `programme-${featured.id}` : undefined;
const runwayPhotoEntry = featuredPhoto ? getStockEntry(featuredPhoto) : undefined;
const runwayFeatured = runwayPhotoEntry?.source === "pexels" || runwayPhotoEntry?.source === "unsplash" ? featured : undefined;
const supportingProgramme = others.find((p) => {
  const entry = getStockEntry(`programme-${p.id}`);
  return entry?.source === "pexels" || entry?.source === "unsplash";
});

// Trending rail — cross-section guides today (programmes collection is
// thin). Falls back to programmes once the section has ≥ 6 entries.
const trending =
  programmes.length >= 6 ? others.slice(0, 5) : guides.slice(0, 5);
const trendingLinkBase = programmes.length >= 6 ? "/airlines" : "/guides";

// Sibling reads (not category filters) — keep these honest: each pivot
// goes to a real, distinct surface the reader will recognise. Generic
// /guides/ "transfer partners" tab dropped (it leaked off-section and
// the guides index isn't filtered to transfer-partner content).
const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({ siteUrl, path: "/airlines/", name: "Airlines & loyalty programmes", description: "Skywards, Etihad Guest, Qatar Privilege Club and the other airline programmes UAE residents earn and redeem in.", crumbs: [{ name: "Airlines & loyalty", path: "/airlines/" }] });
---

<BaseLayout
  title="UAE airlines & loyalty programmes | DubaiPoints"
  description="Skywards, Etihad Guest, Qatar Privilege Club and the other airline programmes UAE residents earn and redeem in. Tiers, sweet spots, transfer partners and expiry policy."
  fullWidth
  schema={schema}
>
  <header class="intel-pagehead dp-runway-pagehead" data-runway-airlines-hero>
    <div class="intel-pagehead-inner">
      <EditorialHubHero
        primary={runwayFeatured && featuredPhoto ? { slug: featuredPhoto, href: `/airlines/${runwayFeatured.id}/`, title: runwayFeatured.data.name, headingId: "runway-feature-heading", eyebrow: `Flagship programme · ${runwayFeatured.data.region}`, description: `Tiers, sweet spots, transfer partners and expiry policy for ${runwayFeatured.data.currencyName} earned and redeemed from the UAE.` } : undefined}
        secondary={supportingProgramme ? { slug: `programme-${supportingProgramme.id}`, href: `/airlines/${supportingProgramme.id}/`, title: supportingProgramme.data.name } : undefined}
      >
      <div class="crumb">DubaiPoints / Airlines</div>
      <h1>Airlines &amp; loyalty.</h1>
      <p>Compare how to earn, transfer and spend miles from the UAE. Each programme guide explains tiers, redemption examples and when miles expire.</p>

      <div class="intel-tools">
        <nav class="intel-tabs" aria-label="Points and miles tools">
          <a href="/transfer-finder/" class="dp-ui-action dp-ui-primary">Find transfer routes</a>
          <a href="/valuations/" class="dp-ui-action dp-ui-secondary">Compare points values</a>
        </nav>
        <form class="intel-search dp-runway-search" action="/search/" method="get" role="search">
          <label class="intel-search-label" for="airlines-search-input">Search DubaiPoints</label>
          <input
            id="airlines-search-input"
            type="search"
            name="q"
            class="dp-ui-field"
            placeholder="Search DubaiPoints…"
            autocomplete="off"
          />
          <button class="dp-ui-action dp-ui-secondary" type="submit">Search</button>
        </form>
      </div>

      </EditorialHubHero>
    </div>
  </header>

  <div class="intel-grid dp-runway-listing">
    <div class="intel-main">
      {featured && !runwayFeatured && (
        <a href={`/airlines/${featured.id}/`} class="intel-featured">
          <StockImage
            slug={`programme-${featured.id}`}
            coverTitle={featured.data.name}
            coverCategory="Programme"
            coverSize="hero"
            class="intel-featured-image"
            sizes={LISTING_SIZES.featured}
            loading="eager"
          />
          <div class="intel-featured-body">
            <span class="intel-featured-eyebrow">Flagship programme · {featured.data.region}</span>
            <h2>{featured.data.name}</h2>
            <p>Tiers, sweet spots, transfer partners and expiry policy for {featured.data.currencyName} earned and redeemed from the UAE.</p>
            <span class="intel-featured-meta">
              {featured.data.currencyName}
            </span>
          </div>
        </a>
      )}

      {others.length > 0 ? (
          <div data-runway-programme-rail>
          <EditorialRail id="airline-programmes" heading="Explore programmes" class="airlines-group">
              {others.map((p) => (
                <li class="intel-card-item">
                  <a href={`/airlines/${p.id}/`} class="intel-card">
                    <StockImage
                      slug={`programme-${p.id}`}
                      coverTitle={p.data.name}
                      coverCategory="Programme"
                      coverSize="med"
                      class="intel-card-image"
                      sizes="(max-width: 640px) min(76vw, 290px), (max-width: 1023px) 45vw, 270px"
                    />
                    <div class="intel-card-body">
                      <span class="intel-card-cat">{p.data.region}</span>
                      <h3>{p.data.name}</h3>
                      <p>{p.data.currencyName} · {p.data.sweetSpots[0]?.title ?? "Programme guide"}</p>
                      <span class="intel-card-meta">{p.data.transferPartners.length} transfer partner{p.data.transferPartners.length === 1 ? "" : "s"}</span>
                    </div>
                  </a>
                  <ImageCredit slug={`programme-${p.id}`} class="dp-runway-tile-credit" />
                </li>
              ))}
          </EditorialRail>
          </div>
      ) : (
        <section class="airlines-roster">
          <span class="airlines-roster-eyebrow">More programmes coming</span>
          <h2>The desk is filling in the rest.</h2>
          <p>
            Etihad Guest, Qatar Privilege Club, Saudia Alfursan and the major
            hotel programmes (Marriott Bonvoy, Hilton Honors, Hyatt, Accor
            ALL) all get their own programme page as the Travel-Experiences
            Editor publishes them.
          </p>
          <p>
            Until they land, the <a href={`/airlines/${featured?.id ?? "skywards"}/`}>flagship Skywards guide</a> covers the programme most UAE residents earn into by default, and the <a href="/guides/">guides desk</a> covers cross-programme strategy (transfers, sweet spots, redemption mechanics).
          </p>
        </section>
      )}

      {hotelCount > 0 && (
        <a href="/hotels/" class="airlines-hotels-pointer">
          <span class="airlines-roster-eyebrow">Hotel programmes</span>
          <span class="airlines-hotels-pointer-title">Marriott Bonvoy, Hilton Honors, Accor ALL, World of Hyatt and IHG One Rewards have their own section →</span>
        </a>
      )}
    </div>

    {trending.length > 0 && (
    <aside class="intel-aside">
      {trending.length > 0 && (
        <nav class="intel-trending" aria-label="Trending content">
          <div class="dp-rail-heading">{programmes.length >= 6 ? "More programmes" : "From the guides desk"}</div>
          <ol>
            {trending.map((item, i) => {
              const title = "title" in item.data ? item.data.title : item.data.name;
              return (
                <li>
                  <span class="num">{String(i + 1).padStart(2, "0")}</span>
                  <a href={`${trendingLinkBase}/${item.id}/`}>{title}</a>
                </li>
              );
            })}
          </ol>
        </nav>
      )}
    </aside>
    )}
  </div>
</BaseLayout>

<style>
  [data-runway-programme-rail] .intel-card-item { display: flex; flex-direction: column; min-inline-size: 0; }
  [data-runway-programme-rail] .intel-card { flex: 1; block-size: auto; transition: border-color .15s ease; }
  [data-runway-programme-rail] .intel-card:hover { transform: none; box-shadow: none; }
  [data-runway-programme-rail] .intel-card:focus-visible { outline: 2px solid var(--green); outline-offset: -3px; }
  [data-runway-programme-rail] :global(.dp-runway-tile-credit) { padding-inline: 2px; overflow-wrap: anywhere; }
  /* Inherits the same .intel-* idiom as /guides/ and /news/.
     Reproduced scoped to /airlines/ so the three siblings can evolve
     independently. If they stay locked, a future refactor lifts these
     into a shared `ArticleIndexLayout`. */
  .intel-pagehead {
    background: var(--paper);
    padding: 48px 32px 32px;
    border-bottom: 1px solid var(--line);
  }
  .intel-pagehead-inner { max-width: var(--container-listing); margin: 0 auto; }
  .intel-pagehead .crumb {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 16px;
  }
  .intel-pagehead h1 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(38px, 5.6vw, 58px);
    letter-spacing: -1.6px;
    line-height: 1.04;
    color: var(--green);
    margin: 0 0 14px;
  }
  .intel-pagehead p {
    max-width: 62ch;
    font-size: 15px; line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 28px;
  }
  .intel-tools {
    display: flex; flex-wrap: wrap;
    gap: 16px 24px;
    align-items: center;
    justify-content: space-between;
  }
  .intel-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
  .intel-search-label {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip: rect(0,0,0,0);
  }
  .intel-search input[type="search"] {
    font-family: var(--font-ui);
    font-size: 16px;
    color: var(--ink);
    width: 100%;
  }
  .intel-search input[type="search"]::placeholder { color: var(--muted); }

  .intel-grid {
    max-width: var(--container-listing);
    margin: 32px auto 56px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .intel-main { display: grid; gap: 28px; }

  .intel-featured {
    display: grid; grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none; color: inherit;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .intel-featured:hover {
    transform: translateY(-2px);
    border-color: var(--ink-soft);
    box-shadow: 0 20px 40px -20px rgba(15, 31, 46, 0.22);
  }
  .intel-featured :global(.intel-featured-image) {
    width: 100%; aspect-ratio: 16 / 9;
    object-fit: cover; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-featured :global(svg.dp-cover) {
    width: 100%; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-featured-body { padding: 24px 28px 28px; display: grid; gap: 10px; }
  .intel-featured-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
  }
  .intel-featured-body h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3.4vw, 34px);
    letter-spacing: -0.9px;
    line-height: 1.12;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .intel-featured:hover h2 { color: var(--green); }
  .intel-featured-body p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin: 0;
    max-width: 64ch;
  }
  .intel-featured-meta {
    font-family: var(--font-ui);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.3px;
    margin-top: 4px;
  }

  .intel-card-grid {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .intel-card-item { display: block; }
  .intel-card {
    display: grid; grid-template-rows: auto 1fr;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none; color: inherit;
    height: 100%;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .intel-card:hover {
    transform: translateY(-2px);
    border-color: var(--ink-soft);
    box-shadow: 0 14px 28px -16px rgba(15, 31, 46, 0.18);
  }
  .intel-card :global(.intel-card-image) {
    width: 100%; aspect-ratio: 3 / 2;
    object-fit: cover; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-card :global(svg.dp-cover) {
    width: 100%; display: block;
    border-bottom: 1px solid var(--line);
  }
  .intel-card-body { padding: 18px 20px 20px; display: grid; gap: 8px; }
  .intel-card-cat {
    font-family: var(--font-ui);
    font-size: 10px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--green);
  }
  .intel-card h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 18px;
    letter-spacing: -0.3px;
    line-height: 1.25;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .intel-card:hover h3 { color: var(--green); }
  .intel-card-body p {
    font-size: 13px; line-height: 1.5;
    color: var(--ink-soft); margin: 0;
  }
  .intel-card-meta {
    font-family: var(--font-ui);
    font-size: 11px; color: var(--muted);
    letter-spacing: 0.2px; margin-top: 2px;
  }

  .airlines-roster {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 32px 32px 36px;
    display: grid; gap: 12px;
  }
  .airlines-group + .airlines-group { margin-top: 32px; }
  .airlines-group-heading {
    font-family: var(--font-display); font-weight: 500; font-size: 22px;
    letter-spacing: -0.2px; margin: 0 0 14px;
  }
  .airlines-hotels-pointer {
    display: grid; gap: 6px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .airlines-hotels-pointer:hover { border-color: var(--ink-soft); }
  .airlines-hotels-pointer-title {
    font-family: var(--font-display); font-weight: 500; font-size: 18px;
    letter-spacing: -0.2px; line-height: 1.3; color: var(--ink);
  }
  .airlines-hotels-pointer:hover .airlines-hotels-pointer-title { color: var(--green); }
  .airlines-roster-eyebrow {
    font-family: var(--font-ui);
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
  }
  .airlines-roster h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(22px, 3vw, 30px);
    letter-spacing: -0.7px;
    line-height: 1.18;
    color: var(--ink);
    margin: 0;
    text-wrap: balance;
  }
  .airlines-roster p {
    font-size: 14px; line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
    max-width: 60ch;
  }
  .airlines-roster a {
    color: var(--green);
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }

  .intel-aside { display: flex; flex-direction: column; gap: 20px; }
  @media (min-width: 1024px) {
    .intel-aside { position: sticky; top: 32px; align-self: flex-start; }
  }
  .intel-trending {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 22px;
  }
  .intel-trending .dp-rail-heading {
    font-family: var(--font-ui);
    font-size: 11px; letter-spacing: 2.5px;
    text-transform: uppercase; color: var(--green);
    margin: 0 0 14px; font-weight: 700;
  }
  .intel-trending ol { list-style: none; padding: 0; margin: 0; }
  .intel-trending li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line-soft);
    font-size: 13px; color: var(--ink-soft);
    display: flex; gap: 12px;
    line-height: 1.35;
  }
  .intel-trending li:last-child { border-bottom: 0; }
  .intel-trending .num {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    font-size: 11px; min-width: 20px;
    flex-shrink: 0; font-weight: 700;
    letter-spacing: 1px;
  }
  .intel-trending a {
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 500; letter-spacing: -0.2px;
    text-decoration: none;
  }
  .intel-trending a:hover { color: var(--green); }

  @media (max-width: 1023px) {
    .intel-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .intel-pagehead { padding: 32px 20px 24px; }
    .intel-grid { padding: 0 20px; margin-top: 24px; gap: 28px; }
    .intel-card-grid { grid-template-columns: 1fr; }
    .airlines-roster { padding: 24px 22px 28px; }
  }

  /* Photo-led composition with copy and credits in flow. */
  .dp-runway-pagehead {
    background: var(--shade-1);
    padding: clamp(24px, 4.5vw, 64px) clamp(16px, 3vw, 32px);
  }
  .dp-runway-pagehead .crumb { margin-block-end: 12px; }
  .dp-runway-pagehead h1 {
    max-inline-size: 13ch;
    color: var(--ink);
    font-size: clamp(2.65rem, 6.25vw, 5.4rem);
    letter-spacing: -.045em;
    line-height: .98;
    text-wrap: balance;
  }
  .dp-runway-pagehead .intel-pagehead-inner > p {
    max-inline-size: 43ch;
    margin-block-end: 18px;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
  }
  .dp-runway-pagehead .intel-tools { flex-flow: column nowrap; align-items: flex-start; gap: 12px; }
  .dp-runway-pagehead .intel-tabs { flex: none; gap: 8px; }
  .intel-search.dp-runway-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px;
    inline-size: min(100%, 27rem);
    min-inline-size: 0;
    height: auto;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
  }
  .dp-runway-search input[type="search"] {
    border: 1px solid var(--muted);
    background: var(--paper);
    border-radius: var(--dp-ui-radius);
  }
  .dp-runway-feature { min-inline-size: 0; margin-block-start: 24px; }
  .dp-runway-feature-figure { margin: 0; }
  .dp-runway-feature-figure :global(.dp-runway-feature-image) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--dp-ui-radius);
  }
  .dp-runway-feature-text {
    display: grid;
    gap: 5px;
    margin-block-start: 16px;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--line);
  }
  .dp-runway-feature-text h2 {
    margin: 0;
    font: 600 clamp(1.5rem, 3vw, 2.25rem) / 1.1 var(--font-display);
    text-wrap: balance;
  }
  .dp-runway-feature-text a {
    display: inline-flex;
    align-items: center;
    gap: .35em;
    min-block-size: 44px;
    color: var(--green);
    text-decoration: underline;
    text-underline-offset: .16em;
  }
  .dp-runway-feature-text a span { font-family: var(--font-ui); font-size: .65em; }
  .dp-runway-feature-text a:hover { color: var(--link); }
  .dp-runway-feature-text p { margin: 0; }
  @media (min-width: 800px) {
    .dp-runway-pagehead-split .intel-pagehead-inner {
      display: grid;
      grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr);
      grid-template-rows: 1fr repeat(4, auto) 1fr;
      column-gap: clamp(32px, 5vw, 80px);
      align-items: start;
    }
    .dp-runway-pagehead-split .crumb { grid-area: 2 / 1; }
    .dp-runway-pagehead-split h1 { grid-area: 3 / 1; }
    .dp-runway-pagehead-split .intel-pagehead-inner > p { grid-area: 4 / 1; }
    .dp-runway-pagehead-split .intel-tools { grid-area: 5 / 1; }
    .dp-runway-feature { grid-area: 1 / 2 / 7; margin-block-start: 0; }
  }

  .dp-runway-listing {
    grid-template-columns: minmax(0, 1fr);
    padding-inline: clamp(16px, 3vw, 32px);
    margin-block-start: clamp(24px, 4vw, 48px);
  }
  .dp-runway-listing > .intel-main {
    grid-template-columns: minmax(0, 1fr);
    min-inline-size: 0;
  }
  .dp-runway-listing > .intel-aside { position: static; }
  .dp-runway-rail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px 14px;
    flex-wrap: wrap;
    margin-block-end: 12px;
  }
  .dp-runway-rail-header h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.65rem, 3.25vw, 2.55rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .dp-runway-rail-controls { display: none; gap: 8px; }
  .dp-runway-rail-controls .dp-carousel-btn {
    min-inline-size: var(--dp-ui-control);
    min-block-size: var(--dp-ui-control);
    border-color: var(--muted);
    font-size: 1.15rem;
  }
  .dp-runway-rail-controls .dp-carousel-btn:disabled { cursor: default; }
