---
// Guides index — Phase F.3 (May 2026 mockup-fidelity rebuild).
// Reference: Replit Canvas mockup, page 03 (Articles & Guides / "All Intel").
//
// Composition mirrors the mockup top-to-bottom:
//   1. Page header — "All intel" h1 + subtitle + category tabs + search input
//   2. 2-column layout (≥1024px): main feed (left 2fr) + sticky sidebar (right 1fr)
//      Main feed:
//        a. Featured guide — full-width hero card with FEATURED GUIDE eyebrow
//        b. Grid of guide cards (2-column at ≥640px, 1-column below)
//      Sidebar:
//        a. Trending Now — numbered list of top 5 guides by updatedAt
//        (the newsletter card was removed 14 Oct 2026)
//
// Dropped from prior layout (Chairman directive 2026-05-14):
//   - .dp-featured-band 7-card mosaic (1 hero + 2 med + 4 small)
//   - .dp-pullquote editorial-standard quote
//   - .dp-feed numbered list

import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageGraph, siteUrlFrom } from "~/lib/schema";
import StockImage from "~/components/StockImage.astro";
import { getStockEntry } from "~/lib/stockManifest";
import { getCollection } from "astro:content";

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

// Featured guide — pillar Expat Starter cornerstone if present,
// otherwise the freshest by updatedAt.
const featured = guides.find((g) => g.id === "expat-starter") ?? guides[0];
const others = guides.filter((g) => g.id !== featured?.id);

const recentlyUpdated = others.slice(0, 5);

// Routes to the existing topic hubs and cornerstone guides, not filters.
const tabs = [
  { label: "Salary transfer", href: "/salary-transfer/" },
  { label: "Account opening", href: "/banks/" },
  { label: "Eligibility", href: "/guides/uae-credit-card-eligibility-2026/" },
  { label: "Redemptions", href: "/airlines/" },
];
const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({ siteUrl, path: "/guides/", name: "UAE points, miles & banking guides", description: "Long-form, AED-first guides to UAE cards, salary transfer and miles.", crumbs: [{ name: "Guides", path: "/guides/" }] });
---

<BaseLayout
  title="UAE points, miles & banking guides | DubaiPoints"
  description="Long-form, AED-first guides to UAE credit-card eligibility, salary-transfer mechanics, miles redemption strategy, and expat-specific friction."
  fullWidth
  schema={schema}
>
  <!-- ── 1. Page header ─────────────────────────────────────────────── -->
  <header class="intel-pagehead">
    <div class="intel-pagehead-inner">
      <div class="crumb">DubaiPoints / Guides</div>
      <h1>UAE points and banking guides</h1>
      <p>Practical guides to choosing a card, switching salary accounts and using points, with dated source links.</p>

      <div class="intel-tools">
        <nav class="intel-tabs" aria-label="Explore guide topics">
          {tabs.map((t) => <a href={t.href} class="dp-ui-action dp-ui-secondary">{t.label}</a>)}
        </nav>
        <form class="intel-search" action="/search/" method="get" role="search" aria-label="Site search from guides">
          <label class="intel-search-label" for="intel-search-input">Search DubaiPoints</label>
          <input
            id="intel-search-input"
            class="dp-ui-field"
            type="search"
            name="q"
            placeholder="Search DubaiPoints"
            autocomplete="off"
          />
          <button class="dp-ui-action dp-ui-secondary" type="submit" aria-label="Search">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <circle cx="9" cy="9" r="6"/>
              <line x1="13.5" y1="13.5" x2="17.5" y2="17.5" stroke-linecap="round"/>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </header>

  <!-- ── 2. Main grid ───────────────────────────────────────────────── -->
  <div class="intel-grid">
    <div class="intel-main">
      {featured && (
        <a href={`/guides/${featured.id}/`} class:list={["intel-featured", { "has-art": getStockEntry(`guide-${featured.id}`) }]} aria-labelledby="featured-guide-heading" data-guide-feature>
          <div class="intel-featured-body">
            <span class="intel-featured-eyebrow">{featured.id === "expat-starter" ? "Start here" : "Featured guide"}</span>
            <h2 id="featured-guide-heading">{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <time class="intel-featured-meta" datetime={featured.data.updatedAt.toISOString().slice(0, 10)}>
              Updated {fmt(featured.data.updatedAt)}
            </time>
          </div>
          {getStockEntry(`guide-${featured.id}`) && (
            <span class="dp-guide-feature-art" data-guide-feature-art>
              <StockImage slug={`guide-${featured.id}`} class="intel-featured-image" sizes="(max-width: 640px) calc(100vw - 56px), 340px" loading="eager" />
            </span>
          )}
        </a>
      )}

      {others.length > 0 && (
        <ul class="intel-card-grid">
          {others.map((g) => (
            <li class="intel-card-item">
              <a href={`/guides/${g.id}/`} class:list={["intel-card", { "has-art": getStockEntry(`guide-${g.id}`) }]} aria-labelledby={`guide-${g.id}`}>
                <div class="intel-card-body">
                  <h2 id={`guide-${g.id}`}>{g.data.title}</h2>
                  <p>{g.data.description}</p>
                  <time class="intel-card-meta" datetime={g.data.updatedAt.toISOString().slice(0, 10)}>Updated {fmt(g.data.updatedAt)}</time>
                </div>
                {getStockEntry(`guide-${g.id}`) && (
                  <span class="dp-guide-card-art">
                    <StockImage slug={`guide-${g.id}`} class="intel-card-image" sizes="120px" />
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    {recentlyUpdated.length > 0 && (
    <aside class="intel-aside">
        <nav class="intel-trending" aria-label="Recently updated guides">
          <div class="dp-rail-heading">Recently updated</div>
          <ol>
            {recentlyUpdated.map((g) => (
              <li>
                <a href={`/guides/${g.id}/`}>{g.data.title}</a>
              </li>
            ))}
          </ol>
        </nav>
    </aside>
    )}
  </div>
</BaseLayout>

<style>
  .intel-pagehead {
    padding: clamp(24px, 4vw, 44px) clamp(16px, 3vw, 32px) clamp(16px, 3vw, 28px);
    border-bottom: 1px solid var(--line);
    background: var(--paper);
  }
  .intel-pagehead-inner { max-width: var(--container-listing); margin-inline: auto; }
  .intel-pagehead .crumb {
    margin-block-end: 10px;
    color: var(--green);
    font: 700 .6875rem/1.4 var(--font-ui);
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .intel-pagehead h1 {
    margin: 0 0 8px;
    color: var(--ink);
    font: 550 clamp(2rem, 5vw, 3.5rem)/1.06 var(--font-display);
    letter-spacing: -.035em;
    text-wrap: balance;
  }
  .intel-pagehead p {
    max-width: 65ch;
    margin: 0 0 clamp(14px, 2.5vw, 24px);
    color: var(--ink-soft);
    font-size: .9375rem;
    line-height: 1.5;
  }
  .intel-tools, .intel-tabs, .intel-search { display: flex; align-items: center; gap: 8px; }
  .intel-tools, .intel-tabs { flex-wrap: wrap; }
  .intel-tools { justify-content: space-between; gap: 10px 18px; }
  .intel-search { min-width: 0; }
  .intel-search-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .intel-search input { width: min(26vw, 260px); }
  .intel-search button { min-inline-size: var(--dp-ui-control); }

  .intel-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: var(--dp-ui-gap);
    max-width: var(--container-listing);
    margin: clamp(18px, 3vw, 36px) auto var(--dp-ui-section);
    padding-inline: clamp(16px, 3vw, 32px);
  }
  .intel-main { min-width: 0; display: grid; gap: var(--dp-ui-gap); }
  .intel-card-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .intel-featured, .intel-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: clamp(10px, 2vw, 20px);
    height: 100%;
    padding: clamp(12px, 2vw, 20px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    color: inherit;
    text-decoration: none;
  }
  .intel-featured { align-items: center; }
  .intel-card.has-art { grid-template-columns: minmax(0, 1fr) clamp(70px, 14vw, 120px); }
  .intel-featured:hover, .intel-card:hover { border-color: var(--green); }
  .intel-featured:focus-visible, .intel-card:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; }
  .dp-guide-feature-art, .dp-guide-card-art {
    display: block;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius);
    overflow: hidden;
  }
  .dp-guide-feature-art :global(.intel-featured-image), .dp-guide-card-art :global(.intel-card-image) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1.6;
    object-fit: cover;
  }
  .dp-guide-card-art :global(.dp-ai-label) { font-size: 10px; padding: 14px 4px 3px; }
  .intel-featured-body, .intel-card-body { display: grid; min-width: 0; gap: 6px; }
  .intel-featured-eyebrow {
    color: var(--green);
    font: 700 .75rem/1.35 var(--font-ui);
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .intel-featured h2, .intel-card h2 {
    margin: 0;
    color: var(--ink);
    font: 550 clamp(1.125rem, 2vw, 1.375rem)/1.16 var(--font-display);
    letter-spacing: -.02em;
    text-wrap: pretty;
  }
  .intel-featured h2 { font-size: clamp(1.375rem, 3vw, 2.125rem); }
  .intel-featured:hover h2, .intel-card:hover h2 { color: var(--green); text-decoration: underline; text-underline-offset: .14em; }
  .intel-featured p, .intel-card p { margin: 0; color: var(--ink-soft); font-size: .875rem; line-height: 1.48; }
  .intel-featured p { font-size: .9375rem; }
  .intel-featured-meta, .intel-card-meta { color: var(--ink-soft); font: 600 .75rem/1.35 var(--font-ui); }

  .intel-trending {
    padding: clamp(14px, 2vw, 22px);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
  }
  .intel-trending .dp-rail-heading {
    margin: 0 0 7px;
    color: var(--green);
    font: 700 .875rem/1.35 var(--font-ui);
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .intel-trending ol { list-style: none; margin: 0; padding: 0; }
  .intel-trending li + li { border-top: 1px solid var(--line); }
  .intel-trending a {
    display: flex;
    align-items: center;
    min-block-size: var(--dp-ui-control);
    padding-block: 7px;
    color: var(--ink);
    font: 550 1rem/1.2 var(--font-display);
    text-decoration: none;
  }
  .intel-trending a:hover { color: var(--green); text-decoration: underline; }

  @media (min-width: 620px) {
    .intel-featured.has-art { grid-template-columns: minmax(0, 1fr) minmax(0, 42%); }
  }
  @media (min-width: 800px) {
    .intel-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1060px) {
    .intel-grid { grid-template-columns: minmax(0, 2.75fr) minmax(0, 1fr); }
    .intel-aside { position: sticky; top: calc(var(--dp-sticky-header-height) + 16px); }
  }
  @media (max-width: 640px) {
    .intel-tabs { gap: 6px; }
    .intel-tabs .dp-ui-action { font-size: .8125rem; padding-inline: .7em; }
    .intel-search { flex: 1 1 100%; }
    .intel-search input { flex: 1; width: 0; }
  }
</style>
