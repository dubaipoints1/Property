<style>
  /* ── S1 hero — page-unique ─────────────────────────────────────────── */
  /* Hero, 4 Oct 2026 (Chairman direction from a reel): a light, airy
     band — a large illustration left, the serif headline right — the
     render cycling through four pictures. Replaces the navy band of the
     same morning; the slow gold/navy light stays (global.css, off under
     reduced motion), now faint on paper so the pictures' off-white
     studio fields blend into the band. */
  .hp-hero {
    position: relative; overflow: hidden;
    background: var(--paper); color: var(--ink);
    padding: 56px 32px 56px;
  }
  .hp-hero::before {
    content: ""; position: absolute; inset: -20%; pointer-events: none;
    background:
      radial-gradient(45% 55% at 22% 18%, rgba(184, 132, 42, 0.14), transparent 62%),
      radial-gradient(40% 50% at 88% 88%, rgba(31, 58, 77, 0.10), transparent 60%);
  }
  .hp-hero-grid { position: relative; z-index: 1; }
  .hp-hero-grid {
    max-width: var(--container-listing);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hp-hero-grid { grid-template-columns: 1.1fr 1fr; gap: 56px; }
  }
  .hp-hero-kicker {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 18px;
  }
  .hp-hero-kicker .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--gold);
  }
  .hp-hero h1 {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(46px, 5.6vw, 72px);
    letter-spacing: -1.4px; line-height: 1.02;
    color: var(--ink);
    margin: 0 0 18px;
  }
  /* The italic accent word is the v0 design's signature, readopted on
     Chairman direction (29 Aug 2026) in the primary accent. */
  .hp-hero h1 em {
    font-style: italic;
    color: var(--gold-ink);
    white-space: nowrap; /* keeps "Pay less" on one line without a &nbsp; that some readers join into one word (F-040) */
  }
  .hp-hero-lede {
    font-size: 18px; line-height: 1.6;
    color: var(--ink-soft, var(--muted));
    max-width: 46ch;
    margin: 0 0 26px;
  }
  .hp-hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  /* Square box CTAs — the v0 "boxes" idiom. */
  .hp-hero-cta {
    display: inline-flex; align-items: center;
    padding: 14px 24px;
    border-radius: 6px;
    background: var(--gold); color: var(--ink);
    font-size: 15px; font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s var(--dp-ease-hover);
  }
  .hp-hero-cta:hover { background: var(--gold-hover); transform: translateY(-1px); }
  .hp-hero-cta.is-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid var(--line);
    padding: 13px 20px; font-weight: 600;
  }
  .hp-hero-cta.is-ghost:hover { background: transparent; color: var(--green); border-color: var(--green); }
  .hp-hero-trust {
    display: flex; flex-wrap: wrap; gap: 0;
    margin: 30px 0 0;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1.4px; text-transform: uppercase;
    color: var(--muted);
  }
  .hp-hero-trust > span { padding-right: 14px; }
  .hp-hero-trust > span + span {
    border-left: 1px solid var(--line);
    padding-left: 14px;
  }
  .hp-hero-feature {
    display: grid; gap: 4px;
    margin: 26px 0 0; padding: 16px 0 0;
    border-top: 1px solid var(--line);
    max-width: 46ch;
    text-decoration: none;
  }
  .hp-hero-feature .eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted);
  }
  .hp-hero-feature .t {
    font-family: var(--font-display); font-weight: 500;
    font-size: 19px; line-height: 1.25; letter-spacing: -0.2px; color: var(--ink);
    transition: color 0.15s;
  }
  .hp-hero-feature:hover .t { color: var(--green); }
  .hp-hero-feature .m { font-size: 12px; font-weight: 600; color: var(--green); }

  /* Hero slideshow — pictures stacked and crossfaded; the edges of each
     render fade into the band so the object sits on the page, not in a
     frame (the reel's seamless look). Transform/opacity only. */
  .hp-hero-show { position: relative; }
  .hp-hero-slides {
    position: relative; width: 100%; aspect-ratio: 4 / 3;
    border-radius: 14px; overflow: hidden;
  }
  /* Edge vignette to the band colour, so the render sits on the page
     rather than in a frame; follows the theme because it is var(--paper). */
  .hp-hero-slides::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    box-shadow: inset 0 0 72px 28px var(--paper);
  }
  .hp-hero-slides > img {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(1.03);
    transition: opacity 1.1s var(--dp-ease), transform 7s linear;
  }
  .hp-hero-slides > img.is-active { opacity: 1; transform: scale(1); }
  :global([data-theme="dark"]) .hp-hero-slides > img { filter: brightness(0.88); }
  .hp-hero-show-bar {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
    gap: 10px 16px;
    margin-top: 6px;
  }
  .hp-hero-label { font-size: 11px; color: var(--muted); }
  .hp-hero-show-ctl { display: flex; align-items: center; gap: 10px; }
  .hp-hero-dots { display: flex; gap: 6px; }
  .hp-hero-dots button {
    width: 22px; height: 22px; padding: 0; border: 0; background: transparent; cursor: pointer;
    display: grid; place-items: center; touch-action: manipulation;
  }
  .hp-hero-dots button::before {
    content: ""; width: 7px; height: 7px; border-radius: 50%;
    background: var(--line);
    transition: background 0.15s, transform 0.2s var(--dp-ease-hover);
  }
  .hp-hero-dots button:hover::before { background: var(--muted); }
  .hp-hero-dots button[aria-pressed="true"]::before { background: var(--gold); transform: scale(1.3); }
  .hp-hero-pause {
    width: 26px; height: 26px; padding: 0; border-radius: 50%;
    border: 1px solid var(--line); background: transparent; color: var(--muted);
    display: inline-grid; place-items: center; cursor: pointer; touch-action: manipulation;
    transition: color 0.15s, border-color 0.15s;
  }
  .hp-hero-pause:hover { color: var(--ink); border-color: var(--muted); }
  .hp-hero-pause[aria-pressed="true"] { color: var(--green); border-color: var(--green); }
  .hp-hero-pause[aria-pressed="true"] svg { display: none; }
  .hp-hero-pause[aria-pressed="true"]::before {
    content: ""; width: 0; height: 0; margin-left: 2px;
    border-left: 8px solid currentColor; border-top: 5px solid transparent; border-bottom: 5px solid transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-hero-slides > img { transition: none; transform: none; }
  }
  @media (max-width: 899px) {
    .hp-hero-show { margin-inline: -8px; }
  }

  /* ── S2b Editor's picks carousel (Phase 3) ────────────────────────── */
  .hp-picks { padding: 48px 32px 24px; }
  .hp-picks-head,
  .hp-picks .dp-carousel {
    max-width: var(--container-listing);
    margin-left: auto; margin-right: auto;
  }
  .hp-picks-head {
    display: flex; flex-wrap: wrap;
    align-items: flex-end; justify-content: space-between;
    gap: 12px 32px; margin-bottom: 20px;
  }
  .hp-picks-head h2 {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(26px, 3vw, 34px); letter-spacing: -0.5px; line-height: 1.1;
    color: var(--ink); margin: 0;
  }
  .hp-pick {
    display: flex; flex-direction: column; gap: 8px;
    height: 100%; padding: 20px 20px 18px;
    background: var(--paper); border: 1px solid var(--line); border-radius: 8px;
    text-decoration: none; color: var(--ink);
    /* Lift + shadow come from the shared rule in the global.css motion layer. */
  }
  .hp-pick:hover { border-color: var(--green); }
  .hp-pick-tier {
    font-size: 10px; font-weight: 700; letter-spacing: 1.6px; text-transform: uppercase;
    color: var(--gold-ink); /* --gold on paper is 3.2:1 at 10px; --gold-ink clears AA */
  }
  .hp-pick-name {
    font-family: var(--font-display); font-weight: 500;
    font-size: 21px; line-height: 1.2; letter-spacing: -0.2px;
  }
  .hp-pick:hover .hp-pick-name { color: var(--green); }
  .hp-pick-bank { font-size: 12px; color: var(--muted); }
  .hp-pick-facts {
    display: grid; gap: 8px; margin-top: 8px; padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    font-variant-numeric: tabular-nums;
