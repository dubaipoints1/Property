---
// Homepage — full rewrite, August 2026 site audit.
//
// Executes the May 2026 redesign briefs that were never applied here:
// the Quiet Ledger 4-section spec (ux-redesign-brief.md — "index.astro:
// full rewrite") merged with the TPG brief's typographic-hero ruling
// ("adopt verbatim") and its 6-section IA, expressed in the current
// warm-paper tokens. Five sections, down from ten bands:
//
//   S1  Typographic hero + story index   (was: photo hero + stats band)
//   S2  Live desk — salary offers + deals, one module (was: two teasers)
//   S3  Latest analysis — .dp-featured-band story grid (was: hp-intel)
//   S4  Start here — .dp-dir-tile directory   (was: wayfinder + wallet
//                                              band + miles tiles)
//   S5  Trust row + press + newsletter band   (was: trust stack + band)
//
// Shared primitives over scoped CSS wherever one exists (.dp-pagehead,
// .dp-featured-band/-grid, .dp-story-card, .dp-dir-grid/-tile,
// .dp-band-green, .dp-live-desk). Scoped styles below cover only what
// is genuinely page-unique: the hero grid, the story index, the trust
// footnote row.

import BaseLayout from "~/layouts/BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import PressStrip from "~/components/PressStrip.astro";
import NewsletterSignup from "~/components/NewsletterSignup.astro";
import { getCollection } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import { getLiveOffers } from "~/lib/offerAdapter";
import { formatAED } from "~/lib/salaryTransfer";
import { resolveDealIssuer } from "~/lib/dealIssuer";

const allGuides = await getCollection("guides");
const allPrograms = await getCollection("programs");
const allBanks = await getCollection("banks");
const allNews = await getCollection("news");
const cards = getActiveCards();

const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
const dateline = new Date().toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Newsletter state — same env flag NewsletterSignup gates its form on.
// While unset, the hero micro-line and the band headline say honestly
// that sign-up is by email; once the Buttondown account is configured
// the launch-pending copy disappears without a code change.
const newsletterLive = Boolean(
  (import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? "").trim(),
);

const guidesSorted = [...allGuides].sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);
const newsSorted = [...allNews].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const newestCard = [...cards].sort(
  (a, b) =>
    new Date(b.lastVerified).getTime() - new Date(a.lastVerified).getTime(),
)[0];

type IntelItem = {
  href: string;
  category: string;
  title: string;
  excerpt: string;
  meta: string;
  imageSlug: string;
  coverCategory: "Guide" | "Review" | "Deal" | "News" | "Programme" | "Topic";
};

const intel: IntelItem[] = [];
for (const g of guidesSorted.slice(0, 3)) {
  intel.push({
    href: `/guides/${g.id}/`,
    category: "Guide",
    title: g.data.title,
    excerpt: g.data.description,
    meta: `Updated ${fmtShort(g.data.updatedAt)}`,
    imageSlug: `guide-${g.id}`,
    coverCategory: "Guide",
  });
}
if (newestCard) {
  const bankName =
    allBanks.find((b) => b.id === newestCard.bank)?.data.name ??
    newestCard.bank;
  intel.push({
    href: `/cards/${newestCard.slug}/`,
    category: "Card review",
    title: newestCard.name,
    excerpt: `${bankName} · annual fee AED ${newestCard.annualFee.amount.toLocaleString()}`,
    meta: `Verified ${fmtShort(new Date(newestCard.lastVerified))}`,
    imageSlug: `card-${newestCard.slug}`,
    coverCategory: "Review",
  });
}
if (newsSorted[0]) {
  const n = newsSorted[0];
  intel.push({
    href: `/news/${n.id}/`,
    category: "News",
    title: n.data.title,
    excerpt: n.data.description,
    meta: `Filed ${fmtShort(n.data.publishedAt)}`,
    imageSlug: `news-${n.id}`,
    coverCategory: "News",
  });
}

// Hero story index — the three newest editorial items, text-only.
const heroIndex = intel.slice(0, 3);

const liveWelcomeCount = cards.filter((c) => Boolean(c.welcomeBonus)).length;
const flagshipProgramme =
  allPrograms.find((p) => p.id === "skywards") ?? allPrograms[0];
const heroSweetSpot = flagshipProgramme?.data.sweetSpots[0];

// ── S2 Live desk: salary-transfer offers ─────────────────────────────
// Real rows from the salaryTransferOffers collection; each column
// renders only while genuinely live rows exist (honest emptiness).
const liveOffers = await getLiveOffers();
const fmtVerified = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const offerRows = liveOffers.map((o) => {
  const best = o.salaryBands.reduce((a, b) => (b.rewardAmount > a.rewardAmount ? b : a));
  const minBand = o.salaryBands.reduce((a, b) => (b.minSalary < a.minSalary ? b : a));
  return {
    bankSlug: o.bankSlug,
    bankName: o.bankName,
    upTo: `${formatAED(best.rewardAmount)} ${best.rewardType === "cash" ? "cash" : best.rewardType.replace("_", " ")}`,
    from: `${formatAED(minBand.minSalary)}+ salary`,
    bands: o.salaryBands.length,
    sharia: o.sharia,
    verified: fmtVerified(o.lastVerified),
  };
});

// ── S2 Live desk: deals ──────────────────────────────────────────────
// Same honest-emptiness contract. Soonest-expiring first, capped at
// four rows — the /deals/ index is the full surface. The expiry filter
// is load-bearing: an expired deal sat on the homepage for a week in
// August 2026 before this guard existed. Do not weaken it.
const todayMs = Date.now();
const liveDealsRaw = (await getCollection("deals"))
  .filter((d) => !d.data.archived && d.data.expiresOn.getTime() >= todayMs)
  .sort((a, b) => a.data.expiresOn.getTime() - b.data.expiresOn.getTime())
  .slice(0, 4);
const dealRows = await Promise.all(
  liveDealsRaw.map(async (d) => ({
    id: d.id,
    title: d.data.title,
    issuer: (await resolveDealIssuer(d)).name,
    ends: fmtShort(d.data.expiresOn),
  })),
);
---

<BaseLayout
  title="DubaiPoints — UAE miles, deals and banking, AED-first"
  description="Independent UAE-resident-led guides to credit cards, salary-transfer bonuses, miles redemptions and lifestyle deals. AED-first, sourced and dated."
  fullWidth
>
  <!-- ── S1. Typographic hero + story index ─────────────────────────── -->
  <header class="dp-pagehead is-hero hp-hero">
    <div class="hp-hero-grid">
      <div class="hp-hero-text">
        <span class="hp-hero-kicker">Independent UAE points &amp; miles publication</span>
        <h1>Fly further. Pay&nbsp;less.</h1>
        <p class="hp-hero-lede">
          UAE-resident guides to the card combinations, salary-transfer
          bonuses and miles redemptions that stretch a Dubai paycheque
          further — AED-first, dated and sourced.
        </p>
        <p class="hp-hero-meta">
          {dateline} · {cards.length} cards · {allBanks.length} banks ·
          {allPrograms.length} programmes · zero paid placements
        </p>
        <div class="hp-hero-ctas">
          <a href="#latest" class="hp-hero-cta">Read the latest ↓</a>
          <a href="/newsletter/" class="hp-hero-cta is-ghost">Join the Friday brief →</a>
        </div>
        {!newsletterLive && (
          <p class="hp-hero-micro">
            The brief is preparing for launch — sign-up is by email until
            the automated list opens.
          </p>
        )}
      </div>

      <aside class="hp-hero-index" aria-label="Latest from the desk">
        <p class="hp-hero-index-label">On the desk</p>
        <ol>
          {heroIndex.map((item) => (
            <li>
              <a href={item.href}>
                <span class="cat">{item.category}</span>
                <span class="t">{item.title}</span>
                <span class="m">{item.meta}</span>
              </a>
            </li>
          ))}
          {heroSweetSpot && flagshipProgramme && (
            <li>
              <a href={`/airlines/${flagshipProgramme.id}/`}>
                <span class="cat">Sweet spot</span>
                <span class="t">{heroSweetSpot.title}</span>
                <span class="m">{flagshipProgramme.data.currencyName} ›</span>
              </a>
            </li>
          )}
        </ol>
      </aside>
    </div>
  </header>

  <!-- ── S2. Live desk — salary offers + deals, one module ──────────── -->
  {(offerRows.length > 0 || dealRows.length > 0) && (
    <section class="dp-live-desk" aria-label="Live data desk">
      <div class="head">
        <div class="dp-featured-eyebrow">
          <span>Live desk</span>
          <span class="rule"></span>
          <span class="meta">Verified against published terms</span>
        </div>
        <h2>What's live right now.</h2>
      </div>
      <div class="cols">
        {offerRows.length > 0 && (
          <div class="col" aria-label="Live salary-transfer offers">
            <div class="col-head">
              <h3>Salary-transfer offers</h3>
              <a href="/salary-transfer/">Full tracker →</a>
            </div>
            <ul class="rows">
              {offerRows.map((r) => (
                <li>
                  <a href={`/salary-transfer/${r.bankSlug}/`} class="row">
                    <span class="bank">{r.bankName}</span>
                    <span class="detail">
                      up to <strong>{r.upTo}</strong> · {r.bands} bands · from {r.from}
                      {r.sharia ? " · Sharia-compliant" : ""}
                    </span>
                    <span class="chip">Verified {r.verified}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="foot">Every band checked against the bank's published terms. Offers change without notice — verify before applying.</p>
          </div>
        )}
        {dealRows.length > 0 && (
          <div class="col" aria-label="Live deals">
            <div class="col-head">
              <h3>Deals desk</h3>
              <a href="/deals/">All deals →</a>
            </div>
            <ul class="rows">
              {dealRows.map((r) => (
                <li>
                  <a href={`/deals/${r.id}/`} class="row">
                    <span class="bank">{r.issuer}</span>
                    <span class="detail">{r.title}</span>
                    <span class="chip is-ends">Ends {r.ends}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="foot">Shown as recorded in the latest editorial sweep. Check the provider before acting; terms can change.</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── S3. Latest analysis ────────────────────────────────────────── -->
  <section class="dp-featured-band" id="latest" aria-label="Latest analysis">
    <div class="dp-featured-eyebrow">
      <span>Latest analysis</span>
      <span class="rule"></span>
      <span class="meta">Checked against primary sources</span>
    </div>
    <div class="dp-featured-grid">
      {intel[0] && (
        <a href={intel[0].href} class="dp-story-card hero">
          <StockImage
            slug={intel[0].imageSlug}
            coverTitle={intel[0].title}
            coverCategory={intel[0].coverCategory}
            coverSize="hero"
            loading="eager"
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{intel[0].category}</span> {intel[0].meta}</span>
            <h3>{intel[0].title}</h3>
            <p>{intel[0].excerpt}</p>
          </div>
        </a>
      )}
      {intel.slice(1, 3).map((item) => (
        <a href={item.href} class="dp-story-card med">
          <StockImage
            slug={item.imageSlug}
            coverTitle={item.title}
            coverCategory={item.coverCategory}
            coverSize="med"
            sizes="(max-width: 1024px) 100vw, 25vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{item.category}</span> {item.meta}</span>
            <h3>{item.title}</h3>
          </div>
        </a>
      ))}
      {intel.slice(3, 5).map((item) => (
        <a href={item.href} class="dp-story-card sm">
          <StockImage
            slug={item.imageSlug}
            coverTitle={item.title}
            coverCategory={item.coverCategory}
            coverSize="sm"
            sizes="(max-width: 640px) 100vw, 25vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{item.category}</span></span>
            <h3>{item.title}</h3>
          </div>
        </a>
      ))}
    </div>
    <div class="hp-latest-foot">
      <a href="/guides/">All guides →</a>
      <a href="/news/">News desk →</a>
    </div>
  </section>

  <!-- ── S4. Start here — directory ─────────────────────────────────── -->
  <section class="hp-dir" aria-label="Browse dubaipoints.ae">
    <div class="dp-featured-eyebrow">
      <span>Start here</span>
      <span class="rule"></span>
      <span class="meta">Everything on dubaipoints.ae</span>
    </div>
    <div class="dp-dir-grid">
      <a href="/cards/" class="dp-dir-tile">
        <span class="eyebrow">{cards.length} cards</span>
        <span class="title">Credit-card reviews</span>
        <span class="desc">Cashback, miles and Islamic cards compared on fees, earn rates and eligibility.</span>
        <span class="meta">{liveWelcomeCount} with recorded welcome-bonus data</span>
      </a>
      <a href="/banks/" class="dp-dir-tile">
        <span class="eyebrow">{allBanks.length} banks</span>
        <span class="title">Bank guides</span>
        <span class="desc">Every covered UAE issuer — fees, eligibility and card line-ups.</span>
        <span class="meta">Browse issuers →</span>
      </a>
      <a href="/airlines/" class="dp-dir-tile">
        <span class="eyebrow">{allPrograms.length} programmes</span>
        <span class="title">Miles &amp; loyalty</span>
        <span class="desc">Skywards, Etihad Guest, Qatar and the hotel programmes — tiers, transfer partners and sweet spots.</span>
        {heroSweetSpot && <span class="meta">Sweet spot: {heroSweetSpot.title}</span>}
      </a>
      <a href="/salary-transfer/" class="dp-dir-tile">
        <span class="eyebrow"><span class="hp-live-dot" aria-hidden="true"></span>Live tracker</span>
        <span class="title">Salary-transfer offers</span>
        <span class="desc">Band-by-band cash and rate offers across UAE banks, verified weekly.</span>
        <span class="meta">{offerRows.length} live offers</span>
      </a>
      <a href="/calculator/" class="dp-dir-tile">
        <span class="eyebrow">Tool</span>
        <span class="title">Welcome-bonus calculator</span>
        <span class="desc">Plug in your monthly AED spend; see which card's welcome offer pays back first.</span>
        <span class="meta">Open the calculator →</span>
      </a>
      <a href="/guides/" class="dp-dir-tile">
        <span class="eyebrow">{allGuides.length} guides</span>
        <span class="title">Guides</span>
        <span class="desc">Expat starter series, eligibility, AECB credit, transfer ratios and the rest of the groundwork.</span>
        <span class="meta">Browse guides →</span>
      </a>
    </div>
  </section>

  <!-- ── S5. Trust + press + newsletter ─────────────────────────────── -->
  <section class="hp-trust" aria-label="Why trust DubaiPoints">
    <div class="dp-featured-eyebrow">
      <span>Why trust us</span>
      <span class="rule"></span>
    </div>
    <div class="dp-dir-grid">
      <a href="/team/" class="dp-dir-tile">
        <span class="eyebrow">Publication</span>
        <span class="title">Who writes DubaiPoints</span>
        <span class="desc">A UAE-resident, single-editor publication using the DubaiPoints Editorial byline. Reviews carry dated verification and supporting sources.</span>
      </a>
      <a href="/editorial-policy/" class="dp-dir-tile">
        <span class="eyebrow">Method</span>
        <span class="title">How we work</span>
        <span class="desc">Card figures draw on issuer product pages, terms, Key Facts Statements and Schedules of Charges. Figures older than 90 days are flagged for refresh.</span>
      </a>
      <a href="/how-we-make-money/" class="dp-dir-tile">
        <span class="eyebrow">Funding</span>
        <span class="title">How we make money</span>
        <span class="desc">No affiliate-driven recommendations. No paid placements. Independent UAE coverage, AED-first.</span>
      </a>
    </div>
    <p class="hp-trust-footnote">
      Also: <a href="/about/">about DubaiPoints</a> · <a href="/corrections/">corrections policy</a> · <a href="/valuations/methodology/">how we value miles + points</a>
    </p>
  </section>

  <PressStrip />

  <section class="dp-band-green hp-news" aria-label="Newsletter">
    <div class="inner">
      <span class="hp-news-eyebrow">The DubaiPoints brief</span>
      <h2>{newsletterLive ? "The Friday brief." : "The Friday brief is preparing for launch."}</h2>
      <p>Salary-transfer changes, new card offers, worthwhile miles redemptions and lifestyle deals — once a week, AED-first.</p>
      <NewsletterSignup source="homepage" />
      <p class="micro">
        We never sell email addresses or browsing data. <a href="/editorial-policy/">Editorial policy</a> · <a href="/rss.xml">RSS feeds</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── S1 hero — page-unique ─────────────────────────────────────────── */
  .hp-hero {
    /* Keep the 3px ink masthead rule — the Quiet Ledger idiom. */
    border-top: 3px solid var(--ink);
    padding: 56px 32px 48px;
  }
  .hp-hero-grid {
    max-width: var(--container-listing);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .hp-hero-grid { grid-template-columns: 1.35fr 1fr; gap: 64px; }
  }
  .hp-hero-kicker {
    display: inline-block;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--green);
    margin-bottom: 18px;
  }
  .hp-hero h1 {
    font-family: 'Fraunces', serif; font-weight: 700;
    font-size: clamp(44px, 6vw, 68px);
    letter-spacing: -1.8px; line-height: 1.02;
    color: var(--ink);
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .hp-hero-lede {
    font-size: 17px; line-height: 1.6;
    color: var(--ink-soft);
    max-width: 54ch;
    margin: 0 0 14px;
  }
  .hp-hero-meta {
    font-size: 12px; letter-spacing: 0.4px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .hp-hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hp-hero-cta {
    display: inline-flex; align-items: center;
    padding: 12px 22px;
    background: var(--ink); color: var(--paper);
    border-radius: 999px;
    font-size: 14px; font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.15s;
  }
  .hp-hero-cta:hover { transform: translateY(-1px); opacity: 0.92; }
  .hp-hero-cta.is-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid var(--ink-soft);
  }
  .hp-hero-micro {
    font-size: 12px; color: var(--muted);
    margin: 14px 0 0;
  }

  /* Story index — typographic, hairline-ruled */
  .hp-hero-index { border-top: 1px solid var(--line); }
  .hp-hero-index-label {
    font-size: 11px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--ink-soft);
    margin: 14px 0 4px;
  }
  .hp-hero-index ol {
    list-style: none; margin: 0; padding: 0;
  }
  .hp-hero-index li { border-bottom: 1px solid var(--line); }
  .hp-hero-index a {
    display: grid; gap: 4px;
    padding: 14px 0;
    text-decoration: none;
  }
  .hp-hero-index .cat {
    font-size: 10px; font-weight: 700;
    letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--green);
  }
  .hp-hero-index .t {
    font-family: 'Fraunces', serif; font-weight: 500;
    font-size: 17px; line-height: 1.3; letter-spacing: -0.2px;
    color: var(--ink);
    transition: color 0.15s;
  }
  .hp-hero-index a:hover .t { color: var(--green); }
  .hp-hero-index .m {
    font-size: 11px; color: var(--muted); letter-spacing: 0.3px;
  }

  /* ── S3 foot links ─────────────────────────────────────────────────── */
  .hp-latest-foot {
    max-width: var(--container-listing);
    margin: 20px auto 0;
    display: flex; gap: 24px;
    padding-bottom: 28px;
  }
  .hp-latest-foot a {
    font-size: 13px; font-weight: 600;
    color: var(--green); text-decoration: none;
  }
  .hp-latest-foot a:hover { text-decoration: underline; }

  /* ── S4 / S5 shells — shared grid, page-level padding only ─────────── */
  .hp-dir, .hp-trust {
    max-width: none;
    padding: 36px 32px 8px;
  }
  .hp-dir .dp-dir-grid, .hp-trust .dp-dir-grid,
  .hp-dir .dp-featured-eyebrow, .hp-trust .dp-featured-eyebrow,
  .hp-latest-foot {
    max-width: var(--container-listing);
    margin-left: auto; margin-right: auto;
  }
  .hp-dir .dp-featured-eyebrow, .hp-trust .dp-featured-eyebrow {
    margin-bottom: 24px;
  }
  .hp-live-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--green);
    display: inline-block;
    animation: hp-pulse 2s ease-in-out infinite;
  }
  @keyframes hp-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-live-dot { animation: none; }
  }
  .hp-trust-footnote {
    max-width: var(--container-listing);
    margin: 18px auto 28px;
    font-size: 12px; color: var(--muted);
  }
  .hp-trust-footnote a { color: var(--green); }

  /* ── S5 newsletter band ────────────────────────────────────────────── */
  .hp-news { padding: 56px 32px 48px; }
  .hp-news .inner {
    max-width: 640px; margin: 0 auto; text-align: center;
  }
  .hp-news-eyebrow {
    display: inline-block;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 12px;
  }
  .hp-news h2 {
    font-family: 'Fraunces', serif; font-weight: 600;
    font-size: clamp(26px, 3.4vw, 36px);
    letter-spacing: -0.6px; line-height: 1.15;
    margin: 0 0 12px;
  }
  .hp-news p {
    font-size: 15px; line-height: 1.6;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 8px;
  }
  .hp-news .micro {
    font-size: 12px; color: rgba(255, 255, 255, 0.6);
    margin-top: 16px;
  }
  .hp-news .micro a { color: rgba(255, 255, 255, 0.82); }
  /* NewsletterSignup renders a paper-background inset; the band's
     white-text cascade would make its copy white-on-paper. Restore ink
     inside the inset (both the form and the email fallback). */
  .hp-news :global(.dp-newsletter-form),
  .hp-news :global(.dp-newsletter-fallback) {
    color: var(--ink);
    text-align: left;
  }
  .hp-news :global(.dp-newsletter-form a),
