---
// Homepage — full rewrite, August 2026 site audit.
//
// Executes the May 2026 redesign briefs that were never applied here:
// the Quiet Ledger 4-section spec (ux-redesign-brief.md — "index.astro:
// full rewrite") merged with the TPG brief's typographic-hero ruling
// ("adopt verbatim") and its 6-section IA, expressed in the current
// warm-paper tokens. Five sections, down from ten bands:
//
//   S1  Hero: masthead + .dp-feature-card feature story
//   S2  Tools strip — .dp-tool-strip (finder / compare / calculators)
//   S3  Live desk — salary offers + deals, one module
//   S4  Strategy panel — .dp-strategy, no-JS radio goals
//   S5  Latest analysis — .dp-featured-band story grid (intel[1..6))
//   S6  Start here — .dp-dir-tile directory
//   S7  Trust row + press + newsletter band
//
// Aug 2026 v0-layout amendment (Chairman direction, 29 Aug): the hero
// carries an image-led feature story and the page gains the tools strip
// and goal panel — the v0 prototype's layout rebuilt in house tokens.
// This supersedes the TPG typographic-only-hero ruling by explicit
// direction; palette unchanged (navy + gold, no third hue).
//
// Shared primitives over scoped CSS wherever one exists (.dp-pagehead,
// .dp-featured-band/-grid, .dp-story-card, .dp-dir-grid/-tile,
// .dp-band-green, .dp-live-desk). Scoped styles below cover only what
// is genuinely page-unique: the hero grid, the story index, the trust
// footnote row.

import BaseLayout from "~/layouts/BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import PressStrip from "~/components/PressStrip.astro";
import NewsletterSignup from "~/components/NewsletterSignup.astro";
import { getCollection } from "astro:content";
import { getActiveCards } from "~/lib/cardsData";
import {
  loyaltyTag,
  welcomeBonusRank,
  compareByWelcomeValue,
} from "~/lib/cardsDataFormat";
import { getStockEntry } from "~/lib/stockManifest";
import { getLiveOffers } from "~/lib/offerAdapter";
import { formatAED } from "~/lib/salaryTransfer";
import { resolveDealIssuer } from "~/lib/dealIssuer";

const allGuides = await getCollection("guides");
const allPrograms = await getCollection("programs");
const allBanks = await getCollection("banks");
const allNews = await getCollection("news");
const cards = getActiveCards();

const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
// No build-time dateline: `new Date()` fossilises at build on a static
// site, and a stale "today" beside real verified dates reads as neglect
// (Head of UX, 29 Aug 2026 review). Freshness claims stay on the items
// that actually carry dates.

// Newsletter state — same env flag NewsletterSignup gates its form on.
// While unset, the hero micro-line and the band headline say honestly
// that sign-up is by email; once the Buttondown account is configured
// the launch-pending copy disappears without a code change.
const newsletterLive = Boolean(
  (import.meta.env.PUBLIC_BUTTONDOWN_USERNAME ?? "").trim(),
);

const guidesSorted = [...allGuides].sort(
  (a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime(),
);
const newsSorted = [...allNews].sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const newestCard = [...cards].sort(
  (a, b) =>
    new Date(b.lastVerified).getTime() - new Date(a.lastVerified).getTime(),
)[0];

type IntelItem = {
  href: string;
  category: string;
  title: string;
  excerpt: string;
  meta: string;
  imageSlug: string;
  coverCategory: "Guide" | "Review" | "Deal" | "News" | "Programme" | "Topic";
};

const intel: IntelItem[] = [];
for (const g of guidesSorted.slice(0, 4)) {
  intel.push({
    href: `/guides/${g.id}/`,
    category: "Guide",
    title: g.data.title,
    excerpt: g.data.description,
    meta: `Updated ${fmtShort(g.data.updatedAt)}`,
    imageSlug: `guide-${g.id}`,
    coverCategory: "Guide",
  });
}
if (newestCard) {
  const bankName =
    allBanks.find((b) => b.id === newestCard.bank)?.data.name ??
    newestCard.bank;
  intel.push({
    href: `/cards/${newestCard.slug}/`,
    category: "Card review",
    title: newestCard.name,
    excerpt: `${bankName} · annual fee AED ${newestCard.annualFee.amount.toLocaleString()}`,
    meta: `Verified ${fmtShort(new Date(newestCard.lastVerified))}`,
    imageSlug: `card-${newestCard.slug}`,
    coverCategory: "Review",
  });
}
if (newsSorted[0]) {
  const n = newsSorted[0];
  intel.push({
    href: `/news/${n.id}/`,
    category: "News",
    title: n.data.title,
    excerpt: n.data.description,
    meta: `Filed ${fmtShort(n.data.publishedAt)}`,
    imageSlug: `news-${n.id}`,
    coverCategory: "News",
  });
}

// Hero feature story — intel[0] leads the hero in a .dp-feature-card;
// the Latest-analysis grid takes intel[1..6) so the two never repeat.
// Bare manifest entry, not <StockImage>: the circular .feat-mask needs
// the primitive's own navy-hatch fallback, not the rectangular Cover.
const featureImg = intel[0] ? getStockEntry(intel[0].imageSlug) : undefined;

const liveWelcomeCount = cards.filter((c) => Boolean(c.welcomeBonus)).length;
const flagshipProgramme =
  allPrograms.find((p) => p.id === "skywards") ?? allPrograms[0];
const heroSweetSpot = flagshipProgramme?.data.sweetSpots[0];

// ── S4 Strategy panel — goal-ranked top-3s, all deterministic L2 ─────
// Mirrors the card finder's formula (spendRate fallback, loyaltyTag,
// annualFee tie-break — see cards/finder/index.astro); the panel's deep
// links land in the finder with the same params so homepage top-3 and
// finder top-6 agree. No LLM extraction anywhere (§6).
type ActiveCard = ReturnType<typeof getActiveCards>[number];
const bankNameOf = (c: ActiveCard) =>
  allBanks.find((b) => b.id === c.bank)?.data.name ?? c.bank;
const spendRate = (c: ActiveCard, key: string): number => {
  const v = (c.earnRates as Record<string, unknown>)[key];
  return typeof v === "number" ? v : (c.earnRates.everythingElse ?? 0);
};
const feeAsc = (a: ActiveCard, b: ActiveCard) =>
  a.annualFee.amount - b.annualFee.amount;

type GoalRow = { slug: string; name: string; bank: string; stat: string; statSub: string };
const asRow = (c: ActiveCard, stat: string, statSub: string): GoalRow => ({
  slug: c.slug,
  name: c.name,
  bank: bankNameOf(c),
  stat,
  statSub,
});

const travelTop = cards
  .filter((c) => loyaltyTag(c.loyaltyProgram) === "miles")
  .sort((a, b) => spendRate(b, "travel") - spendRate(a, "travel") || feeAsc(a, b))
  .slice(0, 3)
  // No numeric stat here: earn units vary per card ("miles per AED",
  // "Miles per AED 10 spent", tiered) and a uniform "/AED" label would
  // misstate rates (§6). The currency names the programme; the review
  // page carries the exact table.
  .map((c) => asRow(c, c.loyaltyProgram ?? "Miles", "ranked on travel earn rate"));

const cashbackTop = cards
  .filter((c) => loyaltyTag(c.loyaltyProgram) === "cashback")
  .sort(
    (a, b) =>
      (b.earnRates.everythingElse ?? 0) - (a.earnRates.everythingElse ?? 0) ||
      feeAsc(a, b),
  )
  .slice(0, 3)
  .map((c) =>
    asRow(c, `${c.earnRates.everythingElse}% back`, "on everything else"),
  );

const welcomeTop = cards
  .filter((c) => welcomeBonusRank(c.welcomeBonus).tier === "priced")
  .sort((a, b) => compareByWelcomeValue(a, b) || feeAsc(a, b))
  .slice(0, 3)
  .map((c) => {
    const rank = welcomeBonusRank(c.welcomeBonus);
    const aed = rank.tier === "priced" ? rank.aed : 0;
    return asRow(c, `≈ AED ${aed.toLocaleString()}`, "welcome value");
  });

const firstTop = cards
  .filter((c) => c.eligibility.minSalary <= 8000 && c.eligibility.invitationOnly !== true)
  .sort(
    (a, b) =>
      feeAsc(a, b) ||
      a.eligibility.minSalary - b.eligibility.minSalary ||
      (b.earnRates.everythingElse ?? 0) - (a.earnRates.everythingElse ?? 0),
  )
  .slice(0, 3)
  .map((c) =>
    asRow(
      c,
      `AED ${c.annualFee.amount.toLocaleString()} fee`,
      `from AED ${c.eligibility.minSalary.toLocaleString()} salary`,
    ),
  );

// Guides carry no tags (content.config.ts) — the goal→guide map is
// hand-curated. The build-time throw keeps a renamed guide from
// silently 404ing the homepage; the postbuild link sweep is the
// second net.
const GOAL_GUIDES = {
  travel: "skywards-business-class-redemptions-2026",
  cashback: "best-entry-level-cards-2026",
  welcome: "best-premium-cards-2026",
  first: "expat-starter-first-credit-card",
} as const;
const goalGuide = (id: keyof typeof GOAL_GUIDES) => {
  const slug = GOAL_GUIDES[id];
  const g = allGuides.find((x) => x.id === slug);
  if (!g) throw new Error(`strategy panel: guide "${slug}" not found for goal "${id}"`);
  return { slug, title: g.data.title, meta: `Updated ${fmtShort(g.data.updatedAt)}` };
};

const goals = [
  {
    id: "travel",
    label: "Travel & miles",
    cards: travelTop,
    guide: goalGuide("travel"),
    tool: {
      href: "/cards/finder/?spend=travel&prefer=miles",
      eyebrow: "Tool",
      title: "Rank miles cards for travel spend",
      meta: "Card finder →",
    },
  },
  {
    id: "cashback",
    label: "Cashback",
    cards: cashbackTop,
    guide: goalGuide("cashback"),
    tool: {
      href: "/cards/finder/?spend=general&prefer=cashback",
      eyebrow: "Tool",
      title: "Rank cashback cards for your spend",
      meta: "Card finder →",
    },
  },
  {
    id: "welcome",
    label: "Welcome bonus",
    cards: welcomeTop,
    guide: goalGuide("welcome"),
    tool: {
      href: "/calculator/",
      eyebrow: "Tool",
      title: "See which welcome offer pays back first",
      meta: "Welcome-bonus calculator →",
    },
  },
  {
    id: "first",
    label: "First card",
    cards: firstTop,
    guide: goalGuide("first"),
    tool: {
      href: "/cards/finder/?salary=8000&fee=under-500",
      eyebrow: "Tool",
      title: "Entry-level cards under AED 500 a year",
      meta: "Card finder →",
    },
  },
] as const;

// ── S2 Live desk: salary-transfer offers ─────────────────────────────
// Real rows from the salaryTransferOffers collection; each column
// renders only while genuinely live rows exist (honest emptiness).
const liveOffers = await getLiveOffers();
const fmtVerified = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const offerRows = liveOffers.map((o) => {
  const best = o.salaryBands.reduce((a, b) => (b.rewardAmount > a.rewardAmount ? b : a));
  const minBand = o.salaryBands.reduce((a, b) => (b.minSalary < a.minSalary ? b : a));
  return {
    bankSlug: o.bankSlug,
    bankName: o.bankName,
    upTo: `${formatAED(best.rewardAmount)} ${best.rewardType === "cash" ? "cash" : best.rewardType.replace("_", " ")}`,
    from: `${formatAED(minBand.minSalary)}+ salary`,
    bands: o.salaryBands.length,
    sharia: o.sharia,
    verified: fmtVerified(o.lastVerified),
  };
});

// ── S2 Live desk: deals ──────────────────────────────────────────────
// Same honest-emptiness contract. Soonest-expiring first, capped at
// four rows — the /deals/ index is the full surface. The expiry filter
// is load-bearing: an expired deal sat on the homepage for a week in
// August 2026 before this guard existed. Do not weaken it.
const todayMs = Date.now();
const liveDealsRaw = (await getCollection("deals"))
  .filter((d) => !d.data.archived && d.data.expiresOn.getTime() >= todayMs)
  .sort((a, b) => a.data.expiresOn.getTime() - b.data.expiresOn.getTime())
  .slice(0, 4);
const dealRows = await Promise.all(
  liveDealsRaw.map(async (d) => ({
    id: d.id,
    title: d.data.title,
    issuer: (await resolveDealIssuer(d)).name,
    ends: fmtShort(d.data.expiresOn),
  })),
);
---

<BaseLayout
  title="DubaiPoints — UAE miles, deals and banking, AED-first"
  description="Independent UAE-resident-led guides to credit cards, salary-transfer bonuses, miles redemptions and lifestyle deals. AED-first, sourced and dated."
  fullWidth
>
  <!-- ── S1. Hero: masthead + feature story ─────────────────────────── -->
  <header class="dp-pagehead is-hero hp-hero">
    <div class="hp-hero-grid">
      <div class="hp-hero-text">
        <span class="hp-hero-kicker">Independent UAE points &amp; miles publication</span>
        <h1>Fly further. Pay&nbsp;less.</h1>
        <p class="hp-hero-lede">
          UAE-resident guides to the card combinations, salary-transfer
          bonuses and miles redemptions that stretch a Dubai paycheque
          further — AED-first, dated and sourced.
        </p>
        <p class="hp-hero-meta">
          {cards.length} cards · {allBanks.length} banks ·
          {allPrograms.length} programmes · zero paid placements
        </p>
        <div class="hp-hero-ctas">
          <a href="#latest" class="hp-hero-cta">Read the latest ↓</a>
          <a href="/newsletter/" class="hp-hero-cta is-ghost">Join the Friday brief →</a>
        </div>
        {!newsletterLive && (
          <p class="hp-hero-micro">
            The brief is preparing for launch — sign-up is by email until
            the automated list opens.
          </p>
        )}
      </div>

      {intel[0] && (
        <a href={intel[0].href} class="dp-feature-card hp-hero-feature">
          {featureImg ? (
            <span class="feat-mask">
              <img
                src={`/${featureImg.file}`}
                alt={featureImg.alt}
                width={featureImg.width}
                height={featureImg.height}
                loading="eager"
                fetchpriority="high"
                decoding="async"
                sizes="(max-width: 899px) 80vw, 30vw"
              />
            </span>
          ) : (
            <span class="feat-mask" aria-hidden="true"></span>
          )}
          <span class="feat-body">
            <span class="feat-eyebrow">Featured · {intel[0].category}</span>
            <span class="feat-title">{intel[0].title}</span>
            <span class="feat-meta">{intel[0].meta}</span>
            <span class="feat-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      )}
    </div>
  </header>

  <!-- ── S2. Tools strip ────────────────────────────────────────────── -->
  <section class="hp-tools" aria-label="Tools">
    <div class="dp-featured-eyebrow">
      <span>Tools</span>
      <span class="rule"></span>
      <span class="meta">Rank, compare, calculate</span>
    </div>
    <div class="dp-tool-strip">
      <a href="/cards/finder/" class="dp-tool">
        <span class="eyebrow">Rank</span>
        <span class="title">Card finder</span>
        <span class="go">{cards.length} cards →</span>
      </a>
      <a href="/cards/compare/" class="dp-tool">
        <span class="eyebrow">Compare</span>
        <span class="title">Compare cards</span>
        <span class="go">Side-by-side specs →</span>
      </a>
      <a href="/calculator/" class="dp-tool">
        <span class="eyebrow">Calculate</span>
        <span class="title">Welcome-bonus calculator</span>
        <span class="go">Payback by AED spend →</span>
      </a>
      <a href="/salary-transfer/calculator/" class="dp-tool">
        <span class="eyebrow">Calculate</span>
        <span class="title">Salary-offer calculator</span>
        <span class="go">Compare bank offers →</span>
      </a>
    </div>
  </section>

  <!-- ── S3. Live desk — salary offers + deals, one module ──────────── -->
  {(offerRows.length > 0 || dealRows.length > 0) && (
    <section class="dp-live-desk" aria-label="Live data desk">
      <div class="head">
        <div class="dp-featured-eyebrow">
          <span>Live desk</span>
          <span class="rule"></span>
          <span class="meta">Verified against published terms</span>
        </div>
        <h2>What's live right now.</h2>
      </div>
      <div class="cols">
        {offerRows.length > 0 && (
          <div class="col" role="group" aria-label="Live salary-transfer offers">
            <div class="col-head">
              <h3>Salary-transfer offers</h3>
              <a href="/salary-transfer/">Full tracker →</a>
            </div>
            <ul class="rows">
              {offerRows.map((r) => (
                <li>
                  <a href={`/salary-transfer/${r.bankSlug}/`} class="row">
                    <span class="bank">{r.bankName}</span>
                    <span class="detail">
                      up to <strong>{r.upTo}</strong> · {r.bands} bands · from {r.from}
                      {r.sharia ? " · Sharia-compliant" : ""}
                    </span>
                    <span class="chip">Verified {r.verified}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="foot">Every band checked against the bank's published terms. Offers change without notice — verify before applying.</p>
          </div>
        )}
        {dealRows.length > 0 && (
          <div class="col" role="group" aria-label="Live deals">
            <div class="col-head">
              <h3>Deals desk</h3>
              <a href="/deals/">All deals →</a>
            </div>
            <ul class="rows">
              {dealRows.map((r) => (
                <li>
                  <a href={`/deals/${r.id}/`} class="row">
                    <span class="bank">{r.issuer}</span>
                    <span class="detail">{r.title}</span>
                    <span class="chip is-ends">Ends {r.ends}</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="foot">Shown as recorded in the latest editorial sweep. Check the provider before acting; terms can change.</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ── S4. Strategy panel — goal-ranked, no-JS radio tabs ─────────── -->
  <section class="dp-strategy" aria-label="Build your points strategy">
    <div class="inner">
      <div class="dp-featured-eyebrow">
        <span>Build your points strategy</span>
        <span class="rule"></span>
        <span class="meta">Ranked from verified card data</span>
      </div>
      <h2>Start from the goal, not the card.</h2>
      <input type="radio" name="dps-goal" id="dps-travel" class="dps-radio" checked />
      <input type="radio" name="dps-goal" id="dps-cashback" class="dps-radio" />
      <input type="radio" name="dps-goal" id="dps-welcome" class="dps-radio" />
      <input type="radio" name="dps-goal" id="dps-first" class="dps-radio" />
      <div class="dps-pills">
        {goals.map((g) => (
          <label for={`dps-${g.id}`}>{g.label}</label>
        ))}
      </div>
      {goals.map((g) => (
        <div class={`dps-panel is-${g.id}`}>
          <ol class="dps-cards">
            {g.cards.map((c, i) => (
              <li>
                <a href={`/cards/${c.slug}/`}>
                  <span class="rank">{i + 1}</span>
                  <span>
                    <span class="name">{c.name}</span>
                    <span class="bank">{c.bank}</span>
                  </span>
                  <span class="stat">{c.stat}<small>{c.statSub}</small></span>
                </a>
              </li>
            ))}
          </ol>
          <div class="dps-aside">
            <a href={`/guides/${g.guide.slug}/`}>
              <span class="eyebrow">Guide</span>
              <span class="t">{g.guide.title}</span>
              <span class="m">{g.guide.meta}</span>
            </a>
            <a href={g.tool.href}>
              <span class="eyebrow">{g.tool.eyebrow}</span>
              <span class="t">{g.tool.title}</span>
              <span class="m">{g.tool.meta}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ── S5. Latest analysis ────────────────────────────────────────── -->
  <section class="dp-featured-band" id="latest" aria-label="Latest analysis">
    <div class="dp-featured-eyebrow">
      <span>Latest analysis</span>
      <span class="rule"></span>
      <span class="meta">Checked against primary sources</span>
    </div>
    <div class="dp-featured-grid">
      {intel[1] && (
        <a href={intel[1].href} class="dp-story-card hero">
          <StockImage
            slug={intel[1].imageSlug}
            coverTitle={intel[1].title}
            coverCategory={intel[1].coverCategory}
            coverSize="hero"
            loading="eager"
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{intel[1].category}</span> {intel[1].meta}</span>
            <h3>{intel[1].title}</h3>
            <p>{intel[1].excerpt}</p>
          </div>
        </a>
      )}
      {intel.slice(2, 4).map((item) => (
        <a href={item.href} class="dp-story-card med">
          <StockImage
            slug={item.imageSlug}
            coverTitle={item.title}
            coverCategory={item.coverCategory}
            coverSize="med"
            sizes="(max-width: 1024px) 100vw, 25vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{item.category}</span> {item.meta}</span>
            <h3>{item.title}</h3>
          </div>
        </a>
      ))}
      {intel.slice(4, 6).map((item) => (
        <a href={item.href} class="dp-story-card sm">
          <StockImage
            slug={item.imageSlug}
            coverTitle={item.title}
            coverCategory={item.coverCategory}
            coverSize="sm"
            sizes="(max-width: 640px) 100vw, 25vw"
          />
          <div class="body">
            <span class="meta"><span class="cat">{item.category}</span></span>
            <h3>{item.title}</h3>
          </div>
        </a>
      ))}
    </div>
    <div class="hp-latest-foot">
      <a href="/guides/">All guides →</a>
      <a href="/news/">News desk →</a>
    </div>
  </section>

  <!-- ── S6. Start here — directory ─────────────────────────────────── -->
  <section class="hp-dir" aria-label="Browse dubaipoints.ae">
    <div class="dp-featured-eyebrow">
      <span>Start here</span>
      <span class="rule"></span>
      <span class="meta">Everything on dubaipoints.ae</span>
    </div>
    <div class="dp-dir-grid">
      <a href="/cards/" class="dp-dir-tile">
        <span class="eyebrow">{cards.length} cards</span>
        <span class="title">Credit-card reviews</span>
        <span class="desc">Cashback, miles and Islamic cards compared on fees, earn rates and eligibility.</span>
        <span class="meta">{liveWelcomeCount} with recorded welcome-bonus data</span>
      </a>
      <a href="/banks/" class="dp-dir-tile">
        <span class="eyebrow">{allBanks.length} banks</span>
        <span class="title">Bank guides</span>
        <span class="desc">Every covered UAE issuer — fees, eligibility and card line-ups.</span>
        <span class="meta">Browse issuers →</span>
      </a>
      <a href="/airlines/" class="dp-dir-tile">
        <span class="eyebrow">{allPrograms.length} programmes</span>
        <span class="title">Miles &amp; loyalty</span>
        <span class="desc">Skywards, Etihad Guest, Qatar and the hotel programmes — tiers, transfer partners and sweet spots.</span>
        {heroSweetSpot && <span class="meta">Sweet spot: {heroSweetSpot.title}</span>}
      </a>
      <a href="/salary-transfer/" class="dp-dir-tile">
        <span class="eyebrow"><span class="hp-live-dot" aria-hidden="true"></span>Live tracker</span>
        <span class="title">Salary-transfer offers</span>
        <span class="desc">Band-by-band cash and rate offers across UAE banks — sources watched weekly, every entry dated.</span>
