<style>
  /* ── S1 hero — page-unique ─────────────────────────────────────────── */
  /* Hero, 4 Oct 2026 (Chairman direction from a reel): a light, airy
     band — a large illustration left, the serif headline right — the
     render cycling through four pictures. Replaces the navy band of the
     same morning; the slow gold/navy light stays (global.css, off under
     reduced motion), now faint on paper so the pictures' off-white
     studio fields blend into the band. */
  .hp-hero {
    /* clip, not hidden: hidden would make the band a scroll container. */
    position: relative; overflow: clip;
    background: var(--paper); color: var(--ink);
    padding: 56px 32px 56px;
  }
  .hp-hero::before {
    content: ""; position: absolute; inset: -20%; pointer-events: none;
    background:
      radial-gradient(45% 55% at 22% 18%, rgba(184, 132, 42, 0.14), transparent 62%),
      radial-gradient(40% 50% at 88% 88%, rgba(31, 58, 77, 0.10), transparent 60%);
  }
  .hp-hero-grid { position: relative; z-index: 1; }
  .hp-hero-grid {
    max-width: var(--container-listing);
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }
  /* Under the reel: headline left, lede and actions right. */
  @media (min-width: 900px) {
    .hp-hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; margin-top: 64px; }
  }
  .hp-hero-kicker {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 18px;
  }
  .hp-hero-kicker .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--gold);
  }
  .hp-hero h1 {
    text-wrap: balance;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(46px, 5.6vw, 72px);
    letter-spacing: -1.4px; line-height: 1.02;
    color: var(--ink);
    margin: 0 0 18px;
  }
  /* The italic accent word is the v0 design's signature, readopted on
     Chairman direction (29 Aug 2026) in the primary accent. */
  .hp-hero h1 em {
    font-style: italic;
    color: var(--gold-ink);
    white-space: nowrap; /* keeps "Pay less" on one line without a &nbsp; that some readers join into one word (F-040) */
  }
  .hp-hero-lede {
    font-size: 18px; line-height: 1.6;
    color: var(--ink-soft, var(--muted));
    max-width: 46ch;
    margin: 0 0 26px;
  }
  .hp-hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  /* Square box CTAs — the v0 "boxes" idiom. */
  .hp-hero-cta {
    display: inline-flex; align-items: center;
    padding: 14px 24px;
    border-radius: 6px;
    background: var(--gold); color: var(--ink);
    font-size: 15px; font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s var(--dp-ease-hover);
  }
  .hp-hero-cta:hover { background: var(--gold-hover); transform: translateY(-1px); }
  .hp-hero-cta.is-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid var(--line);
    padding: 13px 20px; font-weight: 600;
  }
  .hp-hero-cta.is-ghost:hover { background: transparent; color: var(--green); border-color: var(--green); }
  .hp-hero-trust {
    display: flex; flex-wrap: wrap; gap: 0;
    margin: 30px 0 0;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1.4px; text-transform: uppercase;
    color: var(--muted);
  }
  .hp-hero-trust > span { padding-right: 14px; }
  .hp-hero-trust > span + span {
    border-left: 1px solid var(--line);
    padding-left: 14px;
  }
  .hp-hero-feature {
    display: grid; gap: 4px;
    margin: 26px 0 0; padding: 16px 0 0;
    border-top: 1px solid var(--line);
    max-width: 46ch;
    text-decoration: none;
  }
  .hp-hero-feature .eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted);
  }
  .hp-hero-feature .t {
    font-family: var(--font-display); font-weight: 500;
    font-size: 19px; line-height: 1.25; letter-spacing: -0.2px; color: var(--ink);
    transition: color 0.15s;
  }
  .hp-hero-feature:hover .t { color: var(--green); }
  .hp-hero-feature .m { font-size: 12px; font-weight: 600; color: var(--green); }

  /* ── Hero reel (4–5 Oct 2026) ──────────────────────────────────────
     The reel owns the middle of the hero, as in the reference reels: a
     giant word spanning the width, the video centred in front of its
     lower half, the headline below. The word is sized from the reel's
     OWN width (container units), never the viewport's, so the longest
     word cannot run into anything whatever font loads — it did on
     5 Oct 2026, when ARRIVE at 184px overran a 560px column into the H1.
     The page scrolls normally. */
  .hp-story {
    position: relative;
    max-width: var(--container-listing);
    margin: 0 auto;
    container-type: inline-size;
  }
  .hp-story-stage {
    /* ARRIVE is ~4.2em wide at this tracking: 17cqi keeps it inside ~72%
       of the reel, with room for a wider fallback face. */
    --word: min(17cqi, 250px);
    position: relative;
    display: grid; justify-items: center;
    /* The frame covers the lower part of the word, as the object covers
       the lettering in the reel. */
    padding-top: calc(var(--word) * 0.8);
    /* As wide as the hero allows, but short enough that word, video and
       steps fit one screen on a laptop. */
    --fw: min(100%, 960px, max(420px, calc((100svh - 400px) * 4 / 3)));
  }
  /* Giant word behind the picture. Decorative (aria-hidden); the step
     list carries the same words for assistive tech. */
  .hp-story-words {
    position: absolute; inset: 0 0 auto 0; z-index: 0;
    height: var(--word);
    pointer-events: none;
  }
  .hp-story-words > span {
    position: absolute; left: 50%; top: 0;
    max-width: 100%;
    transform: translate(-50%, 18px);
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--word); line-height: 0.82; letter-spacing: -0.04em;
    text-transform: uppercase; white-space: nowrap;
    color: var(--gold);
    opacity: 0;
    transition: opacity 0.5s var(--dp-ease), transform 0.6s var(--dp-ease);
  }
  .hp-story-words > span.is-active { opacity: 1; transform: translate(-50%, 0); }
  :global([data-theme="dark"]) .hp-story-words > span { color: var(--gold-lift); }

  .hp-story-frame {
    position: relative; z-index: 1;
    width: var(--fw);
    aspect-ratio: 4 / 3;
    border-radius: 18px; overflow: hidden;
    background: #0f1f2e;
    box-shadow: 0 34px 70px -34px rgba(15, 31, 46, 0.6), 0 0 0 1px rgba(15, 31, 46, 0.06);
  }
  .hp-story-frame > video {
