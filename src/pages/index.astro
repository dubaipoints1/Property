<style>
  /* ── S1 hero — page-unique ─────────────────────────────────────────── */
  /* Hero, 4 Oct 2026 (Chairman direction from a reel): a light, airy
     band — a large illustration left, the serif headline right — the
     render cycling through four pictures. Replaces the navy band of the
     same morning; the slow gold/navy light stays (global.css, off under
     reduced motion), now faint on paper so the pictures' off-white
     studio fields blend into the band. */
  .hp-hero {
    /* clip, not hidden: hidden would make the band a scroll container. */
    position: relative; overflow: clip;
    /* Night bridge (5 Oct 2026): the band under the reel stays the night
       navy the video ends on, so the page does not cut from a cinematic
       night sky to a flat beige band. Same in both themes. */
    background: var(--navy-pin); color: #fdfcf8;
    padding: 0 0 104px;
  }
  .hp-hero::before {
    content: ""; position: absolute; inset: -20%; pointer-events: none;
    background:
      radial-gradient(45% 55% at 22% 18%, rgba(184, 132, 42, 0.14), transparent 62%),
      radial-gradient(40% 50% at 88% 88%, rgba(31, 58, 77, 0.10), transparent 60%);
  }
  .hp-hero-grid { position: relative; z-index: 1; }
  .hp-hero-grid {
    max-width: var(--container-listing);
    margin: 48px auto 0;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: start;
  }
  /* Under the reel: headline left, lede and actions right. */
  @media (min-width: 900px) {
    .hp-hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; margin-top: 56px; }
  }
  .hp-hero-kicker {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 11px; font-weight: 700;
    letter-spacing: 2.5px; text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 18px;
  }
  .hp-hero-kicker .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--gold);
  }
  .hp-hero h1 {
    text-wrap: balance;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(46px, 5.6vw, 72px);
    letter-spacing: -1.4px; line-height: 1.02;
    color: var(--ink);
    margin: 0 0 18px;
  }
  /* The italic accent word is the v0 design's signature, readopted on
     Chairman direction (29 Aug 2026) in the primary accent. */
  .hp-hero h1 em {
    font-style: italic;
    color: var(--gold-ink);
    white-space: nowrap; /* keeps "Pay less" on one line without a &nbsp; that some readers join into one word (F-040) */
  }
  .hp-hero-lede {
    font-size: 18px; line-height: 1.6;
    color: var(--ink-soft, var(--muted));
    max-width: 46ch;
    margin: 0 0 26px;
  }
  .hp-hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; }
  /* Square box CTAs — the v0 "boxes" idiom. */
  .hp-hero-cta {
    display: inline-flex; align-items: center;
    padding: 14px 24px;
    border-radius: 6px;
    background: var(--gold); color: var(--ink);
    font-size: 15px; font-weight: 700;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s var(--dp-ease-hover);
  }
  .hp-hero-cta:hover { background: var(--gold-hover); transform: translateY(-1px); }
  .hp-hero-cta.is-ghost {
    background: transparent; color: var(--ink);
    border: 1px solid var(--line);
    padding: 13px 20px; font-weight: 600;
  }
  .hp-hero-cta.is-ghost:hover { background: transparent; color: var(--green); border-color: var(--green); }
  /* On the night bridge. */
  .hp-hero .hp-hero-lede { color: rgba(253, 252, 248, 0.78); font-size: clamp(18px, 1.5vw, 21px); }
  .hp-hero .hp-hero-cta.is-ghost { color: #fdfcf8; border-color: rgba(253, 252, 248, 0.3); }
  .hp-hero .hp-hero-cta.is-ghost:hover { color: var(--gold-lift); border-color: var(--gold-lift); }
  .hp-hero .hp-hero-trust { color: rgba(253, 252, 248, 0.62); }
  .hp-hero .hp-hero-trust > span + span { border-left-color: rgba(253, 252, 248, 0.18); }
  .hp-hero .hp-hero-feature { border-top-color: rgba(253, 252, 248, 0.18); }
  .hp-hero .hp-hero-feature .eyebrow { color: rgba(253, 252, 248, 0.6); }
  .hp-hero .hp-hero-feature .t { color: #fdfcf8; }
  .hp-hero .hp-hero-feature:hover .t { color: var(--gold-lift); }
  .hp-hero .hp-hero-feature .m { color: var(--gold-lift); }
  .hp-hero .hp-hero-cta:focus-visible,
  .hp-hero .hp-hero-feature:focus-visible { outline: 2px solid var(--gold-lift); outline-offset: 3px; }
  .hp-hero-trust {
    display: flex; flex-wrap: wrap; gap: 0;
    margin: 30px 0 0;
    font-size: 11px; font-weight: 600;
    letter-spacing: 1.4px; text-transform: uppercase;
    color: var(--muted);
  }
  .hp-hero-trust > span { padding-right: 14px; }
  .hp-hero-trust > span + span {
    border-left: 1px solid var(--line);
    padding-left: 14px;
  }
  .hp-hero-feature {
    display: grid; gap: 4px;
    margin: 26px 0 0; padding: 16px 0 0;
    border-top: 1px solid var(--line);
    max-width: 46ch;
    text-decoration: none;
  }
  .hp-hero-feature .eyebrow {
    font-size: 10px; font-weight: 700; letter-spacing: 1.8px; text-transform: uppercase; color: var(--muted);
  }
  .hp-hero-feature .t {
    font-family: var(--font-display); font-weight: 500;
    font-size: 19px; line-height: 1.25; letter-spacing: -0.2px; color: var(--ink);
    transition: color 0.15s;
  }
  .hp-hero-feature:hover .t { color: var(--green); }
  .hp-hero-feature .m { font-size: 12px; font-weight: 600; color: var(--green); }

  /* ── Hero reel (5 Oct 2026) ───────────────────────────────────────
     Full-bleed video under the sticky site header. With JS (.is-scrub)
     the section becomes a 3-screen track and the stage sticks while
     scroll drives --p from 0 to 1; everything below is a function of
     --p. Without it, one static screen. Colours are fixed light-on-dark
     in both themes: the stage is always night-navy behind a video. */
  .hp-reel {
    --hp-head: 116px;
    --p: 0;
    position: relative;
    height: calc(100svh - var(--hp-head));
    min-height: 420px;
  }
  .hp-reel.is-scrub { height: calc(300svh - var(--hp-head)); }
  .hp-reel-stage {
    position: relative;
    height: calc(100svh - var(--hp-head));
    min-height: 420px;
    overflow: hidden;
    background: var(--navy-pin);
  }
  .hp-reel.is-scrub .hp-reel-stage { position: sticky; top: var(--hp-head); }
  .hp-reel-video {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(calc(1 + var(--p) * 0.06));
    will-change: transform;
  }
  .hp-reel-scrim {
    position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg,
      rgba(22, 32, 44, 0.55) 0%, rgba(22, 32, 44, 0.15) 38%,
      rgba(22, 32, 44, 0.15) 62%, rgba(22, 32, 44, 0.6) 100%);
  }
  .hp-reel-title {
    position: absolute; inset: 0;
    display: grid; place-content: center; justify-items: center;
    padding: 0 6%; text-align: center;
    opacity: clamp(0, 1 - var(--p) / 0.3, 1);
    transform: translateY(calc(clamp(0, var(--p) / 0.3, 1) * -24px));
    filter: blur(calc(clamp(0, var(--p) / 0.3, 1) * 10px));
    pointer-events: none;
  }
  .hp-reel-title .hp-hero-kicker { color: var(--gold-lift); margin-bottom: 20px; }
  .hp-reel-title .hp-hero-lede {
    margin: 22px auto 0; max-width: 42ch;
    color: rgba(253, 252, 248, 0.86);
    text-shadow: 0 2px 16px rgba(10, 16, 24, 0.55);
  }
  .hp-reel-title .hp-hero-ctas { justify-content: center; margin-top: 24px; pointer-events: auto; }
  .hp-reel.is-past-title .hp-reel-title { visibility: hidden; }
  .hp-hero-grid.is-single { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
