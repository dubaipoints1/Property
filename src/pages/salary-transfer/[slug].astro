---
import NextStepLinks from "~/components/NextStepLinks.astro";
import BankLogo from "~/components/BankLogo.astro";
import BaseLayout from "~/layouts/BaseLayout.astro";
import { collectionPageGraph, breadcrumbGraph, siteUrlFrom } from "~/lib/schema";
import SalaryTransferTrackerLayout from "~/layouts/SalaryTransferTrackerLayout.astro";
import SalaryTransferTracker from "~/components/islands/SalaryTransferTracker.tsx";
import Disclaimer from "~/components/Disclaimer.astro";
import { getCollection, render } from "astro:content";
import { getLiveOffers, getOffersForBank } from "~/lib/offerAdapter";
import { formatAED } from "~/lib/salaryTransfer";
import { getTrackerCardPaths } from "~/lib/salaryTransferTrackerImages";
import {
  salaryBandsOverlap,
  TRACKER_SALARY_BANDS,
  type TrackerSalaryBand,
} from "~/lib/salaryTransferTrackerBands";

export async function getStaticPaths() {
  const bandPaths = TRACKER_SALARY_BANDS.map((b) => ({
    params: { slug: b.slug },
    props: { kind: "band" as const, band: b },
  }));
  const banks = await getCollection("banks");
  const bankPaths = banks.map((bank) => ({
    params: { slug: bank.id },
    props: { kind: "bank" as const, bankId: bank.id, bankName: bank.data.name },
  }));
  return [...bandPaths, ...bankPaths];
}

const props = Astro.props as
  | { kind: "band"; band: TrackerSalaryBand }
  | { kind: "bank"; bankId: string; bankName: string };

let bandOffers: Awaited<ReturnType<typeof getLiveOffers>> = [];
let bankOffers: Awaited<ReturnType<typeof getLiveOffers>> = [];
let renderedNotes: { id: string; Content: any }[] = [];
let bankStamp: string | null = null;
let liveOfferCount = 0;

if (props.kind === "band") {
  const { band } = props;
  const all = await getLiveOffers();
  bandOffers = all.filter((o) => o.salaryBands.some((tier) => salaryBandsOverlap(tier, band)));
} else {
  bankOffers = await getOffersForBank(props.bankId);
  liveOfferCount = (await getLiveOffers()).length;
  // Title stamp from the newest verification date, never the build clock
  // (2026-09-06 audit, F-014: every bank page re-dated itself each deploy).
  bankStamp = bankOffers.length
    ? new Date(Math.max(...bankOffers.map((o) => new Date(o.lastVerified).getTime())))
        .toLocaleDateString("en-GB", { month: "long", year: "numeric" })
    : null;
  const offerEntries = await getCollection(
    "salaryTransferOffers",
    (e) => e.data.bank.id === props.bankId,
  );
  renderedNotes = await Promise.all(
    offerEntries.map(async (e) => {
      const { Content } = await render(e);
      return { id: e.id, Content };
    }),
  );
}
const siteUrl = siteUrlFrom(Astro.site);
---

{
  props.kind === "band" && (
    <SalaryTransferTrackerLayout
      title={`Salary transfer offers (${props.band.label}) | DubaiPoints`}
      description={`Live UAE salary transfer offers with eligible salaries within the ${props.band.label} band.`}
      bandLabel={props.band.label}
      liveCount={bandOffers.length}
    >
      <div slot="tracker">
        <SalaryTransferTracker offers={bandOffers} scope={props.band} cardPaths={getTrackerCardPaths(bandOffers)} client:load />
      </div>
      <div slot="bands" class="dp-dir-grid">
        {TRACKER_SALARY_BANDS.map((b) => (
          <a class="dp-dir-tile" href={`/salary-transfer/${b.slug}/`} aria-current={b.slug === Astro.params.slug ? "page" : undefined}>
            <span class="eyebrow">Salary band</span>
            <span class="title">{b.label}</span>
          </a>
        ))}
      </div>
      <Disclaimer slot="footer" variant="offer" />
    </SalaryTransferTrackerLayout>
  )
}

{
  props.kind === "bank" && (
    <BaseLayout
      title={`${props.bankName} salary transfer offer${bankStamp ? ` (${bankStamp})` : ""} | DubaiPoints`}
      description={`Deep-dive on ${props.bankName}'s current salary transfer offer: bands, clawback, payout timing, and expat-relevant gotchas.`}
      fullWidth
      schema={breadcrumbGraph(siteUrl, [{ name: "Salary-transfer tracker", path: "/salary-transfer/" }, { name: props.bankName, path: Astro.url.pathname }])}
    >
      <article class="dp-article is-wide">
        <header class="dp-article-head">
          <p class="dp-article-eyebrow">Salary transfer</p>
          <div class="dp-st-bank-title">
            <BankLogo slug={props.bankId} name={props.bankName} size="md" decorative />
            <h1 class="dp-article-title">{props.bankName}</h1>
          </div>
          <p class="dp-article-meta">
            <a href={`/salary-transfer/history/${props.bankId}/`}>
              View {props.bankName} offer history →
            </a>
          </p>
        </header>

        {bankOffers.length === 0 && (
          <p class="dp-tracker-empty">No live offer tracked for {props.bankName}.</p>
        )}

        {bankOffers.map((o) => {
          const noteEntry = renderedNotes.find((n) => n.id === o.id);
          const NoteContent = noteEntry?.Content;
          return (
            <section class="dp-offer-card">
              <header class="dp-offer-head">
                <h2>{o.name}</h2>
                <span class="dp-offer-verified">
                  Last verified {new Date(o.lastVerified).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}
                </span>
              </header>

              <div class="dp-st-offer-table" role="region" aria-label="Salary and reward tiers" tabindex="0">
              <table class="dp-data-table">
                <thead>
                  <tr>
                    <th>Salary band</th>
                    <th>Reward</th>
                    <th>Type</th>
                    <th>Pays out</th>
                  </tr>
                </thead>
                <tbody>
                  {o.salaryBands.map((b) => (
                    <tr>
                      <td>
                        {formatAED(b.minSalary)} –{" "}
                        {b.maxSalary === null ? "no limit" : formatAED(b.maxSalary)}
                      </td>
                      <td class="num">{formatAED(b.rewardAmount)}</td>
                      <td>{b.rewardType.replace("_", " ")}</td>
                      <td>+{b.monthsToPayout} months</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              </div>

              <section class="dp-article-section">
                <h3>Requirements</h3>
                <ul class="dp-bullet-list">
                  {o.requirements.map((r) => <li>{r}</li>)}
                </ul>
              </section>

              <aside class="dp-clawback">
                <strong>Clawback:</strong> {o.clawbackTerms}
              </aside>

              {NoteContent && (
                <section class="dp-prose dp-offer-note">
                  <NoteContent />
                </section>
              )}

              <p class="dp-offer-source">
                <a href={o.sourceUrl} target="_blank" rel="noopener">Source →</a>
              </p>
            </section>
          );
        })}

        <NextStepLinks
          heading={bankOffers.length ? `Is ${props.bankName} the best deal for your salary?` : "Where to look instead"}
          items={[
            {
              href: "/salary-transfer/",
              title: "Compare every live offer",
              meta: `${liveOfferCount} salary-transfer offers, filtered by your salary band`,
            },
            {
              href: "/salary-transfer/calculator/",
              title: "Work out your reward",
              meta: "What each bank pays at your exact salary, and when",
            },
            {
              href: `/banks/${props.bankId}/`,
              title: `${props.bankName} cards and accounts`,
              meta: "Fees, earn rates and our reviews of this bank's cards",
            },
          ]}
        />

        <Disclaimer variant="offer" />
      </article>
    </BaseLayout>
  )
}

<style>
  .dp-st-bank-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
  }
  .dp-st-offer-table {
    overflow-x: auto;
  }
  .dp-st-offer-table:focus-visible {
    outline: 2px solid var(--green);
    outline-offset: 3px;
  }
  .dp-offer-card {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--paper);
    padding: 24px;
    margin-bottom: 24px;
  }
  .dp-offer-head {
    display: flex; flex-wrap: wrap;
    align-items: baseline; justify-content: space-between;
    gap: 12px; margin-bottom: 18px;
    padding-bottom: 14px; border-bottom: 1px solid var(--line);
  }
  .dp-offer-head h2 {
    font-family: var(--font-display); font-weight: 500;
    font-size: clamp(18px, 3vw, 22px);
    letter-spacing: -0.3px; color: var(--ink);
  }
  .dp-offer-verified {
    font-size: 10px; font-weight: 700; letter-spacing: 1.5px;
    text-transform: uppercase; color: var(--muted);
  }
  .dp-clawback {
    margin-top: 14px;
    padding: 12px 14px;
    border-left: 3px solid var(--red);
    background: #fef2f2;
    border-radius: 4px;
    font-size: 13px; line-height: 1.55;
    color: #7f1d1d;
  }
  .dp-clawback strong { color: #7f1d1d; }
  .dp-offer-note {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .dp-offer-source {
    margin-top: 14px;
    font-size: 12px; color: var(--muted);
  }
  .dp-offer-source a { color: var(--ink); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--line); }
  .dp-offer-source a:hover { color: var(--green); }
</style>
