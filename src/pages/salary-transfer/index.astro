---
// Salary-transfer tracker — Phase C tools template (Claude Design handoff).
// Reference: dubaipoints/project/templates/tools.jsx::Tracker.
// Preserves the existing Preact island for live filtering/sorting; wraps
// it in the new tools chrome (pagehead with stats strip + toolbar + table
// + methodology footer).

import { getCollection } from "astro:content";
import { breadcrumbGraph, siteUrlFrom } from "~/lib/schema";

import BaseLayout from "~/layouts/BaseLayout.astro";
import SalaryTransferTracker from "~/components/islands/SalaryTransferTracker.tsx";
import { getLiveOffers, getLapsedUnarchivedOffers, getUpcomingUnarchivedOffers } from "~/lib/offerAdapter";
import { classifyCoverage, coverageGuardError, SALARY_OFFER_ADVERTISED_WITHOUT_CURRENT_TERMS, SALARY_OFFER_CHECKED_WITHOUT_BANDED_CASH, SALARY_OFFER_REVIEW_PENDING_BANKS } from "~/lib/salaryTransferCoverage";
import { TRACKER_SALARY_BANDS as bands } from "~/lib/salaryTransferTrackerBands";
import { getTrackerCardPaths } from "~/lib/salaryTransferTrackerImages";
import { getSalaryTransferTimeline, getSalaryTransferTimelines } from "~/lib/salaryTransferTimeline";
import { salaryOfferSourceNote } from "~/lib/salaryTransferRules";

const now = new Date();
const [offers, lapsedOffers, upcomingOffers] = await Promise.all([
  getLiveOffers(now),
  getLapsedUnarchivedOffers(now),
  getUpcomingUnarchivedOffers(now),
]);

// Coverage, stated rather than implied. "Banks tracked: 2" alone reads
// either as "we cover two" or "only two banks run an offer" — and the
// second reading is false. The denominator is the banks the publication
// actually covers, so the gap is visible on the page instead of being
// something a reader could only find by counting rows.
//
// Current offers are derived. Negative and special-case findings are
// editorial classifications from the source sweeps (6 August, updated 22
// August 2026) and are named explicitly so a reader can distinguish an
// absence finding from an unfinished search. Standard Chartered's
// November–January campaign is now covered by the live collection.
const allBanks = await getCollection("banks");
const trackedBanks = new Set(offers.map((o) => o.bankSlug));
const sourceHeldOffers = offers.filter((o) => salaryOfferSourceNote(o));
const coveredCount = allBanks.length;
const checkedWithoutLiveOffer = SALARY_OFFER_CHECKED_WITHOUT_BANDED_CASH;
const bankName = new Map(allBanks.map((bank) => [bank.id, bank.data.name]));
// A lapsed, not-yet-archived offer is its own bucket (2026-09-06 P0: the
// RAKBANK cash reward expired on 31 August and the old all-or-nothing
// assertion took the build down with it). Only a bank with no
// classification at all still throws. The warning is for the editor: an
// entry in `lapsedOffers` is a card for the archive sweep.
const coverage = classifyCoverage({
  coveredBanks: allBanks.map((bank) => bank.id),
  liveOfferBanks: [...trackedBanks],
  lapsedOfferBanks: lapsedOffers.map((o) => o.bankSlug),
  upcomingOfferBanks: upcomingOffers.map((o) => o.bankSlug),
  checkedWithoutLiveOffer,
  advertisedWithoutCurrentTerms: SALARY_OFFER_ADVERTISED_WITHOUT_CURRENT_TERMS,
  reviewPendingBanks: SALARY_OFFER_REVIEW_PENDING_BANKS,
});
const guardError = coverageGuardError(coverage, coveredCount);
if (guardError) throw new Error(guardError);
if (lapsedOffers.length) {
  console.warn(
    `[salary-transfer] ${lapsedOffers.length} lapsed offer(s) awaiting archive: ` +
      lapsedOffers.map((o) => `${o.bankSlug} (${o.name}, review date ${o.validUntil.slice(0, 10)})`).join("; "),
  );
}
// Linked variant for the coverage note: the eight "checked, no live offer"
// bank pages had no inbound link anywhere on the site because the tracker
// island links only banks with a live row (2026-09-06 audit, F-013).
const linkList = (slugs: string[]) =>
  slugs.map((slug, i) => ({
    slug,
    name: bankName.get(slug) ?? slug,
    sep: i === 0 ? "" : i === slugs.length - 1 ? " and " : ", ",
  }));

const fmtFull = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
const fmtShort = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });

// The honest freshness signal is the newest per-offer verification date —
// not the build date, which manufactured a "Last refresh: today" stamp
// above offers verified weeks earlier (Fact-Checker redline, 11 June 2026).
const newestVerification = offers.length
  ? new Date(
      Math.max(...offers.map((o) => new Date(o.lastVerified).getTime())),
    )
  : null;
const siteUrl = siteUrlFrom(Astro.site);
const schema = breadcrumbGraph(siteUrl, [{ name: "Salary-transfer tracker", path: "/salary-transfer/" }]);
---

<BaseLayout
  title="UAE salary transfer offers — current tracker | DubaiPoints"
  description="Current UAE salary-transfer cash bonuses, voucher offers and combined card-and-salary promotions, each dated and linked to bank material."
  fullWidth
  schema={schema}
>
  <div class="st-page">
  <div class="dp-pagehead">
    <div class="crumb">DubaiPoints / Salary-transfer tracker</div>
    <h1>The salary-transfer tracker.</h1>
    <p>Find listed UAE salary-transfer offers by salary band. Some routes are shown for reference and aren’t ranked. Check the bank terms before switching.</p>

    <div class="dp-tools-stats">
      {/* Phones get the short labels so the three stats fit one line
          (19 Oct 2026 UX review); the long ones are display:none there,
          so assistive tech reads exactly what is shown. */}
      <span><span class="lbl st-long">Banks in this snapshot:</span><span class="lbl st-short">Banks</span> <strong>{trackedBanks.size} of {coveredCount}</strong></span>
      <span><span class="lbl st-long">Offers in this snapshot:</span><span class="lbl st-short">Offers</span> <strong>{offers.length}</strong></span>
      {newestVerification && (
        <span><span class="lbl st-long">Latest offer check:</span><span class="lbl st-short">Latest</span> <strong><span class="st-long">{fmtFull(newestVerification)}</span><span class="st-short">{fmtShort(newestVerification)}</span></strong></span>
      )}
    </div>
  </div>

  <!-- Preact island handles filter UI + sortable table -->
  <SalaryTransferTracker offers={offers} cardPaths={getTrackerCardPaths(offers)} timelines={getSalaryTransferTimelines(offers)} client:load />

  <div class="st-coverage">
    <details class="dp-coverage-note" id="coverage-note">
      <summary>
        <strong class="st-long">Coverage.</strong> <span class="st-long">{trackedBanks.size} of the {coveredCount} banks profiled on DubaiPoints have an offer in this snapshot. See how we classify the others.</span><span class="st-short">Why some banks are not listed</span>
      </summary>
      <p>
        At the time of our last checks, we did not confirm a qualifying banded cash offer from{" "}
        {linkList(checkedWithoutLiveOffer).map((b) => (
          <>{b.sep}<a href={`/salary-transfer/${b.slug}/`}>{b.name}</a></>
        ))}
        {" "}— Ajman Bank advertises a salary-linked draw, not a guaranteed bonus. Liv and Wio have rate-based
        benefits, and the NBF and United Arab Bank balance offers are not
        standalone payroll cashback. NBF’s separate welcome reward requires
        a referral. We did not confirm a successor to Al Hilal’s expired campaign.
        {coverage.advertisedWithoutCurrentTerms.length > 0 && (
          <>{" "}We could not verify enough to list advertised offers from {linkList(coverage.advertisedWithoutCurrentTerms).map((b) => (
            <>{b.sep}<a href={`/salary-transfer/${b.slug}/`}>{b.name}</a></>
          ))}.</>
        )}
        {coverage.reviewPending.length > 0 && (
          <>{" "}We have not completed a current salary-transfer offer review for {linkList(coverage.reviewPending).map((b) => (
            <>{b.sep}<a href={`/salary-transfer/${b.slug}/`}>{b.name}</a></>
          ))}.</>
        )}
        {coverage.upcoming.length > 0 && (
          <>{" "}Offers from {linkList(coverage.upcoming).map((b) => (
            <>{b.sep}<a href={`/salary-transfer/${b.slug}/`}>{b.name}</a></>
          ))} are not open yet and are not included in the table.</>
        )}
        {lapsedOffers.map((o) => (
          <>{" "}{bankName.get(o.bankSlug) ?? o.bankSlug}&rsquo;s {o.name} {getSalaryTransferTimeline(o)?.endDate === "published" ? "ended" : "is no longer listed following our review date of"} {fmtFull(new Date(o.validUntil))}.</>
        ))}
        {" "}Absence from the table is not evidence that no offer exists.
      </p>
      <p>
        <a href="/salary-transfer/adcb/">ADCB’s Injaz welcome reward</a> is pending verification of the full terms. Its separate BEYOND offer pays TouchPoints, not cash. Al Masraf’s Salary Plus joining bonus is also pending verification.
        <a href="https://www.rakbank.ae/globalassets/rakbank/all-pdfs/002-campaign/islamic-salary-transfer-tc-nov-2026.pdf">RAKislamic’s November offer</a> is pending because the bank’s English and Arabic salary tables disagree.
        {offers.some((o) => o.id === "fab-islamic-amana-2026") && (
          <>{" "}The <a href="/salary-transfer/fab/#fab-islamic-amana-2026">FAB Islamic Amana spend route</a> is listed for reference. Its terms specify qualifying card spend; we do not list a savings route.</>
        )}
      </p>
      {sourceHeldOffers.length > 0 && (
        <p>
          The following banks have listed offers with a source warning:{" "}
          {linkList([...new Set(sourceHeldOffers.map((offer) => offer.bankSlug))]).map((b) => (
            <>{b.sep}<a href={`/salary-transfer/${b.slug}/`}>{b.name}</a></>
          ))}
          {". We exclude those figures from estimated cashback rankings."}
        </p>
      )}
    </details>
  </div>

  <div class="dp-tools-actions">
    <span>See the <a href="/news/uae-salary-switch-scorecard/">Salary Switch Scorecard</a> for worked examples of qualifying steps, payout timing and costs.</span>
  </div>

  <!-- Salary-band entry points -->
  <section class="dp-featured-band" style="padding-top: 56px;">
    <div class="dp-featured-eyebrow">
      <span>Per-band landings</span>
      <span class="rule"></span>
      <span class="meta">Drill into a specific salary range</span>
    </div>
    <div class="dp-dir-grid" style="gap: 12px;">
      {bands.map((b) => (
        <a href={`/salary-transfer/${b.slug}/`} class="dp-dir-tile">
          <span class="eyebrow">Salary band</span>
          <span class="title">{b.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Methodology footer -->
  <section class="dp-tools-methodology" id="methodology">
    <div class="col">
      <div class="lbl">How we verify</div>
      <p>Each listed offer is checked against a bank product page or campaign terms. We date each check, label routes that aren't ranked and leave out offers whose terms we can't verify.</p>
    </div>
    <div class="col">
      <div class="lbl">How we value vouchers</div>
      <p>AED-denominated vouchers (Carrefour, noon, Lulu) discounted to 80% of face value to reflect realistic redemption rates for typical UAE residents.</p>
    </div>
    <div class="col">
      <div class="lbl">How we treat clawback</div>
      <p>Per-bank clawback windows (typically 6–24 months) noted in each offer detail page. Offers are flagged when clawback materially affects net AED value.</p>
    </div>
  </section>

  <div class="dp-tools-actions">
    <span><a href="/editorial-policy/">Methodology</a> · <a href="mailto:info@dubaipoints.ae">Submit a correction</a></span>
    <span><a href="/rss.xml">Subscribe to changes</a></span>
  </div>
  </div>
</BaseLayout>

<style>
  /* One column for the whole page (9 Oct 2026): the head used to run from
     the screen's left edge while the table spanned the full width, which
     on a desktop left a wide empty band beside the title. Everything now
     sits in the same centred listing column; the head keeps its full-bleed
     background. */
  .st-page > :global(*) {
    max-width: var(--container-listing);
    margin-inline: auto;
    box-sizing: border-box;
  }
  /* The tracker island renders inside <astro-island> (display: contents),
     so the width rule has to reach the island's own root. */
  .st-page :global(.dpst) {
    max-width: calc(var(--container-listing) - 64px);
    margin-inline: auto;
    width: auto; /* with side margins, a width of 100% overran by 40px */
    box-sizing: border-box;
  }
  @media (max-width: 1240px) {
    .st-page :global(.dpst) { margin-inline: 20px; }
  }
  @media (max-width: 640px) {
    .st-page :global(.dpst) { margin-inline: 0; }
  }
  .st-page > :global(.dp-pagehead) {
    max-width: none;
    padding-inline: max(20px, calc((100% - var(--container-listing)) / 2 + 32px));
  }
  .st-coverage { padding-inline: 20px; }
  .st-coverage summary { min-block-size: var(--dp-ui-control, 44px); align-content: center; }
  .st-short { display: none; }
  @media (max-width: 640px) {
    .st-page > :global(.dp-pagehead) { padding-top: 20px; padding-bottom: 14px; }
    .st-page :global(.dp-pagehead h1) { font-size: 32px; margin-bottom: 8px; }
    .st-page :global(.dp-pagehead > p) { font-size: 13px; line-height: 1.5; }
    .st-long { display: none; }
    .st-short { display: inline; }
    .st-page :global(.dp-tools-stats) {
      margin-top: 10px; gap: 4px 10px;
      font-size: 12px;
    }
    .st-page :global(.dp-tools-stats .lbl) { margin-right: 3px; }
    .st-page :global(.dp-coverage-note) { margin-top: 12px; padding: 8px 12px; font-size: 13px; }
  }
</style>
