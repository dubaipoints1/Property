---
// Salary-transfer tracker — Phase C tools template (Claude Design handoff).
// Reference: dubaipoints/project/templates/tools.jsx::Tracker.
// Preserves the existing Preact island for live filtering/sorting; wraps
// it in the new tools chrome (pagehead with stats strip + toolbar + table
// + methodology footer).

import { getCollection } from "astro:content";

import BaseLayout from "~/layouts/BaseLayout.astro";
import SalaryTransferTracker from "~/components/islands/SalaryTransferTracker.tsx";
import { getLiveOffers } from "~/lib/offerAdapter";

const offers = await getLiveOffers();

// Coverage, stated rather than implied. "Banks tracked: 2" alone reads
// either as "we cover two" or "only two banks run an offer" — and the
// second reading is false. The denominator is the banks the publication
// actually covers, so the gap is visible on the page instead of being
// something a reader could only find by counting rows.
//
// Current offers are derived. Negative and special-case findings are
// editorial classifications from the source sweeps (6 August, updated 22
// August 2026) and are named explicitly so a reader can distinguish an
// absence finding from an unfinished search. Standard Chartered is its own
// category: the bank ADVERTISES an AED 2,000 Priority salary-transfer
// cashback today, but the campaign T&C it links is the April–June 2026
// document — advertised, without current published terms.
const allBanks = await getCollection("banks");
const trackedBanks = new Set(offers.map((o) => o.bankSlug));
const coveredCount = allBanks.length;
const checkedWithoutLiveOffer = ["adcb", "adib", "cbd", "citi", "emirates-nbd"];
const advertisedWithoutCurrentTerms = ["standard-chartered"];
const bankName = new Map(allBanks.map((bank) => [bank.id, bank.data.name]));
const classifiedBanks = new Set([
  ...trackedBanks,
  ...checkedWithoutLiveOffer,
  ...advertisedWithoutCurrentTerms,
]);
if (classifiedBanks.size !== coveredCount) {
  throw new Error(
    `Salary-transfer coverage classification has ${classifiedBanks.size} banks; expected ${coveredCount}.`,
  );
}
const nameList = new Intl.ListFormat("en-GB", { style: "long", type: "conjunction" });
const listNames = (slugs: string[]) =>
  nameList.format(slugs.map((slug) => bankName.get(slug) ?? slug));

const bands = [
  { slug: "aed-5000-to-8000",   label: "AED 5,000 – 8,000" },
  { slug: "aed-8000-to-15000",  label: "AED 8,000 – 15,000" },
  { slug: "aed-15000-to-30000", label: "AED 15,000 – 30,000" },
  { slug: "aed-30000-to-50000", label: "AED 30,000 – 50,000" },
  { slug: "aed-50000-plus",     label: "AED 50,000+" },
];

const fmtFull = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

// The honest freshness signal is the newest per-offer verification date —
// not the build date, which manufactured a "Last refresh: today" stamp
// above offers verified weeks earlier (Fact-Checker redline, 11 June 2026).
const newestVerification = offers.length
  ? new Date(
      Math.max(...offers.map((o) => new Date(o.lastVerified).getTime())),
    )
  : null;
---

<BaseLayout
  title="UAE salary transfer offers — current tracker | DubaiPoints"
  description="Current UAE salary-transfer cash bonuses, voucher offers and combined card-and-salary promotions, each dated and linked to bank material."
  fullWidth
>
  <div class="dp-pagehead">
    <div class="crumb">DubaiPoints / Salary-transfer tracker</div>
    <h1>The salary-transfer tracker.</h1>
    <p>Each listed salary-transfer offer has been checked against a bank product page or campaign terms and dated per offer. Filter by salary band, reward type, or specific bank.</p>

    <div class="dp-tools-stats">
      <span><span class="lbl">Banks with current offers:</span> <strong>{trackedBanks.size} of {coveredCount}</strong></span>
      <span><span class="lbl">Live offers:</span> <strong>{offers.length}</strong></span>
      {newestVerification && (
        <span><span class="lbl">Newest verification:</span> <strong>{fmtFull(newestVerification)}</strong></span>
      )}
    </div>

    <p class="dp-coverage-note">
      <strong>Coverage status.</strong> We found current, source-backed offers for
      {" "}{trackedBanks.size} banks. We checked {listNames(checkedWithoutLiveOffer)}
      {" "}and found no current live banded cash offer — ADCB is running an
      education-sector-only TouchPoints salary campaign (15 July – 30 September
      2026) that doesn't qualify for the cash table, and ADIB's salary programme
      remains a prize draw rather than a banded reward (re-checked 22 August).
      {" "}{listNames(advertisedWithoutCurrentTerms)} advertises an AED 2,000
      Priority Banking salary-transfer cashback (salaries AED 30,000+), but the
      campaign terms it links to are the April–June 2026 document — treat it as
      unverified until current terms are republished. Absence from the table is
      not evidence that no offer exists.
    </p>
  </div>

  <!-- Preact island handles filter UI + sortable table -->
  <SalaryTransferTracker offers={offers} client:load />

  <!-- Salary-band entry points -->
  <section class="dp-featured-band" style="padding-top: 56px;">
    <div class="dp-featured-eyebrow">
      <span>Per-band landings</span>
      <span class="rule"></span>
      <span class="meta">Drill into a specific salary range</span>
    </div>
    <div class="dp-dir-grid" style="gap: 12px;">
      {bands.map((b) => (
        <a href={`/salary-transfer/${b.slug}/`} class="dp-dir-tile">
          <span class="eyebrow">Salary band</span>
          <span class="title">{b.label}</span>
        </a>
      ))}
    </div>
  </section>

  <!-- Methodology footer -->
  <section class="dp-tools-methodology" id="methodology">
    <div class="col">
      <div class="lbl">How we verify</div>
      <p>Each published offer is checked against a bank product page or campaign terms. Verification dates are stamped per offer, and unsupported entries stay out of the current tracker.</p>
    </div>
    <div class="col">
      <div class="lbl">How we value vouchers</div>
      <p>AED-denominated vouchers (Carrefour, noon, Lulu) discounted to 80% of face value to reflect realistic redemption rates for typical UAE residents.</p>
    </div>
    <div class="col">
      <div class="lbl">How we treat clawback</div>
      <p>Per-bank clawback windows (typically 6–24 months) noted in each offer detail page. Offers are flagged when clawback materially affects net AED value.</p>
    </div>
  </section>

  <div class="dp-tools-actions">
    <span><a href="/editorial-policy/">Methodology</a> · <a href="mailto:info@dubaipoints.ae">Submit a correction</a></span>
    <span><a href="/rss.xml">Subscribe to changes</a></span>
  </div>
</BaseLayout>
