---
// Hotel programmes directory — split out of /airlines/ on 11 October 2026
// (Chairman direction in-session: "all and then merge it"; brief
// .council/briefs/2026-10-11-hotels-section.md). Closes the 15 September
// R5 ruling: Bonvoy, Hilton Honors and Accor ALL now sit under their own
// section, with 301s from the old /airlines/<slug>/ URLs.
//
// Directory idiom per CLAUDE.md "Editorial conventions": dp-article is-wide
// + dp-dir-grid of dp-dir-tile. Every tile figure comes from the programmes
// collection or the valuations table — nothing typed here.
import BaseLayout from "~/layouts/BaseLayout.astro";
import StockImage from "~/components/StockImage.astro";
import EditorialHubHero from "~/components/EditorialHubHero.astro";
import { collectionPageGraph, siteUrlFrom } from "~/lib/schema";
import { getCollection } from "astro:content";
import { isHotelProgramme, programmeHref, programmeImage } from "~/lib/programmes";
import { getStockEntry } from "~/lib/stockManifest";
import { dpValueSub } from "~/lib/valuations";

const programmes = (await getCollection("programs", (p) => isHotelProgramme(p.id))).sort((a, b) =>
  a.data.name.localeCompare(b.data.name),
);
const visualProgrammes = programmes.filter((p) => {
  const entry = getStockEntry(programmeImage(p.id).slug);
  return entry?.source === "pexels" || entry?.source === "unsplash";
});
const heroFeature = (p: typeof programmes[number] | undefined) => p ? { ...programmeImage(p.id), title: p.data.name, href: programmeHref(p.id), eyebrow: p.data.currencyName } : undefined;

const siteUrl = siteUrlFrom(Astro.site);
const schema = collectionPageGraph({
  siteUrl,
  path: "/hotels/",
  name: "Hotel loyalty programmes",
  description: "Marriott Bonvoy, Hilton Honors, Accor ALL, World of Hyatt and IHG One Rewards from the UAE: earning, redemptions, transfer partners and expiry policy.",
  crumbs: [{ name: "Hotels", path: "/hotels/" }],
});
---

<BaseLayout
  title="Hotel loyalty programmes for UAE residents | DubaiPoints"
  description="Marriott Bonvoy, Hilton Honors, Accor ALL, World of Hyatt and IHG One Rewards from the UAE: how to earn, where the points go furthest, transfer partners and expiry policy."
  fullWidth
  schema={schema}
>
  <article class="dp-article is-wide">
    <header class="dp-article-head">
      <EditorialHubHero primary={heroFeature(visualProgrammes[0])} secondary={heroFeature(visualProgrammes[1])}>
      <p class="dp-article-eyebrow">Hotels</p>
      <h1 class="dp-article-title">Hotel programmes.</h1>
      <p class="dp-article-lede">
        Compare how to earn hotel points from UAE stays and cards, where to use them and how long they last.
      </p>
      <nav class="dp-hotel-directory-actions" aria-label="Hotel resources">
        <a href="/valuations/" class="dp-ui-action dp-ui-primary">Compare points values</a>
        <a href="/news/hotels/" class="dp-ui-action dp-ui-secondary">Latest hotel news</a>
      </nav>
      </EditorialHubHero>
    </header>

    <div class="dp-dir-grid">
      {programmes.map((p) => {
        const value = dpValueSub(p.id);
        const image = programmeImage(p.id);
        const entry = getStockEntry(image.slug);
        const stockPhoto = entry?.source === "pexels" || entry?.source === "unsplash" ? entry : undefined;
        const titleId = `hotel-${p.id}`;
        return (
          <a class="dp-dir-tile dp-hotel-tile" href={programmeHref(p.id)} aria-labelledby={titleId}>
            {entry && (
              <span class="dp-hotel-tile-media">
                <StockImage
                  slug={image.slug}
                  class="dp-hotel-tile-img"
                  sizes="(max-width: 639px) calc(100vw - 74px), (max-width: 1023px) calc(50vw - 65px), 310px"
                />
                {(image.caption || stockPhoto) && (
                  <span class="dp-hotel-tile-credit">
                    {image.caption}{image.caption && stockPhoto ? " · " : ""}
                    {stockPhoto && `Photo: ${stockPhoto.photographer}`}
                  </span>
                )}
              </span>
            )}
            <span class="eyebrow">{p.data.currencyName}</span>
            <span class="title" id={titleId}>{p.data.name}</span>
            {p.data.sweetSpots[0] && <span class="desc">{p.data.sweetSpots[0].title}</span>}
            <span class="meta">
              {p.data.transferPartners.length} transfer partner{p.data.transferPartners.length === 1 ? "" : "s"}
              {value && <> · {value}</>}
            </span>
          </a>
        );
      })}
    </div>

    <section class="dp-prose">
      <p>
        Airline programmes (Skywards, Etihad Guest, Qatar Privilege Club and
        the rest) are on the <a href="/airlines/">airline programmes</a> page.
        Hotel-loyalty news, such as promotions and programme changes, runs on
        the <a href="/news/hotels/">hotel news desk</a>, and the
        <a href="/valuations/">valuations table</a> sets out what we count
        each point as worth.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .dp-hotel-directory-actions { display: flex; flex-wrap: wrap; gap: var(--dp-ui-gap, 8px); margin-block-start: 16px; }
  .dp-hotel-tile { min-inline-size: 0; }
  .dp-hotel-tile-media {
    display: grid;
    gap: 6px;
    margin-block-end: 6px;
  }
  .dp-hotel-tile-media :global(.dp-hotel-tile-img) {
    display: block;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    block-size: auto;
    object-fit: cover;
    border-radius: 6px;
  }
  .dp-hotel-tile-credit {
    color: var(--ink-soft);
    font-size: .75rem;
    line-height: 1.35;
  }
</style>
