---
import { bankMark } from "~/lib/logos";
// Bank logo — renders the SVG mark from /logos/banks/[slug].svg by default,
// or the PNG at /logos/banks/[slug].png when the slug is listed in
// PNG_FORMAT_SLUGS (a per-slug override for issuers whose only freely-
// licensed/official brand asset is PNG — e.g. Emirates NBD's brand kit at
// emiratesnbd.com/en/brand-assets ships PNG only).
//
// Falls back to a styled text initial when the asset is missing or fails
// to load. The swap is done by the delegated listener in BaseLayout.astro
// (keyed on data-logo-fallback), not an inline onerror attribute: inline
// handlers cannot be allowed by a Content-Security-Policy hash or nonce.
//
// Usage:
//   <BankLogo slug="emirates-nbd" name="Emirates NBD" size="md" />

interface Props {
  slug: string;
  name: string;
  size?: "sm" | "md" | "lg";
  /** True when the visible bank name sits right beside the mark, so the
   *  logo must not announce "<Bank> logo <Bank>" twice (2026-09-06 audit,
   *  F-046). */
  decorative?: boolean;
}

const { slug, name, size = "md", decorative = false } = Astro.props;

const dim = { sm: 18, md: 28, lg: 44 }[size];

// File and plate come from src/lib/logos.ts (PNG-only and white-only
// marks are listed there). Sources for each are in public/logos/LICENSES.md.
const mark = bankMark(slug);

// Initial fallback: first capital letter of each word, max 2.
const initials = name
  .split(/\s+/)
  .map((w) => w[0]?.toUpperCase() ?? "")
  .slice(0, 2)
  .join("");
---

<span
  class:list={["dp-bank-logo", `dp-bank-logo--${size}`, { "is-plated": mark.plated }]}
  aria-label={decorative ? undefined : `${name} logo`}
  role={decorative ? undefined : "img"}
  aria-hidden={decorative ? "true" : undefined}
>
  <img
    src={mark.src}
    alt=""
    width={dim}
    height={dim}
    loading="lazy"
    decoding="async"
    data-logo-fallback
  />
  <span class="dp-bank-logo-fallback" aria-hidden="true">{initials}</span>
</span>

<style>
  .dp-bank-logo.is-plated {
    background: #1f3a4d;
    border-radius: 6px;
    padding: 3px 6px;
  }
  .dp-bank-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    line-height: 0;
  }
  .dp-bank-logo img {
    display: block;
    width: auto;
    object-fit: contain;
    background: transparent;
  }
  .dp-bank-logo--sm img { height: 18px; max-width: 60px; }
  .dp-bank-logo--md img { height: 28px; max-width: 96px; }
  .dp-bank-logo--lg img { height: 44px; max-width: 140px; }

  .dp-bank-logo-fallback {
    display: none;
    align-items: center;
    justify-content: center;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1;
  }
  .dp-bank-logo--sm .dp-bank-logo-fallback { width: 22px; height: 22px; font-size: 10px; }
  .dp-bank-logo--md .dp-bank-logo-fallback { width: 32px; height: 32px; font-size: 12px; }
  .dp-bank-logo--lg .dp-bank-logo-fallback { width: 48px; height: 48px; font-size: 16px; }
</style>
