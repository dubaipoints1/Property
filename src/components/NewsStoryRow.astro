---
import type { CollectionEntry } from "astro:content";
import NewsListingVisual from "./NewsListingVisual.astro";

const { post } = Astro.props as { post: CollectionEntry<"news"> };
const { title, description, category, publishedAt } = post.data;
const label = category.split("-").map((word) => word[0]?.toUpperCase() + word.slice(1)).join(" ");
const date = publishedAt.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---

<li class="dp-news-row" data-news-row>
  <a href={`/news/${post.id}/`} aria-labelledby={`headline-${post.id}`}>
    <div class="dp-news-row-copy">
      <div class="dp-news-row-meta">
        <span>{label}</span>
        <time datetime={publishedAt.toISOString().slice(0, 10)}>{date}</time>
      </div>
      <h3 id={`headline-${post.id}`}>{title}</h3>
      <p>{description}</p>
    </div>
    <NewsListingVisual id={post.id} compact />
  </a>
</li>

<style>
  .dp-news-row + .dp-news-row { border-top: 1px solid var(--line); }
  .dp-news-row a {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: clamp(10px, 2vw, 18px);
    padding: clamp(12px, 2vw, 18px) 0;
    color: inherit;
    text-decoration: none;
  }
  .dp-news-row-copy { min-width: 0; }
  .dp-news-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 3px 12px;
    margin-bottom: 5px;
    font: 650 .75rem/1.35 var(--font-ui);
    color: var(--ink-soft);
  }
  .dp-news-row-meta span { color: var(--green); }
  .dp-news-row h3 {
    margin: 0;
    color: var(--ink);
    font: 550 clamp(1.12rem, 2vw, 1.375rem)/1.16 var(--font-display);
    text-wrap: pretty;
  }
  .dp-news-row a:hover h3 { color: var(--green); text-decoration: underline; text-underline-offset: .15em; }
  .dp-news-row a:focus-visible { outline: 2px solid var(--green); outline-offset: 4px; border-radius: 4px; }
  .dp-news-row p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 5px 0 0;
    font-size: .875rem;
    line-height: 1.45;
    color: var(--ink-soft);
  }
  @media (max-width: 640px) {
    .dp-news-row p { display: none; }
  }
</style>
