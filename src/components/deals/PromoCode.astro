---
// Promo-code box for a deal page. Renders only for a code the issuer or
// merchant prints on its own page (`promoCode` + `promoCodeSource`, both
// enforced by the deals schema). The code is plain, selectable text, so it
// works without JS; the Copy button is hidden until the script runs. No
// inline handler: the CSP hashes inline scripts and refuses on* attributes.

interface Props {
  code: string;
  source?: string;
}

const { code, source } = Astro.props;
---

<div class="dp-promo" role="group" aria-label="Promo code">
  <span class="dp-promo-label">Promo code</span>
  <div class="dp-promo-row">
    <code class="dp-promo-code">{code}</code>
    <button type="button" class="dp-promo-copy" data-copy-code={code} hidden>Copy code</button>
    <span class="dp-promo-status" role="status" aria-live="polite"></span>
  </div>
  {source && <p class="dp-promo-note"><a href={source} rel="noopener">Check the published code terms →</a></p>}
</div>

<script>
  for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-copy-code]")) {
    btn.hidden = false;
    btn.addEventListener("click", async () => {
      const code = btn.dataset.copyCode ?? "";
      const status = btn.parentElement?.querySelector(".dp-promo-status");
      try {
        await navigator.clipboard.writeText(code);
        if (status) status.textContent = "Copied";
      } catch {
        const el = btn.parentElement?.querySelector(".dp-promo-code");
        if (el) window.getSelection()?.selectAllChildren(el);
        if (status) status.textContent = "Selected: press copy";
      }
      window.setTimeout(() => { if (status) status.textContent = ""; }, 2500);
    });
  }
</script>

<style>
  .dp-promo {
    margin: 0 0 10px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 10px;
  }
  .dp-promo-label {
    font-family: var(--font-ui);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--gold-ink);
  }
  .dp-promo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-width: 0; }
  .dp-promo-code {
    font-family: var(--font-ui);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: var(--ink);
    padding: 5px 8px;
    border: 1px dashed var(--ink-soft);
    border-radius: 8px;
    background: var(--bg);
    user-select: all;
    overflow-wrap: anywhere;
  }
  .dp-promo-copy {
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 700;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    border: 0;
    background: var(--ink);
    color: var(--paper);
    cursor: pointer;
  }
  .dp-promo-copy:hover { background: var(--green); }
  .dp-promo-copy:focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }
  .dp-promo-status { font-family: var(--font-ui); font-size: 13px; font-weight: 600; color: var(--green); }
  .dp-promo-note { margin: 0; font-size: 14px; line-height: 1.5; color: var(--ink-soft); }
  .dp-promo-note a { color: var(--green); }
</style>
