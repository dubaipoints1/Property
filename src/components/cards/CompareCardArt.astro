---
import { getCardArt } from "~/lib/cardArt";
import { cardArtSrcset } from "~/lib/stockDerivatives";

interface Props {
  slug: string;
  /** The static picker renders every card but activates only the chosen ones. */
  deferred?: boolean;
  /** Finder ranks several cards; materialise the artwork only in view. */
  finderViewportDeferred?: boolean;
  /** Only server-visible default cards need a live image without scripts. */
  showNoscriptArt?: boolean;
  /** Identity surfaces give real art more room without cropping it. */
  size?: "compact" | "identity";
}

const { slug, deferred = false, finderViewportDeferred = false, showNoscriptArt = false, size = "compact" } = Astro.props;
const art = getCardArt(slug);
const srcset = art ? cardArtSrcset(slug, art) : undefined;
// The manifest records issuer imagery, not a generic stock credit. Link
// to the actual product page (or image source when no page is recorded).
const creditUrl = art ? art.page ?? art.url : undefined;
const creditLabel = creditUrl ? new URL(creditUrl).hostname.replace(/^www\./, "") : undefined;
const image = art && {
  src: `/${art.file}`,
  srcset,
  sizes: srcset ? (size === "identity" ? "(max-width: 640px) 128px, 144px" : "56px") : undefined,
  width: art.width,
  height: art.height,
  alt: "",
  loading: "lazy" as const,
  decoding: "async" as const,
  "data-compare-card-art": slug,
};
---

{image && (
  <span class="dp-compare-card-art" data-size={size} data-card-art-reserved={deferred || finderViewportDeferred || undefined} data-finder-art-viewport={finderViewportDeferred || undefined}>
    <span class="dp-compare-card-imagebox">
      {deferred || finderViewportDeferred ? <>
        <template data-finder-art-template={finderViewportDeferred || undefined} data-compare-art-template={deferred || undefined}><img {...image} /></template>
        {showNoscriptArt && <noscript><img {...image} /></noscript>}
      </> : <img {...image} />}
    </span>
    {size === "identity" && creditUrl && <small class="dp-compare-card-credit">Card image: <a href={creditUrl}>{creditLabel}</a></small>}
  </span>
)}

<style>
  .dp-compare-card-art {
    display: none;
  }
  .dp-compare-card-art:is(:has(img), [data-card-art-reserved]) {
    display: block;
    flex: none;
    inline-size: 56px;
  }
  .dp-compare-card-imagebox { display: block; inline-size: 100%; aspect-ratio: 16 / 10; }
  .dp-compare-card-art[data-size="identity"]:is(:has(img), [data-card-art-reserved]) {
    inline-size: 144px;
    max-inline-size: 100%;
  }
  .dp-compare-card-art[data-size="identity"] .dp-compare-card-imagebox {
    /* One shared frame gives portrait and angled issuer faces useful room
       without clipping, stretching or pretending their shapes are equal. */
    aspect-ratio: 4 / 3;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius-small, 6px);
    background: var(--shade-1);
  }
  .dp-compare-card-credit { display: block; margin-block-start: 5px; color: var(--ink-soft); font: 400 .6875rem/1.4 var(--font-ui); overflow-wrap: anywhere; }
  .dp-compare-card-credit a { color: inherit; text-decoration: underline; text-underline-offset: 2px; }
  .dp-compare-card-credit a:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .dp-compare-card-art img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
  @media (max-width: 640px) {
    .dp-compare-card-art[data-size="identity"]:is(:has(img), [data-card-art-reserved]) { inline-size: 128px; }
  }
</style>
