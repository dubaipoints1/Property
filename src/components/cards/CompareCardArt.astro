---
import { getCardArt } from "~/lib/cardArt";
import { cardArtSrcset } from "~/lib/stockDerivatives";

interface Props {
  slug: string;
  /** The static picker renders every card but activates only the chosen ones. */
  deferred?: boolean;
}

const { slug, deferred = false } = Astro.props;
const art = getCardArt(slug);
const srcset = art ? cardArtSrcset(slug, art) : undefined;
const image = art && {
  src: `/${art.file}`,
  srcset,
  sizes: srcset ? "56px" : undefined,
  width: art.width,
  height: art.height,
  alt: "",
  loading: "lazy" as const,
  decoding: "async" as const,
  "data-compare-card-art": slug,
};
---

{image && (
  <span class="dp-compare-card-art">
    {deferred ? <template data-compare-art-template><img {...image} /></template> : <img {...image} />}
  </span>
)}

<style>
  .dp-compare-card-art {
    display: none;
  }
  .dp-compare-card-art:has(> img) {
    display: block;
    flex: none;
    inline-size: 56px;
    aspect-ratio: 16 / 10;
  }
  .dp-compare-card-art img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
</style>
