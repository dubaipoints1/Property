---
// ImageCredit — renders attribution microcopy for one or more stock
// images on a page. Pexels licence does not require attribution, but
// the publication credits photographers as a trust signal (Charter
// §"No advertorial-driven recommendations" — transparency on every
// surface, sources visible).
//
// Two usage modes:
//   1. Single slug:  <ImageCredit slug="homepage-hero-cabin" />
//   2. Multiple:     <ImageCredit slugs={["a", "b", "c"]} />
//
// Renders nothing if no slug resolves to a manifest entry (silent
// fallback so pages with Cover.astro SVG fallbacks don't show a
// dangling "Photo by undefined" line).
//
// AI-generated entries (2026-07-29 Charter amendment) render on their
// own line as "Illustration: generated with <model> · not a
// photograph". They are deliberately NOT folded into the photo credit:
// the whole basis of the amendment is that a reader can always tell at
// a glance which images are records and which are drawings. Photo
// credits stay first because they are the ones carrying attribution
// obligations.

import { getStockEntry, isAiGenerated, type StockEntry } from "../lib/stockManifest";

interface Props {
  slug?: string;
  slugs?: string[];
  class?: string;
}

const { slug, slugs, class: className } = Astro.props;

const allSlugs = slug ? [slug] : (slugs ?? []);
const entries: StockEntry[] = allSlugs
  .map((s) => getStockEntry(s))
  .filter((e): e is StockEntry => Boolean(e));

const photos = entries.filter((e) => !isAiGenerated(e));
const illustrations = entries.filter(isAiGenerated);

// De-duplicate by model — three illustrations from one model read as
// one label, not three repetitions of the same sentence.
const generators = [...new Set(illustrations.map((e) => e.generator ?? e.photographer))];

const sourceLabel: Record<string, string> = {
  pexels: "Pexels",
  unsplash: "Unsplash",
  editorial: "Editorial",
  "ai-generated": "AI illustration",
};
---

{photos.length > 0 && (
  <p class={`dp-image-credit ${className ?? ""}`}>
    {photos.length === 1 ? "Photo" : "Photos"}:
    {photos.map((entry, i) => (
      <>
        {i > 0 ? "; " : " "}
        {entry.photographer_url ? (
          <a href={entry.photographer_url} rel="noopener noreferrer">{entry.photographer}</a>
        ) : (
          <span>{entry.photographer}</span>
        )}
        {" "}via{" "}
        {entry.source_url ? (
          <a href={entry.source_url} rel="noopener noreferrer">{sourceLabel[entry.source]}</a>
        ) : (
          <span>{sourceLabel[entry.source]}</span>
        )}
      </>
    ))}
  </p>
)}

{illustrations.length > 0 && (
  <p class={`dp-image-credit is-ai ${className ?? ""}`} data-image-ai-label>
    {illustrations.length === 1 ? "Illustration" : "Illustrations"}: generated with{" "}
    {generators.join(", ")} · not a photograph
  </p>
)}

<style>
  .dp-image-credit {
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 12px;
    color: var(--muted);
    margin: 8px 0 0;
    line-height: 1.4;
  }
  .dp-image-credit a {
    color: var(--ink-soft);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 2px;
  }
  .dp-image-credit a:hover {
    color: var(--ink);
    text-decoration-color: var(--ink-soft);
  }
  /* The AI label is a disclosure, not decoration — italic so it reads
     as an editorial note rather than an attribution link. */
  .dp-image-credit.is-ai {
    font-style: italic;
  }
</style>
