---
import StockImage from "~/components/StockImage.astro";
import { getCardArt } from "~/lib/cardArt";
import { LISTING_SIZES, stockSrcset } from "~/lib/stockDerivatives";
import { getStockEntry } from "~/lib/stockManifest";

interface Props { id: string; featured?: boolean; compact?: boolean; }
const { id, featured = false, compact = false } = Astro.props;
const slug = `news-${id}`;
const photo = getStockEntry(slug);
const livCorrectionArt = id === "uae-card-change-log-liv-eligibility-vat-correction"
  ? getCardArt("liv-cashback-plus") : undefined;
// Listing treatment only. These stories deliberately have no article hero.
const diagram = id === "cash-or-miles-uae-flight-break-even";
const quote = id === "cash-or-miles-etihad-abu-dhabi-muscat";
const card = id === "uae-card-change-log-citi-cash-back-application-route"
  ? getCardArt("citi-cashback") : undefined;
const desk = id === "uae-salary-switch-scorecard"
  ? getStockEntry("guide-salary-transfer-mechanics-2026") : undefined;
const kind = diagram ? "cash-or-miles" : quote ? "cash-or-miles-quote" : card ? "issuer-card" : desk ? "salary-scorecard" : undefined;
const photoSizes = featured
  ? "(max-width: 640px) calc(100vw - 32px), (max-width: 819px) calc(100vw - 48px), (max-width: 1600px) min(calc(56vw - 36px), 630px), 800px"
  : compact ? "clamp(68px, 12vw, 128px)" : LISTING_SIZES.tile;
---

{livCorrectionArt ? (
  <span class:list={["dp-news-issuer-art", { "is-compact": compact }]} data-news-issuer-art="liv">
    <img src={`/${livCorrectionArt.file}`} alt="" width={livCorrectionArt.width} height={livCorrectionArt.height}
      loading={featured ? "eager" : "lazy"} decoding="async" />
    <span>Card image: Liv</span>
  </span>
) : photo ? (
  <span class:list={["dp-news-photo", { "is-compact": compact }]}>
    <StockImage slug={slug} class={featured ? "intel-featured-image" : "intel-card-image"}
      delivery={featured ? "feature" : compact ? "compact" : undefined}
      sizes={photoSizes} loading={featured ? "eager" : "lazy"} />
  </span>
) : kind && (
  <span class:list={["dp-news-preview", { "is-compact": compact }]} data-news-preview={kind} aria-hidden="true">
    {diagram && (
      <svg viewBox="0 0 180 76" width="180" height="76" fill="none" focusable="false">
        <g stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 38h148" stroke-dasharray="2 5" opacity=".45" />
          <rect x="12" y="22" width="48" height="32" rx="6" fill="var(--paper)" />
          <path d="M18 31h36m-35 15h11" />
          <circle cx="90" cy="38" r="14" fill="var(--paper)" />
          <path d="M85 35h10m-10 6h10" />
          <path d="M127 22h41v10a6 6 0 0 0 0 12v10h-41V44a6 6 0 0 0 0-12V22Z" fill="var(--paper)" />
          <path d="m138 41 16-8-6 9v4l-3-4-7-1Z" />
        </g>
      </svg>
    )}
    {quote && (
      <svg viewBox="0 0 180 76" width="180" height="76" fill="none" focusable="false">
        <g stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="21" cy="52" r="4" fill="var(--paper)" />
          <circle cx="159" cy="52" r="4" fill="var(--paper)" />
          <path d="M26 52c35-45 93-45 128 0" stroke-dasharray="2 5" opacity=".6" />
          <circle cx="90" cy="31" r="17" fill="var(--paper)" />
          <path d="m82 32 17-7-7 9v5l-4-5-6-2Z" />
          <path d="M51 60h78" opacity=".3" />
        </g>
      </svg>
    )}
    {card && <img src={`/${card.file}`} alt="" width={card.width} height={card.height}
      loading={featured ? "eager" : "lazy"} decoding="async" />}
    {desk && <img src={`/${desk.file}`} srcset={stockSrcset(desk, import.meta.env.PROD ? "compact" : undefined)} sizes={compact ? "clamp(68px, 12vw, 128px)" : "144px"} alt=""
      width={desk.width} height={desk.height} loading={featured ? "eager" : "lazy"} decoding="async"
      data-stock-slug={desk.slug} data-stock-source={desk.source} />}
  </span>
)}

<style>
  .dp-news-issuer-art {
    display: grid;
    grid-template: minmax(0, 1fr) auto / minmax(0, 1fr);
    place-items: center;
    gap: 6px;
    block-size: clamp(140px, 26vw, 240px);
    padding: 12px;
    box-sizing: border-box;
    background: var(--shade-1);
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line);
  }
  .dp-news-issuer-art img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    min-inline-size: 0;
    min-block-size: 0;
    object-fit: contain;
  }
  .dp-news-issuer-art > span { font: 500 .75rem/1.2 var(--font-ui); }
  .dp-news-issuer-art.is-compact {
    flex: 0 0 auto;
    inline-size: clamp(88px, 14vw, 128px);
    block-size: 88px;
    padding: 6px;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius, 8px);
  }
  .dp-news-photo { display: block; }
  .dp-news-photo.is-compact,
  .dp-news-preview.is-compact {
    display: grid;
    flex: 0 0 auto;
    inline-size: clamp(68px, 12vw, 128px);
    block-size: auto;
    aspect-ratio: 1.5;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--dp-ui-radius, 8px);
  }
  .dp-news-photo.is-compact :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1.5;
    object-fit: cover;
  }
  .dp-news-photo.is-compact :global(.dp-ai-label) {
    font-size: 10px;
    padding: 14px 4px 3px;
  }
  .dp-news-preview {
    display: grid;
    place-items: center;
    min-width: 0;
    padding: 10px;
    block-size: 104px;
    box-sizing: border-box;
    background: var(--shade-1);
    border-bottom: 1px solid var(--line);
    color: var(--green);
  }
  .dp-news-preview svg { max-inline-size: 100%; block-size: 76px; }
  .dp-news-preview img { display: block; max-inline-size: 100%; inline-size: 144px; block-size: 80px; object-fit: contain; }
  [data-news-preview="salary-scorecard"] img { object-fit: cover; border-radius: 8px; }
  .dp-news-preview.is-compact { padding: 4px; }
  .dp-news-preview.is-compact :is(svg, img) { display: block; width: 100%; height: auto; max-block-size: 64px; }
</style>
