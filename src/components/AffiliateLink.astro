---
// Dormant outbound-link component with a visible affiliate marker.
// Disclosure navigation must be supplied by the surrounding page or link copy.
//
// Usage:
//   <AffiliateLink href="https://bank.example.com/apply">Apply now</AffiliateLink>
//
// At launch there are no live affiliate partners and this component is unused.

interface Props {
  href: string;
  rel?: string;
}

const { href, rel = "noopener noreferrer sponsored" } = Astro.props;
---

<a href={href} rel={rel} target="_blank" class="dp-affiliate">
  <slot />
  <sup class="dp-affiliate-mark" aria-label="Affiliate link">*</sup>
</a>

<style>
  .dp-affiliate { position: relative; }
  .dp-affiliate-mark {
    color: var(--gold);
    font-weight: 700;
    margin-left: 1px;
    font-size: 0.85em;
  }
</style>
