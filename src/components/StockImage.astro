---
// StockImage — renders a manifest-tracked photograph with attribution
// metadata baked into the markup. Falls back to Cover.astro SVG when
// the slug is not in the manifest yet (e.g. before `npm run fetch:stock`
// has been run, or for slugs the editor has not chosen a photo for).
//
// Per Charter §"Editorial guarantees" — every image must have a
// `lastVerified`-equivalent provenance trail. The manifest entry is
// that trail; <ImageCredit> renders the visible attribution.
//
// Usage:
//   <StockImage
//     slug="homepage-hero-cabin"
//     coverTitle="UAE rewards, decoded."   // fallback Cover title
//     coverCategory="Editorial"             // fallback Cover category
//     coverSize="hero"                      // fallback Cover size
//     class="hp-hero-image"                 // wrapper class
//     loading="eager"                       // <img> attr (default lazy)
//   />

// AI-generated entries (2026-07-29 amendment) render their "not a
// photograph" label here rather than through <ImageCredit>, because
// <ImageCredit> is not currently mounted on any page — a label routed
// only through it would be a policy with no rendering path. Emitting
// it beside the <img> means the label ships with the image wherever
// the image ships, which is what the amendment actually promises.
// Photographs are unaffected: the label element only exists for
// ai-generated entries, so no existing layout gains a node.

import { getStockEntry } from "../lib/stockManifest";
import Cover from "./Cover.astro";

interface Props {
  slug: string;
  coverTitle?: string;
  coverCategory?: string;
  coverSize?: "hero" | "med" | "sm" | "thumb";
  class?: string;
  loading?: "eager" | "lazy";
  sizes?: string;
}

const {
  slug,
  coverTitle = "",
  coverCategory = "Editorial",
  coverSize = "med",
  class: className,
  loading = "lazy",
  sizes,
} = Astro.props;

const entry = getStockEntry(slug);
const isAi = entry?.source === "ai-generated";
// Editorial photographs (a covered company's own image, used with
// visible credit) get the same overlay treatment as the AI label and
// for the same reason: the credit must ship with the image wherever it
// renders, not depend on a call site remembering a caption. The
// photographer field holds the credit owner per the manifest contract.
const isEditorial = entry?.source === "editorial";
---

{entry ? (
  isAi || isEditorial ? (
    <span class="dp-ai-figure">
      <img
        src={`/${entry.file}`}
        alt={entry.alt}
        width={entry.width}
        height={entry.height}
        loading={loading}
        decoding="async"
        sizes={sizes}
        class={className}
        data-stock-slug={entry.slug}
        data-stock-source={entry.source}
        data-ai-generated={isAi ? "true" : undefined}
      />
      <span class="dp-ai-label" data-image-ai-label={isAi ? true : undefined}>
        {isAi
          ? `Illustration: generated with ${entry.generator} · not a photograph`
          : `Image: ${entry.photographer}`}
      </span>
    </span>
  ) : (
    <img
      src={`/${entry.file}`}
      alt={entry.alt}
      width={entry.width}
      height={entry.height}
      loading={loading}
      decoding="async"
      sizes={sizes}
      class={className}
      data-stock-slug={entry.slug}
      data-stock-source={entry.source}
    />
  )
) : (
  <Cover title={coverTitle} category={coverCategory} size={coverSize} />
)}

<style>
  /* The label rides ON the image rather than under it.

     In-flow it wrapped to two lines inside a listing tile and pushed
     that card's eyebrow and headline ~30px below its neighbours' —
     every card grid on the site broke its rhythm around a single AI
     image. Overlaid, the disclosure travels with the image everywhere
     it appears and costs no layout.

     Only ai-generated and editorial-source entries get this wrapper;
     stock photographs keep the bare <img> they have always rendered,
     so the Pexels entries carry no regression risk from this change. */
  .dp-ai-figure {
    position: relative;
    display: block;
    line-height: 0;
  }
  .dp-ai-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 26px 12px 9px;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-size: 11px;
    font-style: italic;
    line-height: 1.35;
    color: #fff;
    text-align: left;
    /* Scrim tuned against the first real image — a bright gold frame
       where a 62% gradient left white italic text barely readable.
       The dark stop has to reach full strength behind the text itself,
       not just at the image edge. */
    background: linear-gradient(
      to top,
      rgb(0 0 0 / 82%) 0%,
      rgb(0 0 0 / 72%) 55%,
      rgb(0 0 0 / 0%) 100%
    );
    text-shadow: 0 1px 2px rgb(0 0 0 / 55%);
    pointer-events: none;
  }
</style>
