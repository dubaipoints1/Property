---
// CardImage — show the verified face for this exact card, or a plain
// disclosure. Editorial photography is not a substitute for product art.
//
// 9 Oct 2026, Chairman: "for the cards pull the actual images". The card
// sits centred on a quiet panel that takes the same class as the image it
// replaces, so every grid keeps its dimensions.
import { getCardArt } from "../lib/cardArt";
import { cardArtSrcset } from "../lib/stockDerivatives";

interface Props {
  cardSlug: string;
  cardName: string;
  bankName?: string;
  coverSize?: "hero" | "med" | "sm" | "thumb";
  class?: string;
  loading?: "eager" | "lazy";
  /** Rendered slot width; used with the issuer-art srcset. */
  sizes?: string;
}

const { cardSlug, cardName, bankName, coverSize = "med", class: className, loading = "lazy", sizes } = Astro.props;
const art = getCardArt(cardSlug);
// A 360w derivative (scripts/images/make-thumbs.mjs) serves the small
// rows; `sizes` is set only alongside a srcset, never alone.
const artSrcset = art ? cardArtSrcset(cardSlug, art) : undefined;
const artSizes = artSrcset ? (sizes ?? "100vw") : undefined;
---

{art ? (
  <span class:list={["dp-card-art", className, `is-${coverSize}`]}>
    <img
      src={`/${art.file}`}
      srcset={artSrcset}
      sizes={artSizes}
      width={art.width}
      height={art.height}
      alt={`${cardName} card${bankName ? `, as shown by ${bankName}` : ""}`}
      loading={loading}
      fetchpriority={loading === "eager" ? "high" : "low"}
      decoding="async"
      data-card-art={cardSlug}
    />
  </span>
) : (
  <span class:list={["dp-card-art-unavailable", className, `is-${coverSize}`]}>
    Issuer card image unavailable
  </span>
)}

<style>
  .dp-card-art {
    display: grid !important;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    aspect-ratio: 16 / 10;
    width: 100%;
    padding: 9% 12%;
    box-sizing: border-box;
    background:
      radial-gradient(120% 90% at 50% 0%, rgba(184, 132, 42, 0.10), transparent 60%),
      var(--shade-1);
    overflow: hidden;
  }
  .dp-card-art.is-thumb { padding: 10% 8%; }
  .dp-card-art-unavailable {
    display: grid !important;
    place-content: center;
    width: 100%;
    aspect-ratio: 16 / 10;
    padding: 4px;
    box-sizing: border-box;
    background: var(--shade-1);
    color: var(--ink-soft);
    text-align: center;
    font: 500 .75rem/1.25 var(--font-ui);
    overflow-wrap: anywhere;
  }
  .dp-card-art-unavailable.is-thumb { font-size: .625rem; }
  /* More specific than `.dp-prose figure img { height: auto }`: the
     image box must fit this panel before object-fit can contain its art. */
  .dp-card-art img[data-card-art] {
    display: block;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 16px rgba(19, 35, 47, 0.28));
  }
</style>
