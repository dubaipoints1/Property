---
// Footer — simplified 9 October 2026 on Chairman direction ("at the bottom
// of the page remove that big ugly word dubaipoints and the footer with all
// that looks messy clean it up somehow").
//
// Was: six columns (fourteen bank rows with logos, seven salary bands, six
// programmes, twelve site links, ten trust links), an outlined display
// wordmark, then a copyright row and a disclaimer — ~60 small links that
// also made up most of the audit's undersized tap targets. Now: one brand
// line, three short columns, one quiet bottom line. Every page dropped from
// here is still one tap away from the header menu or its section index
// (/banks/, /airlines/, /salary-transfer/).

const year = new Date().getFullYear();

const COLUMNS = [
  {
    heading: "Explore",
    links: [
      { href: "/cards/", label: "Credit cards" },
      { href: "/banks/", label: "Banks" },
      { href: "/airlines/", label: "Miles & hotel programmes" },
      { href: "/salary-transfer/", label: "Salary transfer" },
      { href: "/deals/", label: "Deals" },
      { href: "/guides/", label: "Guides" },
      { href: "/news/", label: "News" },
    ],
  },
  {
    heading: "Tools",
    links: [
      { href: "/cards/finder/", label: "Card finder" },
      { href: "/cards/compare/", label: "Compare cards" },
      { href: "/calculator/", label: "Spend-return calculator" },
      { href: "/salary-transfer/calculator/", label: "Salary-transfer calculator" },
      { href: "/cards/fees/", label: "Card fee index" },
      { href: "/valuations/", label: "Points valuations" },
    ],
  },
  {
    heading: "About",
    links: [
      { href: "/about/", label: "About DubaiPoints" },
      { href: "/editorial-policy/", label: "Editorial policy" },
      { href: "/how-we-make-money/", label: "How we make money" },
      { href: "/corrections/", label: "Corrections" },
      { href: "/tip/", label: "Send a tip" },
    ],
  },
];
---

<footer class="dp-footer">
  <div class="dp-footer-inner">
    <div class="dp-footer-top">
      <div class="dp-footer-brand">
        <a href="/" class="dp-footer-wordmark">DubaiPoints</a>
        <p class="dp-footer-tag">Independent UAE points, miles and card guides. Every figure dated, sourced and in dirhams.</p>
      </div>
      {COLUMNS.map((col) => (
        <nav class="dp-footer-col" aria-label={col.heading}>
          <p class="dp-footer-heading">{col.heading}</p>
          <ul>
            {col.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <p class="dp-footer-bottom">
      <span>© {year} DubaiPoints · Not affiliated with any bank, airline or hotel programme. Check terms with the provider before you apply.</span>
      <a href="mailto:info@dubaipoints.ae">info@dubaipoints.ae</a>
    </p>
  </div>
</footer>

<style>
  .dp-footer {
    background: var(--navy-deep);
    color: rgba(255, 255, 255, 0.72);
    margin-top: 96px;
    padding: 64px 48px 32px;
  }
  .dp-footer-inner { max-width: var(--container-listing); margin: 0 auto; }
  .dp-footer-top {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 40px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .dp-footer-wordmark {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 24px;
    letter-spacing: -0.01em;
    color: #fff;
    text-decoration: none;
  }
  .dp-footer-tag {
    margin: 12px 0 0;
    max-width: 30ch;
    font-size: 14px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.6);
  }
  .dp-footer-heading {
    margin: 0 0 14px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-lift);
  }
  .dp-footer-col ul { list-style: none; margin: 0; padding: 0; }
  .dp-footer-col a {
    display: inline-block;
    padding: 6px 0;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.82);
    text-decoration: none;
    transition: color 0.15s;
  }
  .dp-footer-col a:hover,
  .dp-footer-wordmark:hover { color: var(--gold-lift); }
  .dp-footer a:focus-visible { outline: 2px solid var(--gold-lift); outline-offset: 3px; }
  .dp-footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px 32px;
    margin: 24px 0 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }
  .dp-footer-bottom a { color: rgba(255, 255, 255, 0.72); white-space: nowrap; margin-right: 64px; }

  @media (max-width: 900px) {
    .dp-footer { margin-top: 64px; padding: 48px 20px 96px; }
    .dp-footer-top { grid-template-columns: 1fr 1fr; gap: 32px 20px; }
    .dp-footer-brand { grid-column: 1 / -1; }
    .dp-footer-col a { padding: 9px 0; }
    .dp-footer-bottom { flex-direction: column; }
  }
</style>
