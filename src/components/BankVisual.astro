---
// A bank's own mark on a quiet panel, used where a bank tile or hub would
// otherwise show a generic skyline photograph. 20 Oct 2026, Chairman: "I do
// want logo ... i do not want generic pictures." White-only marks sit,
// unmodified, on the brand navy. Takes the class of the image it replaces.

import { bankMark } from "../lib/logos";

interface Props {
  slug: string;
  name: string;
  class?: string;
  coverSize?: "hero" | "med";
  loading?: "eager" | "lazy";
}

const { slug, name, class: className, coverSize = "med", loading = "lazy" } = Astro.props;
const mark = bankMark(slug);
---

<span class:list={["dp-bank-visual", className, `is-${coverSize}`, { "is-plated": mark.plated }]}>
  <span class="dp-bank-visual-inner">
    <img src={mark.src} alt={`${name} logo`} loading={loading} decoding="async" />
  </span>
</span>

<style>
  .dp-bank-visual {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    background: #fff;
    border-bottom: 1px solid var(--line);
  }
  .dp-bank-visual.is-hero { aspect-ratio: 16 / 9; }
  .dp-bank-visual.is-plated { background: #1f3a4d; }
  .dp-bank-visual-inner {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .dp-bank-visual img {
    max-width: 58%;
    max-height: 40%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
</style>
