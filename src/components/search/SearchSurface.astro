---
// Origin Command-inspired grouping in native Astro/DOM: no cmdk/Radix/React.
const routes = [
  { href: "/cards/finder/", label: "Find a card", description: "Match cards to your spending" },
  { href: "/salary-transfer/", label: "Salary tracker", description: "Browse bank offers and their terms" },
  { href: "/airlines/", label: "Airline programmes", description: "Earning, redeeming and transfers" },
  { href: "/news/", label: "Latest news", description: "Changes that matter to UAE readers" },
];
---

<section class="dp-search-surface" data-dp-search data-pagefind-ignore aria-label="Site search">
  <form action="/search/" method="get" role="search" class="dp-search-form">
    <label for="dp-search-query" class="sr-only">Search DubaiPoints</label>
    <div class="dp-search-field">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
      <input id="dp-search-query" class="pagefind-ui__search-input" data-dp-search-input type="search" name="q" maxlength="160" autocomplete="off" enterkeyhint="search" placeholder="Try Skywards, cashback or salary transfer" aria-label="Search DubaiPoints" aria-describedby="search-tip" />
      <button class="dp-search-clear" type="button" data-search-clear hidden aria-label="Clear search">Clear</button>
      <button class="dp-search-submit" type="submit">Search</button>
    </div>
  </form>
  <p class="dp-search-tip" id="search-tip">Search by card, bank or topic. Use quotation marks for an exact phrase, such as <code>"salary transfer"</code>.</p>
  <noscript><p class="dp-search-fallback">Search needs JavaScript. You can still browse the sections below or use the <a href="/sitemap-index.xml">full sitemap</a>.</p></noscript>
  <div class="dp-search-workspace">
    <p class="dp-search-status" data-search-status role="status" aria-live="polite" aria-atomic="true">Start with a bank, a programme or a topic.</p>
    <div class="dp-search-message" data-search-empty hidden>
      <h2>No matches this time</h2>
      <p>We could not find <strong data-search-empty-query></strong>. Try a shorter phrase, a bank name or a programme name.</p>
    </div>
    <div class="dp-search-message" data-search-error hidden role="alert">
      <h2>Search could not load</h2>
      <p>Your connection may have been interrupted. Try again, or browse a section below.</p>
      <button class="dp-search-retry" type="button" data-search-retry>Try search again</button>
    </div>
    <div class="dp-search-results" data-search-results aria-busy="false"></div>
    <button class="dp-search-more" data-search-more type="button" hidden>Show more results</button>
    <nav class="dp-search-routes" aria-label="Browse DubaiPoints" data-search-routes>
      <h2>Or go straight to</h2>
      <div class="dp-search-route-grid">
        {routes.map((route) => <a href={route.href}><span>{route.label}</span><span class="dp-search-route-description">{route.description}</span><span class="dp-search-route-arrow" aria-hidden="true">↗</span></a>)}
      </div>
    </nav>
  </div>
</section>

<script>
  import { createPagefindIndexLoader, createSearchSession, groupSearchResults, normaliseSearchQuery } from "../../lib/searchPresentation.mjs";
  // Browser search API types: https://pagefind.app/docs/sub-results/ .
  interface SearchSubResult { url: string; title: string; excerpt?: string; plain_excerpt?: string }
  interface SearchRecord { url: string; meta?: { title?: string }; excerpt?: string; plain_excerpt?: string; sub_results?: SearchSubResult[] }
  interface SearchReference { data: () => Promise<SearchRecord> }
  const surface = document.querySelector<HTMLElement>("[data-dp-search]");
  if (surface) {
    const input = surface.querySelector<HTMLInputElement>("[data-dp-search-input]")!;
    const form = surface.querySelector<HTMLFormElement>("form")!;
    const status = surface.querySelector<HTMLElement>("[data-search-status]")!;
    const results = surface.querySelector<HTMLElement>("[data-search-results]")!;
    const clear = surface.querySelector<HTMLButtonElement>("[data-search-clear]")!;
    const more = surface.querySelector<HTMLButtonElement>("[data-search-more]")!;
    const retry = surface.querySelector<HTMLButtonElement>("[data-search-retry]")!;
    const empty = surface.querySelector<HTMLElement>("[data-search-empty]")!;
    const error = surface.querySelector<HTMLElement>("[data-search-error]")!;
    const routes = surface.querySelector<HTMLElement>("[data-search-routes]")!;
    // Generated after Astro's build. Load the index only for an actual query.
    const indexLoader = createPagefindIndexLoader((indexUrl: string) => import(/* @vite-ignore */ indexUrl));
    const session = createSearchSession(indexLoader.load);
    const batchSize = 12;
    let version = 0;
    let timer: ReturnType<typeof setTimeout>;
    let references: SearchReference[] = [];
    let loaded: SearchRecord[] = [];
    let cursor = 0;
    const element = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string, text?: string) => {
      const node = document.createElement(tag);
      node.className = className;
      if (text) node.textContent = text;
      return node;
    };
    const render = () => {
      const fragment = document.createDocumentFragment();
      for (const group of groupSearchResults(loaded)) {
        const section = element("section", "dp-search-group");
        const heading = element("h2", "dp-search-group-title", group.label);
        heading.id = `search-group-${group.id}`;
        section.setAttribute("aria-labelledby", heading.id);
        section.append(heading);
        const list = element("ul", "dp-search-list");
        for (const item of group.results) {
          const row = element("li", "dp-search-result");
          const title = element("h3", "dp-search-result-title");
          const link = element("a", "dp-search-result-link", item.title);
          link.href = item.href;
          title.append(link);
          row.append(title);
          if (item.excerpt) row.append(element("p", "dp-search-excerpt", item.excerpt));
          if (item.subResults.length) {
            const disclosure = element("details", "dp-search-section-matches");
            disclosure.append(element("summary", "dp-search-section-summary", `Jump to ${item.subResults.length} matching ${item.subResults.length === 1 ? "section" : "sections"}`));
            const sections = element("ul", "dp-search-subresults");
            sections.setAttribute("aria-label", `Matching sections in ${item.title}`);
            for (const match of item.subResults) {
              const section = element("li", "dp-search-subresult");
              const heading = element("h4", "dp-search-subresult-title");
              const jump = element("a", "dp-search-subresult-link", match.title);
              jump.href = match.href;
              heading.append(jump);
              section.append(heading);
              if (match.excerpt) section.append(element("p", "dp-search-excerpt", match.excerpt));
              sections.append(section);
            }
            disclosure.append(sections);
            row.append(disclosure);
          }
          list.append(row);
        }
        section.append(list);
        fragment.append(section);
      }
      // Complete batches avoid independently resizing Pagefind skeleton rows.
      results.replaceChildren(fragment);
    };
    const ready = (query: string) => {
      results.setAttribute("aria-busy", "false");
      more.disabled = false;
      more.hidden = cursor >= references.length;
      more.textContent = "Show more results";
      const count = references.length;
      status.textContent = count ? `${count} ${count === 1 ? "result" : "results"} for “${query}”.${cursor < count ? ` Showing the first ${cursor}, grouped by section.` : " Grouped by section."}` : `No results for “${query}”.`;
      empty.hidden = count !== 0;
      empty.querySelector<HTMLElement>("[data-search-empty-query]")!.textContent = `“${query}”`;
      routes.hidden = count !== 0;
    };
    const loadBatch = async (ticket: number, query: string) => {
      const batch = await Promise.all(references.slice(cursor, cursor + batchSize).map((reference) => reference.data()));
      if (ticket !== version) return;
      loaded.push(...batch);
      cursor += batch.length;
      render();
      ready(query);
      return groupSearchResults(batch).flatMap((group) => group.results)[0]?.href;
    };
    const failed = () => {
      results.setAttribute("aria-busy", "false");
      status.textContent = loaded.length ? "Some results are shown. The next results could not load." : "Search is temporarily unavailable.";
      error.hidden = false;
      routes.hidden = false;
      more.disabled = false;
      more.hidden = true;
      retry.textContent = indexLoader.canRetry() ? "Try search again" : "Reload search";
    };
    const run = async () => {
      clearTimeout(timer);
      const ticket = ++version;
      const query = normaliseSearchQuery(input.value);
      clear.hidden = !input.value;
      references = [];
      loaded = [];
      cursor = 0;
      results.replaceChildren();
      empty.hidden = true;
      error.hidden = true;
      more.hidden = true;
      routes.hidden = Boolean(query);
      if (!query) {
        session.invalidate();
        status.textContent = "Start with a bank, a programme or a topic.";
        results.setAttribute("aria-busy", "false");
        return;
      }
      status.textContent = `Searching for “${query}”…`;
      results.setAttribute("aria-busy", "true");
      try {
        const response = await session.search(query);
        if (!response || ticket !== version) return;
        references = response.results;
        await loadBatch(ticket, query);
      } catch { if (ticket === version) failed(); }
    };
    input.addEventListener("input", () => {
      // Invalidate before the debounce, so an older response cannot repaint.
      version += 1;
      session.invalidate();
      clear.hidden = !input.value;
      clearTimeout(timer);
      timer = setTimeout(run, 220);
    });
    form.addEventListener("submit", (event) => { event.preventDefault(); void run(); });
    clear.addEventListener("click", () => { input.value = ""; void run(); input.focus(); });
    retry.addEventListener("click", () => {
      if (indexLoader.canRetry()) void run();
      // Native GET navigation creates a new document/module map and keeps
      // the entered query. Do not invent unbounded retry URL variants.
      else form.submit();
    });
    more.addEventListener("click", async () => {
      const ticket = version;
      const query = normaliseSearchQuery(input.value);
      more.disabled = true;
      more.textContent = "Loading results…";
      results.setAttribute("aria-busy", "true");
      try {
        const nextHref = await loadBatch(ticket, query);
        if (ticket !== version) return;
        // The final batch hides its button. Move deliberately to a newly
        // revealed result rather than dropping keyboard focus to <body>.
        const nextLink = [...results.querySelectorAll<HTMLAnchorElement>("a[href]")].find((link) => link.getAttribute("href") === nextHref);
        if (nextLink) nextLink.focus();
        else if (more.hidden) input.focus({ preventScroll: true });
      }
      catch { if (ticket === version) failed(); }
    });
    input.value = normaliseSearchQuery(new URLSearchParams(window.location.search).get("q") ?? "");
    if (window.matchMedia("(min-width: 1024px) and (pointer: fine)").matches) input.focus({ preventScroll: true });
    if (input.value) void run();
  }
</script>

<style>
  .dp-search-surface { max-width: 900px; margin-inline: auto; padding: 12px 32px 64px; }
  .dp-search-field { display: flex; align-items: center; gap: 12px; padding: 8px; border: 1px solid var(--line); border-radius: var(--dp-ui-radius); background: var(--paper); }
  .dp-search-field > svg { flex-shrink: 0; color: var(--ink-soft); margin-inline-start: 8px; }
  .dp-search-field:focus-within { border-color: var(--green); outline: 2px solid var(--green); outline-offset: 3px; }
  .dp-search-field input { min-width: 0; width: 100%; min-height: 48px; padding: 6px 0; border: 0; background: transparent; color: var(--ink); font: 400 16px/1.5 var(--font-ui); box-shadow: none; }
  .dp-search-field input::placeholder { color: var(--ink-soft); opacity: 1; }
  .dp-search-field input:focus { outline: none; }
  .dp-search-field input::-webkit-search-cancel-button { display: none; }
  .dp-search-surface button { min-height: 44px; padding: 10px 18px; border: 1px solid var(--line); border-radius: calc(var(--dp-ui-radius) - 2px); font: 600 14px/1.3 var(--font-ui); cursor: pointer; }
  .dp-search-surface button:focus-visible, .dp-search-route-grid a:focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .dp-search-submit { color: var(--paper); background: var(--ink); border-color: var(--ink) !important; }
  .dp-search-submit:hover { color: var(--paper); background: var(--green); border-color: var(--green) !important; }
  .dp-search-clear, .dp-search-retry, .dp-search-more { color: var(--ink); background: var(--paper); }
  .dp-search-clear:hover, .dp-search-retry:hover, .dp-search-more:hover { border-color: var(--green); background: var(--shade-1); }
  .dp-search-surface button:disabled { cursor: progress; opacity: 0.65; }
  .dp-search-tip { margin: 14px 0 0; color: var(--ink-soft); font: 400 13px/1.65 var(--font-ui); }
  .dp-search-tip code { color: var(--ink); font-size: inherit; }
  .dp-search-workspace { min-height: 60vh; }
  .dp-search-status { min-height: 48px; margin: 28px 0 8px; color: var(--ink-soft); font: 500 14px/1.6 var(--font-ui); }
  .dp-search-routes { margin-top: 28px; }
  .dp-search-routes h2 { margin: 0 0 16px; color: var(--ink); font: 500 26px/1.2 var(--font-display); }
  .dp-search-route-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .dp-search-route-grid a { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 20px 44px 20px 20px; border: 1px solid var(--line); border-radius: var(--dp-ui-radius); color: var(--ink); background: var(--paper); font: 600 15px/1.4 var(--font-ui); text-decoration: none; }
  .dp-search-route-grid a:hover { border-color: var(--green); background: var(--shade-1); }
  .dp-search-route-description { color: var(--ink-soft); font-size: 13px; font-weight: 400; }
  .dp-search-route-arrow { position: absolute; inset-inline-end: 20px; top: 20px; color: var(--green); font-size: 20px; }
  .dp-search-message, .dp-search-fallback { padding: 24px; border: 1px solid var(--line); border-radius: var(--dp-ui-radius); background: var(--paper); }
  .dp-search-message h2 { margin: 0 0 12px; font: 500 28px/1.25 var(--font-display); color: var(--ink); }
  .dp-search-message p, .dp-search-fallback { color: var(--ink-soft); font: 400 15px/1.65 var(--font-ui); }
  .dp-search-message p { margin: 0 0 16px; }
  .dp-search-more { margin-top: 20px; width: 100%; }
  .dp-search-surface [hidden] { display: none !important; }
  :global([data-dp-search] .dp-search-group) { margin: 0 0 28px; }
  :global([data-dp-search] .dp-search-group-title) { display: flex; align-items: center; gap: 14px; margin: 0 0 4px; color: var(--green); font: 700 11px/1.5 var(--font-ui); letter-spacing: 1.4px; text-transform: uppercase; }
  :global([data-dp-search] .dp-search-group-title::after) { content: ""; flex: 1; height: 1px; background: var(--line); }
  :global([data-dp-search] .dp-search-list) { list-style: none; margin: 0; padding: 0; }
  :global([data-dp-search] .dp-search-result) { position: relative; margin: 0; padding: 20px 0; border-bottom: 1px solid var(--line); }
  :global([data-dp-search] .dp-search-result-title) { margin: 0; font: 500 clamp(20px, 2.2vw, 25px)/1.25 var(--font-display); }
  :global([data-dp-search] .dp-search-result-link) { color: var(--ink); text-decoration: none; text-underline-offset: 4px; }
  :global([data-dp-search] .dp-search-result-link:hover) { color: var(--green); text-decoration: underline; }
  :global([data-dp-search] .dp-search-result-link:focus-visible) { outline: 2px solid var(--green); outline-offset: 4px; border-radius: 2px; }
  :global([data-dp-search] .dp-search-excerpt) { max-width: 72ch; margin: 8px 0 0; color: var(--ink-soft); font: 400 14px/1.65 var(--font-ui); overflow-wrap: anywhere; }
  :global([data-dp-search] .dp-search-section-matches) { margin-top: 10px; }
  :global([data-dp-search] .dp-search-section-summary) { min-height: 44px; align-content: center; color: var(--green); font: 600 13px/1.5 var(--font-ui); cursor: pointer; }
  :global([data-dp-search] .dp-search-section-summary:focus-visible) { outline: 2px solid var(--green); outline-offset: 3px; }
  :global([data-dp-search] .dp-search-subresults) { display: grid; gap: 16px; list-style: none; margin: 18px 0 0; padding: 0 0 0 18px; border-inline-start: 2px solid var(--line); }
  :global([data-dp-search] .dp-search-subresult) { margin: 0; padding: 0; }
  :global([data-dp-search] .dp-search-subresult-title) { margin: 0; font: 600 14px/1.4 var(--font-ui); }
  :global([data-dp-search] .dp-search-subresult-link) { display: inline-flex; align-items: center; min-height: 44px; color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
  :global([data-dp-search] .dp-search-subresult-link:hover) { color: var(--ink); }
  :global([data-dp-search] .dp-search-subresult-link:focus-visible) { outline: 2px solid var(--green); outline-offset: 3px; }
  :global([data-dp-search] .dp-search-subresult .dp-search-excerpt) { margin-top: 2px; font-size: 13px; }
  @media (max-width: 640px) {
    .dp-search-surface { padding: 8px 20px 48px; }
    .dp-search-field { gap: 8px; flex-wrap: wrap; }
    .dp-search-field input { flex: 1; width: 0; }
    .dp-search-field > svg { width: 18px; margin-inline-start: 4px; }
    .dp-search-field input::placeholder { font-size: 14px; }
    .dp-search-surface .dp-search-clear { padding-inline: 8px; }
    .dp-search-submit { flex-basis: 100%; }
    .dp-search-route-grid { grid-template-columns: 1fr; }
    .dp-search-message { padding: 20px; }
  }
</style>
